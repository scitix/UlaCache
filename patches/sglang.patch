+    from sglang.kernels.ops.communication.all_reduce import IPCManager
+    from ulacache.compiler import configure_compiler
+    from ulacache.flashag import create_index_owner as create
+
+    configure_compiler(load_jit)
+    owner = create(serving_group, max_queries=max_queries,
+                   max_page_width=max_page_width, device=device,
+                   ipc_manager_factory=IPCManager)
+
+    import os
+
+    directory = os.environ.get("UDCACHE_MATRIX_AUDIT_DIR")
+    if directory:
+        import json
+        from pathlib import Path
+
+        path = Path(directory)
+        path.mkdir(parents=True, exist_ok=True)
+        receipt = dict(complete=True, rank=owner.rank_in_group,
+                       world=owner.world_size, transport=type(owner).__name__,
+                       compact_scores=owner.compact_scores,
+                       max_queries=owner.max_queries,
+                       max_page_width=owner.max_page_width)
+        (path / f"index_transport.rank{owner.rank_in_group}.json").write_text(
+            json.dumps(receipt, indent=2) + "\n")
+    return owner
