+    def restore_prefix(self, req, indices):
+        import torch
+        req._hisparse_prefix_finished = False
+        pages = self._pages(indices) if indices.numel() else []
+        if any(page <= 0 for page in pages):
+            raise ValueError("A cached prefix cannot refer to padding page zero")
+        owned = self.leases.requests.get(self.key(req), set())
+        wanted = [p for p in pages if p not in owned]
+        missing = [p for p in wanted if p not in self.leases.pages]
+        new_mapping = {}
