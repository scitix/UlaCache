+def create_native_fp8_distributed_index_pool_class(base_class, configuration, *, maximum_columns,
+                                                    serving_group=None):
+    import torch
+    import torch.distributed as distributed
+    from contextlib import nullcontext
+    from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+    from sglang.srt.mem_cache.index_key_cache import IndexKeyCache
+    from sglang.srt.runtime_context import get_parallel, get_spec
+    from sglang.kernels.ops.communication.all_reduce import IPCManager
+    from sglang.srt.layers.attention.dsa import dsa_indexer_kpool
+    from ulacache.indexer import NativeFP8IndexRuntime, NativeIndexOwnership
+    from ulacache.indexer.kernels.fp8_storage import owned_index_location, store_owned_native_fp8_index
+
+    class OwnedIndexKeyCache(IndexKeyCache):
+        def __init__(self, pool):
+            self.pool = pool
+            if pool.index_head_dim != 128 or pool.index_page_size != 64:
+                raise NotImplementedError('Bind native FP8 page64 Index producer banks')
+            ownership = pool.native_index_ownership
+            with pool.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+                with (torch.cuda.use_mem_pool(pool.custom_mem_pool) if pool.custom_mem_pool else nullcontext()):
+                    self.storage = torch.zeros((len(pool.native_index_bank_by_layer), ownership.native_page_count, 8448),
+                        dtype=torch.uint8, device=pool.device)
+            views = list(self.storage.unbind(0))
+            self.buffer = [views[pool.native_index_bank_by_layer[pool.start_layer + layer]]
+                if not pool.skip_topk_layers[layer] else self.storage.new_empty((0, 8448))
+                for layer in range(pool.layer_num)]
+
+        def get_local_buffer(self, layer_id):
+            runtime = self.pool.native_distributed_indexer
+            if runtime is not None and layer_id in self.pool.native_index_bank_by_layer:
+                runtime.before_native_write(self.pool.native_index_bank_by_layer[layer_id])
+            return super().get_local_buffer(layer_id)
+
+        def get_k_and_scale(self, layer_id, seq_len_tensor, page_indices, seq_len_sum, max_seq_len):
+            keys = torch.empty((seq_len_sum, 128), dtype=torch.uint8, device=self.pool.device)
+            scales = torch.empty(seq_len_sum, dtype=torch.float32, device=self.pool.device)
+            runtime = self.pool.native_distributed_indexer
+            bank = self.pool.native_index_bank_by_layer[layer_id]
+            runtime.gather_ragged_prefix(bank, page_indices, seq_len_tensor, keys, scales,
+                maximum_length=max_seq_len)
+            return keys, scales.view(-1, 1)
+
+        def store_quantized(self, layer_id, loc, index_k, index_k_scale):
+            store_owned_native_fp8_index(loc.reshape(-1), index_k.reshape(-1, 128),
+                index_k_scale.reshape(-1), self.get_local_buffer(layer_id),
+                owner_rank=self.pool.native_index_owner_rank, owner_count=self.pool.storage_owner_count)
+
+        def store_key(self, layer_id, key, locations, batch):
+            from sglang.kernels.ops.attention.fused_store_index_cache import fused_store_owner_index_k_cache
+
+            if self.pool.index_kpool != 1:
+                raise NotImplementedError('Compressed Index uses its native k-pool producers')
+            fused_store_owner_index_k_cache(key, self.get_local_buffer(layer_id), locations,
+                degree=self.pool.storage_owner_count, rank=self.pool.native_index_owner_rank,
+                page_size=self.pool.index_page_size)
+
+        def store_key_norm_rope(self, layer_id, key, locations, norm_weight, norm_bias,
+                                epsilon, cos_sin, positions, batch):
+            from sglang.kernels.ops.attention.dsa.indexer_k import fused_k_indexer_norm_rope_store
+
+            if self.pool.index_kpool != 1:
+                raise NotImplementedError('Compressed Index uses its native k-pool producers')
+            fused_k_indexer_norm_rope_store(key, self.get_local_buffer(layer_id), locations,
+                norm_weight, norm_bias, epsilon, cos_sin, positions, self.pool.index_page_size,
+                owner_degree=self.pool.storage_owner_count, owner_rank=self.pool.native_index_owner_rank)
+
+        def move(self, target, source):
+            raise NotImplementedError('Distributed native Index relocation requires shared logical move hooks')
+
+        def cpu_copy(self, indices):
+            raise NotImplementedError('Native request retraction needs an explicit distributed Index backup binding')
+
+        def load_cpu_copy(self, values, indices):
+            raise NotImplementedError('Native request restore needs an explicit distributed Index backup binding')
+
+    class NativeFP8DistributedIndexPool(base_class):
+        def __init__(self, *args, **kwargs):
+            from sglang.srt.ulacache.native_cache_topology import resolve_native_record_owner_count
+
+            self.native_distributed_indexer = None
+            owners = (serving_group.world_size if serving_group is not None else
+                resolve_native_record_owner_count(get_parallel(),
+                    getattr(configuration, 'storage_owner_count', None),
+                    replicated_control=getattr(configuration, 'independent_tensor_parallel_caches', False)))
+            if owners > 1 and (owners != 8 or torch.cuda.get_device_capability()[0] != 9):
+                raise NotImplementedError('Bind native FP8 Index on eight Hopper owners')
+            if get_spec().speculative_algorithm is not None:
+                raise NotImplementedError('Owned native FP8 Index needs a separate speculative metadata binding')
+            prefill_queries = getattr(configuration, 'maximum_index_prefill_query_count', 256)
+            if type(prefill_queries) is not int or prefill_queries < 1:
+                raise ValueError('Declare a positive native Index prefill query chunk bound')
+            super().__init__(*args, **kwargs)
+            if self.storage_owner_count == 1 or not configuration.distributed_indexer:
+                return
+            group = serving_group if serving_group is not None else get_parallel().attn_tp_group
+            if distributed.get_world_size(self.record_owner_process_group) != group.world_size:
+                raise ValueError('KV owners and compressed Index must share the actual TP group')
+            page_width = (maximum_columns + 63) // 64
+            index_queries = max(self.maximum_padded_query_count, prefill_queries)
+            score_group = create_native_index_score_group(configuration, group, max_queries=index_queries,
+                max_page_width=page_width, device=torch.device(self.device))
+            self.native_distributed_indexer = NativeFP8IndexRuntime(self.native_index_ownership,
+                self.index_key_cache.storage, maximum_queries=index_queries,
+                maximum_columns=maximum_columns, score_group=score_group,
+                cpu_group=self.record_owner_process_group, ipc_manager_factory=IPCManager,
+                schedule_builder=lambda lengths: dsa_indexer_kpool.deep_gemm.get_paged_mqa_logits_metadata(
+                    lengths, 64, torch.cuda.get_device_properties(self.device).multi_processor_count),
+                prefill_query_chunk_count=prefill_queries,
+                ragged_score_mode=getattr(configuration, 'index_prefill_score_mode', 'native'))
+
+        def _create_index_key_cache(self):
+            if self.storage_owner_count == 1 or not configuration.distributed_indexer:
+                return super()._create_index_key_cache()
+            if (self.index_kpool not in (1, 4)
+                    or (self.index_kpool == 4 and not self.index_kpool_compress)
+                    or self.storage_owner_count != 8
+                    or torch.cuda.get_device_capability(self.device)[0] != 9):
+                raise NotImplementedError('Bind native FP8 Index on eight Hopper owners')
+            producers = [self.start_layer + i for i in range(self.layer_num) if not self.skip_topk_layers[i]]
+            self.native_index_bank_by_layer = {layer: bank for bank, layer in enumerate(producers)}
+            self.native_index_owner_rank = distributed.get_rank(self.record_owner_process_group)
+            self.native_index_owner_count = self.storage_owner_count
+            self.native_index_location_mapper = owned_index_location
+            self.native_index_ownership = NativeIndexOwnership(
+                (self.size + self.page_size) // self.index_kpool,
+                self.page_size // self.index_kpool, self.storage_owner_count, 64, 0, 132)
+            self.native_index_global_page_count = (
+                self.native_index_ownership.logical_record_capacity + 63) // 64
+            return OwnedIndexKeyCache(self)
+
+        def prepare_cache_forward(self, batch, *, publish_active_query_count=True):
+            super().prepare_cache_forward(batch, publish_active_query_count=publish_active_query_count)
+            if self.native_distributed_indexer is not None:
+                self.native_distributed_indexer.begin_forward()
+
+        def get_device_storage_inventory(self):
+            result = super().get_device_storage_inventory()
+            if self.native_distributed_indexer is not None:
+                result.update(self.native_distributed_indexer.get_device_storage_inventory())
+
+            return result
+
+        def close(self):
+            super().close()
+            if self.native_distributed_indexer is not None:
+                self.native_distributed_indexer.close()
+
+    return NativeFP8DistributedIndexPool
diff --git a/python/sglang/srt/ulacache/native_fp8_index_scoring.py b/python/sglang/srt/ulacache/native_fp8_index_scoring.py
