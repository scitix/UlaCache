+"""Startup-only union of native allocations and the UlaCache device inventory."""
+import json
+import os
+from pathlib import Path
+
+
+def install():
+    import torch
+    from sglang.srt.model_executor.model_runner_components import cuda_graph_setup
+    original = cuda_graph_setup.capture_decode_graph
+
+    def capture(*, model_runner):
+        result = original(model_runner=model_runner)
+        cache = model_runner.token_to_kv_pool.udcache_local
+        rank = torch.distributed.get_rank()
+        root = Path(os.environ["FLOWKV_STEP_TRACE_DIR"])
+        native = json.loads((root / f"memory_audit.rank{rank}.json").read_text())
+        allocations = {v["storage_pointer"]: v["storage_bytes"] for v in native["tensors"].values()}
+        for pointer, size in cache.device_storage_inventory().items():
+            if pointer in allocations and allocations[pointer] != size:
+                raise ValueError("Native and unified tensor storage sizes disagree")
+            allocations[pointer] = size
+        actual = sum(allocations.values())
+        budget = int(os.environ["UDCACHE_DPA_CACHE_BUDGET_BYTES"])
+        cpu = native["cpu_cache_storage_bytes"] + cache.host.nbytes
+        if abs(actual - budget) > 1_000_000_000:
+            raise ValueError(f"Unified cache budget differs by more than 1GB: {actual} vs {budget}")
+        if cpu > int(os.environ["UDCACHE_CPU_CACHE_CAP_BYTES"]):
+            raise ValueError("Unified CPU cache and metadata exceed the per-card cap")
+        value = dict(passed=True, rank=rank, actual_gpu_cache_bytes=actual,
+            paired_gpu_cache_budget_bytes=budget, difference_bytes=actual-budget,
+            cpu_cache_bytes=cpu, library=cache.memory_inventory(),
+            group_anchors=cache.groups.anchors, local_buffer_bytes=0,
+            cache_peer_count=1, scope="Unique persistent native+UlaCache GPU backing storage; weights audited separately")
+        (root / f"unified_memory_audit.rank{rank}.json").write_text(json.dumps(value, indent=2) + "\n")
+        return result
+
+    cuda_graph_setup.capture_decode_graph = capture
