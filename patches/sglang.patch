@@ -0,0 +1,19 @@
+"""Page-aligned logical capacity shared by HiSparse pools and allocators."""
+
+import math
+
+
+def hisparse_logical_capacity(size: int, page_size: int, ratio: float) -> int:
+    """Keep logical IDs integral for fractional CPU/GPU capacity ratios.
+
+    The native host pool rounds this same product down to a complete page,
+    then adds one backing page. Index and allocator capacities exclude that
+    backing page, as they do for integer ratios.
+    """
+    if type(page_size) is not int or page_size <= 0:
+        raise ValueError("HiSparse page_size must be a positive integer")
+    if type(size) is not int or size < 0 or size % page_size:
+        raise ValueError("HiSparse physical capacity must contain complete pages")
+    if type(ratio) not in (int, float) or ratio <= 0 or not math.isfinite(ratio):
+        raise ValueError("HiSparse host_to_device_ratio must be positive and finite")
+    return int(size * ratio) // page_size * page_size
