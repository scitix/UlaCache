index 0000000000000000000000000000000000000000..335bdf56d81721ef490018cddf0a89f7377166d9
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_glm_flash_pool.py
@@ -0,0 +1,133 @@
+"""Bind GLM-5.3-Flash's hybrid sparse MLA while retaining native KDA and Index."""
+
+from dataclasses import dataclass, replace
+from ulacache import CacheCapacityPlan
+from sglang.srt.ulacache.native_sparse_layers import NativeSparseLayerAdapter
+
+from sglang.srt.ulacache.native_dsa_pool import (
+    NativeSparseLatentPoolConfiguration,
+    create_native_sparse_latent_pool_class,
+)
+
+
+@dataclass(frozen=True)
+class NativeGlmFlashPoolConfiguration(NativeSparseLatentPoolConfiguration):
+    index_compression_ratio: int = 4
+    native_attention_backend: str = 'tilelang'
+    maximum_padded_query_count: int | None = None
+    prepare_in_parallel: bool = True
+    independent_tensor_parallel_caches: bool = False
+    distributed_indexer: bool = False
+    use_shared_tensor_parallel_cache: bool = True
+    low_query_pull_blocks: int = 16
+    prefill_buffer_records: int = 1048576
+    initialize_cuda_profiler: bool = False
+    allocation_plan: CacheCapacityPlan | None = None
+    minimum_native_profile_available_bytes: int | None = None
+
+    def __post_init__(self):
+        super().__post_init__()
+        if type(self.initialize_cuda_profiler) is not bool:
+            raise ValueError('CUDA profiler initialization must be boolean')
+
+
+def validate_glm_flash_geometry(text_config, configuration):
+    """Return native payload banks and the complete token-selection width."""
+    if (getattr(text_config, 'model_type', None) != 'glm5_next_text'
+            or text_config.kv_lora_rank != 512
+            or text_config.qk_rope_head_dim != 0):
+        raise NotImplementedError('Bind the native 512-wide NoPE GLM-5.3-Flash checkpoint')
+    if (configuration.index_compression_ratio != text_config.index_kpool
+            or not text_config.index_kpool_compress
+            or not text_config.index_kpool_always_select_tail):
+        raise ValueError('The binding must preserve native compressed Index and its incomplete tail')
+    full = getattr(text_config, 'full_attention_layer_ids', None)
+    linear = getattr(text_config, 'linear_layer_ids', None)
+    if full is not None and linear is not None:
+        # The native config owns the partition used by its KDA/DSA factory.
+        # Runtime normalization may rewrite the descriptive layer-type labels.
+        banks, linear = tuple(full), tuple(linear)
+        all_layers = banks + linear
+        if (not banks or not linear or any(type(layer) is not int for layer in all_layers)
+                or len(set(all_layers)) != len(all_layers)
+                or sorted(all_layers) != list(range(text_config.num_hidden_layers))
+                or tuple(sorted(banks)) != banks):
+            raise ValueError('Native hybrid layer IDs must form a complete ordered partition')
+    else:
+        kinds = tuple(text_config.layer_types)
+        if len(kinds) != text_config.num_hidden_layers:
+            raise ValueError('Every hybrid model layer needs its native attention kind')
+        if set(kinds) != {'linear_attention', 'deepseek_sparse_attention'}:
+            raise NotImplementedError(f'Unexpected hybrid attention layer kinds: {set(kinds)}')
+        banks = tuple(i for i, kind in enumerate(kinds) if kind == 'deepseek_sparse_attention')
+    width = text_config.index_topk + text_config.index_kpool - 1
+    return banks, width
+
+
+class NativeHybridSparseLatentLayerAdapter(NativeSparseLayerAdapter):
+    """Translate global model layers to the native dense latent payload banks."""
+
+
+def install_native_glm_flash_pool(configuration):
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+    from sglang.srt.runtime_context import get_spec
+    from sglang.srt.ulacache.native_sparse_allocator import install_native_sparse_allocator_hooks
+
+    if configuration.use_shared_tensor_parallel_cache:
+        from sglang.srt.ulacache.native_shared_tp_prefetch import install_profile_guard
+        install_profile_guard(configuration.initialize_cuda_profiler)
+
+    if configuration.allocation_plan is None and configuration.device_cache_budget_bytes is not None:
+        raise ValueError('Use a complete allocation plan for native hybrid-state admission')
+    from sglang.srt.ulacache.native_cache_admission import install_native_glm_flash_admission
+    install_native_glm_flash_admission(configuration)
+
+    original = kv_cache_configurator.KVCacheConfigurator._build_hybrid_linear_kv_pool
+
+    def build(self, **kwargs):
+        text = self.model_config.hf_text_config
+        if getattr(text, 'model_type', None) != 'glm5_next_text':
+            raise NotImplementedError('The explicit GLM-Flash entry only accepts GLM-5.3-Flash')
+        if self.is_draft_worker or get_spec().speculative_algorithm is not None:
+            raise NotImplementedError('GLM-Flash speculation requires separate relocation validation')
+        banks, width = validate_glm_flash_geometry(text, configuration)
+        if (self.layer_info.start_layer != 0 or self.layer_info.end_layer != len(text.layer_types)):
+            raise NotImplementedError('Hybrid pipeline boundaries require a separate layer-lifetime binding')
+        if tuple(self.mambaish_config.full_attention_layer_ids) != banks:
+            raise ValueError('Native hybrid payload-bank mapping differs from the checkpoint')
+        bounded = replace(configuration, maximum_prefill_record_count=(
+            configuration.maximum_prefill_record_count
+            or min(configuration.device_record_capacity, self.model_config.context_len)))
+        pool_class = create_native_sparse_latent_pool_class(
+            bounded, tuple(range(len(banks))), width)
+        if bounded.distributed_indexer:
+            from sglang.srt.ulacache.native_glm_flash_index import (
+                create_glm_distributed_index_pool_class, install_glm_distributed_index_scoring)
+            from sglang.srt.ulacache.native_fp8_index_pool import native_fp8_index_column_bound
+            from sglang.srt.mem_cache.allocation_sizing import get_req_to_token_extra_context_len
+
+            install_glm_distributed_index_scoring()
+            pool_class = create_glm_distributed_index_pool_class(pool_class, bounded,
+                maximum_columns=native_fp8_index_column_bound(
+                    self.model_config.context_len + get_req_to_token_extra_context_len(), text.index_kpool))
+        kwargs['dsa_pool_class'] = pool_class
+        if bounded.use_shared_tensor_parallel_cache:
+            from sglang.srt.ulacache.native_shared_tp_prefetch import (
+                install as install_shared_tp_prefetch, install_profile_warmup)
+            install_shared_tp_prefetch()
+            if bounded.initialize_cuda_profiler:
+                install_profile_warmup()
+        pool = original(self, **kwargs)
+        if not isinstance(pool.full_kv_pool, NativeSparseCacheAdapter):
+            raise RuntimeError('The native hybrid builder did not install its declared payload pool')
+        pool._native_sparse_cache_adapter = NativeHybridSparseLatentLayerAdapter(pool)
+        pool.native_distributed_indexer = getattr(pool.full_kv_pool, 'native_distributed_indexer', None)
+        if pool.native_distributed_indexer is not None:
+            for name in ('native_index_owner_rank', 'native_index_owner_count',
+                         'native_index_location_mapper', 'native_index_global_page_count'):
+                setattr(pool, name, getattr(pool.full_kv_pool, name))
+        return pool
+
+    kv_cache_configurator.KVCacheConfigurator._build_hybrid_linear_kv_pool = build
+    install_native_sparse_allocator_hooks()
diff --git a/python/sglang/srt/ulacache/native_index_allocator_audit.py b/python/sglang/srt/ulacache/native_index_allocator_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..c68b757658901e09295922213e07524606f4909d
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_index_allocator_audit.py
@@ -0,0 +1,75 @@
+"""Optional startup-only CUDA allocator snapshots around native autotuning."""
+import functools
+import json
+import os
+import sys
+from pathlib import Path
+import time
+
+
+def install(*, runner_class=None, torch_module=None, output_directory=None):
+    if torch_module is None:
+        import torch as torch_module
+    if runner_class is None:
+        from sglang.srt.model_executor.runner.base_runner import BaseRunner
+        runner_class = BaseRunner
+    root = Path(output_directory or os.environ['ULACACHE_INDEX_ALLOCATOR_AUDIT_DIR'])
+    torch = torch_module
+    counters = {}
+
+    def record(runner, phase, arguments, error=None):
+        rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else int(os.environ.get('LOCAL_RANK',0))
+        key = (rank,type(runner).__name__,phase)
+        count = counters.get(key,0)
+        counters[key] = count+1
+        buffers = arguments.get('buffers')
+        shapes = {}
+        if buffers is not None:
+            for name in ['input_ids','positions','req_pool_indices','seq_lens','out_cache_loc','mrope_positions']:
+                value=getattr(buffers,name,None)
+                if isinstance(value,torch.Tensor):
+                    shapes[name] = dict(shape=list(value.shape),dtype=str(value.dtype),device=str(value.device))
+        # Allocator queries do not synchronize a peer-waiting CUDA stream.
+        # In particular, an OOM observer must not add cudaDeviceSynchronize.
+        value = dict(rank=rank,pid=os.getpid(),phase=phase,runner=type(runner).__name__,
+            call=count,utc_seconds=time.time(),byte_unit='bytes',batch_size=arguments.get('batch_size'),
+            buffer_shapes=shapes,allocated_bytes=torch.cuda.memory_allocated(),
+            reserved_bytes=torch.cuda.memory_reserved(),maximum_allocated_bytes=torch.cuda.max_memory_allocated(),
+            memory_stats=torch.cuda.memory_stats(),segments=torch.cuda.memory_snapshot(),
+            error=repr(error) if error is not None else None,
+            scope='Startup allocator observation only; no source/math/shape change, cache trim or forward instrumentation.')
+        root.mkdir(parents=True,exist_ok=True)
+        target=root/f'rank{rank}.{type(runner).__name__}.{phase}.{count}.json'
+        temporary=target.with_suffix('.tmp')
+        temporary.write_text(json.dumps(value,indent=2,default=str)+'\n')
+        temporary.replace(target)
+
+    for name in ['warmup','_flashinfer_autotune']:
+        original=getattr(runner_class,name)
+        if getattr(original,'_ulacache_allocator_audit',False):
+            continue
+
+        def wrap(function, name):
+            @functools.wraps(function)
+            def audited(runner,*args,**kwargs):
+                try:
+                    record(runner,name+'_begin',kwargs)
+                except Exception as observer_error:
+                    print(f'Allocator observer failed at {name}_begin: {observer_error!r}',file=sys.stderr,flush=True)
+                try:
+                    result=function(runner,*args,**kwargs)
+                except BaseException as error:
+                    try:
+                        record(runner,name+'_error',kwargs,error)
+                    except Exception:
+                        pass
+                    raise
+                try:
+                    record(runner,name+'_end',kwargs)
+                except Exception as observer_error:
+                    print(f'Allocator observer failed at {name}_end: {observer_error!r}',file=sys.stderr,flush=True)
+                return result
+            audited._ulacache_allocator_audit=True
+            return audited
+
+        setattr(runner_class,name,wrap(original,name))
