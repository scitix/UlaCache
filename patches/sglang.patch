@@ -0,0 +1,60 @@
+"""Native attention capabilities and the owner-cache model lifetime boundary.
+
+The framework defines attention and argument resolution statically. This module
+checks those capabilities and connects the model's existing forward lifetime.
+"""
+
+from pathlib import Path
+import hashlib
+
+FRAMEWORK_COMMIT = "baa9befa381511cd4d56f83980951e5a45fffc6d"
+_sink_binding = None
+
+
+def require_scaled_fp8_sink():
+    global _sink_binding
+    if _sink_binding is None:
+        from sglang.srt.layers.attention import dsa_backend
+
+        backend = dsa_backend.DeepseekSparseAttnBackend
+        if not getattr(backend, "supports_scaled_fp8_sink", False):
+            raise RuntimeError(
+                "Apply patches/sglang.patch for the native scaled-FP8 sink reader"
+            )
+        path = Path(dsa_backend.__file__).resolve()
+        _sink_binding = dict(
+            complete=True,
+            framework_commit=FRAMEWORK_COMMIT,
+            native_backend=dict(
+                path=str(path), sha256=hashlib.sha256(path.read_bytes()).hexdigest()
+            ),
+            native_record_bytes=656,
+            physical_page_size=64,
+            official_HiSparse_swapping_unchanged=True,
+            native_KV_writer_unchanged=True,
+            bounded_GPU_correctness_verified=False,
+            whole_model_verified=False,
+        )
+    return _sink_binding
+
+
+_owner_binding = None
+
+
+def install_owner_attention():
+    global _owner_binding
+    if _owner_binding is None:
+        from sglang.srt.mem_cache.flowkv_forward import scoped_raw_model_forward
+        from sglang.srt.models.hunyuan_v4 import HYV4ForCausalLM
+
+        sink = require_scaled_fp8_sink()
+        if not getattr(HYV4ForCausalLM.forward, "_ulacache_raw_forward_scope", False):
+            HYV4ForCausalLM.forward = scoped_raw_model_forward(HYV4ForCausalLM.forward)
+        _owner_binding = dict(
+            complete=True,
+            scope="native656_reader_and_owner_lifetime",
+            native_sink_binding=sink,
+            actual_GPU_correctness_verified=False,
+            full_model_verified=False,
+        )
+    return _owner_binding
diff --git a/python/sglang/srt/ulacache/native_cache_admission.py b/python/sglang/srt/ulacache/native_cache_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..1608eba0b0e0644bcf5df04276c25803bd13f56c
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_cache_admission.py
@@ -0,0 +1,169 @@
+"""Bind one logical history namespace to the original native pool sizing APIs."""
+
+
+def _configured_owner_capacity(configuration, device_field, host_field):
+    from sglang.srt.runtime_context import get_parallel
+    from sglang.srt.ulacache.native_cache_topology import resolve_native_record_owner_count
+
+    owners = resolve_native_record_owner_count(get_parallel(), configuration.storage_owner_count,
+        replicated_control=getattr(configuration, 'independent_tensor_parallel_caches', False))
+    return owners * (getattr(configuration, device_field) + getattr(configuration, host_field))
+
+
+def _install_native_history_admission(configurator_type, *, total_token_capacity,
+                                      validate_memory_budget, matches_target):
+    original_init = configurator_type.__init__
+    original_size = configurator_type.calculate_pool_sizes
+    original_token_size = configurator_type.calculate_pool_sizes_from_max_tokens
+
+    def initialize(self, configurator, *args, **kwargs):
+        original_init(self, configurator, *args, **kwargs)
+        self._ulacache_history_target = (
+            not configurator.is_draft_worker and matches_target(configurator))
+
+    def calculate(self, available_bytes, page_size):
+        if not self._ulacache_history_target:
+            return original_size(self, available_bytes, page_size)
+        validate_memory_budget(available_bytes)
+        capacity = total_token_capacity() if callable(total_token_capacity) else total_token_capacity
+        if capacity <= page_size or capacity % page_size:
+            raise ValueError('Combined history must cover whole native pages and their reserved page')
+        return original_token_size(self, capacity - page_size, page_size)
+
+    def calculate_from_tokens(self, max_total_num_tokens, page_size):
+        if self._ulacache_history_target:
+            capacity = total_token_capacity() if callable(total_token_capacity) else total_token_capacity
+            if max_total_num_tokens != capacity - page_size:
+                raise ValueError('Native token constraints cannot resize the declared cache allocation plan')
+        return original_token_size(self, max_total_num_tokens, page_size)
+
+    configurator_type.__init__ = initialize
+    configurator_type.calculate_pool_sizes = calculate
+    configurator_type.calculate_pool_sizes_from_max_tokens = calculate_from_tokens
+
+
+def install_native_sparse_latent_admission(configuration):
+    from sglang.srt.configs.model_config import is_deepseek_dsa
+    from sglang.srt.model_executor.pool_configurator import DefaultPoolConfigurator
+    from sglang.srt.runtime_context import get_parallel
+    from sglang.srt.ulacache.native_cache_topology import resolve_native_record_owner_count
+
+    def total_capacity():
+        return (configuration.device_record_capacity + configuration.host_record_capacity) * (
+            resolve_native_record_owner_count(get_parallel(), getattr(configuration, 'storage_owner_count', None),
+                replicated_control=getattr(configuration, 'independent_tensor_parallel_caches', False)))
+
+    def validate_memory_budget(available_bytes):
+        if (configuration.device_cache_budget_bytes is not None
+                and not 0 < configuration.device_cache_budget_bytes <= available_bytes):
+            raise ValueError('Declared sparse-cache budget exceeds native available GPU memory')
+
+    _install_native_history_admission(DefaultPoolConfigurator,
+        total_token_capacity=total_capacity,
+        validate_memory_budget=validate_memory_budget,
+        matches_target=lambda configurator: is_deepseek_dsa(configurator.model_config.hf_config))
+
+
+def install_native_paged_admission(configuration):
+    from sglang.srt.model_executor.pool_configurator import DSV4PoolConfigurator
+
+    plan = configuration.allocation_plan
+    if plan is None:
+        _install_native_history_admission(DSV4PoolConfigurator,
+            total_token_capacity=lambda: _configured_owner_capacity(configuration,
+                'device_full_token_capacity', 'host_full_token_capacity'),
+            validate_memory_budget=lambda available: None,
+            matches_target=lambda configurator: True)
+        return
+    if (plan.device_token_capacity_per_owner != configuration.device_full_token_capacity
+            or plan.host_token_capacity_per_owner != configuration.host_full_token_capacity
+            or (configuration.storage_owner_count is not None
+                and plan.storage_owner_count != configuration.storage_owner_count)):
+        raise ValueError('Native cold capacities must match the complete allocation plan')
+    minimum_profile_bytes = getattr(configuration, 'minimum_native_profile_available_bytes', None)
+
+    def validate_memory_budget(available_bytes):
+        if minimum_profile_bytes is None:
+            plan.validate_memory_budget(available_bytes)
+        else:
+            # The complete allocation ceiling comes from actual Native storage.
+            # Native profiling can omit allocator/request/page-padding bytes;
+            # compare its current headroom with the matching calibration phase.
+            plan.validate_memory_budget()
+            if available_bytes < minimum_profile_bytes:
+                raise ValueError('Native GPU profiling headroom fell below the calibrated allocation')
+
+    _install_native_history_admission(DSV4PoolConfigurator,
+        total_token_capacity=plan.storage_owner_count * (
+            plan.device_token_capacity_per_owner + plan.host_token_capacity_per_owner),
+        validate_memory_budget=validate_memory_budget,
+        matches_target=lambda configurator: True)
+
+
+def install_native_qsa_admission(configuration):
+    """Admit explicit paired-QSA history under the common allocation contract."""
+    from sglang.srt.model_executor.pool_configurator import DefaultPoolConfigurator
+    from sglang.srt.layers.attention.qsa.config import parse_qsa_profile
+
+    plan = configuration.allocation_plan
+    if (plan.device_token_capacity_per_owner != configuration.device_record_capacity
+            or plan.host_token_capacity_per_owner != configuration.host_record_capacity
+            or plan.storage_owner_count != configuration.storage_owner_count):
+        raise ValueError('QSA cold capacities must match the complete allocation plan')
+    minimum = configuration.minimum_native_profile_available_bytes
+    if minimum is not None and minimum <= 0:
+        raise ValueError('Calibrated QSA profiling headroom must be positive')
+
+    def validate_memory_budget(available_bytes):
+        if minimum is None:
+            plan.validate_memory_budget(available_bytes)
+        else:
+            # Native profiling has already charged fixed GDN state. The full
+            # allocation union and calibrated profile remain separate checks.
+            plan.validate_memory_budget()
+            if available_bytes < minimum:
+                raise ValueError('Native QSA profiling headroom fell below the calibrated allocation')
+
+    _install_native_history_admission(DefaultPoolConfigurator,
+        total_token_capacity=plan.storage_owner_count * (
+            plan.device_token_capacity_per_owner + plan.host_token_capacity_per_owner),
+        validate_memory_budget=validate_memory_budget,
+        matches_target=lambda configurator: parse_qsa_profile(configurator.model_config.hf_config) is not None)
+
+
+def install_native_glm_flash_admission(configuration):
+    """Preserve native KDA charges while admitting a complete latent-cache plan."""
+    from sglang.srt.model_executor.pool_configurator import DefaultPoolConfigurator
+
+    plan = configuration.allocation_plan
+    if plan is None:
+        _install_native_history_admission(DefaultPoolConfigurator,
+            total_token_capacity=lambda: _configured_owner_capacity(configuration,
+                'device_record_capacity', 'host_record_capacity'),
+            validate_memory_budget=lambda available: None,
+            matches_target=lambda configurator:
+                getattr(configurator.model_config.hf_text_config, 'model_type', None) == 'glm5_next_text')
+        return
+    if (plan.device_token_capacity_per_owner != configuration.device_record_capacity
+            or plan.host_token_capacity_per_owner != configuration.host_record_capacity
+            or (configuration.storage_owner_count is not None
+                and plan.storage_owner_count != configuration.storage_owner_count)):
+        raise ValueError('GLM-Flash allocation must match its declared disjoint owner capacities')
+    minimum = configuration.minimum_native_profile_available_bytes
+    if minimum is not None and minimum <= 0:
+        raise ValueError('Calibrated GLM-Flash profiling headroom must be positive')
+
+    def validate_memory_budget(available_bytes):
+        if minimum is None:
+            plan.validate_memory_budget(available_bytes)
+        else:
+            plan.validate_memory_budget()
+            if available_bytes < minimum:
+                raise ValueError('Native GLM-Flash profiling headroom fell below its calibrated allocation')
+
+    _install_native_history_admission(DefaultPoolConfigurator,
+        total_token_capacity=(configuration.device_record_capacity + configuration.host_record_capacity)
+            * plan.storage_owner_count,
+        validate_memory_budget=validate_memory_budget,
+        matches_target=lambda configurator:
+            getattr(configurator.model_config.hf_text_config, 'model_type', None) == 'glm5_next_text')
diff --git a/python/sglang/srt/ulacache/native_cache_geometry.py b/python/sglang/srt/ulacache/native_cache_geometry.py
new file mode 100644
index 0000000000000000000000000000000000000000..110373ff16b2ac6f8d6719dcf856f5740b2c99fa
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_cache_geometry.py
@@ -0,0 +1,55 @@
+"""Translate native layer identities and page traits into independent contracts.
+
+The framework supplies resolved producer maps. Index-K ownership and TopK
+production are separate inputs, including when reindex layers share stored keys.
+This module allocates no cache storage and does not select a runtime backend.
+"""
+
+from dataclasses import dataclass
+
+from ulacache import (
+    KeyValueRecordPlane, KeyValueStorageLayout, LayerReuseSpecification,
+    MemoryTierCapacity, SparseAccessSpecification, UnifiedCacheSpecification,
+)
+
+
+def create_native_paged_latent_layout(*, name, native_encoding, native_layout,
+                                     records_per_page, tokens_per_record=1):
+    """Consume SGLang KVLayout traits without importing or duplicating its enum."""
+    segment_widths = (native_layout.data_bytes,)
+    if native_layout.scale_bytes:
+        segment_widths += (native_layout.scale_bytes,)
+    return KeyValueStorageLayout(
+        name, (KeyValueRecordPlane('key_value', native_encoding, segment_widths,
+                                   native_layout.page_align, 'segment_major'),),
+        records_per_page, record_kind='compressed' if tokens_per_record > 1 else 'token',
+        tokens_per_record=tokens_per_record,
+    )
+
+
+@dataclass(frozen=True)
+class NativeSparseAttentionCacheBinding:
+    model_layer_indices: tuple[int, ...]
+    cache_specification: UnifiedCacheSpecification
+
+    def cache_layer_index(self, model_layer_index):
+        """Resolve once while constructing native per-layer execution hooks."""
+        return self.model_layer_indices.index(model_layer_index)
+
+
+def create_native_sparse_cache_binding(
+    *, model_layer_indices, key_value_owner_layers, index_storage_owner_layers,
+    sparse_selection_owner_layers, residency_owner_layers,
+    storage_layout: KeyValueStorageLayout, sparse_access: SparseAccessSpecification,
+    capacity_plan: MemoryTierCapacity,
+):
+    """Lower native producer IDs into the local order of one homogeneous tier."""
+    model_layer_indices = tuple(model_layer_indices)
+    cache_layers = {model_layer: cache_layer for cache_layer, model_layer in enumerate(model_layer_indices)}
+    layer_reuse = LayerReuseSpecification(*[
+        tuple(cache_layers[owner] for owner in owners)
+        for owners in (key_value_owner_layers, index_storage_owner_layers,
+                       sparse_selection_owner_layers, residency_owner_layers)
+    ])
+    return NativeSparseAttentionCacheBinding(model_layer_indices,
+        UnifiedCacheSpecification(storage_layout, layer_reuse, sparse_access, capacity_plan))
diff --git a/python/sglang/srt/ulacache/native_cache_topology.py b/python/sglang/srt/ulacache/native_cache_topology.py
new file mode 100644
index 0000000000000000000000000000000000000000..d2da014f2094c98e13364009b07b4b90cdf59b10
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_cache_topology.py
@@ -0,0 +1,43 @@
+"""Keep rank-local cache storage separate from owner-striped TP storage."""
+
+
+def resolve_native_record_owner_count(parallel, declared=None, *, replicated_control=False):
+    """Use disjoint shared-TP record owners unless a replica control is explicit."""
+    if declared is not None and (type(declared) is not int or declared < 1):
+        raise ValueError('Declare a positive record-owner count or use topology defaults')
+    if replicated_control and declared not in (None, 1):
+        raise ValueError('Replica controls cannot also declare disjoint TP owners')
+    owners = (1 if replicated_control else parallel.attn_tp_size) if declared is None else declared
+    if owners > 1:
+        require_replicated_attention_record_owners(parallel, owners)
+    elif parallel.attn_tp_size > 1:
+        if not replicated_control:
+            require_rank_local_attention_storage(parallel)
+        if (parallel.attn_tp_size != parallel.tp_size or parallel.attn_dp_size != 1
+                or parallel.attn_cp_size != 1 or parallel.attn_dcp_size != 1):
+            raise NotImplementedError('Replicated controls require one ordinary shared TP namespace')
+    else:
+        require_rank_local_attention_storage(parallel)
+    return owners
+
+
+def require_rank_local_attention_storage(parallel):
+    """Validate the native attention group before allocating a local cache.
+
+    Model TP may exceed one when attention uses data parallelism. The local
+    runtime requires each attention TP/CP/DCP group to contain one rank.
+    """
+    if (parallel.attn_tp_size != 1 or parallel.attn_cp_size != 1
+            or parallel.attn_dcp_size != 1):
+        raise NotImplementedError(
+            'Rank-local cache storage requires attention TP, CP and DCP sizes of one; '
+            'shared TP needs owner-striped record storage')
+
+
+def require_replicated_attention_record_owners(parallel, storage_owner_count):
+    """Bind one native shared request namespace to its complete record replicas."""
+    if (storage_owner_count < 2 or parallel.attn_tp_size != storage_owner_count
+            or parallel.attn_dp_size != 1 or parallel.attn_cp_size != 1
+            or parallel.attn_dcp_size != 1):
+        raise NotImplementedError(
+            'Native record owners currently require one shared attention TP request namespace')
diff --git a/python/sglang/srt/ulacache/native_capacity_inventory.py b/python/sglang/srt/ulacache/native_capacity_inventory.py
