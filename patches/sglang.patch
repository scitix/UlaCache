@@ -0,0 +1,130 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Adapter lifecycle shared by the live runner and eager model warmup."""
+
+from contextlib import contextmanager
+
+from sglang.srt.mem_cache.flowkv_adapter import (
+    FlowKVExtendHistory,
+    FlowKVSharedIndexAdapter,
+    is_flowkv_adapter,
+)
+from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+
+
+def native_cache_adapter(pool):
+    if isinstance(pool, NativeSparseCacheAdapter):
+        return pool
+    return getattr(pool, "native_sparse_cache_adapter", None)
+
+
+@contextmanager
+def flowkv_forward(pool, batch, req_to_token):
+    native = native_cache_adapter(pool)
+    if native is not None:
+        import torch
+        native.prepare_cache_forward(
+            batch, publish_active_query_count=not torch.cuda.is_current_stream_capturing()
+        )
+        try:
+            yield
+        finally:
+            native.finish_cache_forward()
+        return
+    if not is_flowkv_adapter(pool):
+        yield
+        return
+    mode = batch.forward_mode
+    if isinstance(pool, FlowKVSharedIndexAdapter):
+        pool.flowkv_prepare_batch(batch)
+    if mode.is_extend_without_speculative() or mode.is_split_prefill():
+        prefix = batch.extend_prefix_lens_cpu
+        if prefix is None:
+            raise ValueError(
+                "FlowKV eager prefill requires existing CPU prefix lengths"
+            )
+        pool.flowkv_prepare_extend(
+            FlowKVExtendHistory(
+                req_to_token=req_to_token,
+                req_pool_indices=batch.req_pool_indices,
+                prefix_lens=batch.extend_prefix_lens,
+                prefix_lens_cpu=prefix,
+            )
+        )
+    yield
+    pool.finish_flowkv_forward()
+
+
+def scoped_raw_model_forward(function):
+    """Cover each real model forward, including Graph's two warmup calls."""
+    from functools import wraps
+    @wraps(function)
+    def forward(model, input_ids, positions, forward_batch, *args, **kwargs):
+        from sglang.srt.model_executor.forward_context import (
+            get_req_to_token_pool, get_token_to_kv_pool,
+        )
+        pool = get_token_to_kv_pool()
+        if (not isinstance(pool, FlowKVSharedIndexAdapter)
+                and native_cache_adapter(pool) is None
+                and getattr(pool, "hisparse_prefill_workspace", None) is None):
+            return function(model, input_ids, positions, forward_batch, *args, **kwargs)
+        with flowkv_forward(pool, forward_batch, get_req_to_token_pool().req_to_token):
+            return function(model, input_ids, positions, forward_batch, *args, **kwargs)
+    forward._ulacache_raw_forward_scope = True
+    return forward
+
+
+def bind_native_model_forward(model):
+    """Use the same raw-forward boundary for every selected native pool adapter.
+
+    Native Graph warmup invokes model.forward directly. Wrapping ModelRunner's
+    outer entry would omit those warmup/capture calls.
+    """
+    import os
+    if not (any(os.environ.get(name) for name in (
+            "ULACACHE_CONFIGURATION", "ULACACHE_GLM_FLASH_CONFIGURATION",
+            "ULACACHE_NATIVE_DSA_CONFIGURATION", "ULACACHE_NATIVE_PAGED_CONFIGURATION"))
+            or os.environ.get("ULACACHE_BENCH_PREFIX_CACHE") == "1"):
+        return
+    original = model.forward
+    if getattr(original, "_ulacache_raw_forward_scope", False):
+        return
+    from functools import wraps
+
+    @wraps(original)
+    def forward(input_ids, positions, forward_batch, *args, **kwargs):
+        from sglang.srt.model_executor.forward_context import (
+            get_req_to_token_pool, get_token_to_kv_pool,
+        )
+        pool = get_token_to_kv_pool()
+        if (not isinstance(pool, FlowKVSharedIndexAdapter)
+                and native_cache_adapter(pool) is None
+                and getattr(pool, "hisparse_prefill_workspace", None) is None):
+            return original(input_ids, positions, forward_batch, *args, **kwargs)
+        with flowkv_forward(pool, forward_batch, get_req_to_token_pool().req_to_token):
+            return original(input_ids, positions, forward_batch, *args, **kwargs)
+
+    forward._ulacache_raw_forward_scope = True
+    model.forward = forward
+
+
+def release_native_cache_host_resources(pool):
+    """Release UlaCache's registered host buffers before native process teardown."""
+    if getattr(pool, "_ulacache_host_resources_released", False):
+        return
+    caches = [getattr(pool, name, None) for name in ("memory_cache", "ulacache")]
+    caches = {id(cache): cache for cache in caches if cache is not None}
+    if not caches and getattr(pool, "flowkv_host", None) is None:
+        return
+    import torch
+
+    # Graceful shutdown runs after scheduling stops, with native communicators
+    # still alive. Host unregister must follow every outstanding GPU reader.
+    torch.cuda.synchronize(pool.device)
+    for cache in caches.values():
+        cache.close()
+    for name in ("flowkv_host", "flowkv_request"):
+        resource = getattr(pool, name, None)
+        if resource is not None:
+            resource.close()
+            setattr(pool, name, None)
+    pool._ulacache_host_resources_released = True
