+
+    def finish(self):
+        self.pipeline.finish()
+        self.pending_writer = None
+
+    def abort(self):
+        self.pipeline.abort()
+        self.pending_writer = None
+
+    def memory_inventory(self):
+        result = self.pipeline.memory_inventory()
+        result.update(additional_CPU_KV_payload_bytes=0,
+            decode_mapping_mutations=0, decode_hot_KV_mutations=0,
+            native_draft_KV_unchanged=True,
+            plan_tensor_bytes=(sum(t.nbytes for t in self.pipeline.plan.keepalive_tensors)
+                               if self.active else 0),
+            includes_full_peak_reserve=False)
+        return result
+
+
+def is_target_prefill(mode):
