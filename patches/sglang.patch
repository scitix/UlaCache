@@ -0,0 +1,50 @@
+"""Common native sparse callbacks for noncontiguous hybrid payload banks."""
+
+from abc import ABC, abstractmethod
+
+
+class NativeSparseCachePort(ABC):
+    """Framework-neutral marker and callback ABI for native sparse pools."""
+
+    @abstractmethod
+    def prepare_cache_forward(self, batch, *, publish_active_query_count=True): ...
+
+    @abstractmethod
+    def prepare_native_sparse_attention(self, layer_id, selected_records): ...
+
+    @abstractmethod
+    def read_native_prefill_records(self, layer_id, selected_records, output): ...
+
+    @abstractmethod
+    def finish_cache_attention(self, layer_id): ...
+
+    @abstractmethod
+    def finish_cache_forward(self): ...
+
+    @abstractmethod
+    def register_native_full_pages(self, full_page_ids, *, prefer_device): ...
+
+    @abstractmethod
+    def release_native_full_pages(self, full_page_ids): ...
+
+    @abstractmethod
+    def clear_native_full_records(self): ...
+
+
+class NativeSparseLayerAdapter:
+    def __init__(self, hybrid_pool, *, layer_mapping=None):
+        self.payload = hybrid_pool.full_kv_pool
+        self.layer_mapping = (hybrid_pool.full_attention_layer_id_mapping
+            if layer_mapping is None else layer_mapping)
+
+    def __getattr__(self, name):
+        return getattr(self.payload, name)
+
+    def prepare_native_sparse_attention(self, layer_id, selected_records):
+        return self.payload.prepare_native_sparse_attention(self.layer_mapping[layer_id], selected_records)
+
+    def read_native_prefill_records(self, layer_id, selected_records, output):
+        return self.payload.read_native_prefill_records(self.layer_mapping[layer_id], selected_records, output)
+
+    def finish_cache_attention(self, layer_id):
+        return self.payload.finish_cache_attention(self.layer_mapping[layer_id])
diff --git a/python/sglang/srt/ulacache/native_tensor_parallel_entry.py b/python/sglang/srt/ulacache/native_tensor_parallel_entry.py
