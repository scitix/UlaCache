--- /dev/null
+++ b/python/sglang/srt/ulacache/request_prefill_adapter.py
@@ -0,0 +1,34 @@
+"""Slice native eager TileLang attention at library-planned request boundaries."""
+
+from functools import wraps
+
+
+def install():
+    from sglang.srt.layers.attention.dsa_backend import DeepseekSparseAttnBackend
+
+    original = DeepseekSparseAttnBackend._forward_tilelang
+    if getattr(original, '_ulacache_request_prefill', False):
+        return
+
+    @wraps(original)
+    def forward(self, q_all, kv_cache, v_head_dim, page_table_1, sm_scale):
+        pool = self.token_to_kv_pool
+        pool = getattr(pool, 'full_kv_pool', pool)
+        execution = getattr(pool, 'cache_execution', None)
+        buffers = getattr(execution, 'prefill_buffers', None)
+        if buffers is None or execution.decode_like or buffers.pending_layer is None:
+            return original(self, q_all, kv_cache, v_head_dim, page_table_1, sm_scale)
+        leading_singleton = False
+
+        def attend(queries, planes, indices):
+            nonlocal leading_singleton
+            native = planes[0].view(kv_cache.dtype).reshape(-1, 1, kv_cache.shape[-1])
+            output = original(self, queries, native, v_head_dim, indices, sm_scale)
+            leading_singleton = output.ndim == queries.ndim + 1
+            return output.reshape(queries.shape[0], queries.shape[1], v_head_dim)
+
+        output = buffers.run(q_all, page_table_1, attend)
+        return output.unsqueeze(0) if leading_singleton else output
+
+    forward._ulacache_request_prefill = True
+    DeepseekSparseAttnBackend._forward_tilelang = forward
diff --git a/python/sglang/srt/ulacache/shared_prefill_admission.py b/python/sglang/srt/ulacache/shared_prefill_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..011dfd6a224ac737c8e117d76fcbfcb7947fb00f
--- /dev/null
+++ b/python/sglang/srt/ulacache/shared_prefill_admission.py
@@ -0,0 +1,66 @@
+"""MR77 full-history workspace budget at existing native admission points.
+
+Install once during normal process startup. Backends expose only
+``pool.create_prefill_workspace_budget()``; no request queue, scheduling policy,
+chunk splitter, allocator budget, or ordering is replaced here.
+"""
+from functools import wraps
+
+VERSION = "mr77_full_history_workspace_v1"
+
+
+def _workspace_budget(allocator):
+    factory = getattr(allocator, "create_prefill_workspace_budget", None)
+    budget = factory() if callable(factory) else None
+    if budget is None:
+        getter = getattr(allocator, "get_kvcache", None)
+        pool = getter() if callable(getter) else getattr(allocator, "_kvcache", None)
+        factory = getattr(pool, "create_prefill_workspace_budget", None)
+        budget = factory() if callable(factory) else None
+    if budget is not None and not all(callable(getattr(budget, name, None))
+                                      for name in ("can_reserve", "reserve")):
+        raise TypeError("The backend workspace budget must implement can_reserve/reserve")
+    return budget
+
+
+def bind_prefill_admission(prefill_adder_class):
+    """Bind the legacy native class; current MR77 already owns this hook."""
+    if getattr(prefill_adder_class, "_ulacache_shared_prefill_admission", None) == VERSION:
+        return dict(installed=True, version=VERSION, duplicate_install=False,
+                    native_scratch_points_retained=True)
+    if hasattr(prefill_adder_class, "_reserve_prefill_workspace"):
+        # Current MR77 calls its native provider before its original scratch
+        # reservation. Wrapping the latter would charge the same request twice.
+        return dict(installed=False, native_provider_hook=True, version=VERSION,
+                    native_scratch_points_retained=True)
+    original_init = prefill_adder_class.__init__
+    original_reserve = prefill_adder_class._kv_shard_reserve_scratch
+
+    @wraps(original_init)
+    def initialize(adder, *args, **kwargs):
+        original_init(adder, *args, **kwargs)
+        adder._ulacache_prefill_workspace_budget = _workspace_budget(
+            adder.token_to_kv_pool_allocator)
+
+    @wraps(original_reserve)
+    def reserve(adder, prefix_len, extend_len):
+        budget = adder._ulacache_prefill_workspace_budget
+        if budget is not None and not budget.can_reserve(prefix_len, extend_len):
+            return False
+        if not original_reserve(adder, prefix_len, extend_len):
+            return False
+        if budget is not None:
+            budget.reserve(prefix_len, extend_len)
+        return True
+
+    prefill_adder_class.__init__ = initialize
+    prefill_adder_class._kv_shard_reserve_scratch = reserve
+    prefill_adder_class._ulacache_shared_prefill_admission = VERSION
+    return dict(installed=True, version=VERSION, duplicate_install=False,
+                native_scratch_points_retained=True,
+                complete_history_charged=True, native_FIFO_and_chunking_unchanged=True)
+
+
+def install():
+    from sglang.srt.managers.schedule_policy import PrefillAdder
+    return bind_prefill_admission(PrefillAdder)
diff --git a/python/sglang/srt/ulacache/sparse_trace_adapter.py b/python/sglang/srt/ulacache/sparse_trace_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..a79e8f978a7a13f951854da4e328d119dfd6663f
--- /dev/null
+++ b/python/sglang/srt/ulacache/sparse_trace_adapter.py
@@ -0,0 +1,272 @@
+"""Diagnostic native DPA sparse-address capture for scheduler replay.
+
+Install before pool construction. Buffers stay in an external weak map so
+production allocation inventories remain unchanged; diagnostic bytes are
+reported explicitly. This mode must never produce formal decode measurements.
+"""
+import hashlib
+from functools import wraps
+import json
+import os
+from pathlib import Path
+import weakref
+
+_observers = weakref.WeakKeyDictionary()
+
+
+def trace_lifecycle_call(original, *, release):
+    """Observe native row lifetimes without changing allocation arguments."""
+    @wraps(original)
+    def event(cache, rows, *args, **kwargs):
+        observer = _observers.get(cache)
+        if observer is not None:
+            observer['recorder'].observe_event(rows, release=release)
+        return original(cache, rows, *args, **kwargs)
+
+    return event
+
+
+def bind_native_trace_frame(info, binding, sampler_shapes):
+    """Join one fresh sampled frame to its actual native Graph and source rows."""
+    if not binding or not binding.get('native_replay_tensor_binding_verified'):
+        raise RuntimeError('Fresh sparse trace has no actual native replay binding')
+    if (info['requests'] != binding['raw_requests']
+            or info['queries'] != binding['raw_queries']):
+        raise RuntimeError('Sparse frame and native replay refer to different queries')
+    captured = binding['captured']
+    if (captured['size'] != binding['source_request_bucket']
+            or captured['verify_width'] != binding['verify_width']
+            or set(captured['layers']) != set(sampler_shapes)):
+        raise RuntimeError('Sparse sampler and native capture anchors/bucket differ')
+    for layer, shape in captured['layers'].items():
+        if (shape not in sampler_shapes[layer]
+                or shape['current_rows'] != shape['selected_rows']
+                or not info['queries'] <= shape['selected_rows'] <= shape['native_query_bound']):
+            raise RuntimeError('Sparse sampler source tensor does not match actual native capture')
+    # The observer updates its latest-binding dictionary in place. Each frame
+    # must retain its own load sequence rather than the chunk's final value.
+    return dict(binding)
+
+
+def install(*, replay_geometry=None):
+    import torch
+    from sglang.srt.managers.scheduler import Scheduler
+    from sglang.srt.model_executor.model_runner import ModelRunner
+    from ulacache.cache.local_cache import UnifiedLocalResidency
+    from ulacache.telemetry.sparse_trace import GpuSparseTraceRecorder, SparseTraceGeometry
+
+    root = Path(os.environ['UDCACHE_SPARSE_TRACE_DIR'])
+    max_queries = int(os.environ['UDCACHE_SPARSE_TRACE_QUERY_ROWS'])
+    max_requests = int(os.environ['UDCACHE_SPARSE_TRACE_REQUESTS'])
+    frames = int(os.environ.get('UDCACHE_SPARSE_TRACE_FRAMES', '512'))
+    warmup = int(os.environ.get('UDCACHE_SPARSE_TRACE_WARMUP', '128'))
+    state = dict(armed=False, forwards=0, finished=False, chunks=[], metadata=[],
+                 recorder=None, cohort=0, last_native_replay=0)
+
+    def rank_root():
+        value = root / f'cohort{state["cohort"]:04d}' / f'rank{torch.distributed.get_rank()}'
+        value.mkdir(parents=True, exist_ok=True)
+        return value
+
+    def save_json(name, value):
+        path = rank_root() / name
+        temp = path.with_suffix('.tmp')
+        temp.write_text(json.dumps(value, indent=2) + '\n')
+        temp.replace(path)
+
+    def save_tensors(name, value):
+        path = rank_root() / name
+        temp = path.with_suffix('.tmp')
+        torch.save(value, temp)
+        temp.replace(path)
+        with path.open('rb') as handle:
+            digest = hashlib.file_digest(handle, 'sha256').hexdigest()
+        return dict(path=str(path), sha256=digest, bytes=path.stat().st_size)
+
+    original_init = UnifiedLocalResidency.__init__
+
+    def initialize(cache, *args, **kwargs):
+        original_init(cache, *args, **kwargs)
+        if not cache.parallel_expiry:
+            raise ValueError('This diagnostic adapter requires native parallel DPA bucket expiry')
+        if any(ring.recent_count < 1 for ring in cache.rings):
+            raise ValueError('Capture a PB-LRU trace; other policies replay its frozen addresses and initial state')
+        if max_queries > cache.max_queries or max_requests < 1:
+            raise ValueError('Trace shape exceeds the native allocation or has no request capacity')
+        geometry = SparseTraceGeometry(groups=cache.groups.group_count, query_rows=max_queries,
+                                       topk=cache.topk, frames=frames)
+        recorder = GpuSparseTraceRecorder(geometry, device=cache.gpu.device)
+        descriptors = torch.tensor([[s.epoch.data_ptr(), r.bucket_epochs.data_ptr(),
+            r.summary.data_ptr(), r.summary.shape[1], r.recent_count]
+            for s, r in zip(cache.states, cache.rings)], dtype=torch.int64, device=cache.gpu.device)
+        request_slots = torch.full((geometry.chunk_frames, max_requests), -1,
+                                   dtype=torch.int32, device=cache.gpu.device)
+        seq_lens = torch.full_like(request_slots, -1)
+        _observers[cache] = dict(recorder=recorder, descriptors=descriptors,
+                                request_slots=request_slots, seq_lens=seq_lens,
+                                captured_source_shapes={})
+        root.mkdir(parents=True, exist_ok=True)
+        rank = torch.distributed.get_rank()
+        receipt = root / f'observer.rank{rank}.json'
+        temporary = receipt.with_suffix('.writing')
+        temporary.write_text(json.dumps(dict(passed=True, pid=os.getpid(), rank=rank,
+            groups=geometry.groups, query_rows=max_queries, requests=max_requests,
+            model_path=os.environ.get('ULACACHE_BENCH_MODEL'),
+            checkpoint_config_sha256=(hashlib.sha256(
+                (Path(os.environ['ULACACHE_BENCH_MODEL']) / 'config.json').read_bytes()).hexdigest()
+                if os.environ.get('ULACACHE_BENCH_MODEL') else None),
+            frames=frames, extra_gpu_bytes=recorder.gpu_bytes + descriptors.nbytes
+                + request_slots.nbytes + seq_lens.nbytes), indent=2) + '\n')
+        temporary.replace(receipt)
+
+    UnifiedLocalResidency.__init__ = initialize
+    original_plan = UnifiedLocalResidency.plan
+
+    def plan(cache, layer, selected, current):
+        observer = _observers.get(cache)
+        if observer is not None:
+            if replay_geometry is not None and torch.cuda.is_current_stream_capturing():
+                shape = dict(selected_rows=int(selected.shape[0]),topk=int(selected.shape[1]),
+                    current_rows=int(current.numel()),selected_dtype=str(selected.dtype),
+                    current_dtype=str(current.dtype),native_query_bound=cache.max_queries)
+                shapes = observer['captured_source_shapes'].setdefault(str(layer), [])
+                if shape not in shapes:
+                    shapes.append(shape)
+            group = cache.groups.group(layer)
+            observer['recorder'].observe(group, selected, current, cache.active,
+                                         cache.states[group].epoch)
+        return original_plan(cache, layer, selected, current)
+
+    UnifiedLocalResidency.plan = plan
+    original_begin = UnifiedLocalResidency.begin_forward
+
+    def begin(cache):
+        observer = _observers.get(cache)
+        if observer is None:
+            return original_begin(cache)
+        recorder = observer['recorder']
+        recorder.observe_expiry(observer['descriptors'], after=False)
+        result = original_begin(cache)
+        recorder.observe_expiry(observer['descriptors'], after=True)
+        return result
+
+    UnifiedLocalResidency.begin_forward = begin
+    for method in ('allocate', 'allocate_unbound', 'release'):
+        original = getattr(UnifiedLocalResidency, method)
+        setattr(UnifiedLocalResidency, method,
+                trace_lifecycle_call(original, release=method == 'release'))
+
+    def metadata(batch):
+        requests = batch.req_pool_indices.numel()
+        queries = batch.out_cache_loc.numel()
+        if requests > max_requests or queries > max_queries:
+            raise RuntimeError('Native target batch exceeds frozen sparse trace geometry')
+        if requests and queries % requests:
+            raise RuntimeError('Native query layout requires an explicit ragged request binding')
+        return dict(requests=requests, queries=queries,
+                    forward_mode=str(batch.forward_mode),
+                    queries_per_request=queries // requests if requests else 0)
+
+    def initial_state(runner, batch, cache):
+        # Read only scheduler metadata and mapping, never historical KV bytes.
+        torch.cuda.synchronize()
+        requests = batch.req_pool_indices.long()
+        native = dict(request_slots=requests.cpu(), seq_lens=batch.seq_lens.cpu(),
+                      out_cache_loc=batch.out_cache_loc.cpu(),
+                      req_to_token=runner.req_to_token_pool.req_to_token.index_select(0, requests).cpu())
+        groups = []
+        for native_state, ring in zip(cache.states, cache.rings):
+            groups.append(dict(state={name: value.cpu() for name, value in zip(native_state._fields, native_state)},
+                ring={name: getattr(ring, name).cpu() for name in ('bits', 'summary', 'bucket_epochs', 'gpu_bucket')}))
+        receipt = save_tensors('INITIAL_STATE.pt', dict(native=native, groups=groups))
+        observer = _observers[cache]
+        auxiliary_bytes = sum(observer[name].numel()*observer[name].element_size()
+                              for name in ('descriptors', 'request_slots', 'seq_lens'))
+        save_json('START.json', dict(initial_state=receipt, warmup_target_forwards=warmup,
+            trace_target_forwards=frames, chunk_frames=observer['recorder'].geometry.chunk_frames,
+            max_queries=max_queries, max_requests=max_requests, topk=cache.topk,
+            anchors=cache.groups.anchors, followers=cache.groups.followers,
+            production_inventory=cache.memory_inventory(),
+            production_geometry=dict(max_queries=cache.max_queries,
+                workspace_capacity=cache.workspaces[0].new_rows.numel()),
+            sampler_captured_source_shapes=observer['captured_source_shapes'],
+            native_frame_binding_required=replay_geometry is not None,
+            diagnostic_extra_gpu_bytes=observer['recorder'].gpu_bytes + auxiliary_bytes,
+            total_cuda_allocated_bytes=torch.cuda.memory_allocated(cache.gpu.device),
+            recent_counts=[r.recent_count for r in cache.rings],
+            scope='Instrumented trace only. Additional diagnostic storage is not a production memory-budget claim.'))
+
+    original_forward = ModelRunner.forward
+
+    def forward(runner, batch, *args, **kwargs):
+        cache = getattr(runner.token_to_kv_pool, 'udcache_local', None)
+        target = state['armed'] and not runner.is_draft_worker and cache in _observers
+        capturing = torch.cuda.is_current_stream_capturing()
+        recording = target and not capturing and not state['finished'] and state['forwards'] >= warmup
+        observer = _observers.get(cache) if cache is not None else None
+        if recording:
+            recorder = observer['recorder']
+            frame = state['forwards'] - warmup
+            if frame == 0:
+                initial_state(runner, batch, cache)
+                recorder.start()
+                state['recorder'] = recorder
+            info = metadata(batch)
+            if frame == frames:
+                # Include the native release/acceptance events after the final
+                # verification and one following causal-length boundary.
+                recorder.stop()
+                boundary = dict(info, request_slots=batch.req_pool_indices.cpu(),
+                                seq_lens=batch.seq_lens.cpu(), out_cache_loc=batch.out_cache_loc.cpu())
+                last = save_tensors('CLOSING_BOUNDARY.pt', boundary)
+                events = save_tensors('NATIVE_EVENTS.pt', recorder.event_snapshot())
+                save_json('COMPLETE.json', dict(complete=True, target_forwards=frames,
+                    warmup_target_forwards=warmup, chunks=state['chunks'], closing_boundary=last,
+                    events=events, event_columns=['after_target_frame', 'kind_alloc1_release2', 'native_uid'],
+                    next_forward_allocations_may_appear_in_last_event_frame=True,
+                    acceptance_binding='Native sequential seq_lens, request slots, proposal IDs, and alloc/free events; derive acceptance only after validating native verify-length semantics.',
+                    timing_scope='Trace capture only; unprofiled throughput must be measured separately.'))
+                state['finished'] = True
+                recording = False
+            else:
+                recorder.begin_frame(info['queries'])
+                slot = frame % recorder.geometry.chunk_frames
+                count = info['requests']
+                observer['request_slots'][slot, :count].copy_(batch.req_pool_indices)
+                observer['seq_lens'][slot, :count].copy_(batch.seq_lens[:count])
+                state['metadata'].append(dict(frame=frame, **info))
+        result = original_forward(runner, batch, *args, **kwargs)
+        if recording and replay_geometry is not None:
+            binding = replay_geometry()
+            if not binding or binding['native_replay_sequence'] <= state['last_native_replay']:
+                raise RuntimeError('Sparse frame did not execute a fresh native Graph replay')
+            state['metadata'][-1]['native_replay_binding'] = bind_native_trace_frame(
+                info, binding, observer['captured_source_shapes'])
+            state['last_native_replay'] = binding['native_replay_sequence']
+        if recording and recorder._next_frame % recorder.geometry.chunk_frames == 0:
+            chunk = recorder.drain_chunk()
+            chunk.update(request_slots=observer['request_slots'].cpu(), seq_lens=observer['seq_lens'].cpu(),
+                         metadata=state['metadata'])
+            state['chunks'].append(save_tensors(f'CHUNK_{chunk["first_frame"]:06d}.pt', chunk))
+            state['metadata'] = []
+            observer['request_slots'].fill_(-1)
+            observer['seq_lens'].fill_(-1)
+            save_json('PROGRESS.json', dict(target_forwards=recorder._next_frame, required_forwards=frames,
+                                          chunks=state['chunks']))
+        if target and not capturing:
+            state['forwards'] += 1
+        return result
+
+    ModelRunner.forward = forward
+    original_pause = Scheduler.pause_generation
+
+    def pause(scheduler, request):
+        result = original_pause(scheduler, request)
+        if request.mode == 'in_place':
+            if state['armed'] and not state['finished']:
+                raise RuntimeError('A native trace cohort ended before its full capture window')
+            state.update(armed=True, forwards=0, finished=False, chunks=[], metadata=[],
+                         cohort=state['cohort'] + 1)
+        return result
+
+    Scheduler.pause_generation = pause
