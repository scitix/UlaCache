+                        group=get_parallel().attn_tp_group, degree=owners, compiler=load_jit,
+                        host_factory=FlowKVHostRecordPool, ipc_factory=IPCManager,
+                        memory_region=nullcontext, prefill_records=configuration.prefill_buffer_records,
+                        prefill_query_chunk=configuration.prefill_query_chunk,
