index 0000000000000000000000000000000000000000..dd5813eee722c7c9feb538751e9dd856572280a9
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_fp8_index_scoring.py
@@ -0,0 +1,62 @@
+"""Supply owned native Index buffers and scores through ordinary DSA hooks."""
+
+
+def install_native_fp8_index_scoring():
+    from sglang.srt.layers.attention.dsa import dsa_indexer as module
+    from sglang.srt.layers.attention.dsa_backend import DeepseekSparseAttnBackend
+
+    if getattr(module.Indexer, '_ulacache_distributed_index_installed', False):
+        return
+    original_math = module.deep_gemm
+    original_metadata = DeepseekSparseAttnBackend.get_indexer_metadata
+    original_initialize = DeepseekSparseAttnBackend._init_cp_index_scorer
+
+    def runtime_for(pool):
+        return getattr(pool, 'native_distributed_indexer', None)
+
+    class NativeFP8MathServices:
+        def __getattr__(self, name):
+            return getattr(original_math, name)
+
+        def fp8_mqa_logits(self, q, kv, weights, starts, ends, *, clean_logits):
+            runtime = runtime_for(module.get_token_to_kv_pool())
+            if runtime is None:
+                return original_math.fp8_mqa_logits(q, kv, weights, starts, ends,
+                    clean_logits=clean_logits)
+
+            def native(q, keys, scales, weights, starts, ends, *, clean_logits):
+                return original_math.fp8_mqa_logits(q, (keys, scales), weights, starts, ends,
+                    clean_logits=clean_logits)
+
+            return runtime.score_ragged(q, kv[0], kv[1], weights, starts, ends,
+                native_score=native, clean_logits=clean_logits)
+
+    class BorrowedNativeCPScorer:
+        def __init__(self, runtime, bank, metadata):
+            self.runtime, self.bank, self.metadata = runtime, bank, metadata
+
+        def score(self, *, q, weights, score_fn, **unused):
+            return self.runtime.score_paged(self.bank, q, weights,
+                self.metadata.get_seqlens_int32(), self.metadata.get_page_table_64(),
+                native_score=score_fn)
+
+    def metadata(self, layer_id, forward_batch):
+        result = original_metadata(self, layer_id, forward_batch)
+        pool = self.token_to_kv_pool
+        runtime = runtime_for(pool)
+        if runtime is not None:
+            if forward_batch.forward_mode.is_target_verify():
+                raise NotImplementedError('Owned FP8 Index verification needs its expanded metadata binding')
+            object.__setattr__(result, 'cp_index_scorer', BorrowedNativeCPScorer(
+                runtime, pool.native_index_bank_by_layer[layer_id], result))
+        return result
+
+    def initialize(self, model_runner):
+        if runtime_for(model_runner.token_to_kv_pool) is None:
+            return original_initialize(self, model_runner)
+        self.cp_index_scorer = None
+
+    module.deep_gemm = NativeFP8MathServices()
+    DeepseekSparseAttnBackend.get_indexer_metadata = metadata
+    DeepseekSparseAttnBackend._init_cp_index_scorer = initialize
+    module.Indexer._ulacache_distributed_index_installed = True
diff --git a/python/sglang/srt/ulacache/native_glm_flash_entry.py b/python/sglang/srt/ulacache/native_glm_flash_entry.py
