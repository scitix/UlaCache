+"""Supply the native IPC service to the library-owned peer lifetime."""
+from ulacache.transfer.ipc import FlowKVPeerShards as _PeerShards
+
+class FlowKVPeerShards(_PeerShards):
+    def __init__(self, storage, cpu_group):
+        from sglang.kernels.ops.communication.all_reduce import IPCManager
+        super().__init__(storage, cpu_group, ipc_manager_factory=IPCManager)
diff --git a/python/sglang/srt/mem_cache/flowkv_plain_pool.py b/python/sglang/srt/mem_cache/flowkv_plain_pool.py
new file mode 100644
index 0000000000000000000000000000000000000000..dcde6180d866bdd6f58d0b212450b91c42152a17
--- /dev/null
+++ b/python/sglang/srt/mem_cache/flowkv_plain_pool.py
@@ -0,0 +1,355 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Complete native MLA records with native, unmodified shared Index outputs."""
+
+import torch
+
+from ulacache.speculative import is_cache_step
+from sglang.srt.mem_cache.flowkv_adapter import (
+    FlowKVExtendHistory,
+    FlowKVSharedIndexAdapter,
+)
+from sglang.srt.mem_cache.flowkv_record_lifecycle import SharedIndexLifecycle
+from sglang.srt.mem_cache.flowkv_record_storage import (
+    configure_pool,
+    global_ids,
+)
+from sglang.srt.mem_cache.memory_pool import DSATokenToKVPool, unwrap_write_loc
+
+
+class FlowKVPlainTokenToKVPool(FlowKVSharedIndexAdapter, DSATokenToKVPool):
+    def __init__(self, *args, flowkv_layout, **kwargs):
+        self.flowkv_layout = flowkv_layout
+        self._flowkv_mode = "none"
+        self._flowkv_decode_layer = None
+        self._flowkv_prefill_layer = None
+        self._flowkv_history_rows = None
+        self._flowkv_current_native = None
+        self._flowkv_current_rows = None
+        super().__init__(*args, **kwargs)
+
+    def _create_buffers(self):
+        layout = self.flowkv_layout
+        if (
+            self.dtype not in (torch.bfloat16, torch.float8_e4m3fn)
+            or layout.native_segment_bytes != (layout.row_bytes,)
+            or layout.row_bytes != self.dtype.itemsize * self.kv_cache_dim
+            or layout.pool_rows != self.size + self.page_size
+            or layout.layers != self.layer_num
+        ):
+            raise ValueError("Plain record budget disagrees with the native MLA pool")
+        configure_pool(self, step_publication=True)
+        self._flowkv_empty_rows = torch.empty(0, dtype=torch.int32, device=self.device)
+        self.flowkv_shared_index = SharedIndexLifecycle(
+            layout.layer_groups,
+            self,
+            prefetch=self.flowkv_prefetch,
+        )
+
+    @property
+    def supports_mha_one_shot(self):
+        # The bounded prefill path reconstructs selected rows into a window;
+        # it cannot expose the flat full-context view used by native MHA.
+        return not bool(self.flowkv_layout.prefill_window_rows)
+
+    @property
+    def flowkv_plain_compact_prefill(self):
+        return bool(self.flowkv_layout.prefill_window_rows) and self._flowkv_mode == "prefill"
+
+    def flowkv_compact_prefill_attention(
+        self, layer_id, query, native_rows, seq_lens, attend
+    ):
+        from sglang.srt.mem_cache.flowkv_v0522_context import get_parallel
+        from ulacache.cache.prefill.window import run_compact_prefill_attention
+
+        if not self.flowkv_plain_compact_prefill:
+            raise RuntimeError("Plain compact attention requires an active bounded prefill")
+        if get_parallel().attn_cp_size != 1:
+            raise RuntimeError("Plain compact prefill requires the verified TP needed-row union")
+        return run_compact_prefill_attention(
+            self, layer_id, query, native_rows, seq_lens, attend
+        )
+
+    def _flowkv_peer_offset(self, layer):
+        return layer * self.flowkv_shards.shape[1] * self.flowkv_layout.row_bytes
+
+    @property
+    def flowkv_packed_compression_ratio(self):
+        return 1
+
+    def flowkv_prepare_batch(self, batch):
+        if not is_cache_step(batch.forward_mode):
+            return
+        # The real Graph execute hook supplies unpadded native current rows.
+        # Captured forwards must read that live scalar, not record a fixed fill
+        # or borrow DP-only global-token buffers in an ordinary TP process.
+        if torch.cuda.is_current_stream_capturing():
+            return
+        self.flowkv_arena.valid.fill_(batch.out_cache_loc.numel())
+
+    def flowkv_before_layer_prepare(self, layer_id, batch):
+        layer = layer_id - self.start_layer
+        if not is_cache_step(batch.forward_mode):
+            self._flowkv_mode = "prefill"
+            if layer == 0:
+                self.flowkv_arena.invalidate(global_ids(self, batch.out_cache_loc))
+            return
+        if batch.out_cache_loc.numel() == 0:
+            return
+        if layer == 0:
+            self._flowkv_mode = "decode"
+            self._flowkv_current_native = batch.out_cache_loc
+            current = self._flowkv_global_current[: batch.out_cache_loc.numel()]
+            self.flowkv_arena.kernel().globalize_current(
+                batch.out_cache_loc, current, self._flowkv_owner_start
+            )
+            self.flowkv_step_publication.begin(current, self.flowkv_arena.valid)
+            self.flowkv_shared_index.begin_forward()
+        if self.flowkv_prefetch:
+            self.flowkv_shared_index.before_layer_prepare(layer)
+
+    def flowkv_on_index_ready(self, layer_id, indices, batch):
+        if is_cache_step(batch.forward_mode):
+            self.flowkv_shared_index.on_index_ready(
+                layer_id - self.start_layer, indices
+            )
+
+    def flowkv_prepare_extend(self, history: FlowKVExtendHistory):
+        rows = history.locations()
+        if rows.numel() > 1:
+            rows = torch.sort(rows).values
+            rows[1:] = torch.where(rows[1:] == rows[:-1], -1, rows[1:])
+        self._flowkv_history_rows = rows.contiguous()
+        self._flowkv_mode = "prefill"
+
+    def flowkv_prepare_topk_lookup(self, *, layer_id, packed_out_loc):
+        # This adapter explicitly uses the native Index return contract.
+        # --enable-flowkv-fused-topk is rejected by its cache-spec factory.
+        return None
+
+    def flowkv_prefetch_packed_attention(
+        self, *, layer_id, sparse_indices, packed_out_loc
+    ):
+        raise RuntimeError(
+            "Shared Index transport must start at its native return hook"
+        )
+
+    def flowkv_prepare_packed_attention(
+        self, *, layer_id, sparse_indices, packed_out_loc, decode_like
+    ):
+        layer = layer_id - self.start_layer
+        if not decode_like:
+            self._flowkv_mode = "prefill"
+            return sparse_indices
+        self.flowkv_shared_index.before_history_consume(layer)
+        self._flowkv_decode_layer = layer
+        self._flowkv_mode = "decode"
+        return self.flowkv_arena.groups[layer].remap[: sparse_indices.shape[0]]
+
+    def flowkv_after_attention(self, layer_id):
+        if self._flowkv_mode == "decode":
+            layer = layer_id - self.start_layer
+            self.flowkv_shared_index.after_attention(layer)
+            if layer + 1 == self.layer_num:
+                self.flowkv_shared_index.finish_forward()
+
+    def set_mla_kv_buffer(
+        self, layer, loc_info, cache_k_nope, cache_k_rope, layer_id_override=None
+    ):
+        loc, _, _ = unwrap_write_loc(loc_info)
+        self._check_physical_write_loc(loc_info, "set_mla_kv_buffer (record)")
+        layer_id = layer.layer_id if layer_id_override is None else layer_id_override
+        local = layer_id - self.start_layer
+        if self.dsa_kv_cache_store_fp8:
+            # Reuse the native scaled-FP8 writer before any raw FP8 cast.
+            # Its uint8 outputs retain both FP32 scales and BF16 RoPE bytes.
+            from sglang.kernels.ops.attention.dsa.quant_k_cache import (
+                quantize_k_cache_separate,
+            )
+
+            cache_k_nope, cache_k_rope = quantize_k_cache_separate(
+                cache_k_nope, cache_k_rope
+            )
+        elif cache_k_nope.dtype != self.dtype:
+            # TRTLLM supplies quantized views; short dense prefill supplies
+            # model projections. Preserve the native raw MLA conversion.
+            cache_k_nope = cache_k_nope.to(self.dtype)
+            if cache_k_rope.numel() > 0:
+                cache_k_rope = cache_k_rope.to(self.dtype)
+        if loc.numel() > self.flowkv_layout.max_staging_tokens:
+            raise ValueError("Native MLA write exceeds its configured chunk capacity")
+        arena, group = self.flowkv_arena, self.flowkv_arena.groups[local]
+        decode = self._flowkv_mode == "decode"
+        if not decode and self._flowkv_mode != "prefill":
+            raise RuntimeError("Native MLA writer requires a forward lifecycle")
+        compact_prefill = not decode and self.flowkv_plain_compact_prefill
+        resident = (
+            arena.storage[local] if decode
+            else arena.staging if compact_prefill else arena.prefill
+        )
+        current_rows = self.flowkv_staging_target_rows[: loc.numel()]
+        writer = (
+            arena.kernel().write_decode if decode
+            else arena.kernel().write_prefill_staged if compact_prefill
+            else arena.kernel().write_prefill
+        )
+        host_args = (
+            (self.flowkv_host.descriptors[local],)
+            if self.flowkv_host is not None else ()
+        )
+        if self.flowkv_request is not None:
+            host_args = (self.flowkv_request.page_map,)
+        writer(
+            cache_k_nope,
+            cache_k_rope,
+            loc,
+            self.flowkv_peers.device_ptr,
+            resident,
+            current_rows,
+            self._flowkv_owner_start,
+            self._flowkv_peer_offset(local),
+            self.flowkv_rank,
+            self._flowkv_namespaces > 1,
+            self.flowkv_layout.capacity,
+            group.cursors,
+            group.totals,
+            arena.active,
+            *host_args,
+        )
+        self._flowkv_current_rows = current_rows
+        if compact_prefill:
+            from ulacache.cache.prefill.window import invalidate_current_prefill_rows
