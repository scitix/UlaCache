index 0000000000000000000000000000000000000000..77254f44bf23308260e82239667b5a57d49deb98
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_ipc_environment.py
@@ -0,0 +1,21 @@
+"""Reject temporary paths that overflow native Linux symmetric-memory sockets."""
+import os
+import sys
+
+
+def validate_native_ipc_environment(environment=None, *, platform=None):
+    """Check the native TMPDIR precedence without importing device libraries."""
+    if (sys.platform if platform is None else platform) != 'linux':
+        return None
+    environment = os.environ if environment is None else environment
+    directory = next((environment[key] for key in ('TMPDIR', 'TMP', 'TEMP', 'TEMPDIR')
+                      if key in environment), '/tmp')
+    # PyTorch IpcChannel appends this suffix and copies into sun_path[108].
+    # Leave one byte for the terminator in the zero-initialized sockaddr_un.
+    socket_bytes = len(os.fsencode(directory + '/symm_mem-2147483647'))
+    if socket_bytes >= 108:
+        raise ValueError(
+            f'Native symmetric-memory socket path may use {socket_bytes} bytes; '
+            'Linux sun_path allows at most 107. Select a shorter TMPDIR before '
+            'starting serving. Keep persistent compiler caches at their configured locations.')
+    return dict(temporary_directory=directory, maximum_socket_path_bytes=socket_bytes)
