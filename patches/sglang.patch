index 0000000000000000000000000000000000000000..9eac7a09016488e2a817b219d942ab4c7ae00ce9
--- /dev/null
+++ b/python/sglang/srt/ulacache/pd_record_adapter.py
@@ -0,0 +1,339 @@
+"""Native PD shared-Index bindings and bounded DPA CPU record reception.
+
+Attention, quantization, Mooncake transport and the native deferred-release
+protocol remain native. Record publication and receive-window ownership live
+in the framework-independent UlaCache transfer module.
+"""
+from __future__ import annotations
+
+import dataclasses
+import json
+import os
+from pathlib import Path
+
+
+def configure_native_launch(configuration, arguments, environment):
+    """Select record reception from native PD flags before workers are created."""
+    import argparse
+
+    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
+    parser.add_argument("--disaggregation-mode", default="null")
+    parser.add_argument("--disaggregation-transfer-backend", default="mooncake")
+    parser.add_argument("--attn-dp-size", type=int, default=1)
+    options, _ = parser.parse_known_args(arguments)
+    if options.disaggregation_mode == "null":
+        return
+    if options.disaggregation_mode not in ("prefill", "decode"):
+        raise ValueError("PD requires a native prefill or decode role")
+    if options.disaggregation_transfer_backend != "mooncake":
+        if configuration is not None:
+            raise NotImplementedError("UlaCache record reception currently binds Mooncake")
+        return
+    if configuration is not None and (
+            configuration.adapter != "native_dpa" or options.attn_dp_size != 8
+            or options.disaggregation_mode != "decode"):
+        raise NotImplementedError("The common PD entry currently supports DPA8 reception")
+    kind = "ulacache" if configuration is not None else environment.get(
+        "UDCACHE_MATRIX_CACHE_KIND", "native")
+    required = {
+        "ULACACHE_PD_CACHE_KIND": kind,
+        "ULACACHE_PD_ATTENTION_MODE": "dpa" if options.attn_dp_size == 8 else "tp",
+        "SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE": "1",
+        "ULACACHE_NATIVE_PD_LINEAR_MTP": "1",
+    }
+    for name, value in required.items():
+        if name in environment and environment[name] != value:
+            raise ValueError(f"{name} conflicts with the native PD launch")
+    environment.update(required)
+    # The configuration's pool has already been installed by the common entry.
+    # Keep the same pool and allocator rather than installing another backend.
+    install(target_cache_installer=(lambda: None) if configuration is not None else None)
+
+
+def bind_native_pd_index_elision(configurator, get_memory, get_parallel, get_disagg):
+    """Retain native shared-TopK ownership for DPA/TP8 PD and HiSparse.
+
+    Pool sizing and construction consult this same predicate. HiSparse's host
+    payload does not require separate Index banks for shared-TopK followers;
+    the existing native constructor already accepts those empty placeholders.
+    Attention CP and pipeline partitioning retain their original policy.
+    """
+    original_elide = configurator._should_elide_dsa_index_k
+
+    def elide(*, is_draft_worker):
+        if original_elide(is_draft_worker=is_draft_worker):
+            return True
+        memory, parallel, disagg = get_memory(), get_parallel(), get_disagg()
+        return (not is_draft_worker
+            and not memory.enable_unified_cache_external_linker
+            and ((disagg.disaggregation_mode in ("prefill", "decode")
+                  and disagg.disaggregation_transfer_backend == "mooncake")
+                 or (disagg.disaggregation_mode == "null" and memory.enable_hisparse))
+            and parallel.attn_tp_size in (1, 8)
+            and parallel.attn_cp_size == parallel.pp_size == 1)
+
+    configurator._should_elide_dsa_index_k = elide
+
+
+def bind_native_pd_state_compaction(transfer_utils, dsa_state_type, *consumers):
+    """Retain native target/draft layer identities while removing empty banks."""
+    original = transfer_utils.setup_state_kv_args
+
+    def state_args(kv_args, pool, draft_token_to_kv_pool=None,
+                   total_kv_layers=None, req_to_token_pool=None):
+        result = original(kv_args, pool, draft_token_to_kv_pool,
+            total_kv_layers=total_kv_layers, req_to_token_pool=req_to_token_pool)
+        for index, kind in enumerate(kv_args.state_types):
+            if kind != dsa_state_type:
+                continue
+            lengths = kv_args.state_data_lens[index]
+            local_start, local_end = 0, pool.layer_num
+            if getattr(pool, "layer_shard_enabled", False):
+                local_start, local_end = pool._owned_local_layer_range()
+                if not 0 <= local_start < local_end <= pool.layer_num:
+                    raise ValueError("PD Index layer shard is outside the target pool")
+            target_ids = list(range(pool.start_layer + local_start,
+                                    pool.start_layer + local_end))
+            draft_entries = len(lengths) - len(target_ids)
+            if draft_entries < 0:
+                raise ValueError("PD shared Index table omits target layers")
+            layer_ids = target_ids
+            if draft_entries:
+                draft = draft_token_to_kv_pool
+                if draft is None or total_kv_layers is None:
+                    raise ValueError("PD draft Index requires its native pool and target layer count")
+                if total_kv_layers < pool.start_layer + pool.layer_num:
+                    raise ValueError("PD draft layer band overlaps target layers")
+                if len(draft.get_state_buf_infos()[1]) != draft_entries:
+                    raise ValueError("PD draft Index table differs from its native pool")
+                native_ids = transfer_utils._draft_entry_layer_ids(
+                    pool=draft, num_entries=draft_entries)
+                layer_ids += transfer_utils._remap_draft_layer_ids(native_ids, total_kv_layers)
+            existing = kv_args.state_layer_ids[index]
+            if existing:
+                if list(existing) != layer_ids:
+                    raise ValueError("PD native Index layer identities differ from pool ownership")
+            names = ("state_data_ptrs", "state_data_lens", "state_item_lens")
+            if any(len(getattr(kv_args, name)[index]) != len(lengths) for name in names):
+                raise ValueError("PD Index pointers, lengths and strides must align")
+            if any(size < 0 for size in lengths):
+                raise ValueError("PD Index byte lengths cannot be negative")
+            owned = [i for i, size in enumerate(lengths) if size > 0]
+            for name in names:
+                values = getattr(kv_args, name)[index]
+                getattr(kv_args, name)[index] = [values[i] for i in owned]
+            kv_args.state_layer_ids[index] = [layer_ids[i] for i in owned]
+        return result
+
+    transfer_utils.setup_state_kv_args = state_args
+    for consumer in consumers:
+        consumer.setup_state_kv_args = state_args
+
+
+def bind_native_pd_draft_receive(pool, draft):
+    """Bind native draft banks to the target's common receive-page lease."""
+    window = getattr(pool, "pd_receive_window", None)
+    if window is None or draft is None:
+        return
+    if getattr(draft, "_ulacache_pd_receive_window", None) is not None:
+        raise ValueError("Native draft pool already has a PD receive binding")
+    banks = list(draft.kv_buffer)
+    infos = draft.get_contiguous_buf_infos()
+    if (infos[0] != [bank.data_ptr() for bank in banks]
+            or infos[1] != [bank.nbytes for bank in banks]):
+        raise ValueError("Native draft transfer banks differ from canonical KV storage")
+    getter = window.add_sidecar_record_banks("native_draft", banks,
+        page_size=draft.page_size)
+    draft._ulacache_pd_receive_window = window
+    draft.get_contiguous_buf_infos = getter
+
+
+def install(*, model_layout=None, target_cache_installer=None, receive_window_type=None):
+    from sglang.srt.mem_cache import kv_cache_configurator as configurator
+    from sglang.srt.runtime_context import get_disagg, get_memory, get_parallel
+    from sglang.srt.disaggregation.base.conn import StateType
+    from sglang.srt.disaggregation.decode import DecodePreallocQueue, DecodeTransferQueue
+    from sglang.srt.disaggregation.mooncake.conn import MooncakeKVManager
+    from importlib import import_module
+    native_args = getattr(import_module('sglang.srt.disaggregation.base.conn'), 'KVArgs', None)
+    direct_protocol = hasattr(native_args, 'additional_kv_regions')
+    if direct_protocol:
+        from sglang.srt.ulacache.pd_direct_adapter import install_sender
+        install_sender()
+    from ulacache.transfer.receive_window import (
+        PinnedRecordReceiveWindow, incremental_state_indices,
+    )
+
+    if getattr(configurator, "_ulacache_pd_record_adapter_bound", False):
+        return
+    configurator._ulacache_pd_record_adapter_bound = True
+    bind_native_pd_index_elision(configurator, get_memory, get_parallel, get_disagg)
+    from sglang.srt.ulacache.pd_linear_mtp_capability import install as install_linear_mtp_capability
+    install_linear_mtp_capability(model_layout=model_layout)
+
+    # Native attention keeps layer-aligned empty placeholders. Transport
+    # registers only owned storage and pairs the remaining entries by layer ID.
+    from sglang.srt.disaggregation import utils as transfer_utils
+    from sglang.srt.disaggregation import decode, prefill
+    bind_native_pd_state_compaction(transfer_utils, StateType.DSA, decode, prefill)
+
+    # Use the same native page suffix for MLA KV and shared-TopK Index state.
+    original_extra = MooncakeKVManager.maybe_send_extra
+
+    def send_extra(self, request, state_indices, executor, registration=None):
+        prefix = int(request.decode_prefix_len or 0)
+        if prefix and StateType.DSA in self.kv_args.state_types:
+            source, destination = list(state_indices), list(request.dst_state_indices)
+            index = self.kv_args.state_types.index(StateType.DSA)
+            source[index], destination[index] = incremental_state_indices(
+                source[index], destination[index], prefix, self.kv_args.page_size)
+            request = dataclasses.replace(request, dst_state_indices=destination)
+            state_indices = source
+        return original_extra(self, request, state_indices, executor, registration)
+
+    MooncakeKVManager.maybe_send_extra = send_extra
+    if os.environ.get("ULACACHE_PD_CACHE_KIND") != "ulacache":
+        return
+
+    if os.environ.get("SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE") != "1":
+        raise ValueError("UlaCache PD requires native deferred remote-write retirement")
+    import torch
+    import numpy as np
+    if target_cache_installer is None:
+        import sglang.srt.ulacache.unified_local_adapter as unified_local_adapter
+        unified_local_adapter.install()
+    else:
+        if not callable(target_cache_installer):
+            raise TypeError("The native target-cache installer must be callable")
+        target_cache_installer()
+    mode = os.environ.get('ULACACHE_PD_RECEIVE_MODE',
+        'direct' if direct_protocol and receive_window_type is None else 'window')
+    if mode == 'direct':
+        if receive_window_type is not None:
+            raise NotImplementedError('Direct PD reception requires canonical contiguous record storage')
+        from sglang.srt.ulacache.pd_direct_adapter import install_receiver
+        install_receiver()
+        return
+    if mode != 'window':
+        raise ValueError('Unknown UlaCache PD receive mode')
+    from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+    from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+
+    original_build = configurator.KVCacheConfigurator._build_dsa_kv_pool
+
+    def build(self, **kwargs):
+        pool = original_build(self, **kwargs)
+        if self.is_draft_worker:
+            return pool
+        if get_disagg().disaggregation_mode != "decode":
+            raise ValueError("UlaCache receive windows require a decode-only worker")
+        window_type = PinnedRecordReceiveWindow if receive_window_type is None else receive_window_type
+        pool.pd_receive_window = window_type(pool.memory_cache,
+            record_capacity=int(os.environ["ULACACHE_PD_RECEIVE_RECORDS"]),
+            allocate_host_record_storage=FlowKVHostRecordPool, device=pool.device)
+        pool.get_contiguous_buf_infos = pool.pd_receive_window.contiguous_buffer_infos
+        return pool
+
+    configurator.KVCacheConfigurator._build_dsa_kv_pool = build
+    original_queue_init = DecodePreallocQueue.__init__
+
+    def queue_init(self, req_to_token_pool, token_to_kv_pool_allocator,
+                   draft_token_to_kv_pool, *args, **kwargs):
+        # Registration occurs in the native initializer. Attach every bank
+        # before any registered address or destination index is exposed.
+        bind_native_pd_draft_receive(token_to_kv_pool_allocator.get_kvcache(),
+                                     draft_token_to_kv_pool)
+        return original_queue_init(self, req_to_token_pool,
+            token_to_kv_pool_allocator, draft_token_to_kv_pool, *args, **kwargs)
+
+    DecodePreallocQueue.__init__ = queue_init
+    original_budget = DecodePreallocQueue._allocatable_token_budgets
+    original_allocate = DecodePreallocQueue._pre_alloc
+    original_metadata = DecodePreallocQueue._send_kv_metadata
+    original_pages = DecodePreallocQueue._transfer_page_indices
+    original_commit = DecodeTransferQueue._commit_transfer_to_req
+    original_defer_release = DecodeTransferQueue._defer_release
+    original_release = PagedTokenToKVPoolAllocator._release_page_ids
+
+    def budget(self, *args, **kwargs):
+        result = original_budget(self, *args, **kwargs)
+        window = getattr(self.token_to_kv_pool, "pd_receive_window", None)
+        return min(result, window.available_records) if window is not None else result
+
+    def allocate(self, *args, **kwargs):
+        allocator = self.token_to_kv_pool_allocator
+        previous = getattr(allocator, "_udcache_receiving_records", False)
+        allocator._udcache_receiving_records = True
+        try:
+            return original_allocate(self, *args, **kwargs)
+        finally:
+            allocator._udcache_receiving_records = previous
+
+    def metadata(self, request, kv_indices, page_size, state_indices=None, **kwargs):
+        window = getattr(self.token_to_kv_pool, "pd_receive_window", None)
+        if window is not None:
+            if page_size != window.page_size:
+                raise ValueError("Receive window and native transfer page sizes differ")
+            window.reserve(request.req.bootstrap_room, kv_indices[::page_size] // page_size,
+                           record_count=kv_indices.numel())
+        return original_metadata(self, request, kv_indices, page_size,
+                                 state_indices, **kwargs)
+
+    def pages(self, request, kv_indices, page_size):
+        window = getattr(self.token_to_kv_pool, "pd_receive_window", None)
+        if window is None:
+            return original_pages(self, request, kv_indices, page_size)
+        return np.asarray(window.transfer_pages(request.req.bootstrap_room), dtype=np.int32)
+
+    def commit(self, request):
+        prealloc = self.scheduler.disagg_decode_prealloc_queue
+        window = getattr(prealloc.token_to_kv_pool, "pd_receive_window", None)
+        if window is not None:
+            room = self.metadata_buffers.get_buf(request.metadata_buffer_index)[-1]
+            expected = request.req.bootstrap_room
+            if room[0].item() == expected and expected:
+                records = window.publish(expected)
+                audit = os.environ.get("ULACACHE_PD_AUDIT_DIR")
+                if audit:
+                    root = Path(audit)
+                    root.mkdir(parents=True, exist_ok=True)
+                    row = dict(room=expected, received_records=records,
+                        prefix_tokens=request.req.kv.cache_protected_len,
+                        source="registered_cpu_receive_window",
+                        publication_complete_before_native_commit=True)
+                    with (root / f"receive.rank{get_parallel().attn_dp_rank}.jsonl").open("a") as f:
+                        f.write(json.dumps(row) + "\n")
+        return original_commit(self, request)
+
+    def release(self, *page_ids):
+        window = getattr(self._kvcache, "pd_receive_window", None)
+        retired = None
+        if window is not None:
+            ids = page_ids[0] if len(page_ids) == 1 else torch.cat(page_ids)
+            retired = ids.to(device="cpu", dtype=torch.int64).tolist()
+        result = original_release(self, *page_ids)
+        if window is not None:
+            window.logical_pages_freed(retired)
+        return result
+
+    def defer_release(self, request):
+        result = original_defer_release(self, request)
+        pool = self.scheduler.disagg_decode_prealloc_queue.token_to_kv_pool
+        if getattr(pool, "pd_receive_window", None) is not None:
+            entry = self._deferred_releases[-1]
+            if entry[0] is not request:
+                raise RuntimeError("Native deferred receive retirement order changed")
+            # Native device destinations permit a timeout without an RDMA drain
+            # acknowledgement. Our registered host window must retain its lease
+            # until the existing native acknowledgement check actually succeeds.
+            self._deferred_releases[-1] = (
+                entry[0], entry[1], float("inf"), entry[3], entry[4])
+        return result
+
+    DecodePreallocQueue._allocatable_token_budgets = budget
+    DecodePreallocQueue._pre_alloc = allocate
+    DecodePreallocQueue._send_kv_metadata = metadata
+    DecodePreallocQueue._transfer_page_indices = pages
+    DecodeTransferQueue._commit_transfer_to_req = commit
+    DecodeTransferQueue._defer_release = defer_release
+    PagedTokenToKVPoolAllocator._release_page_ids = release
diff --git a/python/sglang/srt/ulacache/qwen_cpu_ngram_audit.py b/python/sglang/srt/ulacache/qwen_cpu_ngram_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c68c82860b9b22e1ce32eee123e76bf496a2886
--- /dev/null
+++ b/python/sglang/srt/ulacache/qwen_cpu_ngram_audit.py
@@ -0,0 +1,49 @@
+"""Audit actual native FP8 CPU N-gram placement after Graph capture."""
+
+import json
+import os
+from pathlib import Path
+
+
+def install():
+    import torch
+    from sglang.srt.model_executor.model_runner_components import cuda_graph_setup
+
+    original = cuda_graph_setup.capture_decode_graph
+
+    def capture(*, model_runner):
+        result = original(model_runner=model_runner)
+        tables = []
+        for name, module in model_runner.model.named_modules():
+            if type(module).__name__ != 'Qwen4ExpPinnedHostEmbedding':
+                continue
+            weight = module.weight
+            if weight.device.type != 'cpu' or not weight.is_pinned():
+                raise ValueError('Qwen N-gram table must reside in pinned CPU memory')
+            if weight.dtype != torch.float8_e4m3fn:
+                raise ValueError('This pinned FP8 checkpoint audit requires its native FP8 N-gram table')
+            tables.append(dict(name=name, device=str(weight.device), dtype=str(weight.dtype),
+                shape=list(weight.shape), pinned=weight.is_pinned(),
+                storage_bytes=weight.untyped_storage().nbytes(),
+                vocabulary_start=module.shard_indices.org_vocab_start_index,
+                vocabulary_end=module.shard_indices.org_vocab_end_index,
+                tp_size=module.tp_size, scale_device=str(module.weight_scale.device)))
+        if len(tables) != 1:
+            raise ValueError(f'Expected exactly one native CPU N-gram table, found {len(tables)}')
+        pool = model_runner.token_to_kv_pool
+        payload = getattr(pool, 'full_kv_pool', pool)
+        cache = getattr(payload, 'memory_cache', None)
+        rank = torch.distributed.get_rank()
+        root = Path(os.environ['UDCACHE_MATRIX_AUDIT_DIR'])
+        receipt = dict(rank=rank, tables=tables, ngram_cpu_bytes=sum(t['storage_bytes'] for t in tables),
+            qsa_pool_type=type(pool).__name__, payload_pool_type=type(payload).__name__,
+            full_attention_layers=list(pool.full_attention_layer_id_mapping),
+            compressed_index_dtype=str(pool.qsa_compressed_dtype),
+            compressed_index_bytes=pool.qsa_compressed_flat.untyped_storage().nbytes(),
+            cache_inventory=cache.get_memory_inventory() if cache is not None else None,
+            cache_device_storage_bytes=sum(payload.get_device_storage_inventory().values()) if cache is not None else None,
+            scope='Actual post-capture placement and retained allocation inventory; no throughput or accuracy claim')
+        (root / f'qwen.rank{rank}.json').write_text(json.dumps(receipt, indent=2) + '\n')
+        return result
+
+    cuda_graph_setup.capture_decode_graph = capture
