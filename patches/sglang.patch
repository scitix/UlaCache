+"""Bind the exact native quantizer and its actual v0.5.22 loader alias."""
+from functools import wraps
+import hashlib
+from pathlib import Path
+
+from ulacache.tools.fp8_loading import aligned_fp32_scales, dequantize_aligned_rows
+
+FP8_SHA = '31ee485f151f504d70a7c7e7e99d067d8fc412c9c3434ce0336545927b0585e6'
+LOADER_SHA = '34d73d632b1311f4013f4ca636a1324a67198a8695e086aaef0cec325d76edde'
+_binding = None
+_converter = None
+
+
+def install():
+    global _binding, _converter
+    from sglang.srt.layers.quantization import fp8_utils as native
+    from sglang.srt.models.deepseek_common import deepseek_weight_loader as caller
+
+    if _binding is not None:
+        if (caller.block_quant_to_tensor_quant is not _converter
+                or native.block_quant_to_tensor_quant is not _converter):
+            raise RuntimeError('The native loader alias changed after installation')
+        return dict(_binding)
+    for module, digest in ((native, FP8_SHA), (caller, LOADER_SHA)):
+        if hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest() != digest:
+            raise ValueError('The version-pinned FP8 loading source changed')
+    original = native.block_quant_to_tensor_quant
+    if caller.block_quant_to_tensor_quant is not original:
+        raise ValueError('The actual native loader alias was already replaced')
+    quantize = native.scaled_fp8_quant
+
+    @wraps(original)
+    def convert(values, scales, block_size):
+        if not (native._is_cuda and values.is_cuda
+                and aligned_fp32_scales(values, scales, block_size)):
+            return original(values, scales, block_size)
+        return quantize(dequantize_aligned_rows(values, scales, block_size))
+
+    native.block_quant_to_tensor_quant = caller.block_quant_to_tensor_quant = convert
+    _converter = convert
+    _binding = dict(fp8_sha256=FP8_SHA, loader_sha256=LOADER_SHA,
+        actual_loader_alias_bound=True, native_quantizer_unchanged=True,
+        fastpath='CUDA aligned row blocks with FP32 scales',
+        unsupported_layouts_original_callable=True)
+    return dict(_binding)
