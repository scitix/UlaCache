+++ b/python/sglang/srt/ulacache/hy4_pd_layout.py
@@ -0,0 +1,167 @@
+"""Source-bound HY4 Preview PD layout; this does not enable MTP Index carry.
+
+The native HY4 draft recomputes Index independently. Its KV and Index banks
+therefore remain separate sidecars under the target receive-page lease.
+This descriptor permits CPU validation only; it is not GPU qualification.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+
+NATIVE_MTP_SOURCES = {
+    "sglang/srt/configs/model_config.py":
+        "25e5f87f0dbebae2ae78201c9c20b1b74df4ed4fd0788ac55c333785f8e8ae4b",
+    "sglang/srt/layers/attention/index_topk_share.py":
+        "e4b2218c1b0ef472c5dc51c87e889c10742d33360d3fc7215458b64b6d3deebe",
+    "sglang/srt/speculative/eagle_worker_v2.py":
+        "618bd38535abe53f779854dd4649081c58150594a0a99f6d3ef7e3a1a00bdeff",
+}
+
+
+class HY4PDLayout:
+    """An explicit budget-selected capacity, never an H200 capacity default."""
+
+    def __init__(self, *, framework_directory, request_capacity, attention_mode):
+        if type(request_capacity) is not int or request_capacity < 1:
+            raise ValueError("HY4 PD requires an explicit positive request capacity")
+        if attention_mode not in ("tp", "dpa"):
+            raise ValueError("HY4 PD supports explicit TP8 or DPA8 only")
+        root = Path(framework_directory).resolve(strict=True)
+        sources = {}
+        for relative, expected in NATIVE_MTP_SOURCES.items():
+            path = (root / relative).resolve(strict=True)
+            if not path.is_relative_to(root):
+                raise ValueError("Native MTP source escapes the selected framework")
+            digest = hashlib.sha256(path.read_bytes()).hexdigest()
+            if digest != expected:
+                raise ValueError("HY4 PD requires the attested native MTP implementation")
+            sources[relative] = {"path": str(path), "sha256": digest}
+        self.request_capacity = request_capacity
+        self.attention_mode = attention_mode
+        self.native_sources = sources
+
+    def target_index_layer_ids(self, model):
+        """Use the bound native model predicate, never an H200 owner list."""
+        from sglang.srt.configs.model_config import dsa_layer_skips_topk
+        import inspect
+        path = Path(inspect.getfile(dsa_layer_skips_topk)).resolve(strict=True)
+        if hashlib.sha256(path.read_bytes()).hexdigest() != NATIVE_MTP_SOURCES[
+                "sglang/srt/configs/model_config.py"]:
+            raise ValueError("HY4 Index ownership requires its attested native predicate")
+        kinds = getattr(model.hf_config, 'indexer_types', None)
+        if (not isinstance(kinds, list) or len(kinds) != 78
+                or any(kind not in ('full', 'shared') for kind in kinds)):
+            raise ValueError("HY4 requires its explicit native per-layer Index pattern")
+        owners = tuple(layer for layer in range(78)
+                       if not dsa_layer_skips_topk(model.hf_config, layer))
+        if not owners or owners[0] != 0:
+            raise ValueError("HY4's first layer must own its native Index")
+        return owners
+
+    def validation_view(self, config):
+        """Read the existing private TP configuration without adding CLI flags."""
+        if self.attention_mode != 'tp':
+            return config
+        from sglang.srt.ulacache.v0522_owner_tp import _View, configuration
+        selected = configuration()
+        return _View(config, enable_flowkv=selected.enabled,
+            enable_flowkv_cpu_offload=selected.cpu_offload,
+            enable_flowkv_prefetch=bool(selected.prefetch), flowkv_cpu_policy='index',
+            dsa_decode_score_mode='cp' if selected.enabled else 'replicated')
+
+    def supports(self, config, model):
+        hf = model.hf_config
+        # False is the native default. True changes draft math and is rejected.
+        if getattr(hf, "index_share_for_mtp_iteration", False) is not False:
+            return False
+        fields = ((model, "num_nextn_predict_layers", 1),
+                  (model, "kv_lora_rank", 512),
+                  (model, "qk_rope_head_dim", 64),
+                  (hf, "num_hidden_layers", 78),
+                  (hf, "index_topk", 2048),
+                  (hf, "index_head_dim", 128),
+                  (hf, "index_n_heads", 32),
+                  (config, "max_running_requests", self.request_capacity))
+        if any(type(getattr(obj, field, None)) is not int
+               or getattr(obj, field) != expected for obj, field, expected in fields):
+            return False
+        if getattr(hf, "architectures", None) != ["HYV4ForCausalLM"]:
+            return False
+        try:
+            self.target_index_layer_ids(model)
+        except (ValueError, ImportError):
+            return False
+        return True
+
+    def evidence(self):
+        return dict(model="HY4 Preview", target_layers=78, draft_layers=1,
+            row_bytes=656, index_row_bytes=132, page_size=64,
+            index_topk=2048, cross_MTP_Index_carry=False,
+            independent_draft_Index=True, attention_mode=self.attention_mode,
+            request_capacity=self.request_capacity, native_sources=self.native_sources,
+            actual_GPU_qualified=False)
+
+
+def validate_hy4_pd_ready(*, layout, config, model, target, draft, draft_worker,
+                          actual_parallel, cpu_inventory_bytes,
+                          cpu_budget_bytes=128_000_000_000):
+    """Consume actual post-construction views, including independent draft Index.
+
+    CPU tests may replay these views but cannot create an actual GPU receipt.
+    Inventory must include receive staging and every draft/Index sidecar once.
+    """
+    if not isinstance(layout, HY4PDLayout) or not layout.supports(config, model):
+        raise ValueError("HY4 PD configuration differs from its source-bound layout")
+    expected_parallel = dict(tp_size=8, attn_tp_size=8 if layout.attention_mode == "tp" else 1,
+        attn_dp_size=1 if layout.attention_mode == "tp" else 8, attn_cp_size=1,
+        pp_size=1, dp_size=1)
+    if any(type(getattr(actual_parallel, name, None)) is not int
+           or getattr(actual_parallel, name) != value for name, value in expected_parallel.items()):
+        raise ValueError("Actual PD parallel groups differ from the selected TP/DPA topology")
+    if type(cpu_inventory_bytes) is not int or not 0 <= cpu_inventory_bytes <= cpu_budget_bytes:
+        raise ValueError("All-role CPU KV inventory exceeds the per-card PD budget")
+    if (getattr(draft_worker, "index_share_for_mtp_iteration", None) is not False
+            or getattr(draft_worker, "seed_dsa_topk_from_draft_extend", None) is not False
+            or getattr(draft_worker, "dsa_seed_topk_width", "missing") is not None
+            or getattr(getattr(draft_worker, "draft_runner", None), "token_to_kv_pool", None) is not draft):
+        raise ValueError("Actual HY4 draft worker must retain independent native Index recomputation")
+    window = getattr(target, "pd_receive_window", None)
+    if window is None or getattr(draft, "_ulacache_pd_receive_window", None) is not window:
+        raise ValueError("Target and draft require the same actual receive lease")
+    receive_inventory = window.memory_inventory()
+    if receive_inventory["pending_publications"] != 0:
+        raise ValueError("PD startup cannot accept an in-flight receive publication")
+    known_cpu_bytes = window.engine.host.storage.nbytes + sum(
+        value for name, value in receive_inventory.items() if name.startswith("cpu_"))
+    if cpu_inventory_bytes < known_cpu_bytes:
+        raise ValueError("All-role CPU inventory omits actual receive or host KV storage")
+    if target.layer_num != 78 or draft.layer_num != 1:
+        raise ValueError("HY4 PD requires 78 native target layers and one draft layer")
+    if target.page_size != 64 or draft.page_size != 64:
+        raise ValueError("HY4 PD requires native page64 storage")
+    target_width = (target.flowkv_layout.row_bytes if hasattr(target, "flowkv_layout")
+                    else getattr(target, "_row_bytes", None))
+    if target_width != 656 or getattr(draft, "kv_cache_dim", None) != 656:
+        raise ValueError("HY4 PD target/draft records must retain all native 656 bytes")
+    if getattr(draft.index_key_cache, "is_owner_compact", False):
+        raise ValueError("Independent HY4 draft Index must remain replicated")
+    target_state, draft_state = target.get_state_buf_infos(), draft.get_state_buf_infos()
+    if any(len(field) != 78 for field in target_state) or any(len(field) != 1 for field in draft_state):
+        raise ValueError("HY4 PD Index tables must retain native target/draft layer identities")
+    owned = tuple(i for i, nbytes in enumerate(target_state[1]) if nbytes)
+    expected = layout.target_index_layer_ids(model)
+    if owned != expected or draft_state[1][0] <= 0:
+        raise ValueError("HY4 PD target owners or independent draft Index storage differ")
+    if set(target_state[0][i] for i in owned) & set(draft_state[0]):
+        raise ValueError("Independent HY4 draft Index cannot alias target Index banks")
+    if any(stride != (8448 if size else 0)
+           for size, stride in zip(target_state[1], target_state[2])) or draft_state[2] != [8448]:
+        raise ValueError("HY4 PD Index pages must retain native 132-byte records")
+    return dict(complete=True, scope="post_constructor_layout_consumer",
+        target_Index_layer_ids=list(owned), draft_Index_native_layer_ids=[0],
+        draft_Index_transfer_layer_ids=[78], independent_draft_Index=True,
+        cross_MTP_Index_carry=False, cpu_inventory_bytes=cpu_inventory_bytes,
+        cpu_budget_bytes=cpu_budget_bytes, known_cpu_receive_and_host_bytes=known_cpu_bytes,
+        actual_parallel=expected_parallel, actual_GPU_qualified=False)
diff --git a/python/sglang/srt/ulacache/hy4_pd_registration_guard.py b/python/sglang/srt/ulacache/hy4_pd_registration_guard.py
new file mode 100644
index 0000000000000000000000000000000000000000..e66326bb1fb8034cbfda1ba228b4dc6c653b909a
--- /dev/null
+++ b/python/sglang/srt/ulacache/hy4_pd_registration_guard.py
@@ -0,0 +1,61 @@
+"""Check native startup registration results before publishing PD readiness."""
+from functools import wraps
+import hashlib
+import inspect
+import itertools
+import json
+import os
+from pathlib import Path
+
+
+def checked_batch_register(original, receipt_directory, source):
+    sequence = itertools.count()
+
+    @wraps(original)
+    def checked(self, ptrs, lengths):
+        # The upstream caller ignores this return code. Keep its native batch
+        # registration and turn a failure into a normal startup exception.
+        fields = Path('/proc/self/stat').read_text().rsplit(')', 1)[1].split()
+        receipt = dict(pid=os.getpid(), start_ticks=fields[19],
+                       pointers=list(ptrs), lengths=list(lengths), source=source,
+                       MC_FORCE_TCP_key_absent='MC_FORCE_TCP' not in os.environ,
+                       WITH_NVIDIA_PEERMEM=os.environ.get('WITH_NVIDIA_PEERMEM'))
+        path = Path(receipt_directory) / (f'{os.getpid()}_{fields[19]}_{next(sequence):04d}.json')
+        path.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            code = original(self, ptrs, lengths)
+        except BaseException as error:
+            receipt.update(complete=False, exception=repr(error))
+            with path.open('x') as stream:
+                json.dump(receipt, stream, indent=2)
+                stream.write('\n')
+            raise
+        receipt.update(complete=code == 0, return_code=code)
+        with path.open('x') as stream:
+            json.dump(receipt, stream, indent=2)
+            stream.write('\n')
+        if code != 0:
+            raise RuntimeError(f'Native Mooncake batch registration failed ({code}); receipt: {path}')
+        return code
+
+    return checked
+
+
+def install(framework_directory, receipt_directory):
+    if 'MC_FORCE_TCP' in os.environ or os.environ.get('WITH_NVIDIA_PEERMEM') != '0':
+        raise ValueError('PD requires MC_FORCE_TCP absent and WITH_NVIDIA_PEERMEM=0')
+    from sglang.srt.distributed.device_communicators.mooncake_transfer_engine import MooncakeTransferEngine
+    module = Path(inspect.getfile(MooncakeTransferEngine)).resolve(strict=True)
+    if not module.is_relative_to(Path(framework_directory).resolve(strict=True)):
+        raise ValueError('Mooncake wrapper came from a different framework')
+    source = dict(path=str(module), sha256=hashlib.sha256(module.read_bytes()).hexdigest())
+    previous = getattr(MooncakeTransferEngine, '_hy4_pd_registration_guard', None)
+    binding = dict(source=source, receipt_directory=str(receipt_directory))
+    if previous is not None:
+        if previous != binding:
+            raise ValueError('Registration guard was already installed with a different binding')
+        return binding
+    MooncakeTransferEngine.batch_register = checked_batch_register(
+        MooncakeTransferEngine.batch_register, receipt_directory, source)
+    MooncakeTransferEngine._hy4_pd_registration_guard = binding
+    return binding
diff --git a/python/sglang/srt/ulacache/hy4_pd_validation.py b/python/sglang/srt/ulacache/hy4_pd_validation.py
new file mode 100644
index 0000000000000000000000000000000000000000..a52764bb913b75975fe083cc711a0d97e802454f
--- /dev/null
+++ b/python/sglang/srt/ulacache/hy4_pd_validation.py
@@ -0,0 +1,48 @@
+"""Verify the consolidated native PD extension points without rewriting source."""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+PARENT_FILES = {
+    "sglang.srt.arg_groups.memory_hook":
+        "8eda47b5491bac604bddc8529979d51902dfa9cd03a4dcbe95edd03c671dd39a",
+    "sglang.srt.arg_groups.pd_disaggregation_hook":
+        "5c6976de69a75a1b52c9383bb29f2533a6f98d4a25cac2a85a9d75357cb53e20",
+    "sglang.srt.mem_cache.flowkv_config":
+        "81d04d1a70bfc59c7890a2441ad143680d7a5be94bce19f97a2d6d0a5dda1c49",
+}
+_binding = None
+
+
+def install():
+    """Install on normal startup; importing this module loads no framework."""
+    global _binding
+    if _binding is not None:
+        return _binding
+    import importlib
+
+    modules = {}
+    refs = {}
+    for name, expected in PARENT_FILES.items():
+        module = importlib.import_module(name)
+        path = Path(module.__file__).resolve(strict=True)
+        digest = hashlib.sha256(path.read_bytes()).hexdigest()
+        if digest != expected:
+            raise ValueError("HY4 PD validation requires its exact native parent: " + name)
+        modules[name] = module
+        refs[name] = dict(path=str(path), sha256=digest)
+    memory = modules["sglang.srt.arg_groups.memory_hook"]
+    pd = modules["sglang.srt.arg_groups.pd_disaggregation_hook"]
+    records = modules["sglang.srt.mem_cache.flowkv_config"]
+    required = (
+        (memory, "register_flowkv_pd_cpu_offload_capability"),
+        (pd, "register_decode_radix_speculation_capability"),
+        (records, "_ulacache_pd_records_supported"),
+    )
+    if any(not callable(getattr(module, name, None)) for module, name in required):
+        raise RuntimeError("Apply the consolidated SGLang patch before binding PD")
+    _binding = dict(complete=True, scope="explicit_native_validation_only",
+        parent_files=refs, native_defaults_changed=False,
+        native_transfer_utils_changed=False, actual_GPU_qualified=False)
+    return _binding
diff --git a/python/sglang/srt/ulacache/matrix_graph_padding_adapter.py b/python/sglang/srt/ulacache/matrix_graph_padding_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..db7a7dfffd481ee7ad90abe3df010e6d327a074e
--- /dev/null
+++ b/python/sglang/srt/ulacache/matrix_graph_padding_adapter.py
@@ -0,0 +1,78 @@
+"""Optional benchmark-only dummy input reset between drained KV cohorts.
+
+Native full Graph replay overwrites real input IDs and retains its unused
+tail. A previous larger cohort can therefore change dummy-token MoE routing.
+Observe/reset these captured input tensors at admission, outside timing.
+"""
+import weakref
+
+_registries = weakref.WeakSet()
+_installed = False
+
+
+def require_drained_pause(scheduler):
+    """Validate the benchmark boundary before touching captured graph inputs."""
+    if not scheduler._engine_paused or scheduler.waiting_queue:
+        raise RuntimeError('Graph padding reset requires a paused empty admission queue')
+    if not scheduler.running_batch.is_empty():
+        raise RuntimeError('Graph padding reset requires the running batch to drain')
+    if scheduler.enable_overlap:
+        raise NotImplementedError('Graph padding reset requires disabled overlap scheduling')
+    if scheduler.chunked_req is not None:
+        raise RuntimeError('Graph padding reset cannot interrupt a prefill chunk')
+    previous = scheduler.last_batch
+    if previous is not None and any(not req.finished() for req in previous.reqs):
+        raise RuntimeError('Graph padding reset cannot interrupt a previous batch')
+
+
+def install():
+    global _installed
+    if _installed:
+        return
+    from sglang.srt.model_executor.cuda_graph_buffer_registry import CudaGraphBufferRegistry
+
+    original = CudaGraphBufferRegistry.__init__
+
+    def initialize(registry, *args, **kwargs):
+        original(registry, *args, **kwargs)
+        _registries.add(registry)
+
+    CudaGraphBufferRegistry.__init__ = initialize
+    _installed = True
+
+
+def reset():
+    """Call only after native execution drains, before restoring a new cohort."""
+    import torch
+
+    if not _installed or torch.cuda.is_current_stream_capturing():
+        raise RuntimeError('Install before capture and reset only at an eager idle boundary')
+    candidates, records = {}, []
+    for registry in list(_registries):
+        if not registry.has_slot('input_ids'):
+            continue
+        tensor = registry.get_slot('input_ids').buffer
+        if tensor is None:
+            continue
+        previous = candidates.get(tensor.data_ptr())
+        if previous is None or tensor.numel() > previous.numel():
+            candidates[tensor.data_ptr()] = tensor
+    for tensor in candidates.values():
+        records.append(dict(elements=tensor.numel(), bytes=tensor.numel()*tensor.element_size(),
+                            before_first32=tensor.reshape(-1)[:32].cpu().tolist()))
+        tensor.zero_()
+    if not records:
+        raise RuntimeError('No native Graph input buffers were registered')
+    return dict(reset=True, buffers=records,
+        scope='Unmeasured benchmark admission only. Reset dummy input IDs; native replay overwrites every real input. KV, positions, request tables and model/cache algorithms are untouched.')
+
+
+def reset_at_drained_pause(scheduler):
+    """Run on every TP/DP rank, including ranks with no next-cohort requests."""
+    require_drained_pause(scheduler)
+    import torch
+
+    torch.cuda.synchronize()
+    receipt = reset()
+    torch.cuda.synchronize()
+    return dict(receipt, boundary='Drained native in_place pause acknowledgement')
diff --git a/python/sglang/srt/ulacache/matrix_prefix_load_adapter.py b/python/sglang/srt/ulacache/matrix_prefix_load_adapter.py
