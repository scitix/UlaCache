+
+def configure_pool(pool):
+    import torch
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.kernels.ops.communication.all_reduce import IPCManager
+    from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+    from sglang.srt.runtime_context import get_parallel
+    from ulacache.bindings import BackendServices
+    from ulacache.cache.tp_cache import configure_pool as configure
+    from ulacache.cache_config import CacheOptions, PrefetchPolicy
+    from ulacache.compiler import configure_compiler
+    from ulacache.storage.workspace import PipelineTPLayout
+
+    parallel = get_parallel()
+    if parallel.attn_tp_size != 8 or torch.cuda.get_device_capability(pool.device) != (9, 0):
+        raise NotImplementedError('Bind eight Hopper GPU owners per native pipeline stage')
+    group = parallel.attn_tp_group
+    # Native compaction and teardown use the same existing TP CPU group.
+    pool._flowkv_cpu_group = group.cpu_group
+    pool.flowkv_layout = PipelineTPLayout.from_native(pool.flowkv_layout)
+    configure_compiler(load_jit)
+    services = BackendServices(
+        degree=parallel.attn_tp_size, group=group, namespaces=1,
+        config=CacheOptions(cpu_offload=False, local_eviction_policy='age_lru',
+            prefetch=PrefetchPolicy(enabled=True, completion='layer')),
+        memory_region=lambda: pool.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE),
+        ipc_manager_factory=IPCManager, host_pool_factory=_no_host_storage,
+        host_memory_budget_bytes=lambda: 0)
+    configure(pool, services, step_publication=True)
+
+
+def install():
+    """Install in each native worker before constructing target or draft pools."""
+    global _installed
+    if _installed is not None:
+        return _installed
+    modules = {name: importlib.import_module(name) for name in PINS}
+    receipts = {name: hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest()
+                for name, module in modules.items()}
+    if receipts != PINS:
+        raise ValueError('The GPU TP/PP framework sources differ from the supported binding')
+    from ulacache.cache.prefetch import SharedIndexLifecycle
+    from ulacache.cache.prefill.plans import NativePrefillReadPlans, PrefillSequenceBudget
+    from ulacache.cache.tensor_parallel import adopt_native_pool
+
+    native = modules['sglang.srt.flowkv.pool']
+    pool_class = native.FlowKVPlainTokenToKVPool
+    names = ('flowkv_before_layer_prepare', 'flowkv_on_index_ready',
+             'flowkv_prepare_packed_attention', 'flowkv_after_attention', 'set_mla_kv_buffer')
+    replacements = {name: _compile(getattr(pool_class, name), name, writer_boundary=5)
+                    for name in names}
+    original_create, original_clear = pool_class._create_buffers, pool_class._clear_buffers
+    original_extend, original_finish = pool_class.flowkv_prepare_extend, pool_class.finish_flowkv_forward
+    original_before = replacements['flowkv_before_layer_prepare']
+
+    @wraps(original_create)
+    def create(self, *args, **kwargs):
+        from ulacache.storage.workspace import PipelineTPLayout
+
+        # The native constructor retains this descriptor in a local variable.
+        # Convert before it captures the shared group object, not during allocation.
+        self.flowkv_layout = PipelineTPLayout.from_native(self.flowkv_layout)
+        result = original_create(self, *args, **kwargs)
+        adopt_native_pool(self, native_kv_format='scaled656')
+        self._ulacache_prefill_reads = NativePrefillReadPlans(self.ulacache,
+            self.flowkv_layout.layer_groups, self.flowkv_layout.prefill_window_rows)
+        return result
+
+    @wraps(original_clear)
+    def clear(self, *args, **kwargs):
+        self._ulacache_prefill_invalidated_rows = None
+        plans = getattr(self, '_ulacache_prefill_reads', None)
+        if plans is not None:
+            plans.reset()
+        cache = getattr(self, 'ulacache', None)
+        if cache is not None:
+            cache.close()
+        return original_clear(self, *args, **kwargs)
+
+    @wraps(original_extend)
+    def extend(self, *args, **kwargs):
+        self._ulacache_prefill_invalidated_rows = None
+        self._ulacache_prefill_reads.reset()
+        return original_extend(self, *args, **kwargs)
+
+    @wraps(original_finish)
+    def finish(self, *args, **kwargs):
+        try:
+            return original_finish(self, *args, **kwargs)
+        finally:
+            self._ulacache_prefill_reads.reset()
+            self._ulacache_prefill_invalidated_rows = None
+
+    @wraps(original_before)
+    def before(self, layer_id, batch):
+        result = original_before(self, layer_id, batch)
+        if layer_id == self.start_layer and self._flowkv_mode == 'prefill':
+            # The pinned native hook just invalidated these IDs in every group.
+            self._ulacache_prefill_invalidated_rows = batch.out_cache_loc
+        return result
+
+    replacements['flowkv_before_layer_prepare'] = before
+
+    native.configure_pool = configure_pool
+    native.SharedIndexLifecycle = SharedIndexLifecycle
+    modules['sglang.srt.flowkv.prefill'].PrefillSequenceBudget = PrefillSequenceBudget
+    pool_class._create_buffers, pool_class._clear_buffers = create, clear
+    pool_class.flowkv_prepare_extend, pool_class.finish_flowkv_forward = extend, finish
+    pool_class.read_native_prefill_records = read_native_prefill_records
+    pool_class.read_prefill_attention_records = read_prefill_attention_records
+    for name, method in replacements.items():
+        setattr(pool_class, name, method)
+    _installed = dict(framework_sources=receipts, pool_class=pool_class.__name__,
+        native_replicated_index=True, cpu_kv=False, public_cache_api=True,
+        prefill_planner=NativePrefillReadPlans.__module__)
+    return _installed
+
+
+# Compatibility for the separate legacy TP/PP framework only.
+def adapt_method(source, name, *, writer_boundary=4):
+    """Replace only the version-pinned calls at existing native boundaries."""
+    function = ast.parse(textwrap.dedent(source)).body[0]
+    changed = []
+
+    def method(value):
+        if (isinstance(value, ast.Call) and isinstance(value.func, ast.Attribute)
+                and isinstance(value.func.value, ast.Attribute)
+                and isinstance(value.func.value.value, ast.Name)
+                and value.func.value.value.id == 'self'
+                and value.func.value.attr == 'flowkv_shared_index'):
+            return value.func.attr
+        return None
+
+    class ReplaceCalls(ast.NodeTransformer):
+        def visit_Call(self, node):
+            original = method(node)
+            if original in ('begin_forward', 'before_layer_prepare', 'after_attention'):
+                replacement = dict(begin_forward='begin_model_forward',
+                    before_layer_prepare='prepare_layer_execution',
+                    after_attention='finish_layer_attention')[original]
+                node.func.value.attr = 'ulacache'
+                node.func.attr = replacement
+                changed.append(original)
+            elif original == 'on_index_ready':
+                if len(node.args) != 2:
+                    raise ValueError('Unexpected native Index publication signature')
+                node.func.value.attr = 'ulacache'
+                node.func.attr = 'prepare_sparse_attention'
+                selected = ast.Call(func=ast.Name(id='_canonical_selection',ctx=ast.Load()),
+                    args=[node.args[1],ast.Attribute(value=ast.Attribute(
+                        value=ast.Name(id='self',ctx=ast.Load()),attr='flowkv_layout',ctx=ast.Load()),
+                        attr='topk',ctx=ast.Load())],keywords=[])
+                node.args[1] = ast.Call(func=ast.Name(id='_PublicAccessPlan',ctx=ast.Load()),
+                    args=[selected,ast.Attribute(value=ast.Name(id='self',ctx=ast.Load()),
+                        attr='_flowkv_current_native',ctx=ast.Load())],keywords=[])
+                changed.append(original)
+            return self.generic_visit(node)
+
+        def visit_Expr(self, node):
+            if method(node.value) == 'before_history_consume':
+                changed.append('before_history_consume')
+                return ast.parse('_public_view = self.ulacache.access(\n'
+                    '    _canonical_selection(sparse_indices, self.flowkv_layout.topk), layer)').body[0]
+            return self.generic_visit(node)
+
+        def visit_If(self, node):
+            if (name == 'flowkv_after_attention' and len(node.body) == 1
+                    and isinstance(node.body[0], ast.Expr)
+                    and method(node.body[0].value) == 'finish_forward'):
+                changed.append('finish_forward')
+                return None
+            return self.generic_visit(node)
+
+        def visit_Return(self, node):
+            if (name == 'flowkv_prepare_packed_attention'
+                    and isinstance(node.value, ast.Subscript)):
+                changed.append('resident_view')
+                return ast.parse('return _public_view.slot_ids').body[0]
+            return self.generic_visit(node)
+
+    if name == 'set_mla_kv_buffer':
+        # Everything through the native quantizer/cast is retained verbatim.
+        boundaries = [index for index,node in enumerate(function.body)
+            if isinstance(node,ast.If) and ast.unparse(node.test) == 'self.dsa_kv_cache_store_fp8']
+        if boundaries != [writer_boundary]:
+            raise ValueError('The native writer encoding boundary changed')
+        function.body = function.body[:writer_boundary + 1] + ast.parse(
+            'self.ulacache.write(loc, local, (cache_k_nope, cache_k_rope))').body
+    else:
+        function = ReplaceCalls().visit(function)
+        expected = {
+            'flowkv_before_layer_prepare':['begin_forward','before_layer_prepare'],
+            'flowkv_on_index_ready':['on_index_ready'],
+            'flowkv_prepare_packed_attention':['before_history_consume','resident_view'],
+            'flowkv_after_attention':['after_attention','finish_forward'],
+        }
+        if changed != expected.get(name):
+            raise ValueError(f'The native {name} boundaries changed: {changed}')
+    return ast.unparse(ast.fix_missing_locations(function))
+
+def _compile(method, name, *, writer_boundary=4):
+    from ulacache import SparseAttentionAccessPlan
+
+    namespace = dict(method.__globals__, _PublicAccessPlan=SparseAttentionAccessPlan,
+        _canonical_selection=canonical_selection)
+    source = adapt_method(inspect.getsource(method), name, writer_boundary=writer_boundary)
+    filename = method.__code__.co_filename + ':public_client'
+    exec(compile(source,filename,'exec',flags=__import__('__future__').annotations.compiler_flag),namespace)
+    return update_wrapper(namespace[name],method)
