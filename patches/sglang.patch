+
+    @property
+    def allocation_page_size(self):
+        from sglang.srt.mem_cache.flowkv_v0522_context import get_exec
+
+        return self.page_size * (
+            self._flowkv_storage_size
+            if get_exec().kernel.dsa_decode_score_mode == "cp" else 1
+        )
