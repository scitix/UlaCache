+"""Legacy native entry using the shared pool configuration decoder."""
+
+import os
+import runpy
+
+
+def install_bindings():
+    from sglang.srt.ulacache.model_configuration import load_pool_configuration
+    from sglang.srt.ulacache.native_dsa_pool import install_native_sparse_latent_pool
+    from sglang.srt.ulacache.matrix_startup_audit import install as install_startup_audit
+
+    install_native_sparse_latent_pool(load_pool_configuration('dsa', os.environ['ULACACHE_NATIVE_DSA_CONFIGURATION']))
+    install_startup_audit()
+
+
+install_bindings()
+
+if __name__ == '__main__':
+    runpy.run_module('sglang.launch_server', run_name='__main__')
diff --git a/python/sglang/srt/ulacache/native_dsa_optimized_pool.py b/python/sglang/srt/ulacache/native_dsa_optimized_pool.py
