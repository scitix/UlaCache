+                    from sglang.kernels.ops.communication.all_reduce import IPCManager
+                    from contextlib import nullcontext
+                    from sglang.srt.ulacache.request_prefill_adapter import install as install_request_prefill
+
+                    self.cache_execution = create_native_shared_tp_execution(specification,
