@@ -0,0 +1,38 @@
+"""Opt-in Index experiment; supply explicit KV and Index startup bounds."""
+import json
+import os
+from pathlib import Path
+import runpy
+
+
+def install_index_bindings():
+    import sglang.srt.ulacache.native_paged_pool as native_paged_pool
+    from sglang.srt.ulacache.native_owner_index import (
+        NativeOwnerIndexConfiguration, create_native_owner_index_pool_class,
+        install_native_owner_index_scoring,
+    )
+    settings = json.loads(Path(os.environ['ULACACHE_NATIVE_OWNER_INDEX_CONFIGURATION']).read_text())
+    configuration = NativeOwnerIndexConfiguration(**settings)
+    original_factory = native_paged_pool.create_native_paged_pool_class
+
+    def create(configuration_kv, selection_producer_layers, *, record_owner_process_group=None):
+        if configuration_kv.storage_owner_count != 8 or record_owner_process_group is None:
+            raise ValueError('Owner Index requires the same eight owners as native cold KV')
+        base = original_factory(configuration_kv, selection_producer_layers,
+            record_owner_process_group=record_owner_process_group)
+        return create_native_owner_index_pool_class(base, configuration, cpu_group=record_owner_process_group)
+
+    native_paged_pool.create_native_paged_pool_class = create
+    install_native_owner_index_scoring()
+
+
+install_index_bindings()
+# Import installs the existing native-paged bindings without launching a
+# second server when multiprocessing imports this file as __mp_main__.
+import sglang.srt.ulacache.native_paged_entry as native_paged_entry
+if os.environ.get('ULACACHE_INDEX_ALLOCATOR_AUDIT_DIR'):
+    from sglang.srt.ulacache.native_index_allocator_audit import install as install_allocator_audit
+    install_allocator_audit()
+
+if __name__ == '__main__':
+    runpy.run_module('sglang.launch_server', run_name='__main__')
