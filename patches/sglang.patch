+"""Thin rank-local DPA binding for the pinned SGLang v0.5.22 framework.
+
+Native allocation, quantization, local Index, sinks, attention and speculation
+remain framework-owned. NativePagedResidency supplies the existing public
+record lifecycle, per-layer follower IO and residency implementation.
+Importing this module does not import Torch or initialize a device.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import wraps
+import hashlib
+import importlib
+import inspect
+from pathlib import Path
+
+FRAMEWORK_COMMIT = 'baa9befa381511cd4d56f83980951e5a45fffc6d'
+PARENT_FILES = {'sglang.srt.mem_cache.memory_pool': 'ce1ea806071a289753675b5d5b56e3804c9658183817dfa7272dfb1899907c03',
+ 'sglang.srt.mem_cache.kv_cache_configurator': '450810e8050ab37fdb2008fa1dffa83eee9269e01fdc3d6017113a5abd3b420d',
+ 'sglang.srt.mem_cache.allocator.paged': 'b5889350d3d2b7d67cf4b119f1a963743d467274c8d0fca05c5bffe64d2c96b2',
+ 'sglang.srt.model_executor.pool_configurator': 'f7f29aef4a5a78b0a2538be1fdbd5e22e8b85cbcdefc9dc9735a0da1f437ed36',
+ 'sglang.srt.runtime_context': '1b4e9cc6d9afa941d7d4619dab1f434a5b83072fe60f165008e68c3740e54aab',
+ 'sglang.srt.mem_cache.flowkv_adapter': '9e03c7ad1d34a7a63db4aa2c9f4ffc0d0bb542528eb73da33e536adf9702869b'}
+_binding = None
+
+
+@dataclass(frozen=True)
+class DPAConfiguration:
+    device_record_capacity: int
+    host_record_capacity: int
+    device_cache_budget_bytes: int
+    maximum_running_requests: int = 128
+    maximum_write_record_count: int = 8192
+    exchange_blocks: int = 64
+    exchange_threads: int = 256
+    local_current_publication: bool = False
+    maximum_padded_query_count: int | None = None
+    host_cache_budget_bytes: int | None = None
+
+    def __post_init__(self):
+        if self.host_cache_budget_bytes is not None and (
+                type(self.host_cache_budget_bytes) is not int
+                or self.host_cache_budget_bytes <= 0):
+            raise ValueError('Host cache budget must be a positive byte count or null')
+        if type(self.local_current_publication) is not bool:
+            raise ValueError('Local current publication must be boolean')
+        if self.maximum_padded_query_count is not None and (
+                type(self.maximum_padded_query_count) is not int
+                or self.maximum_padded_query_count <= 0):
+            raise ValueError('Padded query capacity must be a positive integer or null')
+        for name in ('device_record_capacity','host_record_capacity',
+                'device_cache_budget_bytes','maximum_running_requests',
+                'maximum_write_record_count'):
+            value = getattr(self,name)
+            if type(value) is not int or value <= 0:
+                raise ValueError(f'{name} must be a positive integer')
+        if self.device_record_capacity % 64 or self.host_record_capacity % 64:
+            raise ValueError('Rank-local capacities must contain complete page64 records')
+        if self.device_record_capacity+self.host_record_capacity >= 2**31:
+            raise ValueError('Native DPA logical records must fit positive int32')
+        from ulacache.cache.kernels.cpu_residency import validate_exchange_launch
+        validate_exchange_launch((self.exchange_blocks,self.exchange_threads))
+
+
+def validate_context(parallel,speculation,kernels):
+    from sglang.srt.ulacache.native_cache_topology import require_rank_local_attention_storage
+    from ulacache.speculative import LinearVerifyConfig
+
+    require_rank_local_attention_storage(parallel)
+    if (parallel.tp_size != 8 or parallel.attn_dp_size != 8
+            or parallel.pp_size != 1 or parallel.moe_ep_size != 1):
+        raise NotImplementedError('Bind modelTP8/attentionDP8/PP1/EP1 separately from owner TP')
+    if (kernels.dsa_prefill_backend != 'flashmla_kv'
+            or kernels.dsa_decode_backend != 'flashmla_kv'):
+        raise NotImplementedError('Scaled656 HY4 DPA requires the native sink-capable FlashMLA KV reader')
+    if speculation.speculative_algorithm is None:
+        return 1
+    LinearVerifyConfig(algorithm=speculation.speculative_algorithm,
+        steps=speculation.speculative_num_steps,topk=speculation.speculative_eagle_topk,
+        verify_tokens=speculation.speculative_num_draft_tokens,
+        adaptive=speculation.speculative_adaptive).validate()
+    return speculation.speculative_num_draft_tokens
+
+
+def _selection(ids):
+    if ids.ndim == 3 and ids.shape[1] == 1:
+        return ids.view(ids.shape[0],ids.shape[2])
+    if ids.ndim != 2:
+        raise ValueError('Native sparse selection must be QxK or Qx1xK')
+    return ids
+
+
+class DPACacheHooks:
+    """Borrow native tensors and translate native lifetime calls only."""
+
+    @property
+    def flowkv_packed_compression_ratio(self):
+        return 1
+
+    def flowkv_prepare_batch(self,batch):
+        import torch
+
+        if torch.cuda.is_current_stream_capturing():
+            return
+        counts = batch.global_num_tokens_gpu
+        active = self.memory_cache.active_query_count_tensor
+        if counts is None:
+            active.fill_(batch.out_cache_loc.numel())
+        else:
+            rank = self._attention_dp_rank
+            active.copy_(counts[rank:rank+1])
+
+    def flowkv_before_layer_prepare(self,layer_id,batch):
+        from ulacache.speculative import is_cache_step
+
+        local = layer_id-self.start_layer
+        if local == 0:
+            self._decode = is_cache_step(batch.forward_mode)
+            self._current = batch.out_cache_loc
+            self.cache_execution.begin_forward(decode_like=self._decode,
+                active_query_counts=batch.global_num_tokens_gpu,
+                attention_data_parallel_rank=self._attention_dp_rank,
+                query_count=batch.out_cache_loc.numel(),
+                publish_active_query_count=False,current_logical_record_ids=self._current)
+        if self._decode:
+            self.memory_cache.prepare_layer_execution(local)
+
+    def flowkv_on_index_ready(self,layer_id,indices,batch):
+        # A native Index backend may return sequence positions rather than
+        # physical IDs. Preserve its own causal transform and consume IDs only
+        # at the native FlashMLA reader, after the original writer was staged.
+        return None
+
+    def flowkv_prepare_extend(self,history):
+        # Native eager prefix reconstruction remains query/reader-driven.
+        self._decode = False
+
+    def flowkv_prepare_topk_lookup(self,**kwargs):
+        return None
+
+    def flowkv_prefetch_packed_attention(self,**kwargs):
+        return None
+
+    def flowkv_prepare_packed_attention(self,*,layer_id,sparse_indices,
+            packed_out_loc,decode_like):
+        raise RuntimeError('DPA physical IDs must enter at the installed native FlashMLA reader')
+
+    def flowkv_after_attention(self,layer_id):
+        self.cache_execution.finish_attention(layer_id-self.start_layer)
+
+    def finish_flowkv_forward(self):
+        # Every reader retires at its real native attention return boundary.
+        self.memory_cache._access_engine.require_idle('finishing native DPA forward')
+
+    def set_mla_kv_buffer(self,layer,loc_info,cache_k_nope,cache_k_rope,
+            layer_id_override=None):
+        from sglang.srt.mem_cache.memory_pool import unwrap_write_loc
+
+        loc,_,_ = unwrap_write_loc(loc_info)
+        self._check_physical_write_loc(loc_info,'set_mla_kv_buffer (DPA native records)')
+        model_layer = layer.layer_id if layer_id_override is None else layer_id_override
+        local=model_layer-self.start_layer
+        # The original writer/quantizer encodes once into existing bounded
+        # staging. Current CPU rows are published only after the native plan
+        # commits their destination, preserving the established DPA contract.
+        self.writer_staging.stage_native_records(local,loc,(cache_k_nope,cache_k_rope))
+        self.cache_execution.publish_after_native_write(local)
+
+    def register_native_full_pages(self,pages,*,prefer_device):
+        self.cache_execution.register_full_pages(pages,prefer_device=prefer_device)
+
+    def register_native_receive_pages(self, pages):
+        records = self.cache_execution._logical_records_for_pages(pages)
+        self.memory_cache.register_receive_records(records)
+
+    def release_native_full_pages(self,pages):
+        self.cache_execution.release_full_pages(pages)
+
+    def clear_native_full_records(self):
+        self.cache_execution.clear_records()
+
+    def prepare_native_reader(self,layer_id,physical_native_ids):
+        selected=_selection(physical_native_ids)
+        local=layer_id-self.start_layer
+        rows=self.cache_execution.prepare_attention(local,selected)
+        if self._decode:
+            # This is the public borrowed access over the already prepared
+            # transaction; it does not create another directory or planner.
+            rows=self.memory_cache.access(selected,local).device_record_indices
+        return rows.reshape(physical_native_ids.shape)
+
+    def read_native_prefill_records(self,layer_id,logical_ids,output):
+        def read(planes,rows,destination):
+            from sglang.kernels.ops.attention.dsa.dequant_k_cache import dequantize_k_cache_paged
+            native=planes[0].view(self.dtype).reshape(-1,1,self.kv_cache_dim)
+            destination.copy_(dequantize_k_cache_paged(native,rows.clamp_min(0)))
+        self.cache_execution.reconstruct_prefill_records(layer_id-self.start_layer,
+            logical_ids,output,read)
+
+    def get_device_storage_inventory(self):
+        return self.cache_execution.get_device_storage_inventory()
+
+    def _native_record_io(self,indices):
+        import torch
+        from ulacache.transfer.file_io import QuiescentRecordIO
+        engine=self.memory_cache._execution_engine
+        storage=engine.record_storage
+        if len(storage.plane_storage) != 1:
+            raise ValueError('Native MLA snapshots require one complete record plane')
+        plane=storage.plane_storage[0]
+        if engine.execution_plan.storage_producer_layers != tuple(range(self.layer_num)):
+            raise NotImplementedError('Bind native snapshot layer aliases explicitly')
+        def quiesce():
+            engine._require_retired_readers()
+            if torch.device(self.device).type=='cuda':
+                torch.cuda.synchronize(self.device)
+        return QuiescentRecordIO(
+            gpu_records=plane.device_record_pages.view(self.layer_num,-1,656),
+            cpu_records=plane.host_record_pool.storage.view(self.layer_num,-1,656),
+            layer_groups=engine.execution_plan.residency_domain_indices_by_layer,
+            owner_rows=indices, directories=tuple(state.directory for state in engine.residency_states),
+            page_rows=64,quiesce=quiesce)
+
+    def get_cpu_copy(self,indices,mamba_indices=None,req_pool_index=None):
+        # Preserve the original native chunk protocol, including its singleton
+        # head dimension. Reuse the shared blocking IO router, not logical-ID
+        # indexing into a compact physical bank or another IO implementation.
+        chunks=[]
+        with self._native_record_io(indices) as records:
+            for layer in range(self.layer_num):
+                chunks.append([records.read(layer,start,
+                    min(self.cpu_offloading_chunk_size,indices.numel()-start)).reshape(-1,1,656)
+                    for start in range(0,indices.numel(),self.cpu_offloading_chunk_size)])
+            index=self.index_key_cache.cpu_copy(indices)
+        return dict(kv=chunks,index_k=index)
+
+    def load_cpu_copy(self,value,indices,mamba_indices=None,req_pool_index=None):
+        import torch
+        if len(value['kv'])!=self.layer_num:
+            raise ValueError('Native snapshot layer count differs')
+        for chunks in value['kv']:
+            if len(chunks)!=(indices.numel()+self.cpu_offloading_chunk_size-1)//self.cpu_offloading_chunk_size:
+                raise ValueError('Native snapshot chunk count differs')
+            for chunk,data in enumerate(chunks):
+                rows=min(self.cpu_offloading_chunk_size,
+                    indices.numel()-chunk*self.cpu_offloading_chunk_size)
+                if (data.device.type!='cpu' or data.dtype!=torch.uint8
+                        or tuple(data.shape)!=(rows,1,656)):
+                    raise ValueError('Native snapshot must retain complete scaled656 byte rows')
+        with self._native_record_io(indices) as records:
+            for layer,chunks in enumerate(value['kv']):
+                for chunk,data in enumerate(chunks):
+                    records.write(layer,chunk*self.cpu_offloading_chunk_size,data.reshape(-1,656))
+            self.index_key_cache.load_cpu_copy(value['index_k'],indices)
+
+    def move_kv_cache(self,target_locations,source_locations):
+        raise NotImplementedError('Bind a validated logical-record relocation before enabling it')
+
+    def _clear_buffers(self):
+        self.memory_cache.close()
+        return super()._clear_buffers()
+
+
+def create_pool_class(configuration,layer_selection_owners,maximum_selected_records):
+    """Create a native subtype; the framework retains the complete constructor."""
+    import torch
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+    from sglang.srt.mem_cache.flowkv_adapter import FlowKVSharedIndexAdapter
+    from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+    from sglang.srt.mem_cache.memory_pool import DSATokenToKVPool
+    from sglang.srt.runtime_context import get_parallel,get_spec,get_exec
+    from ulacache import (CacheExecutionOptions,KeyValueRecordPlane,KeyValueStorageLayout,
+        LayerReuseSpecification,LocalCacheBindings,MemoryTierCapacity,
+        SparseAccessSpecification,UnifiedCacheSpecification,init)
+    from ulacache.cache.planning import create_paged_cache_execution_plan
+    from ulacache.cache.attention_access import NativeSparseCacheExecution
+    from ulacache.storage.writers import NativeRecordWriteStaging
+
+    owners = tuple(layer_selection_owners)
+
+    class NativeDPATokenToKVPool(DPACacheHooks,FlowKVSharedIndexAdapter,DSATokenToKVPool):
+        def __init__(self,*args,**kwargs):
+            width = validate_context(get_parallel(),get_spec(),get_exec().kernel)
+            self._attention_dp_rank=get_parallel().attn_dp_rank
+            native_rows = kwargs.get('max_running_requests')
+            if native_rows not in (configuration.maximum_running_requests,
+                    configuration.maximum_running_requests+1):
+                raise ValueError('Bind the actual per-rank request limit,excluding its dummy row')
+            if kwargs.get('index_kpool',1) != 1 or kwargs.get('index_kpool_compress',False):
+                raise NotImplementedError('Independent DPA currently binds native uncompressed Index IDs')
+            kwargs['skip_topk_layers'] = [owner != local for local,owner in enumerate(owners)]
+            required_queries = configuration.maximum_running_requests*width
+            self._maximum_queries = (configuration.maximum_padded_query_count
+                if configuration.maximum_padded_query_count is not None else required_queries)
+            if self._maximum_queries < required_queries:
+                raise ValueError('Padded query capacity cannot shrink the native request geometry')
+            self._decode,self._current = False,None
+            self.flowkv_plain_compact_prefill = False
+            super().__init__(*args,**kwargs)
+
+        def _create_buffers(self):
+            if (self.dtype != torch.float8_e4m3fn or self.kv_cache_dim != 656
+                    or not self.dsa_kv_cache_store_fp8 or self.kv_lora_rank != 512
+                    or self.qk_rope_head_dim != 64 or self.page_size != 64):
+                raise NotImplementedError('Bind only the native scaled656 FP8 page64 format')
+            if self.layer_num != len(owners):
+                raise ValueError('Native stage layers differ from shared Index declarations')
+            capacity = MemoryTierCapacity(configuration.device_record_capacity,
+                configuration.host_record_capacity,configuration.maximum_write_record_count,
+                reserved_logical_record_count=64,
+                maximum_prefill_union_record_count=configuration.device_record_capacity)
+            if self.size+self.page_size != capacity.logical_record_capacity:
+                raise ValueError('Native allocator admission differs from GPU+CPU logical rows')
+            spec = UnifiedCacheSpecification(
+                KeyValueStorageLayout('native-scaled-MLA',(
+                    KeyValueRecordPlane('kv','mla.scaled656.fp8.v1',(528,128)),),64),
+                LayerReuseSpecification.from_shared_sparse_selection(owners),
+                SparseAccessSpecification(self._maximum_queries,maximum_selected_records),capacity)
+            grid=(configuration.exchange_blocks,configuration.exchange_threads)
+            options=CacheExecutionOptions(record_storage_backend='native_paged',
+                prefill_union_method='device',prepare_residency_in_parallel=True,
+                prepare_current_records_in_parallel=True,select_victims_in_parallel=True,
+                fuse_native_record_publication=True,
+                copy_follower_records_asynchronously=True,follower_copy_mode='layer',
+                exchange_launch_dimensions=grid,follower_exchange_launch_dimensions=grid,
+                prefill_exchange_launch_dimensions=grid)
+            execution_plan=create_paged_cache_execution_plan(spec)
+            def native_write(values,pages,indices):
+                native=pages.view(self.store_dtype).reshape(-1,1,self.kv_cache_dim)
+                self._write_mla_kv_buffer(native,indices,*values)
+            with self.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+                self.writer_staging=NativeRecordWriteStaging(spec,execution_plan,
+                    self.device,native_write)
+                self.memory_cache=init(spec,LocalCacheBindings(self.device,
+                    FlowKVHostRecordPool,load_jit,options))
+            self.cache_execution=NativeSparseCacheExecution(self.memory_cache,execution_plan,
+                self.writer_staging,spec,self.device,
+                local_current_publication=configuration.local_current_publication)
+            self.kv_buffer=[plane[0].view(self.store_dtype).reshape(-1,1,656)
+                for plane in self.memory_cache._execution_engine.device_record_planes_by_layer]
+            self._reserved_rows=self.cache_execution.reserved_logical_records
+
+    return NativeDPATokenToKVPool
+
+
+def install(configuration):
+    """Install before native constructors; never alter target/draft compute."""
+    global _binding
+    if not isinstance(configuration,DPAConfiguration):
+        raise TypeError('Expected the explicit rank-local DPA configuration')
+    if _binding is not None:
+        if _binding['configuration'] != configuration:
+            raise RuntimeError('Another DPA configuration is already installed')
+        return _binding
+    parents={}
+    for name,expected in PARENT_FILES.items():
+        path=Path(importlib.import_module(name).__file__).resolve(strict=True)
+        digest=hashlib.sha256(path.read_bytes()).hexdigest()
+        if digest not in ((expected,) if isinstance(expected,str) else expected):
+            raise ValueError(f'The version-pinned DPA framework boundary differs: {name}')
+        parents[name]=dict(path=str(path),sha256=digest)
+    from sglang.srt.ulacache.v0522_owner_tp import configuration as owner_configuration
+    if owner_configuration().enabled:
+        raise ValueError('Rank-local DPA cannot install over ordinary owner TP')
+    from sglang.srt.configs.model_config import dsa_layer_skips_topk,get_dsa_index_topk
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.ulacache.native_cache_admission import install_native_sparse_latent_admission
+    from sglang.srt.ulacache.native_sparse_allocator import install_native_sparse_allocator_hooks
+    from sglang.srt.ulacache.native_attention import require_scaled_fp8_sink
+    original = kv_cache_configurator.KVCacheConfigurator._build_dsa_kv_pool
+    signature = inspect.signature(original)
+    if tuple(signature.parameters) != ('self','max_total_num_tokens',
+            'max_running_requests','dsa_pool_class'):
+        raise ValueError('The actual v0.5.22 DSA factory ABI differs')
+
+    @wraps(original)
+    def build(self,**kwargs):
+        if not self.is_draft_worker:
+            owners=[]
+            for layer in range(self.layer_info.start_layer,self.layer_info.end_layer):
+                shared=dsa_layer_skips_topk(self.model_config.hf_config,layer)
+                if shared and not owners:
+                    raise NotImplementedError('Shared Index cannot cross a pipeline-stage boundary')
+                owners.append(owners[-1] if shared else len(owners))
+            kwargs['dsa_pool_class']=create_pool_class(configuration,owners,
+                get_dsa_index_topk(self.model_config.hf_config))
+        if configuration.host_cache_budget_bytes is not None:
+            from sglang.srt.mem_cache.pool_host.base import host_memory_budget_scope
+
+            with host_memory_budget_scope(configuration.host_cache_budget_bytes):
+                return original(self,**kwargs)
+        return original(self,**kwargs)
+
+    # Reuse the native sink shim, without the owner-TP physical TopK boundary.
+    # Native DPA composes its own physical IDs before this leaf reader.
+    sink_binding=require_scaled_fp8_sink()
+    from sglang.srt.layers.attention.dsa_backend import DeepseekSparseAttnBackend
+    native_reader=DeepseekSparseAttnBackend._forward_flashmla_kv
+    @wraps(native_reader)
+    def read(self,q_all,kv_cache,v_head_dim,sm_scale,layer,metadata,page_table_1,attn_sink=None):
+        pool=self.token_to_kv_pool
+        if not isinstance(pool,DPACacheHooks):
+            return native_reader(self,q_all,kv_cache,v_head_dim,sm_scale,
+                layer,metadata,page_table_1,attn_sink=attn_sink)
+        mapped=pool.prepare_native_reader(layer.layer_id,page_table_1)
+        result=native_reader(self,q_all,kv_cache,v_head_dim,sm_scale,
+            layer,metadata,mapped,attn_sink=attn_sink)
+        pool.flowkv_after_attention(layer.layer_id)
+        return result
+    read._hy4_native_sink_bound=True
+    DeepseekSparseAttnBackend._forward_flashmla_kv=read
+    _install_prefill_reader()
+    from sglang.srt.models.hunyuan_v4 import HYV4ForCausalLM
+    from sglang.srt.mem_cache.flowkv_forward import scoped_raw_model_forward
+    if not getattr(HYV4ForCausalLM.forward,'_ulacache_raw_forward_scope',False):
+        HYV4ForCausalLM.forward=scoped_raw_model_forward(HYV4ForCausalLM.forward)
+    install_native_sparse_latent_admission(configuration)
+    from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+    if not hasattr(PagedTokenToKVPoolAllocator, '_consume_free_pages'):
+        raise RuntimeError('Apply patches/sglang.patch before using native DPA')
+    install_native_sparse_allocator_hooks(sparse_adapter_class=DPACacheHooks)
+    kv_cache_configurator.KVCacheConfigurator._build_dsa_kv_pool=build
+    path=Path(inspect.getfile(kv_cache_configurator)).resolve()
+    _binding=dict(complete=True,configuration=configuration,framework_commit=FRAMEWORK_COMMIT,
+        parent_files=parents,
+        actual_factory_file=dict(path=str(path),sha256=hashlib.sha256(path.read_bytes()).hexdigest()),
+        native_sink_binding=sink_binding,backend='NativePagedResidency',
+        target_only=True,native_draft_unchanged=True,actual_GPU_verified=False,
+        whole_model_verified=False,prefix_MHA_reader_binding_pending=False)
+    return _binding
+
+
+def _install_prefill_reader():
+    from sglang.srt.models.deepseek_common.attention_forward_methods import forward_mha
+    original=forward_mha.DeepseekMHAForwardMixin._get_mla_kv_buffer_from_fp8_for_dsa
+    @wraps(original)
+    def read(self,forward_batch):
+        pool=forward_mha.get_token_to_kv_pool()
+        if not isinstance(pool,DPACacheHooks):
+            return original(self,forward_batch)
+        import torch
+        backend=forward_mha.resolve_attn_backend(forward_batch)
+        rows=backend.forward_metadata.page_table_1_flattened
+        if rows is None:
+            raise ValueError('Native MHA prefix requires its original flattened logical IDs')
+        result=torch.empty((rows.numel(),1,self.kv_lora_rank+self.qk_rope_head_dim),
+            dtype=torch.bfloat16,device=rows.device)
+        pool.read_native_prefill_records(self.attn_mha.layer_id,rows,result)
+        return (result[:,:,:self.kv_lora_rank].squeeze(1).contiguous(),
+            result[:,:,self.kv_lora_rank:])
+    forward_mha.DeepseekMHAForwardMixin._get_mla_kv_buffer_from_fp8_for_dsa=read
