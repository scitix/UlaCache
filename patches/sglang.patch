+                    dict(reset_at_drained_pause(scheduler),
+                         pause_sequence=state["pause_sequence"],
+                         rank=torch.distributed.get_rank()))
+            report("pause_ack", dict(rank=torch.distributed.get_rank(),
+                sequence=state["pause_sequence"], engine_paused=bool(scheduler._engine_paused),
+                native_waiting_count=len(scheduler.waiting_queue),
+                graph_padding_reset=bool(config.get("reset_graph_padding", False))))
+        return result
+
+    def admit(scheduler, request, *args, **kwargs):
+        result = original_admit(scheduler, request, *args, **kwargs)
+        if scheduler._engine_paused:
+            cohorts = {}
+            for req in scheduler.waiting_queue:
+                params = req.sampling_params.custom_params or {}
+                cohort = params.get("udcache_snapshot_cohort")
+                if cohort is not None:
+                    cohorts.setdefault(cohort, []).append(params["udcache_snapshot_key"])
+            for cohort, keys in cohorts.items():
+                report("admission", dict(request_cohort=cohort, engine_paused=True,
+                    attn_dp_rank=get_parallel().attn_dp_rank, waiting_keys=sorted(keys),
+                    native_waiting_count=len(keys)))
+        return result
+
+    Scheduler.get_new_batch_prefill = prefill
+    Scheduler.handle_generate_request = admit
+    Scheduler.pause_generation = pause_execution
+    ModelRunner.forward = forward
