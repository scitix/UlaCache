+"""Native non-PD radix prefixes backed by the existing UlaCache record tier.
+
+The radix tree owns stable logical IDs, locks and eviction decisions. UlaCache
+owns their exclusive GPU/CPU residency. An internal GPU eviction therefore
+does not evict a prefix and no second HiCache host payload is allocated.
+"""
+from __future__ import annotations
+
+
+def validate_configuration(memory, disagg, spec):
+    """Fail before binding a tree whose lifecycle would contradict the tier."""
+    if disagg.disaggregation_mode != "null":
+        raise ValueError("Native logical prefixes require a non-PD service")
+    if memory.disable_radix_cache:
+        raise ValueError("UlaCache prefix reuse requires native radix caching")
+    if memory.enable_hierarchical_cache:
+        raise ValueError("UlaCache logical prefixes already use the declared CPU record tier")
+    if getattr(memory, "enable_unified_cache_external_linker", False):
+        raise ValueError("External prefix storage needs its own record-lifetime binding")
+    if spec.speculative_algorithm is not None and (
+        spec.speculative_algorithm != "EAGLE"
+        or spec.speculative_eagle_topk != 1
+        or spec.speculative_adaptive
+    ):
+        raise ValueError("Native logical prefixes require linear native MTP or SPEC OFF")
+
+
+def prefix_storage_contract(tree_cache):
+    """Describe borrowed native IDs without allocating host or GPU storage."""
+    allocator = tree_cache.token_to_kv_pool_allocator
+    pool = allocator.get_kvcache()
+    cache = getattr(pool, "memory_cache", None)
+    if cache is None:
+        return None
+    engine = getattr(cache, '_execution_engine', None)
+    if engine is not None and not callable(getattr(engine, 'finish_forward', None)):
+        raise NotImplementedError('This record backend has no prefix-publication boundary')
+    plan = cache.cache_specification.capacity_plan
+    if tree_cache.disable:
+        raise ValueError("Native radix tree was initialized with prefixes disabled")
+    if allocator.page_size != pool.page_size or allocator.page_size != 64:
+        raise ValueError("Native prefix ownership must use the existing complete page geometry")
+    if allocator.size + pool.page_size != plan.logical_record_capacity:
+        raise ValueError("Prefix allocator capacity must cover exactly the GPU+CPU logical tier")
+    if pool.size != allocator.size:
+        raise ValueError("Native prefix indices and the record pool must share one capacity")
+    if plan.reserved_logical_record_count != pool.page_size:
+        raise ValueError("Native zero-page records must stay outside reusable prefixes")
+    for name in ("inc_lock_ref", "dec_lock_ref", "checkpoint", "evict"):
+        if not callable(getattr(tree_cache, name, None)):
+            raise ValueError("Native prefix cache is missing its ownership lifecycle: " + name)
+    return dict(
+        enabled=True,
+        tree_type=type(tree_cache).__name__,
+        native_logical_allocator=True,
+        logical_slots=allocator.size,
+        device_record_capacity=plan.device_record_capacity,
+        host_record_capacity=plan.host_record_capacity,
+        reserved_records=plan.reserved_logical_record_count,
+        prefix_payload_storage="existing_exclusive_gpu_cpu_record_tier",
+        additional_prefix_payload_bytes=0,
+        allocation_owner="native_radix_tree",
+        residency_owner="ulacache",
+    )
+
+
+def bind_native_prefix_cache(cache_class, get_memory, get_disagg, get_spec):
+    """Retain native matching/refcounts and order publication after KV writes."""
+    if getattr(cache_class, "_ulacache_logical_prefix_bound", False):
+        return
+    original_init = cache_class.__init__
+    original_checkpoint = cache_class.checkpoint
+
+    def initialize(self, params):
+        pool = params.token_to_kv_pool_allocator.get_kvcache()
+        ours = getattr(pool, "memory_cache", None) is not None
+        if ours:
+            validate_configuration(get_memory(), get_disagg(), get_spec())
+        original_init(self, params)
+        if ours:
+            contract = prefix_storage_contract(self)
+            self.ulacache_prefix_cache_contract = contract
+            pool.native_prefix_cache_contract = contract
+
+    def checkpoint(self, req, *, up_to, **kwargs):
+        pool = self.token_to_kv_pool_allocator.get_kvcache()
+        cache = getattr(pool, "memory_cache", None)
+        if cache is not None:
+            # Native checkpoint keys only committed history. Future readers
+            # run on this stream, ordered after all follower-copy events.
+            cache.finish_model_forward()
+        return original_checkpoint(self, req, up_to=up_to, **kwargs)
+
+    cache_class.__init__ = initialize
+    cache_class.checkpoint = checkpoint
+    cache_class._ulacache_logical_prefix_bound = True
+
+
+def install():
+    """Install before native scheduler/pool construction; no PD backend binds."""
+    from sglang.srt.ulacache.unified_local_adapter import install as install_records
+    install_records()
+    from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+    from sglang.srt.runtime_context import get_disagg, get_memory, get_spec
+
+    bind_native_prefix_cache(UnifiedRadixCache, get_memory, get_disagg, get_spec)
