@@ -0,0 +1,291 @@
+"""Startup configuration for the version-pinned SGLang owner-TP adapter.
+
+This module contains no cache or attention implementation. The framework
+patch supplies native tensors and callbacks to ``ulacache``. Importing this
+module does not import Torch or SGLang.
+"""
+
+from dataclasses import dataclass
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+
+from ulacache.cache_config import PrefetchPolicy
+
+
+FRAMEWORK_COMMIT = "baa9befa381511cd4d56f83980951e5a45fffc6d"
+CONFIGURATION_ENV = "ULACACHE_V0522_CONFIGURATION"
+_configuration = None
+_external_modules = {}
+
+
+@dataclass(frozen=True)
+class OwnerTPConfiguration:
+    enabled: bool = False
+    cpu_offload: bool = False
+    cpu_slots: int = 0
+    cpu_ratio: float = 2.0
+    prefetch: bool | PrefetchPolicy = True
+    local_eviction_policy: str = "age_lru"
+    host_exchange_blocks: int = 64
+    host_exchange_threads: int = 256
+    low_query_pull_blocks: int | None = None
+    cache_capacity_multiplier: float = 3.0
+    device_cache_budget_bytes: int | None = None
+    native_kv_format: str = "raw576"
+    prefill_window_rows: int = 0
+    index_sharding: bool = True
+    owner_index_draft: bool = False
+
+    def __post_init__(self):
+        if isinstance(self.prefetch, dict):
+            object.__setattr__(self, 'prefetch', PrefetchPolicy(**self.prefetch))
+        if type(self.prefetch) is not bool and not isinstance(self.prefetch, PrefetchPolicy):
+            raise ValueError('prefetch must be boolean or a PrefetchPolicy')
+        for field in ("enabled", "cpu_offload", "index_sharding", "owner_index_draft"):
+            if type(getattr(self, field)) is not bool:
+                raise ValueError(f"{field} must be boolean")
+        if not self.enabled and self.cpu_offload:
+            raise ValueError("CPU residency requires the owner-TP adapter")
+        if self.owner_index_draft and not self.enabled:
+            raise ValueError("Draft owner Index requires the owner-TP adapter")
+        if self.owner_index_draft and not self.index_sharding:
+            raise ValueError("Draft owner Index requires a sharded target Index")
+        if type(self.cpu_slots) is not int or self.cpu_slots < 0 or self.cpu_slots % 64:
+            raise ValueError("CPU slots must be nonnegative and page64 aligned")
+        if not self.cpu_offload and self.cpu_slots:
+            raise ValueError("CPU-off must not reserve host KV")
+        if self.cpu_offload and not self.cpu_slots:
+            raise ValueError("Declare the CPU-on slot budget explicitly")
+        if not self.prefetch and self.enabled:
+            raise ValueError("This experiment retains shared-Index prefetch")
+        from ulacache.storage.layout import NativeMLARecord
+
+        NativeMLARecord(self.native_kv_format)
+        if (type(self.prefill_window_rows) is not int or self.prefill_window_rows < 0
+                or self.prefill_window_rows % 64
+                or 0 < self.prefill_window_rows < 2048):
+            raise ValueError("Prefill window must be zero or a page64-aligned complete TopK window")
+        self.cache_options()
+        import math
+        if (isinstance(self.cache_capacity_multiplier, bool)
+                or not math.isfinite(self.cache_capacity_multiplier)
+                or self.cache_capacity_multiplier <= 0):
+            raise ValueError("Cache capacity multiplier must be finite and positive")
+        if self.enabled and self.cache_capacity_multiplier < 3:
+            raise ValueError("Three native verify rows require at least three TopK histories per request")
+        if self.device_cache_budget_bytes is not None and (
+                type(self.device_cache_budget_bytes) is not int
+                or self.device_cache_budget_bytes <= 0):
+            raise ValueError("An explicit device cache budget must be a positive byte count")
+
+    def cache_options(self):
+        from ulacache.cache_config import CacheOptions
+
+        return CacheOptions(cpu_offload=self.cpu_offload,
+            cpu_slots=self.cpu_slots, cpu_ratio=self.cpu_ratio,
+            prefetch=self.prefetch,
+            local_eviction_policy=self.local_eviction_policy,
+            host_exchange_blocks=self.host_exchange_blocks,
+            host_exchange_threads=self.host_exchange_threads,
+            host_parallel_finish=self.cpu_offload,
+            host_parallel_victims=self.cpu_offload,
+            low_query_pull_blocks=self.low_query_pull_blocks)
+
+
+def read_configuration(path):
+    value = json.loads(Path(path).read_text())
+    if not isinstance(value, dict) or value.pop("schema_version", None) != 1:
+        raise ValueError("Expected owner-TP configuration schema version 1")
+    return OwnerTPConfiguration(**value)
+
+
+def configure(configuration):
+    global _configuration
+    if not isinstance(configuration, OwnerTPConfiguration):
+        raise TypeError("Expected OwnerTPConfiguration")
+    if _configuration is not None and _configuration != configuration:
+        raise RuntimeError("A different owner-TP configuration is already installed")
+    _configuration = configuration
+
+
+def configuration():
+    global _configuration
+    if _configuration is None:
+        path = os.environ.get(CONFIGURATION_ENV)
+        if not path:
+            configure(OwnerTPConfiguration())
+        else:
+            configure(read_configuration(path))
+    return _configuration
+
+
+class _View:
+    """Read-only adapter fields without mutating native runtime dataclasses."""
+
+    def __init__(self, original, **fields):
+        self._original, self._fields = original, fields
+
+    def __getattr__(self, name):
+        if name in self._fields:
+            return self._fields[name]
+        return getattr(self._original, name)
+
+
+def get_memory():
+    from sglang.srt.runtime_context import get_memory as native
+
+    cfg = configuration()
+    return _View(native(), enable_flowkv=cfg.enabled,
+        enable_flowkv_cpu_offload=cfg.cpu_offload,
+        flowkv_cpu_slots=cfg.cpu_slots, flowkv_cpu_ratio=cfg.cpu_ratio,
+        flowkv_cpu_policy="index", enable_flowkv_prefetch=bool(cfg.prefetch),
+        enable_flowkv_fused_topk=False, enable_flowkv_cp_prefill=False,
+        flowkv_prefill_window_rows=cfg.prefill_window_rows)
+
+
+def get_exec():
+    from sglang.srt.runtime_context import get_exec as native
+
+    value = native()
+    cfg = configuration()
+    return _View(value, kernel=_View(value.kernel,
+        dsa_decode_score_mode="cp" if cfg.enabled and cfg.index_sharding else "replicated"))
+
+
+def validate_native_context(kvc):
+    """Check the actual resolved target context before allocating storage."""
+    from sglang.srt.runtime_context import get_parallel, get_spec
+    from ulacache.speculative import LinearVerifyConfig
+
+    parallel, execution, spec = get_parallel(), get_exec(), get_spec()
+    if (parallel.tp_size != 8 or parallel.attn_tp_size != 8
+            or parallel.attn_dp_size != 1 or parallel.attn_cp_size != 1
+            or parallel.attn_dcp_size != 1 or parallel.pp_size != 1
+            or parallel.moe_ep_size != 1):
+        raise NotImplementedError("This binding requires TP8/EP1/DP1/CP1/DCP1/PP1")
+    if kvc.is_draft_worker or not kvc.use_mla_backend or kvc.is_hybrid_swa:
+        raise NotImplementedError("Owner-TP storage is a target-only native MLA pool")
+    from ulacache.storage.layout import NativeMLARecord
+    from sglang.srt.mem_cache.kv_cache_configurator import calculate_mla_kv_cache_dim
+
+    record = NativeMLARecord(configuration().native_kv_format,
+        latent_width=kvc.model_config.kv_lora_rank,
+        rope_width=kvc.model_config.qk_rope_head_dim)
+    record.validate_backends(execution.kernel.dsa_prefill_backend,
+                             execution.kernel.dsa_decode_backend)
+    actual_width = calculate_mla_kv_cache_dim(
+        model_config=kvc.model_config, kv_cache_dtype=kvc.kv_cache_dtype)
+    if actual_width != record.row_bytes:
+        raise ValueError("The actual native KV pool layout differs from its configured encoding")
+    if spec.speculative_algorithm is not None:
+        LinearVerifyConfig(algorithm=spec.speculative_algorithm,
+            steps=spec.speculative_num_steps, topk=spec.speculative_eagle_topk,
+            verify_tokens=spec.speculative_num_draft_tokens,
+            adaptive=spec.speculative_adaptive).validate()
+        if (spec.speculative_num_steps, spec.speculative_eagle_topk,
+                spec.speculative_num_draft_tokens) != (2, 1, 3):
+            raise ValueError("This owner-TP binding uses EAGLE steps2/topk1/verify3")
+    if execution.overlap.enable_two_batch_overlap:
+        raise NotImplementedError("Shared Index publication has no TBO lifetime")
+
+
+def _external_module(path_variable, hash_variable, module_name):
+    path = os.environ.get(path_variable)
+    expected = os.environ.get(hash_variable)
+    if not path and not expected:
+        return None
+    if not path or not expected or not Path(path).is_absolute():
+        raise ValueError("Bind the external startup helper with an absolute path and SHA256")
+    actual = hashlib.sha256(Path(path).read_bytes()).hexdigest()
+    if actual != expected:
+        raise ValueError("External startup helper SHA256 does not match")
+    if module_name in _external_modules:
+        previous_path, previous_sha, module = _external_modules[module_name]
+        if (previous_path, previous_sha) != (path, actual):
+            raise RuntimeError("A different external helper is already installed")
+        return module
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    _external_modules[module_name] = path, actual, module
+    return module
+
+
+def install_external_startup_observer():
+    """Load one explicitly bound observer before any model constructor."""
+    module = _external_module("GLM_THREEWAY_STARTUP_INSTALLER",
+        "GLM_THREEWAY_STARTUP_INSTALLER_SHA256", "_glm_threeway_startup_observer")
+    if module is not None:
+        module.bootstrap()
+
+
+def install():
+    """Require the exact private framework patch; never silently fall back."""
+    cfg = configuration()
+    if cfg.native_kv_format == 'scaled656':
+        from sglang.srt.ulacache.v0522_fp8_loading import install as install_fp8_loading
+
+        install_fp8_loading()
+    if cfg.enabled:
+        key = "UDCACHE_PLAIN_PREFILL_WINDOW_ROWS"
+        expected = str(cfg.prefill_window_rows)
+        if key in os.environ and os.environ[key] != expected:
+            raise ValueError("Plain prefill window environment and configuration disagree")
+        os.environ[key] = expected
+        if cfg.prefill_window_rows == 1048576:
+            from sglang.srt.ulacache.shared_prefill_admission import install as install_admission
+            install_admission()
+    budget = _external_module("GLM_THREEWAY_NATIVE_BUDGET_HELPER",
+        "GLM_THREEWAY_NATIVE_BUDGET_HELPER_SHA256", "_glm_threeway_native_budget")
+    if cfg.enabled:
+        from sglang.srt.mem_cache.flowkv_v0522_context import FRAMEWORK_BINDING
+
+        if FRAMEWORK_BINDING != FRAMEWORK_COMMIT:
+            raise RuntimeError("The version-pinned owner-TP framework patch is missing")
+    elif budget is not None:
+        budget.install_native_budget_sizing()
+    install_external_startup_observer()
+
+
+def owner_pool_available_bytes(kvc, available_bytes):
+    """Give the original owner-pool solver the shared actual-weight budget."""
+    from types import SimpleNamespace
+    from sglang.srt.runtime_context import get_parallel
+
+    helper = _external_module("GLM_THREEWAY_NATIVE_BUDGET_HELPER",
+        "GLM_THREEWAY_NATIVE_BUDGET_HELPER_SHA256", "_glm_threeway_native_budget")
+    if not configuration().enabled or kvc.is_draft_worker:
+        raise RuntimeError("Only the explicitly configured target owner pool uses this budget")
+    if helper is None:
+        declared = configuration().device_cache_budget_bytes
+        if declared is None:
+            return available_bytes
+        if declared > available_bytes:
+            raise ValueError("The explicit cache budget exceeds native available pool memory")
+        return declared
+    rank = get_parallel().tp_rank
+    snapshot = helper.runner_snapshot(SimpleNamespace(model=kvc.model,
+        token_to_kv_pool=None, gpu_id=kvc.gpu_id, is_draft_worker=False, tp_rank=rank),
+        phase="before_owner_pool")
+    union = helper.merge_intervals(snapshot["storage"])
+    weights = sum(row["bytes"] for row in union if row["device"].startswith("cuda:"))
+    residual = 272_000_000_000 - weights - 1_500_000_000 - 128_000_000
+    if residual <= 0 or residual > available_bytes:
+        raise ValueError("The declared owner-pool budget does not fit actual available GPU memory")
+    directory = Path(os.environ["GLM_NATIVE_BUDGET_DIR"])
+    directory.mkdir(parents=True, exist_ok=True)
+    calls = list(directory.glob(f"owner.rank{rank}.call*.json"))
+    path = directory / f"owner.rank{rank}.call{len(calls):03d}.json"
+    path.open("x").write(json.dumps(dict(pid=snapshot["pid"],
+        start_ticks=snapshot["start_ticks"], rank=rank,
+        model_gpu_bytes=weights, target_model_storage=union,
+        actual_available_pool_bytes=int(available_bytes), pool_solver_budget_bytes=residual,
+        gpu_target_bytes=272_000_000_000, draft_weight_reserve_bytes=1_500_000_000,
+        post_graph_metadata_reserve_bytes=128_000_000,
+        final_actual_ready_inventory_required=True), indent=2)+"\n")
+    return residual
