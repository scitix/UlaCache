+++ b/python/sglang/srt/ulacache/standalone_cache_binding.py
@@ -0,0 +1,39 @@
+"""Translate native MLA geometry into UlaCache's independent startup contract."""
+
+from ulacache import (
+    KeyValueRecordPlane, KeyValueStorageLayout, LayerReuseSpecification,
+    MemoryTierCapacity, LocalCacheBindings, SparseAccessSpecification,
+    UnifiedCacheSpecification, PositionShardBindings, init,
+)
+
+
+def create_native_latent_attention_cache(
+    *, layer_selection_owners, bytes_per_record, records_per_page,
+    device_record_capacity, host_record_capacity, maximum_padded_query_count,
+    maximum_selected_records, maximum_write_record_count,
+    maximum_prefill_union_record_count, device, allocate_host_record_storage,
+    compile_device_module, execution_options, position_layout=None,
+):
+    native_encoding, bytes_per_segment = {
+        576: ("mla.raw576.fp8.v1", (512, 64)),
+        656: ("mla.scaled656.fp8.v1", (528, 128)),
+    }[bytes_per_record]
+    cache_specification = UnifiedCacheSpecification(
+        storage_layout=KeyValueStorageLayout(
+            name="sparse_history",
+            record_planes=(KeyValueRecordPlane("key_value", native_encoding, bytes_per_segment),),
+            records_per_page=records_per_page,
+        ),
+        layer_reuse=LayerReuseSpecification.from_shared_sparse_selection(layer_selection_owners),
+        sparse_access=SparseAccessSpecification(maximum_padded_query_count, maximum_selected_records),
+        capacity_plan=MemoryTierCapacity(
+            device_record_capacity, host_record_capacity, maximum_write_record_count,
+            reserved_logical_record_count=records_per_page,
+            maximum_prefill_union_record_count=maximum_prefill_union_record_count,
+        ),
+    )
+    arguments = dict(device=device, allocate_host_record_storage=allocate_host_record_storage,
+        compile_device_module=compile_device_module, execution_options=execution_options)
+    cache_bindings = (LocalCacheBindings(**arguments) if position_layout is None else
+        PositionShardBindings(**arguments, position_layout=position_layout))
+    return init(cache_specification, cache_bindings)
diff --git a/python/sglang/srt/ulacache/tensor_parallel_draft_index.py b/python/sglang/srt/ulacache/tensor_parallel_draft_index.py
