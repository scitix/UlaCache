+++ b/python/sglang/srt/ulacache/unified_local_snapshot_adapter.py
@@ -0,0 +1,142 @@
+"""Restore native DPA requests through explicit UlaCache sequence byte IO."""
+import json
+import os
+from pathlib import Path
+import time
+
+
+def install(config):
+    import torch
+    from sglang.srt.managers.scheduler import Scheduler
+    from sglang.srt.managers.schedule_batch import NextBatchPlan
+    from sglang.srt.model_executor.model_runner import ModelRunner
+    from sglang.srt.runtime_context import get_parallel
+    from ulacache.tools import SnapshotReader
+    from ulacache.tools.snapshot.restore import iter_sequence_plane, write_index_records
+    from ulacache.tools.snapshot.restore import write_sequence_records
+
+    original_prefill, original_forward = Scheduler.get_new_batch_prefill, ModelRunner.forward
+    reader = None
+    state = dict(cohort=0, prefill=0, decode=0, graph=0, active=False)
+
+    def report(kind, value):
+        root = Path(config["receipts"])
+        root.mkdir(parents=True, exist_ok=True)
+        path = root / f"{kind}.cohort{state['cohort']:06d}.rank{torch.distributed.get_rank()}.json"
+        tmp = path.with_suffix(".tmp")
+        tmp.write_text(json.dumps(value, indent=2) + "\n")
+        tmp.replace(path)
+
+    def prefill(scheduler, running_batch):
+        nonlocal reader
+        waiting = scheduler.waiting_queue
+        if not waiting:
+            return original_prefill(scheduler, running_batch)
+        if reader is None:
+            reader = SnapshotReader(config["path"])
+            if reader.layout.model_fingerprint != config["model_fingerprint"] or reader.layout.mla_row_bytes != 576:
+                raise ValueError("B300 unified loader requires matching raw576 snapshot")
+        parallel = get_parallel()
+        params = [req.sampling_params.custom_params or {} for req in waiting]
+        sizes = {p["udcache_snapshot_batch"] for p in params}
+        assert len(sizes) == 1
+        total = sizes.pop()
+        target = len(range(parallel.attn_dp_rank, total, parallel.attn_dp_size))
+        if len(waiting) < target:
+            return NextBatchPlan(batch_to_run=None, running_batch=running_batch)
+        assert len(waiting) == target and running_batch.is_empty()
+        assert total <= config["batch"]
+        state.update(cohort=state["cohort"] + 1, prefill=0, decode=0, graph=0, active=False)
+        selected = {p["udcache_snapshot_key"]: req for req, p in zip(waiting, params)}
+        saved = [req for req in reader.requests if req.key in selected]
+        assert len(saved) == target
+        allocator = scheduler.token_to_kv_pool_allocator
+        pool = allocator.get_kvcache()
+        cache = pool.udcache_local
+        assert pool.layer_num == reader.layout.layers
+        started, checked, unused_index_bytes = time.monotonic(), 0, 0
+        torch.cuda.synchronize()
+        native_requests = [selected[r.key] for r in saved]
+        assert scheduler.req_to_token_pool.alloc(native_requests) is not None
+        allocations = []
+        try:
+            for request in saved:
+                req = selected[request.key]
+                assert tuple(req.origin_input_ids) == request.input_ids
+                assert request.next_position % allocator.page_size == 0
+                assert not req.return_logprob and not req.is_dllm()
+                rows = allocator.alloc(request.next_position)
+                if rows is None:
+                    raise RuntimeError("Saved history exceeds independent DPA logical capacity")
+                allocations.append((req, rows))
+                scheduler.req_to_token_pool.req_to_token[req.kv.req_pool_idx, :len(rows)] = rows
+                req.kv.kv_allocated_len = req.kv.kv_committed_len = request.next_position
+                req.output_ids.extend(request.generated_ids)
+                req.full_untruncated_fill_ids = req.origin_input_ids + req.output_ids
+                req.prefix_len, req.extend_end = 0, request.next_position
+                for plane in reader.layout.planes():
+                    layer = int(plane.rsplit("_", 1)[1])
+                    for start, data in iter_sequence_plane(reader, request.key, plane):
+                        if plane.startswith("index_") and not pool.index_key_cache.buffer[layer].numel():
+                            # Native shared-TopK followers have no Index bank.
+                            # Consume and checksum their canonical streams but
+                            # restore only the native banks used by scoring.
+                            unused_index_bytes += data.numel()
+                            checked += data.numel()
+                            continue
+                        if plane.startswith("mla_"):
+                            write_sequence_records(cache, layer,
+                                rows[start:start + len(data)], data,
+                                verify=config.get("verify_restored", False))
+                        else:
+                            write_index_records(pool.index_key_cache.buffer[layer],
+                                rows[start:start + len(data)], data)
+                            if config.get("verify_restored"):
+                                target_buf = pool.index_key_cache.buffer[layer]
+                                loc = rows[start:start + len(data)].long()
+                                pieces, native_start = [], 0
+                                for width in reader.layout.index_segment_bytes:
+                                    columns = native_start + (loc % 64)[:, None] * width + torch.arange(width, device=loc.device)
+                                    pieces.append(target_buf[(loc // 64)[:, None], columns].cpu())
+                                    native_start += 64 * width
+                                assert torch.equal(torch.cat(pieces, dim=1), data)
+                        checked += data.numel()
+                torch.cuda.synchronize()
+
+        except BaseException:
+            # The service fails explicitly before publishing a partial cohort.
+            # Native owned-controller cleanup releases all allocations.
+            report("restore_failed", dict(published=False, prepared_requests=len(allocations)))
+            raise
+        scheduler.waiting_queue = []
+        batch = scheduler._build_hisparse_decode_batch(native_requests)
+        batch.prepare_for_decode()
+        batch.can_run_decode_cuda_graph = True
+        batch.is_extend_in_batch = False
+        state["active"] = True
+        report("restore", dict(model_prefill_forwards=0, checked_bytes=checked,
+            checksummed_unused_index_bytes=unused_index_bytes,
+            restored_bytes_verified=config.get("verify_restored", False),
+            request_keys=[r.key for r in saved], history_tokens=[r.next_position for r in saved],
+            seconds=time.monotonic() - started, native_entry="Shared native decode batch builder, independent DPA GPU/CPU restore",
+            actual_local_bs=target, global_bs=total))
+        return NextBatchPlan(batch_to_run=batch, running_batch=batch)
+
+    def forward(runner, batch, *args, **kwargs):
+        if state["active"] and not torch.cuda.is_current_stream_capturing() and batch.forward_mode.is_extend():
+            raise RuntimeError("Snapshot load attempted a model prefill forward")
+        result = original_forward(runner, batch, *args, **kwargs)
+        if state["active"] and batch.forward_mode.is_decode() and not torch.cuda.is_current_stream_capturing():
+            state["decode"] += 1
+            state["graph"] += int(bool(getattr(result, "can_run_graph", False)))
+            if state["decode"] == 1:
+                report("first_decode", dict(model_prefill_forwards=0, actual_bs=int(batch.batch_size),
+                    cuda_graph=bool(getattr(result, "can_run_graph", False)), forward_mode=batch.forward_mode.name))
+            # Passive completion proof; normal sequential forwards continue.
+            if state["decode"] == 1023:
+                report("decode_complete", dict(model_prefill_forwards=0, actual_bs=int(batch.batch_size),
+                    decode_calls=state["decode"], cuda_graph_calls=state["graph"]))
+        return result
+
+    Scheduler.get_new_batch_prefill = prefill
+    ModelRunner.forward = forward
