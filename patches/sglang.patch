+            raise ValueError('Native Index transport must be flash_ag or nccl')
+        if type(self.prefill_buffer_records) is not int or self.prefill_buffer_records < 0:
+            raise ValueError('Prefill buffer records must be a nonnegative integer')
+        if type(self.prefill_query_chunk) is not int or self.prefill_query_chunk < 1:
+            raise ValueError('Prefill query chunk must be a positive integer')
+        if type(self.prefill_buffer_prefetch) is not bool:
+            raise ValueError('Prefill buffer prefetch must be boolean')
+        if type(self.use_shared_tensor_parallel_cache) is not bool:
+            raise ValueError('Shared tensor-parallel cache selection must be boolean')
+        if type(self.low_query_pull_blocks) is not int or self.low_query_pull_blocks < 0:
+            raise ValueError('Low-query pull blocks must be a nonnegative integer')
+
