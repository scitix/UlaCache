--- /dev/null
+++ b/python/sglang/srt/mem_cache/flowkv_owner_index.py
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One stable GPU Index key per owner-striped logical KV identity."""
+
+from contextlib import nullcontext
+
+import torch
+import torch.distributed as dist
+
+from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+from sglang.srt.mem_cache.flowkv_peer import FlowKVPeerShards
+from sglang.srt.mem_cache.index_key_cache import IndexKeyCache
+from sglang.srt.mem_cache.flowkv_v0522_context import get_parallel
+
+
+class FlowKVOwnerIndexCache(IndexKeyCache):
+    """Index lifetime is the native allocator's lifetime, with no second allocator.
+
+    native_loc % degree selects the owner and native_loc // degree selects its
+    compact Index row. Index-policy CPU residency changes only the KV address. Request-policy
+    residency moves this complete native Index page with its MLA superpage;
+    logical rows and their owning ranks remain unchanged. Each owner retains the
+    native 64*132-byte page ABI. Allocation
+    uses superpages of 64*degree native slots so decode can use native paged MQA.
+    """
+
+    is_owner_compact = True
+
+    def __init__(self, pool, index_buf_size: int):
+        self.pool = pool
+        self.request_tier = getattr(pool, "flowkv_request", None)
+        self.page_map = self.request_tier.page_map if self.request_tier is not None else None
+        self.degree = pool._flowkv_storage_size
+        self.rank = pool.flowkv_rank
+        group = get_parallel().tp_group
+        if (
+            torch.device(pool.device).type != "cuda"
+            or pool.page_size != 64 or pool.index_page_size != 64
+            or pool.index_head_dim != 128 or pool.quant_block_size != 128
+            or pool.index_kpool != 1 or pool.index_kpool_compress
+            or pool.index_k_with_scale_buffer_dtype != torch.uint8
+            or pool._flowkv_namespaces != 1
+            or self.degree < 2 or self.degree & (self.degree - 1)
+            or not 0 <= self.rank < self.degree
+            or group.world_size != self.degree or group.rank_in_group != self.rank
+            or index_buf_size != getattr(pool, "flowkv_index_native_size", pool.size)
+        ):
+            raise ValueError("Owner Index requires ordinary page64 TP Index storage")
+        self.native_rows = index_buf_size + pool.page_size
+        self.owner_pages = (self.native_rows + self.degree * 64 - 1) // (self.degree * 64)
+        self.storage_pages = (self.request_tier.gpu_page_count
+                              if self.request_tier is not None else self.owner_pages)
+        self._anchors = {}
+        for local, skip in enumerate(pool.skip_topk_layers):
+            if not skip:
+                self._anchors[pool.start_layer + local] = len(self._anchors)
+        if not self._anchors:
+            raise ValueError("Owner Index requires at least one Index anchor")
+        if self.request_tier is not None:
+            local_anchors = tuple(layer - pool.start_layer for layer in self._anchors)
+            if local_anchors != self.request_tier.anchors:
+                raise ValueError("Request physical Index anchors disagree with the native layer plan")
+        with pool.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+            with (
+                torch.cuda.use_mem_pool(pool.custom_mem_pool)
+                if pool.custom_mem_pool else nullcontext()
+            ):
+                self.storage = torch.zeros(
+                    (len(self._anchors), self.storage_pages, 8448),
+                    dtype=torch.uint8, device=pool.device,
+                )
+                self._prefill_ready_token = torch.zeros(1, dtype=torch.int32, device=pool.device)
+        if self.request_tier is not None:
+            self.request_tier.bind_index_storage(self.storage)
+        empty = self.storage[:0].view(0, 8448)
+        self.buffer = [
+            self.storage[self._anchors[pool.start_layer + local]] if not skip else empty
+            for local, skip in enumerate(pool.skip_topk_layers)
+        ]
+        self.peers = FlowKVPeerShards(self.storage, group.cpu_group)
+        self._device_group = group.device_group
+        self._closed = False
+
+    def _anchor(self, layer_id: int) -> int:
+        if layer_id not in self._anchors:
+            raise ValueError("The requested layer does not own Index keys")
+        return self._anchors[layer_id]
+
+    def _ready(self, forward_batch) -> None:
+        from ulacache.speculative import is_cache_step
+
+        if not is_cache_step(forward_batch.forward_mode):
+            # The stream-ordered NCCL task follows every owner's native store.
+            # Its completion precedes remote prefill loads. This is a data
+            # dependency, not a CPU barrier or the writer's early PDL trigger.
+            dist.all_reduce(self._prefill_ready_token, group=self._device_group)
+
+    def store_key(self, layer_id, key, loc, forward_batch) -> None:
+        from sglang.kernels.ops.attention.fused_store_index_cache import fused_store_owner_index_k_cache
+
+        self._anchor(layer_id)
+        fused_store_owner_index_k_cache(
+            key, self.get_local_buffer(layer_id), loc,
+            degree=self.degree, rank=self.rank, page_map=self.page_map,
+        )
+        self._ready(forward_batch)
+
+    def store_key_norm_rope(
+        self, layer_id, key_raw, loc, normweights, normbias, eps,
+        cos_sin, positions, forward_batch,
+    ) -> None:
+        from sglang.kernels.ops.attention.dsa.indexer_k import fused_k_indexer_norm_rope_store
+
+        self._anchor(layer_id)
+        fused_k_indexer_norm_rope_store(
+            key_raw, self.get_local_buffer(layer_id), loc,
+            normweights, normbias, eps, cos_sin, positions, 64,
+            owner_degree=self.degree, owner_rank=self.rank, owner_page_map=self.page_map,
+        )
+        self._ready(forward_batch)
+
+    def get_k_and_scale(
+        self, layer_id, seq_len_tensor, page_indices, seq_len_sum, max_seq_len,
+    ):
+        from sglang.kernels.ops.attention.dsa.owner_index_cache import gather_owner_index
+
+        self.get_local_buffer(layer_id)  # Preserve the native layer-transfer wait.
+        return gather_owner_index(
+            self.peers.ptrs, page_indices, seq_len_tensor,
+            degree=self.degree, anchor=self._anchor(layer_id),
+            owner_pages=self.storage_pages, native_rows=self.native_rows,
+            page_map=self.page_map,
+            seq_len_sum=seq_len_sum, max_seq_len=max_seq_len,
+        )
+
+    def capacity_audit(self) -> dict:
+        audit = {
+            "degree": self.degree, "rank": self.rank,
+            "native_rows": self.native_rows, "owner_pages": self.owner_pages,
+            "owner_rows": self.owner_pages * 64, "anchor_layers": list(self._anchors),
+            "page_bytes": 8448, "storage_shape": list(self.storage.shape),
+            "storage_nbytes": self.storage.nbytes,
+            "layer_view_nbytes": sum(buf.nbytes for buf in self.buffer),
+            "peer_ptr_nbytes": self.peers.ptrs.nbytes,
+            "ready_token_nbytes": self._prefill_ready_token.nbytes,
+            "allocation_page_size": self.pool.allocation_page_size,
+        }
+        if self.request_tier is not None:
+            audit["request_tier"] = self.request_tier.capacity_audit()
+            audit["physical_owner_pages"] = self.storage_pages
+        if self.pool.flowkv_host is not None:
+            audit["cpu_tier"] = self.pool.flowkv_host.capacity_audit()
+        return audit
+
+    def store_quantized(self, *args, **kwargs) -> None:
+        raise NotImplementedError("Owner Index requires its original fused quant/store entry")
+
+    def move(self, *args, **kwargs) -> None:
+        raise NotImplementedError("Owner Index does not support relocating live native slots")
+
+    def cpu_copy(self, *args, **kwargs):
+        raise NotImplementedError("Owner Index CPU offload is not supported")
+
+    def load_cpu_copy(self, *args, **kwargs) -> None:
+        raise NotImplementedError("Owner Index CPU offload is not supported")
+
+    def close(self) -> None:
+        if not self._closed:
+            self.peers.close()
+            self._closed = True
+
+    def clear(self) -> None:
+        self.close()
+        del self.buffer, self.storage, self.peers, self._prefill_ready_token
