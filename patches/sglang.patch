+
+    def _pages(self, indices):
+        import torch
+        return torch.unique(indices.to(torch.int64) // self.page_size).cpu().tolist()
+
+    def _rows(self, pages):
+        import torch
+        heads = torch.tensor(list(pages), dtype=torch.int64, device=self.device)
+        lane = torch.arange(self.page_size, dtype=torch.int64, device=self.device)
