index 0000000000000000000000000000000000000000..3ca5a68b7d6a5cdf65268fd2e2e19a4ab8d49fc4
--- /dev/null
+++ b/python/sglang/srt/ulacache/pd_owner_receive_bindings.py
@@ -0,0 +1,126 @@
+"""Explicit native owner-pool bindings, not an automatic serving installation.
+
+The native host tier supplies the actual peer-reader/prefetch drain. Bounded
+factory/RDMA/graph and whole-model acceptance are required before activation.
+"""
+from types import SimpleNamespace
+
+
+def _native_index_banks(pool):
+    banks = list(pool.index_key_cache.buffer)
+    original = pool.get_state_buf_infos()
+    if (len(banks) != pool.layer_num or tuple(original[0]) != tuple(bank.data_ptr() for bank in banks)
+            or tuple(original[1]) != tuple(bank.nbytes for bank in banks)
+            or tuple(original[2]) != tuple(8448 if bank.numel() else 0 for bank in banks)):
+        raise ValueError('Native Index registration differs from canonical layer-aligned banks')
+    owned = [index for index, bank in enumerate(banks) if bank.numel()]
+    return banks, owned
+
+
+def _index_banks_and_layer_getter(window, pool, name, *, replicated):
+    banks, owned = _native_index_banks(pool)
+    getter = window.add_index_page_banks(name, [banks[index] for index in owned],
+                                       replicated=replicated)
+
+    def aligned_infos():
+        compact = getter()
+        result = [[0] * pool.layer_num for _ in range(3)]
+        for position, index in enumerate(owned):
+            for field in range(3):
+                result[field][index] = compact[field][position]
+        return tuple(result)
+
+    return aligned_infos
+
+
+def bind_native_owner_receive_storage(pool, *, record_capacity,
+        allocate_host_record_storage, drain_native_readers=None, copy_chunk_records=4096):
+    """View existing native owner tensors; allocate only bounded receive staging."""
+    from ulacache.transfer.owner_index_receive import OwnerIndexRecordReceiveWindow
+
+    host, index = pool.flowkv_host, pool.index_key_cache
+    if drain_native_readers is None:
+        drain_native_readers = getattr(host, 'drain_readers', None)
+    if (host is None or pool.flowkv_request is not None
+            or pool._flowkv_namespaces != 1 or pool.page_size != 64
+            or pool.allocation_page_size != 64 * pool._flowkv_storage_size
+            or not getattr(index, 'is_owner_compact', False)
+            or index.degree != pool._flowkv_storage_size or index.rank != pool.flowkv_rank
+            or not callable(drain_native_readers)
+            or getattr(pool, 'pd_receive_window', None) is not None):
+        raise ValueError('Native owner receive binding requires an unbound ordinary page64 TP host tier')
+    if (tuple(pool.flowkv_shards.shape) != (
+            pool.layer_num, host.gpu_slots, pool.flowkv_layout.row_bytes)
+            or tuple(host.host.storage.shape) != (
+                pool.layer_num, host.host_slots, pool.flowkv_layout.row_bytes)
+            or host.logical_slots != host.gpu_slots + host.host_slots
+            or host.logical_slots * index.degree != pool._flowkv_global_rows):
+        raise ValueError('Native owner tensor views disagree with the residency geometry')
+    _native_index_banks(pool)
+    engine = SimpleNamespace(gpu=pool.flowkv_shards, host=host.host,
+        directory=host.directory, groups=host.groups,
+        gpu_slots=host.gpu_slots, host_slots=host.host_slots,
+        row_bytes=pool.flowkv_layout.row_bytes, _drain_transfers=drain_native_readers)
+    cache = SimpleNamespace(_execution_engine=engine,
+        cache_specification=SimpleNamespace(storage_layout=SimpleNamespace(records_per_page=64)))
+    window = OwnerIndexRecordReceiveWindow(cache, degree=index.degree, rank=index.rank,
+        record_capacity=record_capacity, allocate_host_record_storage=allocate_host_record_storage,
+        device=pool.device, copy_chunk_records=copy_chunk_records)
+    state_infos = _index_banks_and_layer_getter(window, pool, 'native_target_index', replicated=False)
+    pool.pd_receive_window = window
+    pool.get_contiguous_buf_infos = window.contiguous_buffer_infos
+    pool.get_state_buf_infos = state_infos
+    return window
+
+
+def bind_native_owner_draft_receive(pool, draft):
+    """Retain the replicated native draft KV/Index layer identities and lease."""
+    window = pool.pd_receive_window
+    if (getattr(draft, '_ulacache_pd_receive_window', None) is not None
+            or getattr(draft.index_key_cache, 'is_owner_compact', False)
+            or draft.page_size != 64):
+        raise ValueError('Native draft receive binding requires an unbound replicated page64 pool')
+    banks = list(draft.kv_buffer)
+    original = draft.get_contiguous_buf_infos()
+    if (list(original[0]) != [bank.data_ptr() for bank in banks]
+            or list(original[1]) != [bank.nbytes for bank in banks]):
+        raise ValueError('Native draft registration differs from canonical KV banks')
+    state_infos = _index_banks_and_layer_getter(window, draft, 'native_draft_index', replicated=True)
+    kv_infos = window.add_sidecar_record_banks('native_draft', banks, page_size=64)
+    draft._ulacache_pd_receive_window = window
+    draft.get_contiguous_buf_infos = kv_infos
+    draft.get_state_buf_infos = state_infos
+
+
+def native_index_receive_state_indices(window, room, state_indices, *, dsa_state_index, prefix_tokens):
+    """Preserve native state ordering while routing DSA suffix pages to the lease."""
+    import numpy as np
+    from ulacache.transfer.receive_window import incremental_receive_state_pages
+
+    if type(dsa_state_index) is not int or not 0 <= dsa_state_index < len(state_indices):
+        raise ValueError('Native DSA state index is outside the registered state table')
+    canonical = state_indices[dsa_state_index]
+    if not isinstance(canonical, np.ndarray) or canonical.ndim != 1 or canonical.dtype != np.int32:
+        raise ValueError('Native DSA state metadata requires a one-dimensional int32 page table')
+    result = list(state_indices)
+    mapped = incremental_receive_state_pages(canonical.tolist(), window.transfer_pages(room),
+        prefix_tokens=prefix_tokens, page_size=window.page_size)
+    result[dsa_state_index] = np.asarray(mapped, dtype=np.int32)
+    return result
+
+
+def retire_native_owner_receive_pages(pool, allocation_page_ids, *, transport_quiesced):
+    """Return a common receive lease only after native remote-write retirement."""
+    from ulacache.transfer.receive_window import transfer_pages_from_retired_allocation_pages
+
+    if transport_quiesced is not True:
+        raise RuntimeError('Native remote writes must retire before receive-page reuse')
+    window = getattr(pool, 'pd_receive_window', None)
+    if (window is None or window.degree != pool._flowkv_storage_size
+            or window.rank != pool.flowkv_rank or window.page_size != pool.page_size
+            or pool.allocation_page_size != window.degree * window.page_size):
+        raise ValueError('Native allocation and receive ownership geometry disagree')
+    pages = transfer_pages_from_retired_allocation_pages(allocation_page_ids,
+        allocation_page_size=pool.allocation_page_size, transfer_page_size=window.page_size)
+    window.logical_pages_freed(pages)
+    return len(pages)
diff --git a/python/sglang/srt/ulacache/pd_record_adapter.py b/python/sglang/srt/ulacache/pd_record_adapter.py
