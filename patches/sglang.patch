index 0000000000000000000000000000000000000000..37dd17131c0685f165046606f22cbaf5a7733bb4
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_capacity_inventory.py
@@ -0,0 +1,71 @@
+"""Summarize actual owner partitions with the common history-capacity contract."""
+
+import hashlib
+
+
+def summarize_native_sparse_cache_capacity(inventories, policy):
+    from ulacache import (
+        KeyValueRecordPlane, KeyValueStorageLayout, RecordOwnerCapacity,
+        RequiredCachePartitionCapacity, RequestNamespaceCapacityBounds,
+        calculate_addressable_history_capacity,
+    )
+
+    by_rank = {value['rank']: (raw, value) for raw, value in inventories}
+    partitions, bounds = [], []
+    declared = policy['allocation_plan']
+    for namespace in policy['request_namespaces']:
+        members = [by_rank[rank][1] for rank in namespace['process_ranks']]
+        distributions = [member['record_distribution'] for member in members]
+        assert all(value['kind'] == 'native_sparse_cache_partitions' for value in distributions)
+        names = set(distributions[0]['required_partitions'])
+        assert all(set(value['required_partitions']) == names for value in distributions)
+        groups = namespace.get('required_owner_groups', {'': namespace['process_ranks']})
+        grouped_ranks = [rank for ranks in groups.values() for rank in ranks]
+        assert sorted(grouped_ranks) == sorted(namespace['process_ranks'])
+        assert len(grouped_ranks) == len(set(grouped_ranks))
+        for group_name, group_ranks in groups.items():
+            group_members = [by_rank[rank][1] for rank in group_ranks]
+            for name in sorted(names):
+                rows = [member['record_distribution']['required_partitions'][name] for member in group_members]
+                for row in rows:
+                    if row.get('storage_owner_process_ranks') is not None:
+                        assert row['storage_owner_process_ranks'] == group_ranks
+                count = rows[0]['storage_owner_count']
+                assert count == declared['storage_owner_count'] == len(group_members)
+                assert {row['storage_owner_rank'] for row in rows} == set(range(count))
+                assert all(row['storage_layout'] == rows[0]['storage_layout'] for row in rows)
+                storage = dict(rows[0]['storage_layout'])
+                storage['record_planes'] = tuple(KeyValueRecordPlane(**plane) for plane in storage['record_planes'])
+                layout = KeyValueStorageLayout(**storage)
+                for row in rows:
+                    assert row['storage_owner_count'] == count
+                    assert row['device_record_capacity_per_owner'] * layout.tokens_per_record == declared['device_token_capacity_per_owner']
+                    assert row['host_record_capacity_per_owner'] * layout.tokens_per_record == declared['host_token_capacity_per_owner']
+                    assert row['reserved_logical_record_count'] == rows[0]['reserved_logical_record_count']
+                    banks = row['physical_storage_bank_count']
+                    assert row['device_cold_payload_bytes'] == banks * layout.calculate_storage_bytes(row['device_record_capacity_per_owner'])
+                    assert row['host_cold_payload_bytes'] == banks * layout.calculate_storage_bytes(row['host_record_capacity_per_owner'])
+                owners = tuple(RecordOwnerCapacity(row['storage_owner_rank'],
+                    row['device_record_capacity_per_owner'], row['host_record_capacity_per_owner']) for row in rows)
+                partitions.append(RequiredCachePartitionCapacity(namespace['request_namespace_id'],
+                    f'{group_name}/{name}' if group_name else name, layout, owners, rows[0]['reserved_logical_record_count']))
+        allocator_slots = min(member['pool_fields']['logical_allocator_size'] for member in members)
+        address_slots = min(member['pool_fields']['native_request_slots'] for member in members) * policy['context_length']
+        assert all(member['pool_fields']['request_address_token_slots'] >= address_slots for member in members)
+        assert all(value['allocator_usable_history_token_slots'] == allocator_slots for value in distributions)
+        bounds.append(RequestNamespaceCapacityBounds(namespace['request_namespace_id'], allocator_slots, address_slots))
+    report = calculate_addressable_history_capacity(partitions, bounds)
+    for rank, (_, inventory) in by_rank.items():
+        actual_partitions = inventory['record_distribution']['required_partitions'].values()
+        assert inventory['gpu_pool_storage_bytes'] >= sum(row['device_cold_payload_bytes'] for row in actual_partitions)
+        assert inventory['cpu_pool_storage_bytes'] >= sum(row['host_cold_payload_bytes'] for row in actual_partitions)
+        for field, limit in policy['memory_limits_by_rank'][str(rank)].items():
+            assert inventory[field] <= limit, (rank, field, inventory[field], limit)
+        assert inventory['model_registered_storage_bytes'] == policy['model_registered_storage_bytes_by_rank'][str(rank)]
+    report.update(per_rank=[dict(rank=value['rank'], model_storage_bytes=value['model_storage_bytes'],
+        model_registered_storage_bytes=value['model_registered_storage_bytes'],
+        gpu_pool_storage_bytes=value['gpu_pool_storage_bytes'], cpu_pool_storage_bytes=value['cpu_pool_storage_bytes'],
+        cuda_allocated_bytes=value['cuda_allocated_bytes'], pool_fields=value['pool_fields'],
+        receipt_sha256=hashlib.sha256(raw).hexdigest()) for raw, value in inventories],
+        scope='Actual startup cold capacities, native layout byte checks, disjoint owner identities, allocator/request bounds and declared per-rank byte ceilings. Resident attention replicas and physical storage aliases do not add history. This does not establish maximum running concurrency, runtime peak, accuracy or comparative performance.')
+    return report
diff --git a/python/sglang/srt/ulacache/native_dpa_geometry_adapter.py b/python/sglang/srt/ulacache/native_dpa_geometry_adapter.py
