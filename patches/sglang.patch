+++ b/python/sglang/srt/ulacache/hisparse_prefix_adapter.py
@@ -0,0 +1,559 @@
+"""Native radix prefixes backed by the existing HiSparse logical host store.
+
+The radix tree owns logical IDs. Prefill borrows pages in the existing GPU
+pool; decode retains its native request-local hot buffer and speculative swap.
+No second host KV store or additional GPU payload bank is allocated.
+"""
+from __future__ import annotations
+
+import functools
+import types
+
+
+def bind_logical_pool_capacity_constructor(owner):
+    """Keep native logical counters and their conservation capacity in one unit.
+
+    HiSparse's scheduler model capacity describes physical GPU slots. Its
+    prefix allocator and radix tree instead count canonical host logical IDs.
+    Observer, invariant-checker and load-snapshot capacities must follow those
+    IDs; device residency keeps HiSparse's separate physical GPU statistics.
+    """
+    original = owner.__init__
+
+    @functools.wraps(original)
+    def initialize(instance, *args, **kwargs):
+        allocator = kwargs.get("token_to_kv_pool_allocator")
+        runtime = getattr(allocator, "_hisparse_prefix_runtime", None)
+        if runtime is not None:
+            kwargs = dict(kwargs, max_total_num_tokens=runtime.host_capacity)
+        return original(instance, *args, **kwargs)
+
+    owner.__init__ = initialize
+
+
+def bind_abort_prefix_release(scheduler_type):
+    """Retire request residency before native abort frees its logical suffix."""
+    original = scheduler_type._release_aborted_request
+
+    @functools.wraps(original)
+    def release(scheduler, req):
+        coordinator = getattr(scheduler, "hisparse_coordinator", None)
+        runtime = getattr(coordinator, "prefix_runtime", None)
+        if runtime is not None:
+            # Pending chunked-prefill aborts do not call request_finished().
+            # Keep the allocator's live-reader guard: finish only this
+            # request's leases while the native radix lock is still held.
+            runtime.finish(req)
+        return original(scheduler, req)
+
+    scheduler_type._release_aborted_request = release
+
+
+def prefix_budget_class(base):
+    """Keep native logical reservations and add a separate physical GPU limit."""
+    class PrefixBudget(base):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            self.physical_offset = 0
+            self.candidate = None
+
+        def _available_and_evictable(self):
+            # Radix eviction reclaims logical host IDs; it cannot create GPU
+            # hot pages because the cached prefixes already live in host memory.
+            return (self.allocator.logical_attn_allocator.available_size()
+                    + self.tree_cache.evictable_size())
+
+        def _physical_need(self, extend):
+            from ulacache.cache.prefill.leases import prefill_physical_tokens
+            runtime = self.allocator._hisparse_prefix_runtime
+            req = self.candidate
+            if req is None:
+                raise ValueError("HiSparse prefill budget needs its native candidate")
+            co = runtime.coordinator
+            held = len(runtime.leases.requests.get(runtime.key(req), ())) * self.page_size
+            total = req.prefix_len + extend
+            hot = min(self.ceil_paged_tokens(total), co.device_buffer_size)
+            if co.spec_swap.enabled or hot == co.device_buffer_size:
+                hot = co.padded_buffer_size
+            hot = max(hot - getattr(runtime, "pending_hot", {}).get(
+                runtime.key(req), 0), 0)
+            scratch = (co.spec_swap.scratch_capacity
+                       if req.kv.req_pool_idx is None else 0)
+            return prefill_physical_tokens(prefix_tokens=req.prefix_len,
+                held_prefix_tokens=held, extend_tokens=extend, hot_tokens=hot,
+                scratch_tokens=scratch, page_size=self.page_size)
+
+        def _physical_free(self):
+            pending = getattr(self.allocator._hisparse_prefix_runtime,
+                              "pending_hot", {})
+            return (self.allocator.hisparse_attn_allocator.available_size()
+                    - sum(pending.values()) - self.physical_offset)
+
+        def _fit_physical_chunk(self, extend, limit):
+            maximum = min(extend, limit) if limit is not None else extend
+            page = self.page_size
+            lo, hi = 0, -(-maximum // page)
+            free = self._physical_free()
+            while lo < hi:
+                mid = (lo + hi + 1) // 2
+                if self._physical_need(min(mid * page, maximum)) <= free:
+                    lo = mid
+                else:
+                    hi = mid - 1
+            if not lo:
+                return None
+            return min(lo * page, limit) if limit is not None else lo * page
+
+        def has_capacity(self):
+            return super().has_capacity() and self._physical_free() > 0
+
+        def check_prefill(self, **kwargs):
+            okay, limit = super().check_prefill(**kwargs)
+            if not okay:
+                return okay, limit
+            bound = self._fit_physical_chunk(kwargs['extend_input_len'], limit)
+            if bound is None:
+                return False, None
+            if bound >= self.ceil_paged_tokens(kwargs['extend_input_len']):
+                return True, limit
+            return True, bound
+
+        def can_allocate_prefill(self, **kwargs):
