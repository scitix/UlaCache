@@ -0,0 +1,33 @@
+"""Normal-startup binding for position-sharded DSA CPU expansion.
+
+Install before constructing native pools. The existing DPA environment keys
+describe PER-OWNER physical capacities; native DCP widens the allocator. This
+entry does not change model weights, Index math, attention math or collectives.
+"""
+
+
+def exchange_prefill_queries(group, output, input):
+    """Use the existing DCP send/receive backend for eager prefill as well.
+
+    PyNccl's equal-split interface takes flattened buffers. Its scoped state
+    remains unchanged for other framework collectives and profiling scopes.
+    """
+    from sglang.srt.layers.dcp.comm import dcp_all_to_all_single
+    dcp_all_to_all_single(output, input, group)
+
+
+def install(*, prefill_context_parallel=True):
+    import os
+    for key, value in {
+        "UDCACHE_DPA_PARALLEL_PREPARE": "1",
+        "UDCACHE_DPA_PARALLEL_VICTIMS": "1",
+        "UDCACHE_DPA_ASYNC_FOLLOWERS": "1",
+        "UDCACHE_DPA_EXCHANGE_BLOCKS": "64",
+        "UDCACHE_DPA_EXCHANGE_THREADS": "256",
+        "SGLANG_DSA_INDEX_COMM_BACKEND": "flashag",
+        "UDCACHE_INDEX_COMPACT_SCORES": "1",
+    }.items():
+        os.environ.setdefault(key, value)
+    from sglang.srt.ulacache.unified_local_adapter import install as install_local_pool
+    install_local_pool(position_sharded=True,
+        prefill_context_parallel=prefill_context_parallel)
diff --git a/python/sglang/srt/ulacache/context_parallel_attention.py b/python/sglang/srt/ulacache/context_parallel_attention.py
new file mode 100644
index 0000000000000000000000000000000000000000..689c49bf1e942612c6ffc8c71c4c71ecdbc493f4
--- /dev/null
+++ b/python/sglang/srt/ulacache/context_parallel_attention.py
@@ -0,0 +1,42 @@
+"""SGLang attention adapter: transpose TP heads into CP rows and back.
+
+Projection weights stay in their original TP shards. The existing serving
+group supplies two all-to-all exchanges; attention consumes a complete layer
+history from the two-window prefill pipeline. No weight replica is allocated.
+"""
+
+
+def run_position_prefill_attention(query, selected_rows, sequence_lengths, *,
+        degree, rank, value_dimension, exchange, attend):
+    import torch
+
+    if (type(degree) is not int or degree < 2 or degree & (degree - 1)
+            or type(rank) is not int or not 0 <= rank < degree
+            or query.ndim != 3 or not query.is_cuda
+            or selected_rows.ndim != 2 or selected_rows.shape[0] != query.shape[0]
+            or sequence_lengths.shape != (query.shape[0],)
+            or selected_rows.device != query.device or sequence_lengths.device != query.device
+            or not callable(exchange) or not callable(attend) or value_dimension < 1):
+        raise ValueError('Bind native TP query rows, causal selections and the existing CP exchange')
+    tokens, local_heads, dimension = query.shape
+    if tokens == 0:
+        return query.new_empty((0, local_heads, value_dimension))
+    local_tokens = (tokens + degree - 1) // degree
+    padded = query.new_zeros((local_tokens * degree, local_heads, dimension))
+    padded[:tokens].copy_(query)
+    send = padded.view(local_tokens, degree, local_heads, dimension).transpose(0, 1).contiguous()
+    received = torch.empty_like(send)
+    exchange(received.view(-1), send.view(-1))
+    context_query = received.transpose(0, 1).reshape(local_tokens, degree * local_heads, dimension)
+    rows = selected_rows.new_full((local_tokens, selected_rows.shape[1]), -1)
+    lengths = sequence_lengths.new_zeros((local_tokens,))
+    selected = selected_rows[rank::degree]
+    rows[:selected.shape[0]].copy_(selected)
+    lengths[:selected.shape[0]].copy_(sequence_lengths[rank::degree])
+    output = attend(context_query, rows, lengths)
+    if output.shape != (local_tokens, degree * local_heads, value_dimension):
+        raise ValueError('Native CP prefill attention returned a different query/head layout')
+    send = output.reshape(local_tokens, degree, local_heads, value_dimension).transpose(0, 1).contiguous()
+    received = torch.empty_like(send)
+    exchange(received.view(-1), send.view(-1))
+    return received.transpose(0, 1).reshape(local_tokens * degree, local_heads, value_dimension)[:tokens]
