index 0000000000000000000000000000000000000000..a6ea841393e8425be9a566c3b61ddc1e627b1f47
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_prefill_history.py
@@ -0,0 +1,71 @@
+"""Complete native prefix+extend IDs shared by the U/Hi prefill adapters.
+
+PAGED/flashmla_kv legitimately leaves page_table_1_flattened unset. Never
+interpret that as an empty warm history; use native request-table identities.
+"""
+import operator
+
+
+def _cpu_lengths(value, name):
+    if value is None:
+        return None
+    if hasattr(value, 'device'):
+        if value.device.type != 'cpu':
+            raise ValueError(name + ' must be the existing CPU mirror')
+        value = value.tolist()
+    result = [operator.index(n) for n in value]
+    if any(n < 0 for n in result):
+        raise ValueError(name + ' contains a negative sequence length')
+    return result
+
+
+def build_full_prefill_history(batch, *, native_history=None, req_to_token=None,
+                               flattened=None):
+    import torch
+    prefix = _cpu_lengths(
+        getattr(native_history, 'prefix_lens_cpu', None) if native_history is not None
+        else getattr(batch, 'extend_prefix_lens_cpu', None), 'prefix_lens_cpu')
+    lengths = _cpu_lengths(getattr(batch, 'seq_lens_cpu', None), 'seq_lens_cpu')
+    if lengths is None:
+        extend = _cpu_lengths(getattr(batch, 'extend_seq_lens_cpu', None), 'extend_seq_lens_cpu')
+        if prefix is not None and extend is not None:
+            if len(prefix) != len(extend):
+                raise ValueError('Native prefix/extend CPU mirrors differ')
+            lengths = [a+b for a,b in zip(prefix, extend)]
+    if lengths is None:
+        if prefix is not None and not any(prefix):
+            return batch.out_cache_loc.reshape(-1).to(torch.int32)
+        raise ValueError('Complete warm prefill requires native CPU sequence lengths')
+    total = sum(lengths)
+    if total > 1048576:
+        raise ValueError('Complete prefix+extend histories exceed shared prefill admission')
+    if flattened is not None and flattened.numel() == total:
+        # The native RAGGED/MHA constructor fills this exact full-sequence
+        # shape from the same request table. Other shapes are not trusted.
+        result = flattened.reshape(-1).to(torch.int32).contiguous()
+    else:
+        if req_to_token is None and native_history is not None:
+            req_to_token = native_history.req_to_token
+        if req_to_token is None:
+            pool = getattr(batch, 'req_to_token_pool', None)
+            req_to_token = getattr(pool, 'req_to_token', None)
+        if req_to_token is None:
+            if prefix is not None and not any(prefix) and total == batch.out_cache_loc.numel():
+                return batch.out_cache_loc.reshape(-1).to(torch.int32)
+            raise ValueError('Warm prefill has no complete native table; refusing current-only history')
+        indices = (native_history.req_pool_indices if native_history is not None
+                   else batch.req_pool_indices)
+        if (req_to_token.ndim != 2 or indices.numel() != len(lengths)
+                or req_to_token.device != indices.device):
+            raise ValueError('Native request table/indices/sequence mirror differ')
+        if lengths and max(lengths) > req_to_token.shape[1]:
+            raise ValueError('Native sequence exceeds its request-table width')
+        lens = torch.tensor(lengths, dtype=torch.int32, device=indices.device)
+        starts = lens.cumsum(0, dtype=torch.int32) - lens
+        requests = torch.repeat_interleave(indices, lens, output_size=total)
+        positions = (torch.arange(total, dtype=torch.int32, device=indices.device)
+                     - torch.repeat_interleave(starts, lens, output_size=total))
+        result = req_to_token[requests, positions].to(torch.int32).contiguous()
+    if result.numel():
+        torch._assert_async((result > 0).all(), 'A valid full-history native KV identity is missing')
+    return result
diff --git a/python/sglang/srt/ulacache/native_qsa_pool.py b/python/sglang/srt/ulacache/native_qsa_pool.py
new file mode 100644
index 0000000000000000000000000000000000000000..a063d29f2222d905c88574c6a7caf6ef7c7d6bf9
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_qsa_pool.py
@@ -0,0 +1,67 @@
+"""Bind the native QSA GQA payload to UlaCache; retain native index and GDN."""
+
+from dataclasses import dataclass
+from ulacache import CacheCapacityPlan
+from sglang.srt.ulacache.native_sparse_layers import NativeSparseLayerAdapter
+
+
+@dataclass(frozen=True)
+class NativeQsaPoolConfiguration:
+    device_record_capacity: int
+    host_record_capacity: int
+    maximum_padded_query_count: int
+    maximum_write_record_count: int
+    maximum_selected_records: int = 2051
+    storage_owner_count: int = 1
+    native_record_writes_replicated: bool = False
+    allocation_plan: CacheCapacityPlan | None = None
+    minimum_native_profile_available_bytes: int | None = None
+    prepare_in_parallel: bool = True
+    maximum_prefill_record_count: int | None = None
+
+
+class NativeQsaLayerAdapter(NativeSparseLayerAdapter):
+    """Translate global hybrid model layer IDs to dense native payload banks."""
+
+    def native_selected_record_ids(self, request_records, request_rows, positions, sequence_lengths):
+        from ulacache.storage.buffers import compose_selected_record_ids
+        return compose_selected_record_ids(request_records, request_rows, positions, sequence_lengths)
+
+def create_native_qsa_pool_class(configuration, *, record_owner_process_group=None):
+    from sglang.srt.ulacache.native_paired_pool import create_native_paired_pool_class
+
+    return create_native_paired_pool_class(configuration,
+        record_owner_process_group=record_owner_process_group)
+
+
+def install_native_qsa_pool(configuration):
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.layers.attention.qsa.config import parse_qsa_profile
+    from sglang.srt.ulacache.native_sparse_allocator import install_native_sparse_allocator_hooks
+    from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+    from sglang.srt.layers.attention.qsa import sparse_attn
+    from ulacache.storage.buffers import gather_selected_pairs
+
+    sparse_attn._resident_pair_gather = gather_selected_pairs
+
+    if configuration.storage_owner_count != 1:
+        raise NotImplementedError('Model owner groups require a verified QKV replica topology binding')
+    if configuration.allocation_plan is not None:
+        from sglang.srt.ulacache.native_cache_admission import install_native_qsa_admission
+        install_native_qsa_admission(configuration)
+    original = kv_cache_configurator.KVCacheConfigurator._build_hybrid_linear_kv_pool
+
+    def build(self, **kwargs):
+        profile = parse_qsa_profile(self.model_config.hf_config)
+        if profile is not None and not self.is_draft_worker:
+            if (profile.compress_ratio != 4
+                    or profile.budget + profile.compress_ratio - 1 != configuration.maximum_selected_records):
+                raise ValueError('QSA profile differs from the declared native payload geometry')
+            kwargs['mha_pool_class'] = create_native_qsa_pool_class(configuration)
+        pool = original(self, **kwargs)
+        if isinstance(pool.full_kv_pool, NativeSparseCacheAdapter):
+            pool._native_sparse_cache_adapter = NativeQsaLayerAdapter(pool)
+        return pool
+
+    kv_cache_configurator.KVCacheConfigurator._build_hybrid_linear_kv_pool = build
+    install_native_sparse_allocator_hooks()
diff --git a/python/sglang/srt/ulacache/native_scheduler_admission.py b/python/sglang/srt/ulacache/native_scheduler_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..df62629397e73c969ffb621825f65334cb29cb11
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_scheduler_admission.py
@@ -0,0 +1,136 @@
+"""Source-bound native scheduler control for paused benchmark admission.
+
+The serving process records its actual PortArgs. The client pauses only the
+scheduler; TokenizerManager remains able to admit the complete HTTP cohort.
+Transport acknowledgement never substitutes for queued-request receipts.
+"""
+from __future__ import annotations
+
+from functools import wraps
+import hashlib
+import inspect
+import json
+import os
+from pathlib import Path
+
+
+def process_identity(pid):
+    fields = Path(f'/proc/{int(pid)}/stat').read_text().rsplit(')', 1)[1].split()
+    if fields[0] in ('Z', 'X'):
+        raise RuntimeError('The recorded scheduler has exited')
+    return dict(pid=int(pid), start_ticks=fields[19])
+
+
+def validate_endpoint(endpoint):
+    if (not isinstance(endpoint, str) or not endpoint.startswith('ipc:///')
+            or len(os.fsencode(endpoint[6:])) >= 108 or '\0' in endpoint):
+        raise ValueError('Native scheduler requires a bounded absolute IPC endpoint')
+    return endpoint
+
+
+def install_scheduler_receipts(scheduler_class, directory):
+    """Run before Scheduler construction in the parent and spawned workers."""
+    directory = Path(directory).resolve()
+    original = scheduler_class.__init__
+    previous = getattr(original, '_ulacache_port_args_directory', None)
+    if previous is not None:
+        if previous != str(directory):
+            raise ValueError('Scheduler receipt directory changed after installation')
+        return
+    signature = inspect.signature(original)
+
+    @wraps(original)
+    def initialize(scheduler, *args, **kwargs):
+        bound = signature.bind(scheduler, *args, **kwargs)
+        port_args = bound.arguments['port_args']
+        endpoint = validate_endpoint(port_args.rpc_ipc_name)
+        original(scheduler, *args, **kwargs)
+        from sglang.srt.managers import io_struct
+        from sglang.srt.runtime_context import get_parallel
+
+        rank = int(get_parallel().tp_rank)
+        codec = Path(io_struct.__file__).resolve()
+        directory.mkdir(parents=True, exist_ok=True)
+        receipt = dict(schema_version=1, rank=rank,
+            event='Scheduler.__init__ completed with actual PortArgs',
+            port_args_field='rpc_ipc_name', endpoint=endpoint,
+            owner=process_identity(os.getpid()), io_struct_path=str(codec),
+            io_struct_sha256=hashlib.sha256(codec.read_bytes()).hexdigest())
+        path = directory / f'scheduler_control.rank{rank}.json'
+        with path.open('x') as output:
+            json.dump(receipt, output, indent=2)
+            output.write('\n')
+
+    initialize._ulacache_port_args_directory = str(directory)
+    scheduler_class.__init__ = initialize
+
+
+class NativeSchedulerControl:
+    def __init__(self, receipt):
+        self.receipt = json.loads(Path(receipt).read_text())
+        if (self.receipt.get('schema_version') != 1 or self.receipt.get('rank') != 0
+                or self.receipt.get('port_args_field') != 'rpc_ipc_name'
+                or self.receipt.get('event') != 'Scheduler.__init__ completed with actual PortArgs'):
+            raise ValueError('Use the actual rank-zero PortArgs receipt from this serving process')
+        endpoint = validate_endpoint(self.receipt['endpoint'])
+        self._check_owner()
+        codec = Path(self.receipt['io_struct_path']).resolve(strict=True)
+        if hashlib.sha256(codec.read_bytes()).hexdigest() != self.receipt['io_struct_sha256']:
+            raise ValueError('Serving IPC codec changed after scheduler construction')
+        os.environ['CUDA_VISIBLE_DEVICES'] = ''
+        import zmq
+        import sglang.srt.managers.io_struct as io
+
+        if Path(io.__file__).resolve() != codec:
+            raise ValueError('Client must import the exact serving source IPC codec')
+        self.io = io
+        self.context = zmq.Context()
+        self.socket = None
+        try:
+            self.socket = self.context.socket(zmq.DEALER)
+            self.socket.setsockopt(zmq.IMMEDIATE, 1)
+            self.socket.setsockopt(zmq.SNDTIMEO, 10_000)
+            self.socket.setsockopt(zmq.RCVTIMEO, 10_000)
+            self.socket.setsockopt(zmq.LINGER, 0)
+            self.socket.bind(endpoint)
+        except BaseException:
+            self.close()
+            raise
+
+    def _check_owner(self):
+        owner = self.receipt['owner']
+        if process_identity(owner['pid']) != owner:
+            raise RuntimeError('Scheduler PID was reused; preserve its original identity')
+
+    def pause(self, mode='in_place'):
+        if mode not in ('in_place', 'abort'):
+            raise ValueError('Unsupported native benchmark pause mode')
+        self._check_owner()
+        if self.socket is None:
+            raise RuntimeError('Native scheduler control is closed')
+        if mode == 'abort':
+            # Scheduler.pause_generation rejects abort in v0.5.22. The
+            # TokenizerManager also translates that mode into AbortReq.
+            # This client owns the isolated benchmark service and cohort.
+            request = self.io.AbortReq(abort_all=True)
+        else:
+            request = self.io.PauseGenerationReqInput(mode=mode)
+        self.io.sock_send(self.socket, request)
+        # The same ingress and native collective CPU RPC order the pause on
+        # every TP rank before HTTP generations are submitted.
+        self.io.sock_send(self.socket, self.io.RpcReqInput(method='__dir__'))
+        reply = self.io.sock_recv(self.socket)
+        if not isinstance(reply, self.io.RpcReqOutput) or not reply.success:
+            raise RuntimeError('Native collective pause ordering acknowledgement failed')
+        self._check_owner()
+        return dict(complete=True, mode=mode, native_collective_cpu_ordering_ack=True,
+                    tokenizer_pause_untouched=True, endpoint=self.receipt['endpoint'],
+                    owner=self.receipt['owner'], full_cohort_queued_receipts_still_required=True)
+
+    def close(self):
+        if self.socket is not None:
+            self.socket.close(linger=0)
+            self.socket = None
+        if self.context is not None:
+            self.context.term()
+            self.context = None
diff --git a/python/sglang/srt/ulacache/native_shared_tp_prefetch.py b/python/sglang/srt/ulacache/native_shared_tp_prefetch.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b3d924521b51449f4abe4c1b766ed64a165aaa0
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_shared_tp_prefetch.py
@@ -0,0 +1,92 @@
+"""Start the existing TP history pull at the unmodified native Index return."""
+
+
+def install():
+    from sglang.srt.layers.attention.dsa import dsa_indexer_kpool as module
+    from sglang.srt.layers.attention.dsa_backend import transform_index_page_table_decode
+
+    original = module.IndexerKPool._get_topk_paged
+    if getattr(original, '_ulacache_shared_tp_prefetch', False):
+        return
+
+    def paged(self, forward_batch, layer_id, q_fp8, weights, metadata):
+        indices = original(self, forward_batch, layer_id, q_fp8, weights, metadata)
+        pool = module.get_token_to_kv_pool()
+        payload = getattr(pool, 'full_kv_pool', pool)
+        execution = getattr(payload, 'cache_execution', None)
+        prefetch = getattr(execution, 'prefetch_attention', None)
+        if prefetch is not None and execution.decode_like and execution.current is not None:
+            # Native fused TopK already returns complete logical token IDs.
+            # Otherwise borrow the original backend's exact page transformation.
+            selected = (indices if module._should_fuse_kpool_topk(metadata)
+                else transform_index_page_table_decode(
+                    page_table=metadata.attn_metadata.page_table_1,
+                    topk_indices=indices, page_size=1))
+            local = pool.full_attention_layer_id_mapping[layer_id] - payload.start_layer
+            prefetch(local, selected)
+        return indices
+
+    paged._ulacache_shared_tp_prefetch = True
+    module.IndexerKPool._get_topk_paged = paged
+
+
+def install_profile_warmup():
+    """Initialize CUDA tracing before retaining native cache Graph functions.
+
+    H100 v0.5.22 fails when CUDA tracing first instruments these functions
+    after Graph capture. A normal startup forward before each capture binds
+    tracing first. No profiler remains active during serving or measurement.
+    """
+    import torch
+    from sglang.srt.model_executor.runner_backend.full_cuda_graph_backend import FullCudaGraphBackend
+    from ulacache.cache.native_shared_tp import NativeSharedTensorParallelExecution
+
+    original = FullCudaGraphBackend.capture_one
+    if getattr(original, '_ulacache_native_profile_warmup', False):
+        return
+
+    def capture(self, shape_key, forward_fn, capture_inputs=None, post_warmup_hook=None):
+        runner = self._cuda_graph_runner.model_runner
+        pool = runner.token_to_kv_pool
+        payload = getattr(pool, 'full_kv_pool', pool)
+        execution = getattr(payload, 'cache_execution', None)
+        if (isinstance(execution, NativeSharedTensorParallelExecution)
+                and not torch.autograd._profiler_enabled()):
+            self._device_module.synchronize()
+            self._tp_group.barrier()
+            with torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CPU,
+                    torch.profiler.ProfilerActivity.CUDA], with_stack=False, record_shapes=False):
+                forward_fn()
+                self._device_module.synchronize()
+            if post_warmup_hook is not None:
+                post_warmup_hook()
+        return original(self, shape_key, forward_fn, capture_inputs=capture_inputs,
+            post_warmup_hook=post_warmup_hook)
+
+    capture._ulacache_native_profile_warmup = True
+    FullCudaGraphBackend.capture_one = capture
+
+
+def install_profile_guard(initialized):
+    """Reject late first GPU instrumentation before dispatching worker work."""
+    from sglang.srt.managers.tokenizer_control_mixin import TokenizerControlMixin
+
+    original = TokenizerControlMixin.start_profile
+    if getattr(original, '_ulacache_native_profile_guard', False):
+        return
+
+    async def start(self, req=None):
+        activities = getattr(req, 'activities', None)
+        if activities is None:
+            activities = ['CPU', 'GPU']
+        native_capture_profile = getattr(self.server_args, 'enable_profile_cuda_graph', False)
+        if (not initialized and not native_capture_profile
+                and any(name in activities for name in ('GPU', 'CUDA_PROFILER'))):
+            from fastapi import HTTPException
+            raise HTTPException(status_code=409, detail=(
+                'Native TP Graph profiling requires initialize_cuda_profiler=true at startup. '
+                'Use a separate profiling run for GPU diagnostics.'))
+        return await original(self, req)
+
+    start._ulacache_native_profile_guard = True
+    TokenizerControlMixin.start_profile = start
diff --git a/python/sglang/srt/ulacache/native_sparse_allocator.py b/python/sglang/srt/ulacache/native_sparse_allocator.py
new file mode 100644
index 0000000000000000000000000000000000000000..52995c7dbfe6155345632c10b70bff795e5825d7
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_sparse_allocator.py
@@ -0,0 +1,78 @@
+"""Bind native full-page allocation and permanent release to cache ownership."""
+
+
+def install_native_sparse_allocator_hooks(*, sparse_adapter_class=None):
+    import torch
+    from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+    from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+    if sparse_adapter_class is None:
+        from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+        sparse_adapter_class = NativeSparseCacheAdapter
+
+    def cache_owner(allocator):
+        owner = getattr(allocator, 'native_sparse_cache_owner', None)
+        if owner is None:
+            owner = getattr(allocator._kvcache, 'native_sparse_cache_adapter', None)
+        if owner is None and isinstance(allocator._kvcache, sparse_adapter_class):
+            owner = allocator._kvcache
+        return owner
+
+    original_swa_init = SWATokenToKVPoolAllocator.__init__
+
+    def swa_init(self, *args, **kwargs):
+        original_swa_init(self, *args, **kwargs)
+        owner = getattr(self._kvcache, 'native_sparse_cache_adapter', None)
+        if owner is None and isinstance(self._kvcache, sparse_adapter_class):
+            owner = self._kvcache
+        if owner is not None:
+            self.full_attn_allocator.native_sparse_cache_owner = owner
+
+    SWATokenToKVPoolAllocator.__init__ = swa_init
+    for method_name in ('alloc', 'alloc_extend', 'alloc_decode'):
+        original_allocate = getattr(PagedTokenToKVPoolAllocator, method_name)
+
+        def allocate(self, *args, _original=original_allocate, _method=method_name, **kwargs):
+            if cache_owner(self) is None:
+                return _original(self, *args, **kwargs)
+            previous = getattr(self, '_ulacache_prefill_allocation', False)
+            self._ulacache_prefill_allocation = previous or _method == 'alloc_extend'
+            try:
+                return _original(self, *args, **kwargs)
+            finally:
+                self._ulacache_prefill_allocation = previous
+
+        setattr(PagedTokenToKVPoolAllocator, method_name, allocate)
+    original_consume = PagedTokenToKVPoolAllocator._consume_free_pages
+
+    def consume(self, count):
+        pages = original_consume(self, count)
+        owner = cache_owner(self)
+        if owner is not None and count:
+            if (getattr(owner, 'pd_direct_receiver', None) is not None
+                    and getattr(self, '_udcache_receiving_records', False)):
+                owner.register_native_receive_pages(pages)
+            else:
+                owner.register_native_full_pages(pages,
+                    prefer_device=not getattr(self, '_ulacache_prefill_allocation', False))
+        return pages
+
+    PagedTokenToKVPoolAllocator._consume_free_pages = consume
+    original_release = PagedTokenToKVPoolAllocator._release_page_ids
+
+    def release(self, *page_ids):
+        owner = cache_owner(self)
+        if owner is not None:
+            pages = page_ids[0] if len(page_ids) == 1 else torch.cat(page_ids)
+            owner.release_native_full_pages(pages)
+        return original_release(self, *page_ids)
+
+    PagedTokenToKVPoolAllocator._release_page_ids = release
+    original_clear = PagedTokenToKVPoolAllocator.clear
+
+    def clear(self):
+        owner = cache_owner(self)
+        if owner is not None:
+            owner.clear_native_full_records()
+        return original_clear(self)
+
+    PagedTokenToKVPoolAllocator.clear = clear
diff --git a/python/sglang/srt/ulacache/native_sparse_layers.py b/python/sglang/srt/ulacache/native_sparse_layers.py
