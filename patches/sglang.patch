+# ==============================================================================
+
+"""Native logical allocation for the mutually exclusive FlowKV GPU/CPU tier.
+
+Request rows and radix values continue to store stable, interleaved logical
+indices. Only the host tier's residency directory translates those indices to
+physical GPU/CPU slots. Migration never calls this allocator's free methods.
+
+The native FULL prefix-cache component already selects unlocked leaves by LRU
+and advances to their parents. Keeping migrated values in that same logical
+tree makes its existing permanent-eviction algorithm preserve contiguous
+prefixes, independently of each rank's physical residency and LRU order.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Protocol
+
+import torch
+
+from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+
+if TYPE_CHECKING:
+    from sglang.srt.mem_cache.memory_pool import KVCache
+
+
+class FlowKVHostTierAllocation(Protocol):
+    """The tier owns physical slots; the allocator owns logical identities."""
+
+    row_batch_limit: int
+
+    def allocate(self, logical_indices: torch.Tensor) -> None: ...
+
+    def release(self, logical_indices: torch.Tensor) -> None: ...
+
+    def clear(self) -> None: ...
+
+
+class FlowKVHostTokenToKVPoolAllocator(PagedTokenToKVPoolAllocator):
+    """Reuse native pages over ``P * (gpu_slots + cpu_slots)`` logical rows.
+
+    ``page_size`` remains the pool's allocation quantum (native storage page
+    times owner count). Thus a page reserves an equal number of stable Index
+    rows on every owner. Scheduler capacity, prefix matching, locks and free
+    grouping retain the native allocator contract.
+    """
+
+    def __init__(
+        self,
+        size: int,
+        page_size: int,
+        dtype: torch.dtype,
+        device: str,
+        kvcache: KVCache,
+        need_sort: bool,
+        *,
+        host_tier: FlowKVHostTierAllocation,
+    ):
+        self.host_tier = host_tier
+        super().__init__(size, page_size, dtype, device, kvcache, need_sort)
+
+    def _register_logical_indices(self, indices):
+        if indices is not None:
+            self.host_tier.allocate(indices)
+        return indices
+
+    def alloc(self, need_size: int):
+        return self._register_logical_indices(super().alloc(need_size))
+
+    def alloc_extend(
+        self,
+        prefix_lens: torch.Tensor,
+        prefix_lens_cpu: torch.Tensor,
+        seq_lens: torch.Tensor,
+        seq_lens_cpu: torch.Tensor,
+        last_loc: torch.Tensor,
+        extend_num_tokens: int,
+        num_new_pages: int = None,
+    ):
+        return self._register_logical_indices(
+            super().alloc_extend(
+                prefix_lens,
+                prefix_lens_cpu,
+                seq_lens,
+                seq_lens_cpu,
+                last_loc,
+                extend_num_tokens,
+                num_new_pages=num_new_pages,
+            )
+        )
+
+    def alloc_decode(
+        self,
+        seq_lens: torch.Tensor,
+        seq_lens_cpu: torch.Tensor,
+        last_loc: torch.Tensor,
+    ):
+        return self._register_logical_indices(
+            super().alloc_decode(seq_lens, seq_lens_cpu, last_loc)
+        )
+
+    def decode_capacity_failure_message(self) -> str:
+        return (
+            "FlowKV GPU+CPU KV capacity exhausted: "
+            f"capacity={self.size} logical token slots, "
+            f"available={self.available_size()}. "
+            "The request cannot grow without discarding required KV."
+        )
+
+    def prepare_for_reclaim(self, tree_cache, num_tokens, *, requests=None) -> None:
+        if (
+            self.available_size() >= num_tokens
+            or requests is None
+            or tree_cache is None
+            or not tree_cache.supports_prefix_sharing()
+        ):
+            return
+        from sglang.srt.mem_cache.base_prefix_cache import MatchPrefixParams
+        from sglang.srt.mem_cache.radix_cache import RadixKey
+
+        # Native match refreshes the cached tail and its ancestors on either
+        # tree backend. Finish every batch touch before eviction starts;
+        # private new tokens are allocator-owned and not tree candidates.
+        for req in requests:
+            if req.kv.cache_protected_len > 0:
+                tree_cache.match_prefix(
+                    MatchPrefixParams(
+                        key=RadixKey(
+                            req.full_untruncated_fill_ids,
+                            extra_key=req.extra_key,
+                            cache_salt=req.cache_salt,
+                            limit=req.kv.cache_protected_len,
+                        )
+                    )
+                )
+
+    def _release_page_ids(self, *page_ids: torch.Tensor):
+        # Releasing a logical page invalidates every row it reserved, including
+        # unwritten padding in its final partial page. Only this permanent
+        # release allows an Index identity to be reused by another token.
+        pages_per_batch = max(1, self.host_tier.row_batch_limit // self.page_size)
+        for pages in page_ids:
+            for start in range(0, pages.numel(), pages_per_batch):
+                batch = pages[start : start + pages_per_batch]
+                indices = torch.arange(
+                    batch.numel() * self.page_size, device=self.device
+                ).view(-1, self.page_size)
+                indices.remainder_(self.page_size)
+                indices.add_(batch[:, None], alpha=self.page_size)
+                self.host_tier.release(indices.view(-1))
+                del indices
+        super()._release_page_ids(*page_ids)
+
+    def clear(self):
+        self.host_tier.clear()
+        super().clear()
+
+    def resize(self, config) -> None:
+        raise NotImplementedError(
+            "FlowKV CPU tier logical capacity is fixed at pool initialization"
+        )
