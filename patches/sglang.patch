@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Exclusive host/device residency for owner-striped FlowKV records.
+
+Logical rows are the request allocator's identities and the GPU Index rows.
+Only their KV residency changes. Physical GPU and CPU rows are independent
+free lists; each shared-Index group has its own recent ring and unified cold set.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from sglang.srt.mem_cache.flowkv_peer import FlowKVPeerShards
+from sglang.srt.mem_cache.pool_host.base import host_memory_budget_bytes
+from sglang.srt.mem_cache.pool_host.common import (
+    HostTensorAllocator,
+    _cuda_host_unregister,
+    alloc_with_host_register,
+    make_kernel_ptr_table,
+)
+
+
+class FlowKVHostRecordPool:
+    """An exact-size, per-rank HiCache pinned allocation of complete records.
+
+    HiCache's mmap allocator, host budget, CUDA registration and pointer-table
+    helpers are reused. Index keys stay on the GPU and are not in this pool.
+    Physical host allocation is managed on the GPU together with residency,
+    rather than by a second request-level host allocator.
+    """
+
+    def __init__(self, *, layers, slots, row_bytes, device):
+        self.layers, self.slots, self.row_bytes = layers, slots, row_bytes
+        requested = layers * slots * row_bytes
+        available = host_memory_budget_bytes(requested)
+        if requested > available:
+            raise ValueError(
+                f"FlowKV CPU pool needs {requested} bytes per rank; "
+                f"the HiCache host budget permits {available} bytes"
+            )
+        self.storage = alloc_with_host_register(
+            (layers, slots, row_bytes), torch.uint8, "cpu", True,
+            HostTensorAllocator(),
+        )
+        self.ptrs = make_kernel_ptr_table(
+            [self.storage], device, host_memory_registered=True,
+        )
+
+    @property
+    def nbytes(self):
+        return self.storage.nbytes
+
+    def close(self):
+        _cuda_host_unregister(self.storage)
+        del self.storage, self.ptrs
diff --git a/python/sglang/srt/mem_cache/flowkv_layout.py b/python/sglang/srt/mem_cache/flowkv_layout.py
