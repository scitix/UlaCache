diff --git a/python/sglang/srt/mem_cache/flowkv_adapter.py b/python/sglang/srt/mem_cache/flowkv_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..9dee9f8a5ba9b629d9b22d53aa74cef182f040eb
--- /dev/null
+++ b/python/sglang/srt/mem_cache/flowkv_adapter.py
@@ -0,0 +1,156 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Lifecycle and model geometry for a FlowKV packed-MLA cache."""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+
+@dataclass(frozen=True)
+class FlowKVExtendHistory:
+    """Prefix metadata already available to the runner before an eager forward.
+
+    Keep request ids on the device. CPU lengths determine allocation sizes;
+    the adapter selects its physical compression ratio when gathering rows.
+    """
+
+    req_to_token: Any
+    req_pool_indices: Any
+    prefix_lens: Any
+    prefix_lens_cpu: Sequence[int]
+
+    def locations(self, compression_ratio: int = 1):
+        from ulacache.transfer.kernels.prefix import gather_prefix_cache_indices
+
+        return gather_prefix_cache_indices(
+            self.req_to_token,
+            self.req_pool_indices,
+            self.prefix_lens,
+            self.prefix_lens_cpu,
+            compression_ratio=compression_ratio,
+        )
+
+
+@dataclass(frozen=True)
+class FlowKVPackedMLASpec:
+    """Model-provided geometry for a packed, indexed MLA cache tier.
+
+    A packed cache (such as a FlashMLA tier) has a physical KV row that is
+    different from ordinary DSA's latent row.  The FlowKV planner does not
+    need to know the model family or a tier's marketing name: it only needs
+    the rows that use this representation, the index width, and its packing
+    geometry.  A model-specific cache adapter constructs this descriptor.
+    """
+
+    compression_ratio: int
+    indexed_layer_ids: Sequence[int]
+    # Complete native selected-output width, including any appended tail.
+    topk: int
+    row_bytes: int
+    native_segment_bytes: tuple[int, ...]
+    index_layer_anchors: tuple[int, ...]
+    # Some packed formats pad every storage page for a kernel ABI.  This is a
+    # property of the packed representation, not of FlowKV's planner.
+    page_storage_alignment: int = 1
+
+    def __post_init__(self):
+        if self.topk <= 0 or self.topk % 256:
+            raise NotImplementedError(
+                f"FlowKV planner requires an aligned native selected width: "
+                f"received {self.topk}, expected a positive multiple of 256. "
+                "Native Index outputs and appended tail columns are preserved."
+            )
+
+    def local_layer_anchors(self, start_layer: int, end_layer: int) -> tuple[int, ...]:
+        if len(self.index_layer_anchors) != len(self.indexed_layer_ids):
+            raise ValueError("Every native KV layer must declare an Index anchor")
+        local_ids = tuple(
+            layer
+            for layer in self.indexed_layer_ids
+            if start_layer <= layer < end_layer
+        )
+        local = {layer: i for i, layer in enumerate(local_ids)}
+        owners = dict(zip(self.indexed_layer_ids, self.index_layer_anchors))
+        if any(owners[layer] not in local for layer in local_ids):
+            raise ValueError("A shared Index group crosses the local KV stage")
+        return tuple(local[owners[layer]] for layer in local_ids)
+
+    def local_layer_count(self, start_layer: int, end_layer: int) -> int:
+        if start_layer < 0 or end_layer <= start_layer:
+            raise ValueError("Invalid packed-MLA layer range")
+        if self.page_storage_alignment <= 0:
+            raise ValueError("Packed-MLA page storage alignment must be positive")
+        return sum(
+            start_layer <= layer_id < end_layer for layer_id in self.indexed_layer_ids
+        )
+
+
+class FlowKVPackedMLAAdapter(ABC):
+    """The runner lifecycle and attention interface for a packed KV tier."""
+
+    @abstractmethod
+    def flowkv_prepare_extend(self, history: FlowKVExtendHistory) -> None:
+        """Prepare prefix rows before an eager prefill or its graph warmup."""
+
+    @abstractmethod
+    def finish_flowkv_forward(self) -> None:
+        """Clear transient state after the forward completes."""
+
+    @property
+    @abstractmethod
+    def flowkv_packed_compression_ratio(self) -> int:
+        """Logical-token to packed-row ratio of the FlowKV-managed tier."""
+
+    @abstractmethod
+    def flowkv_prepare_topk_lookup(self, *, layer_id: int, packed_out_loc: Any) -> Any:
+        """Return optional device lookup metadata for the native TopK epilogue."""
+
+    @abstractmethod
+    def flowkv_prefetch_packed_attention(
+        self, *, layer_id: int, sparse_indices: Any, packed_out_loc: Any
+    ) -> None:
+        """Schedule history after native Index; current KV is produced later."""
+
+    @abstractmethod
+    def flowkv_prepare_packed_attention(
+        self,
+        *,
+        layer_id: int,
+        sparse_indices: Any,
+        packed_out_loc: Any,
+        decode_like: bool,
+    ) -> Any:
+        """Prepare packed KV and return the indices to consume for this layer.
+
+        A resident planner can return its stable remap buffer directly. The
+        caller keeps the original physical-index metadata for subsequent
+        layers and forwards.
+        """
+
+
+def is_flowkv_adapter(pool: object) -> bool:
+    """Return whether ``pool`` implements FlowKV's runner lifecycle."""
+    return isinstance(pool, FlowKVPackedMLAAdapter)
+
+
+class FlowKVSharedIndexAdapter(FlowKVPackedMLAAdapter):
+    """Native MLA cache with explicit shared-Index lifecycle boundaries."""
+
+    @abstractmethod
+    def flowkv_prepare_batch(self, batch: Any) -> None:
+        """Refresh the stable active-query count outside CUDA Graph replay."""
+
+    @abstractmethod
+    def flowkv_before_layer_prepare(self, layer_id: int, batch: Any) -> None:
+        """Begin a captured shared-Index metadata epoch."""
+
+    @abstractmethod
+    def flowkv_on_index_ready(self, layer_id: int, indices: Any, batch: Any) -> None:
+        """Plan once after the unmodified native Index returns its indices."""
+
+    @abstractmethod
+    def flowkv_after_attention(self, layer_id: int) -> None:
+        """Mark the layer consumed; followers reuse the anchor metadata."""
