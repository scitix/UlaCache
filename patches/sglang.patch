+        local = layer_id - self.start_layer
+        arena, layout = self.flowkv_arena, self.flowkv_layout
+        if self._flowkv_mode == "decode":
+            if self._flowkv_decode_layer != local:
+                raise RuntimeError("Native MLA read has no matching group history join")
+            storage = arena.storage[local]
+        elif self._flowkv_mode == "prefill":
+            if self.flowkv_plain_compact_prefill:
+                raise RuntimeError("Bounded Plain KV requires the remapped native attention reader")
