+    )
+
+
+def fused_store_owner_index_k_cache(
+    key: torch.Tensor,
+    cache: torch.Tensor,
+    loc: torch.Tensor,
+    *,
+    degree: int,
+    rank: int,
+    page_size: int = 64,
+    page_map: torch.Tensor | None = None,
+) -> None:
+    """Original quantizer/store, restricted to native slots owned by this rank."""
+    if degree < 2 or degree & (degree - 1) or not 0 <= rank < degree:
+        raise ValueError("Owner Index requires a power-of-two TP degree and valid rank")
+    if key.ndim != 2:
+        key = key.reshape(-1, key.shape[-1])
+    if (
+        key.ndim != 2
+        or key.shape != (loc.numel(), 128)
+        or key.dtype not in (torch.bfloat16, torch.float16)
+        or loc.ndim != 1
+        or loc.dtype != torch.int64
+        or cache.ndim != 2
+        or cache.shape[1] != 132 * page_size
+        or cache.dtype != torch.uint8
+        or not cache.is_contiguous()
+        or key.device != cache.device
+        or loc.device != cache.device
+        or cache.device.type != "cuda"
+    ):
+        raise ValueError("Owner Index quant/store received an unsupported native view")
+    if loc.numel() == 0:
+        return
+    if page_map is not None and (page_map.dtype != torch.int32 or page_map.device != cache.device
+            or page_map.ndim != 1 or not page_map.is_contiguous() or page_size != 64):
+        raise ValueError("Request Index writer requires a contiguous local page64 map")
+    module = _jit_dsa_owner_store_module(key.dtype, loc.dtype, page_size, degree, page_map is not None)
+    module.store(key.contiguous(), cache, loc.contiguous(), rank,
+                 *((page_map,) if page_map is not None else ()))
