+
+    def write_current(self, layer, indices, nope, rope):
+        if self.pending_writer is not None or layer in self.pipeline.installed:
+            raise RuntimeError("A prefill layer must write current KV exactly once")
+        self.pending_writer = (layer, indices, nope, rope)
+        self.pipeline.read(layer)
+
+    def remap(self, logical_indices):
+        import torch
+        if not self.active:
+            raise RuntimeError("Prefill addressing requires an active independent window")
+        live = logical_indices > 0
+        positions = torch.searchsorted(self.pipeline.plan.record_ids,
+            logical_indices.contiguous().to(torch.int64), out_int32=True)
+        return torch.where(live, positions, -1)
+
+    def read(self, layer):
+        return self.pipeline.read(layer).view(self.pool.dtype)
+
+    def after_attention(self, layer):
+        plan = self.pipeline.plan
+        window = self.pipeline.read(layer)
+        if plan.current_rows.numel():
+            # The CPU destination is the existing canonical bank, not staging.
+            # Retire only after this current-layer writeback is on the stream.
+            self.transfer(cache_dst=self.coordinator.mem_pool_host.kv_buffer[layer],
+                indices_dst=plan.current_rows, cache_src=window,
+                indices_src=plan.current_positions, element_dim=self.row_bytes,
+                page_size=self.coordinator.page_size)
