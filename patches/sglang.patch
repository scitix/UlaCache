index 0000000000000000000000000000000000000000..832239d0d6193de6baf94cba228b8aaf3eb05687
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_paged_pool.py
@@ -0,0 +1,305 @@
+"""Bind native compressed MLA pools to independent paged cache handles."""
+
+from dataclasses import dataclass, replace
+
+from ulacache.storage.capacity import CacheCapacityPlan
+
+
+@dataclass(frozen=True)
+class NativePagedPoolConfiguration:
+    """Cold capacities are per owner; rank-local storage has one owner.
+
+    Shared attention TP uses disjoint owners by default. Native compressed MLA
+    writers produce complete record replicas before ownership is applied.
+    The native full allocator and Index still cover the shared global namespace.
+    """
+    device_full_token_capacity: int
+    host_full_token_capacity: int
+    maximum_padded_query_count: int
+    maximum_write_record_count: int
+    maximum_selected_records: int
+    managed_compression_ratios: tuple[int, ...] = (1, 2)
+    storage_owner_count: int | None = None
+    maximum_prefill_record_count: int | None = None
+    native_record_writes_replicated: bool = True
+    allocation_plan: CacheCapacityPlan | None = None
+    minimum_native_profile_available_bytes: int | None = None
+    native_selections_replicated: bool = False
+    distributed_indexer: bool = True
+    prepare_in_parallel: bool = False
+    reuse_attention_workspaces: bool = False
+
+
+def create_native_paged_pool_class(configuration: NativePagedPoolConfiguration, selection_producer_layers,
+                                   *, record_owner_process_group=None):
+    """Construct explicitly before building native pools or capturing Graphs."""
+    import torch
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.kernels.ops.attention.dsv4 import fused_store_cache
+    from sglang.kernels.ops.attention.dsv4.dequant_k_cache import dequantize_k_cache_paged
+    from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+    from sglang.srt.mem_cache.deepseek_v4_memory_pool import (
+        DeepSeekV4SingleKVPool, DeepSeekV4TokenToKVPool,
+    )
+    from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+    from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeFusedSparseCacheAdapter
+    from sglang.srt.runtime_context import get_parallel, get_spec
+    from ulacache import (
+        MemoryTierCapacity, CacheExecutionOptions, LocalCacheBindings, RecordOwnerBindings,
+        SparseAccessSpecification, UnifiedMemoryCache,
+    )
+    from ulacache.cache.planning import create_owner_paged_execution_plan, create_paged_cache_execution_plan
+    from ulacache.speculative import LinearVerifyConfig, is_cache_step
+    from sglang.srt.ulacache.native_cache_geometry import create_native_paged_latent_layout, create_native_sparse_cache_binding
+    from ulacache.storage.writers import NativeRecordWriteStaging
+    from ulacache.cache.attention_access import NativeSparseCacheExecution
+    from sglang.srt.ulacache.native_cache_topology import (
+        require_rank_local_attention_storage, require_replicated_attention_record_owners,
+        resolve_native_record_owner_count,
+    )
+
+    if configuration.storage_owner_count is None:
+        configuration = replace(configuration,
+            storage_owner_count=resolve_native_record_owner_count(get_parallel()))
+    distributed_owners = configuration.storage_owner_count > 1
+    if configuration.reuse_attention_workspaces and not distributed_owners:
+        raise NotImplementedError('Attention workspace reuse requires distributed record owners')
+    if distributed_owners:
+        import torch.distributed as distributed
+        from sglang.kernels.ops.communication.all_reduce import IPCManager
+
+        if record_owner_process_group is None:
+            record_owner_process_group = get_parallel().attn_tp_group.cpu_group
+        if distributed.get_world_size(record_owner_process_group) != configuration.storage_owner_count:
+            raise ValueError('Declared cold owners must match the native process group')
+        if not configuration.native_record_writes_replicated:
+            raise NotImplementedError('Bind complete native writer replicas before enabling record owners')
+        if configuration.maximum_prefill_record_count is None:
+            raise ValueError('Declare the bounded native reconstruction chunk before startup')
+    create_execution_plan = (create_owner_paged_execution_plan if distributed_owners
+        else create_paged_cache_execution_plan)
+
+    class NativePagedSingleKVPool(DeepSeekV4SingleKVPool):
+        def __init__(self, *args, native_binding, **kwargs):
+            self.native_binding = native_binding
+            self.execution_plan = create_execution_plan(native_binding.cache_specification)
+            self.cache_layers_by_model_layer = {
+                layer: index for index, layer in enumerate(native_binding.model_layer_indices)}
+            super().__init__(*args, **kwargs)
+
+        def _create_buffers(self):
+            specification = self.native_binding.cache_specification
+            self.kv_cache_total_dim = self.get_bytes_per_token()
+            self.bytes_per_page_padded = self.kv_layout.page_bytes(self.page_size)
+            def write_native_pages(values, pages, indices, **arguments):
+                fused_store_cache(input=values, cache=pages, indices=indices,
+                    page_size=self.page_size, type='flashmla', layout=self.kv_layout, **arguments)
+
+            self.writer_staging = NativeRecordWriteStaging(specification, self.execution_plan,
+                self.device, write_native_pages)
+            options = CacheExecutionOptions.native_paged(
+                prepare_in_parallel=configuration.prepare_in_parallel,
+                prefill_union_method='sort' if distributed_owners else 'device',
+                reuse_attention_workspaces=configuration.reuse_attention_workspaces)
+            if distributed_owners:
+                services = RecordOwnerBindings(self.device, record_owner_process_group,
+                    FlowKVHostRecordPool, load_jit, IPCManager, self.page_size,
+                    configuration.maximum_prefill_record_count,
+                    configuration.native_record_writes_replicated, options,
+                    native_selections_replicated=configuration.native_selections_replicated)
+            else:
+                services = LocalCacheBindings(self.device, FlowKVHostRecordPool, load_jit,
+                    options)
+            with self.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+                self.memory_cache = UnifiedMemoryCache(specification, services)
+            self.cache_execution = NativeSparseCacheExecution(self.memory_cache, self.execution_plan,
+                self.writer_staging, specification, self.device,
+                maximum_prefill_record_count=configuration.maximum_prefill_record_count)
+            layer_views = self.memory_cache.device_record_storage
+            self.kv_buffer = [layer_views[layer] for layer in self.execution_plan.storage_producer_layers]
+
+        def set_key_buffer_fused(self, layer_id, loc, cache_k, freqs_cis=None):
+            cache_layer = self.execution_plan.storage_producer_layers[layer_id]
+            arguments = {} if freqs_cis is None else dict(freqs_cis=freqs_cis)
+            self.writer_staging.stage_native_records(cache_layer, loc, cache_k, **arguments)
+            self.cache_execution.publish_after_native_write(cache_layer)
+
+        def prepare_sparse_attention(self, model_layer, native_indices):
+            return self.cache_execution.prepare_attention(self.cache_layers_by_model_layer[model_layer], native_indices)
+
+        def _read_native_resident_records(self, record_planes, physical_record_ids, output):
+            # Native causal indices discard padding after a valid resident load.
+            dequantize_k_cache_paged(record_planes[0], physical_record_ids.clamp_min_(0),
+                page_size=self.page_size, out=output, layout=self.kv_layout)
+
+        def read_prefill_records(self, model_layer, native_indices, output):
+            self.cache_execution.reconstruct_prefill_records(self.cache_layers_by_model_layer[model_layer],
+                native_indices, output, self._read_native_resident_records)
+
+        def get_device_storage_inventory(self):
+            return self.cache_execution.get_device_storage_inventory()
+
+    class NativePagedSparseTokenPool(NativeFusedSparseCacheAdapter, DeepSeekV4TokenToKVPool):
+        def __init__(self, *args, **kwargs):
+            if configuration.storage_owner_count == 1:
+                require_rank_local_attention_storage(get_parallel())
+            else:
+                require_replicated_attention_record_owners(get_parallel(), configuration.storage_owner_count)
+            speculation = get_spec()
+            if speculation.speculative_algorithm is not None:
+                LinearVerifyConfig(algorithm=speculation.speculative_algorithm,
+                    steps=speculation.speculative_num_steps, topk=speculation.speculative_eagle_topk,
+                    verify_tokens=speculation.speculative_num_draft_tokens,
+                    adaptive=speculation.speculative_adaptive).validate()
+            self.native_paged_tiers = {}
+            self._creating_compressed_tiers = False
+            super().__init__(*args, **kwargs)
+
+        def _init_compressed_pools(self, **kwargs):
+            self._creating_compressed_tiers = True
+            try:
+                return super()._init_compressed_pools(**kwargs)
+            finally:
+                self._creating_compressed_tiers = False
+
+        def _make_kv_pool(self, **kwargs):
+            ratio = kwargs['global_page_size'] // kwargs['page_size']
+            if not self._creating_compressed_tiers or ratio not in configuration.managed_compression_ratios:
+                return super()._make_kv_pool(**kwargs)
+            model_layers = tuple(layer for layer in range(self._stage_start, self._stage_end)
+                if self.compression_ratios[layer] == ratio)
+            if not model_layers:
+                return super()._make_kv_pool(**kwargs)
+            owners = tuple(self.source_layer_of(layer) for layer in model_layers)
+            selections = tuple(max(producer for producer in selection_producer_layers
+                if producer <= layer and self.compression_ratios[producer] == ratio) for layer in model_layers)
+            layout = create_native_paged_latent_layout(name=f'native_history_ratio_{ratio}',
+                native_encoding='sglang.' + kwargs['kv_layout'].value + '.v1', native_layout=kwargs['kv_layout'],
+                records_per_page=kwargs['page_size'], tokens_per_record=ratio)
+            if kwargs['page_size'] % configuration.storage_owner_count:
+                raise ValueError('Each native allocation page must cover complete owner stripes')
+            capacity = MemoryTierCapacity(configuration.device_full_token_capacity // ratio,
+                configuration.host_full_token_capacity // ratio, configuration.maximum_write_record_count,
+                reserved_logical_record_count=kwargs['page_size'] // configuration.storage_owner_count,
+                maximum_prefill_union_record_count=configuration.device_full_token_capacity // ratio)
+            if ((self.full_size + self.page_size) // ratio
+                    != capacity.logical_record_capacity * configuration.storage_owner_count):
+                raise ValueError('Native full-page admission must match the declared CPU plus GPU capacity')
+            binding = create_native_sparse_cache_binding(model_layer_indices=model_layers,
+                key_value_owner_layers=owners, index_storage_owner_layers=owners,
+                sparse_selection_owner_layers=selections, residency_owner_layers=owners,
+                storage_layout=layout, sparse_access=SparseAccessSpecification(
+                    configuration.maximum_padded_query_count, configuration.maximum_selected_records),
+                capacity_plan=capacity)
+            kwargs.pop('cls', None)
+            pool = NativePagedSingleKVPool(qk_nope_head_dim=self.qk_nope_head_dim,
+                qk_rope_head_dim=self.qk_rope_head_dim, native_binding=binding, **kwargs)
+            self.native_paged_tiers[ratio] = pool
+            return pool
+
+        def prepare_cache_forward(self, batch, *, publish_active_query_count=True):
+            for pool in self.native_paged_tiers.values():
+                pool.cache_execution.begin_forward(decode_like=is_cache_step(batch.forward_mode),
+                    active_query_counts=batch.global_num_tokens_gpu,
+                    attention_data_parallel_rank=get_parallel().attn_dp_rank,
+                    query_count=batch.out_cache_loc.numel(),
+                    publish_active_query_count=publish_active_query_count)
+
+        def manages_native_sparse_tier(self, layer_id, compression_ratio):
+            return compression_ratio in self.native_paged_tiers
+
+        def prepare_native_fused_cache_write(self, layer_id, raw_write_locations, logical_record_ids):
+            ratio = self.compression_ratios[layer_id]
+            pool = self.native_paged_tiers[ratio]
+            layer = pool.cache_layers_by_model_layer[layer_id]
+            pages, source_indices = pool.writer_staging.reserve_native_write(layer, logical_record_ids)
+            # The original fused kernels use raw locations only for padding
+            # validity and their KV destination (divided by ratio for c2).
+            # Request/position state and the index-K locations remain native.
+            write_locations = torch.where(raw_write_locations > 0, source_indices * ratio, 0)
+            return pages, write_locations
+
+        def finish_native_fused_cache_write(self, layer_id):
+            pool = self.native_paged_tiers[self.compression_ratios[layer_id]]
+            pool.cache_execution.publish_after_native_write(pool.cache_layers_by_model_layer[layer_id])
+
+        def prepare_native_sparse_attention(self, layer_id, selected_records):
+            return self.native_paged_tiers[self.compression_ratios[layer_id]].prepare_sparse_attention(
+                layer_id, selected_records)
+
+        def read_native_prefill_records(self, layer_id, selected_records, output):
+            self.native_paged_tiers[self.compression_ratios[layer_id]].read_prefill_records(
+                layer_id, selected_records, output)
+
+        def finish_cache_attention(self, layer_id):
+            pool = self.native_paged_tiers[self.compression_ratios[layer_id]]
+            pool.cache_execution.finish_attention(pool.cache_layers_by_model_layer[layer_id])
+
+        def finish_cache_forward(self):
+            pass
+
+        def register_native_full_pages(self, full_page_ids, *, prefer_device):
+            for pool in self.native_paged_tiers.values():
+                pool.cache_execution.register_full_pages(full_page_ids, prefer_device=prefer_device)
+
+        def release_native_full_pages(self, full_page_ids):
+            for pool in self.native_paged_tiers.values():
+                pool.cache_execution.release_full_pages(full_page_ids)
+
+        def clear_native_full_records(self):
+            for pool in self.native_paged_tiers.values():
+                pool.cache_execution.clear_records()
+
+        def move_kv_cache(self, target_locations, source_locations):
+            raise NotImplementedError('Native paged relocation requires a logical-record move binding')
+
+        def close(self):
+            for pool in self.native_paged_tiers.values():
+                pool.memory_cache.close()
+
+    return NativePagedSparseTokenPool
+
+
+def install_native_paged_pool(configuration: NativePagedPoolConfiguration):
+    """Opt-in experiment binding; keep native admission and permanent reclamation."""
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.ulacache.native_sparse_allocator import install_native_sparse_allocator_hooks
+    from sglang.srt.ulacache.native_cache_admission import install_native_paged_admission
+
+    install_native_paged_admission(configuration)
+
+    original_build = kv_cache_configurator.KVCacheConfigurator._build_dsv4_kv_pool
+
+    def build(self, **kwargs):
+        if not self.is_draft_worker:
+            from sglang.srt.runtime_context import get_parallel
+            from sglang.srt.ulacache.native_cache_topology import resolve_native_record_owner_count
+
+            owners = resolve_native_record_owner_count(get_parallel(), configuration.storage_owner_count)
+            bounded = replace(configuration, storage_owner_count=owners,
+                maximum_prefill_record_count=(configuration.maximum_prefill_record_count
+                    or min(configuration.device_full_token_capacity, self.model_config.context_len)))
+            group = None
+            if owners > 1:
+                group = get_parallel().attn_tp_group.cpu_group
+            pool_class = create_native_paged_pool_class(bounded,
+                tuple(self.model_config.hf_config.index_source_layer_ids), record_owner_process_group=group)
+            if bounded.distributed_indexer and owners > 1 and not getattr(
+                    pool_class, '_ulacache_owner_index_binding', False):
+                from sglang.srt.ulacache.native_owner_index import (NativeOwnerIndexConfiguration,
+                    create_native_owner_index_pool_class, install_native_owner_index_scoring)
+                from sglang.srt.mem_cache.allocation_sizing import get_req_to_token_extra_context_len
+
+                text = self.model_config.hf_config
+                index_configuration = NativeOwnerIndexConfiguration(
+                    bounded.maximum_padded_query_count,
+                    self.model_config.context_len + get_req_to_token_extra_context_len(),
+                    bounded.maximum_write_record_count, text.index_n_heads, text.index_head_dim)
+                install_native_owner_index_scoring()
+                pool_class = create_native_owner_index_pool_class(pool_class,
+                    index_configuration, cpu_group=group)
+            kwargs['native_sparse_pool_class'] = pool_class
+        return original_build(self, **kwargs)
+
+    kv_cache_configurator.KVCacheConfigurator._build_dsv4_kv_pool = build
+    install_native_sparse_allocator_hooks()
diff --git a/python/sglang/srt/ulacache/native_paired_pool.py b/python/sglang/srt/ulacache/native_paired_pool.py
new file mode 100644
index 0000000000000000000000000000000000000000..0928975d3730d56d273a82d21a95ca4d4115748c
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_paired_pool.py
@@ -0,0 +1,186 @@
+"""Shared native BF16 GQA pool with paired or separate K/V byte planes."""
+
+def create_native_paired_pool_class(configuration, *, record_owner_process_group=None,
+                                    allocate_host_record_storage=None, sparse_adapter_class=None,
+                                    separate_record_planes=False):
+    import torch
+    prefill_bound = configuration.maximum_prefill_record_count or configuration.device_record_capacity
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.kernels.ops.kvcache.kvcache import store_cache
+    if allocate_host_record_storage is None:
+        from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+        allocate_host_record_storage = FlowKVHostRecordPool
+    from sglang.srt.mem_cache.memory_pool import MHATokenToKVPool, unwrap_write_loc
+    if sparse_adapter_class is None:
+        from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+        sparse_adapter_class = NativeSparseCacheAdapter
+    from sglang.srt.runtime_context import get_parallel, get_spec
+    from ulacache import (
+        KeyValueRecordPlane, KeyValueStorageLayout, LayerReuseSpecification,
+        MemoryTierCapacity, CacheExecutionOptions, LocalCacheBindings,
+        RecordOwnerBindings, SparseAccessSpecification,
+        UnifiedCacheSpecification, UnifiedMemoryCache,
+    )
+    from ulacache.cache.planning import create_paged_cache_execution_plan, create_owner_paged_execution_plan
+    from ulacache.storage.writers import NativeRecordWriteStaging
+    from ulacache.cache.attention_access import NativeSparseCacheExecution
+    from ulacache.storage.buffers import paired_record_views, read_paired_records
+
+    class NativePairedPayloadPool(sparse_adapter_class, MHATokenToKVPool):
+        @property
+        def native_sparse_cache_adapter(self):
+            return self
+
+        def __init__(self, *args, **kwargs):
+            parallel = get_parallel()
+            if (parallel.attn_cp_size != 1 or parallel.attn_dcp_size != 1
+                    or parallel.attn_dp_size != 1):
+                raise NotImplementedError('The QSA payload binding requires TP with CP, DCP and DP sizes of one')
+            if get_spec().speculative_algorithm is not None or kwargs.get('enable_kv_cache_copy'):
+                raise NotImplementedError('QSA speculative KV relocation requires a separate validation')
+            super().__init__(*args, **kwargs)
+
+        def _create_buffers(self):
+            if (self.dtype != torch.bfloat16 or self.is_quantized_kv_cache
+                    or self.use_hnd or self.kv_cache_layout != 'nhd' or self.post_capture_active):
+                raise NotImplementedError('QSA payload binding currently preserves native BF16 NHD KV')
+            owners = configuration.storage_owner_count
+            if owners > 1:
+                if (record_owner_process_group is None
+                        or torch.distributed.get_world_size(record_owner_process_group) != owners
+                        or not configuration.native_record_writes_replicated):
+                    raise ValueError('QSA owner storage needs an explicit complete-KV replica group')
+            elif record_owner_process_group is not None:
+                raise ValueError('Rank-local QSA storage does not accept a replica process group')
+            if self.page_size % owners:
+                raise ValueError('Native allocation pages must contain complete owner stripes')
+            capacity = MemoryTierCapacity(configuration.device_record_capacity,
+                configuration.host_record_capacity, configuration.maximum_write_record_count,
+                reserved_logical_record_count=self.page_size // owners,
+                maximum_prefill_union_record_count=prefill_bound)
+            if self.size + self.page_size != owners * capacity.logical_record_capacity:
+                raise ValueError('Native QSA history must match the declared GPU and CPU capacities')
+            planes = ((
+                KeyValueRecordPlane('key', 'gqa.bfloat16.key.v1', (self.head_num * self.head_dim * 2,)),
+                KeyValueRecordPlane('value', 'gqa.bfloat16.value.v1', (self.head_num * self.v_head_dim * 2,)),
+            ) if separate_record_planes else (
+                KeyValueRecordPlane('key_value', 'gqa.bfloat16.paired.v1',
+                    (self.head_num * self.head_dim * 2, self.head_num * self.v_head_dim * 2)),))
+            specification = UnifiedCacheSpecification(
+                KeyValueStorageLayout('gqa_history' if separate_record_planes else 'qsa_history',
+                    planes, self.page_size),
+                LayerReuseSpecification.from_shared_sparse_selection(tuple(range(self.layer_num))),
+                SparseAccessSpecification(configuration.maximum_padded_query_count,
+                    configuration.maximum_selected_records), capacity)
+            self.execution_plan = (create_owner_paged_execution_plan if owners > 1
+                else create_paged_cache_execution_plan)(specification)
+
+            def write_native_pages(values, pages, indices):
+                if separate_record_planes:
+                    key = pages[0].view(self.dtype).reshape(-1, self.head_num, self.head_dim)
+                    value = pages[1].view(self.dtype).reshape(-1, self.head_num, self.v_head_dim)
+                else:
+                    key, value = paired_record_views(pages, self.dtype, self.head_num,
+                        self.head_dim, self.v_head_dim)
+                # Native store_cache accepts independent source and destination
+                # row strides. Scalar encoding and rounding remain unchanged.
+                store_cache(values[0].reshape(-1, self.head_num * self.head_dim),
+                    values[1].reshape(-1, self.head_num * self.v_head_dim),
+                    key.view(-1, self.head_num * self.head_dim),
+                    value.view(-1, self.head_num * self.v_head_dim), indices)
+
+            self.writer_staging = NativeRecordWriteStaging(specification,
+                self.execution_plan, self.device, write_native_pages)
+            if owners > 1:
+                from sglang.kernels.ops.communication.all_reduce import IPCManager
+                services = RecordOwnerBindings(self.device, record_owner_process_group,
+                    allocate_host_record_storage, load_jit, IPCManager, self.page_size,
+                    prefill_bound, configuration.native_record_writes_replicated,
+                    CacheExecutionOptions.native_paged(prepare_in_parallel=configuration.prepare_in_parallel),
+                    native_selections_replicated=False)
+            else:
+                services = LocalCacheBindings(self.device, allocate_host_record_storage, load_jit,
+                    CacheExecutionOptions.native_paged(prepare_in_parallel=configuration.prepare_in_parallel))
+            self.memory_cache = UnifiedMemoryCache(specification, services)
+            self.cache_execution = NativeSparseCacheExecution(self.memory_cache,
+                self.execution_plan, self.writer_staging, specification, self.device,
+                maximum_prefill_record_count=prefill_bound)
+            if separate_record_planes:
+                views = [(key.view(self.dtype).reshape(-1, self.head_num, self.head_dim),
+                          value.view(self.dtype).reshape(-1, self.head_num, self.v_head_dim))
+                    for key, value in (self.memory_cache.get_device_record_planes(layer)
+                        for layer in range(self.layer_num))]
+            else:
+                views = [paired_record_views(pages, self.dtype, self.head_num,
+                    self.head_dim, self.v_head_dim) for pages in self.memory_cache.device_record_storage]
+            self.k_buffer = [pair[0] for pair in views]
+            self.v_buffer = [pair[1] for pair in views]
+            self.k_scale_buffer = self.v_scale_buffer = None
+            self.native_k_scale_buffer = self.native_v_scale_buffer = None
+            self.dq_k_buffer = self.dq_v_buffer = None
+            self._kv_buffer_descs = ()
+            self._init_data_ptrs_and_strides()
+
+        def set_kv_buffer(self, layer, loc_info, cache_k, cache_v, k_scale=None,
+                          v_scale=None, layer_id_override=None, dcp_kv_mask=None):
+            if (k_scale not in (None, 1.0) or v_scale not in (None, 1.0)
+                    or dcp_kv_mask is not None):
+                raise NotImplementedError('QSA native BF16 writes have no scales or DCP mask')
+            locations, _, _ = unwrap_write_loc(loc_info)
+            model_layer = layer.layer_id if layer_id_override is None else layer_id_override
+            local_layer = model_layer - self.start_layer
+            self.writer_staging.stage_native_records(local_layer, locations,
+                (cache_k.to(self.dtype), cache_v.to(self.dtype)))
+            self.cache_execution.publish_after_native_write(local_layer)
+
+        def prepare_cache_forward(self, batch, *, publish_active_query_count=True):
+            self.cache_execution.begin_forward(decode_like=batch.forward_mode.is_decode(),
+                active_query_counts=batch.global_num_tokens_gpu,
+                attention_data_parallel_rank=get_parallel().attn_dp_rank,
+                query_count=batch.out_cache_loc.numel(),
+                publish_active_query_count=publish_active_query_count,
+                current_logical_record_ids=batch.out_cache_loc)
+
+        def prepare_native_sparse_attention(self, layer_id, selected_records):
+            return self.cache_execution.prepare_attention(layer_id - self.start_layer, selected_records)
+
+        def _read_native_resident_records(self, record_planes, physical_record_ids, output):
+            if separate_record_planes:
+                slots = physical_record_ids.clamp_min(0).long()
+                output[0].copy_(record_planes[0].view(self.dtype).reshape(
+                    -1, self.head_num, self.head_dim).index_select(0, slots))
+                output[1].copy_(record_planes[1].view(self.dtype).reshape(
+                    -1, self.head_num, self.v_head_dim).index_select(0, slots))
+            else:
+                read_paired_records(record_planes[0], physical_record_ids, output, self.dtype,
+                    self.head_num, self.head_dim, self.v_head_dim)
+
+        def read_native_prefill_records(self, layer_id, selected_records, output):
+            self.cache_execution.reconstruct_prefill_records(layer_id - self.start_layer,
+                selected_records, output, self._read_native_resident_records)
+
+        def finish_cache_attention(self, layer_id):
+            self.cache_execution.finish_attention(layer_id - self.start_layer)
+
+        def finish_cache_forward(self):
+            pass
+
+        def register_native_full_pages(self, full_page_ids, *, prefer_device):
+            self.cache_execution.register_full_pages(full_page_ids, prefer_device=prefer_device)
+
+        def release_native_full_pages(self, full_page_ids):
+            self.cache_execution.release_full_pages(full_page_ids)
+
+        def clear_native_full_records(self):
+            self.cache_execution.clear_records()
+
+        def move_kv_cache(self, *args, **kwargs):
+            raise NotImplementedError('QSA logical record relocation requires a separate binding')
+
+        def get_device_storage_inventory(self):
+            return self.cache_execution.get_device_storage_inventory()
+
+        def close(self):
+            self.memory_cache.close()
+
+    return NativePairedPayloadPool
diff --git a/python/sglang/srt/ulacache/native_prefill_history.py b/python/sglang/srt/ulacache/native_prefill_history.py
