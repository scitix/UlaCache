+"""Diagnostic-only existing residency counters and sparse device snapshots."""
+import json
+import os
+from pathlib import Path
+
+
+def install():
+    import torch
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.managers.scheduler import Scheduler
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+    state = dict(armed=False, forwards=0, frames=[])
+    cuts = {64, 256, 512, 1024, 1984}
+    nsys_start = int(os.environ.get('UDCACHE_MATRIX_NSYS_START', '-1'))
+    nsys_stop = nsys_start + int(os.environ.get('UDCACHE_MATRIX_NSYS_STEPS', '8'))
+    local_stats = os.environ.get('UDCACHE_MATRIX_LOCAL_STATS', '1') == '1'
+
+    def nsys_boundary(runner, start):
+        services = getattr(runner.token_to_kv_pool, 'udcache_services', None)
+        if services is not None:
+            group = services.group.cpu_group
+        else:
+            # Rank-local DPA storage has no shared-TP cache services. Use the
+            # serving framework's existing CPU group for diagnostic boundaries.
+            from sglang.srt.distributed.parallel_state import get_tp_group
+            group = get_tp_group().cpu_group
+        torch.cuda.synchronize()
+        torch.distributed.barrier(group=group)
+        if start:
+            torch.cuda.cudart().cudaProfilerStart()
+        else:
+            torch.cuda.cudart().cudaProfilerStop()
+        torch.distributed.barrier(group=group)
+    tp_sampling = os.environ.get('UDCACHE_MATRIX_TP_HIT_SAMPLING') == '1'
+    samplers = []
+    if tp_sampling:
+        from ulacache.cache.prefetch import SharedIndexLifecycle
+        from ulacache.telemetry.cache_hits import CacheHitSampler
+        original_lifecycle_init = SharedIndexLifecycle.__init__
+        original_plan = SharedIndexLifecycle._plan_index
+
+        def lifecycle_init(self, *args, **kwargs):
+            original_lifecycle_init(self, *args, **kwargs)
+            self.udcache_hit_sampler = CacheHitSampler(self.pool)
+            samplers.append(self.udcache_hit_sampler)
+
+        def plan(self, layer, native_indices):
+            # The original lifecycle already selected its planning stream.
+            # Observe before hints, directory and retention metadata change.
+            self.udcache_hit_sampler.observe(layer, native_indices)
+            return original_plan(self, layer, native_indices)
+
+        SharedIndexLifecycle.__init__ = lifecycle_init
+        SharedIndexLifecycle._plan_index = plan
+    original_build = kv_cache_configurator.KVCacheConfigurator._build_dsa_kv_pool
+
+    def build(self, **kwargs):
+        pool = original_build(self, **kwargs)
+        cache = getattr(pool, 'udcache_local', None)
+        if cache is not None and local_stats:
+            cache.collect_stats = True
+        return pool
+
+    kv_cache_configurator.KVCacheConfigurator._build_dsa_kv_pool = build
+    original_forward = ModelRunner.forward
+
+    def forward(runner, batch, *args, **kwargs):
+        target = state['armed'] and not runner.is_draft_worker
+        if target and nsys_start >= 0 and state['forwards'] == nsys_start:
+            nsys_boundary(runner, True)
+        recording = target and nsys_start <= state['forwards'] < nsys_stop and nsys_start >= 0
+        if recording:
+            torch.cuda.nvtx.range_push('ulacache.target_forward')
+        try:
+            result = original_forward(runner, batch, *args, **kwargs)
+        finally:
+            if recording:
+                torch.cuda.nvtx.range_pop()
+        if state['armed'] and not runner.is_draft_worker and not torch.cuda.is_current_stream_capturing():
+            state['forwards'] += 1
+            if nsys_start >= 0 and state['forwards'] == nsys_stop:
+                nsys_boundary(runner, False)
+            if tp_sampling and state['forwards'] in cuts:
+                # Sparse diagnostic checkpoints survive a later tool failure.
+                # Read only1.5KiB at five idle-in-stream boundaries; never use
+                # this instrumented mode for the formal throughput curves.
+                rank = torch.distributed.get_rank()
+                root = Path(os.environ['UDCACHE_MATRIX_DIAGNOSTIC_DIR'])
+                root.mkdir(parents=True, exist_ok=True)
+                path = root / f'tp_hits.forward{state["forwards"]:06d}.rank{rank}.json'
+                temporary = path.with_suffix('.tmp')
+                value = dict(rank=rank, target_forwards=state['forwards'],
+                             counters=samplers[0].snapshot())
+                temporary.write_text(json.dumps(value, indent=2) + '\n')
+                temporary.replace(path)
+            cache = getattr(runner.token_to_kv_pool, 'udcache_local', None)
+            if cache is not None and local_stats and state['forwards'] in cuts:
+                state['frames'].append((state['forwards'], cache.stats.clone()))
+        return result
+
+    ModelRunner.forward = forward
+    original_pause = Scheduler.pause_generation
+
+    def pause(scheduler, request):
+        result = original_pause(scheduler, request)
+        if request.mode != 'in_place':
+            return result
+        runner = scheduler.tp_worker.model_runner
+        cache = getattr(runner.token_to_kv_pool, 'udcache_local', None)
+        if not state['armed']:
+            state.update(armed=True, forwards=0, frames=[])
+            if tp_sampling:
+                if len(samplers) != 1:
+                    raise RuntimeError('TP hit sampling requires exactly one target lifecycle')
+                samplers[0].set_enabled(True, reset=True)
+                torch.cuda.synchronize()
+            if cache is not None and local_stats:
+                cache.stats.zero_()
+                torch.cuda.synchronize()
+        elif state['forwards']:
+            rank = torch.distributed.get_rank()
+            value = dict(rank=rank, forwards=state['forwards'],
+                cache_kind=os.environ['UDCACHE_MATRIX_CACHE_KIND'],
+                local_stats_enabled=local_stats,
+                scope='Post-run diagnostic state; each counter set documents its own denominator. Not unique transfer bytes or formal performance.')
+            if cache is not None and local_stats:
+                frames = state['frames'] + [(state['forwards'], cache.stats)]
+                value['snapshots'] = [dict(forward=count, groups=tensor.cpu().tolist()) for count,tensor in frames]
+                value['layer_weights'] = [1 + len(f) for f in cache.groups.followers]
+                value['inventory'] = cache.memory_inventory()
+            if tp_sampling:
+                value['tp_cache_hits'] = samplers[0].snapshot()
+                samplers[0].set_enabled(False)
+            root = Path(os.environ['UDCACHE_MATRIX_DIAGNOSTIC_DIR'])
+            root.mkdir(parents=True, exist_ok=True)
+            path = root / f'counters.rank{rank}.json'
+            temp = path.with_suffix('.tmp')
+            temp.write_text(json.dumps(value, indent=2) + '\n')
+            temp.replace(path)
+            state['armed'] = False
+        return result
+
+    Scheduler.pause_generation = pause
