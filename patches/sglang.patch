+"""Normal-startup HY4 Preview PD bindings for native TP8 and DPA8.
+
+Call after the existing source-first compiler/dependency setup, before native
+ServerArgs validation, pool construction, or CUDA Graph capture. No service is
+started here. Capacities must come from the HY4 resource selection.
+"""
+from __future__ import annotations
+
+_binding = None
+
+
+def install(*, framework_directory, request_capacity, attention_mode,
+            role="decode", on_publication=None, dpa_configuration=None):
+    global _binding
+    from sglang.srt.ulacache.hy4_pd_layout import HY4PDLayout
+    from sglang.srt.ulacache.hy4_pd_validation import install as install_validation
+
+    if _binding is not None:
+        if (_binding["attention_mode"], _binding["role"], _binding["request_capacity"]) != (
+                attention_mode, role, request_capacity):
+            raise ValueError("HY4 PD is already bound to a different topology or capacity")
+        return _binding
+    if role not in ("prefill", "decode"):
+        raise ValueError("HY4 PD requires an explicit native prefill/decode role")
+    if role == "decode":
+        import os
+        required = {"ULACACHE_PD_CACHE_KIND": "ulacache",
+            "ULACACHE_PD_ATTENTION_MODE": attention_mode,
+            "SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE": "1"}
+        if attention_mode == "dpa":
+            required["ULACACHE_NATIVE_PD_LINEAR_MTP"] = "1"
+        if any(os.environ.get(key) != value for key, value in required.items()):
+            raise ValueError("HY4 PD requires explicit cache, topology, and native retirement selection")
+    layout = HY4PDLayout(framework_directory=framework_directory,
+        request_capacity=request_capacity, attention_mode=attention_mode)
+    validation = install_validation()
+    if role == "prefill":
+        from sglang.srt.ulacache.native_attention import require_scaled_fp8_sink as install_native_sink
+        install_native_sink()
+        # Prefill keeps its native pool/writer. Only the transport table loses
+        # unused target Index placeholders; independent draft state stays.
+        from sglang.srt.mem_cache import kv_cache_configurator as configurator
+        from sglang.srt.runtime_context import get_disagg, get_memory, get_parallel
+        from sglang.srt.disaggregation import decode, prefill, utils
+        from sglang.srt.disaggregation.base.conn import StateType
+        from sglang.srt.ulacache.pd_record_adapter import bind_native_pd_index_elision, bind_native_pd_state_compaction
+        bind_native_pd_index_elision(configurator, get_memory, get_parallel, get_disagg)
+        bind_native_pd_state_compaction(utils, StateType.DSA, decode, prefill)
+        receiver = dict(scope="native_prefill_state_metadata_only",
+            native_prefill_writer_unchanged=True, CPU_offload_qualified=False)
+    elif attention_mode == "tp":
+        from sglang.srt.ulacache.v0522_owner_tp import configuration as owner_configuration
+        from sglang.srt.ulacache.native_attention import install_owner_attention as install_hy4_native_reader
+        from sglang.srt.ulacache.pd_owner_adapter import install as install_owner
+        selected = owner_configuration()
+        if not (selected.enabled and selected.cpu_offload
+                and selected.native_kv_format == 'scaled656'):
+            raise ValueError("HY4 owner PD requires the explicitly selected native TP cache")
+        def install_target():
+            # The native factory selects the public TP pool directly.
+            from sglang.srt.ulacache.v0522_owner_tp import install
+            install()
+        install_hy4_native_reader()
+        receiver = install_owner(model_layout=layout, on_publication=on_publication,
+            target_cache_installer=install_target)
+    else:
+        from sglang.srt.ulacache.v0522_dpa import DPAConfiguration, install as install_native_dpa
+        from sglang.srt.ulacache.pd_record_adapter import install as install_records
+        from ulacache.transfer.native_paged_receive import NativePagedRecordReceiveWindow
+        if (not isinstance(dpa_configuration, DPAConfiguration)
+                or dpa_configuration.maximum_running_requests * 8 != request_capacity):
+            raise ValueError("HY4 DPA PD requires its explicit native global/local request geometry")
+        def install_target():
+            return install_native_dpa(dpa_configuration)
+        install_records(model_layout=layout, target_cache_installer=install_target,
+            receive_window_type=NativePagedRecordReceiveWindow)
+        receiver = dict(scope="native_DPA_record_receive_window",
+            independent_draft_Index=True, actual_GPU_qualified=False,
+            target_backend='v0522_dpa.NativePagedResidency')
+    _binding = dict(complete=True, scope="normal_startup_binding_only",
+        attention_mode=attention_mode, role=role, request_capacity=request_capacity,
+        model_layout=layout.evidence(), validation=validation, receiver=receiver,
+        actual_GPU_qualified=False, full_PD_serving_qualified=False)
+    return _binding
diff --git a/python/sglang/srt/ulacache/hy4_pd_layout.py b/python/sglang/srt/ulacache/hy4_pd_layout.py
new file mode 100644
index 0000000000000000000000000000000000000000..be011ff5d44fcdf7d2dd474dc6ed1424fc9978cd
