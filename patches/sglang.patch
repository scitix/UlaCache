+"""Dependency-free configuration shared by the native model entry points."""
+
+from dataclasses import asdict, dataclass, fields
+from importlib import import_module
+import json
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class PoolBinding:
+    module: str
+    configuration_class: str
+    installer: str
+    capacity_fields: tuple[str, str]
+
+
+POOL_BINDINGS = {
+    'dsa_optimized': PoolBinding('sglang.srt.ulacache.native_dsa_optimized_pool', 'NativeSparseLatentPoolConfiguration',
+        'install_native_sparse_latent_pool', ('device_record_capacity', 'host_record_capacity')),
+    'dsa': PoolBinding('sglang.srt.ulacache.native_dsa_pool', 'NativeSparseLatentPoolConfiguration',
+        'install_native_sparse_latent_pool', ('device_record_capacity', 'host_record_capacity')),
+    'paged': PoolBinding('sglang.srt.ulacache.native_paged_pool', 'NativePagedPoolConfiguration',
+        'install_native_paged_pool', ('device_full_token_capacity', 'host_full_token_capacity')),
+    'glm_flash': PoolBinding('sglang.srt.ulacache.native_glm_flash_pool', 'NativeGlmFlashPoolConfiguration',
+        'install_native_glm_flash_pool', ('device_record_capacity', 'host_record_capacity')),
+    'qsa': PoolBinding('sglang.srt.ulacache.native_qsa_pool', 'NativeQsaPoolConfiguration',
+        'install_native_qsa_pool', ('device_record_capacity', 'host_record_capacity')),
+}
+
+
+@dataclass(frozen=True)
+class NativeTensorParallelConfiguration:
+    prefill_window_rows: int = 512
+    low_query_pull_blocks: int = 0
+    reuse_prefill_metadata: bool = False
+
+
+@dataclass(frozen=True)
+class NativeDataParallelConfiguration:
+    device_record_capacity: int
+    host_record_capacity: int
+    device_cache_budget_bytes: int
+    host_cache_budget_bytes: int = 128_000_000_000
+    cpu_prefill: bool = False
+    parallel_prepare: bool = False
+    parallel_victims: bool = False
+    asynchronous_followers: bool = False
+
+
+ADAPTERS = ('native', 'native_tp', 'native_dpa', *POOL_BINDINGS)
+CAPACITY_FIELDS = ('device_token_capacity_per_owner', 'host_token_capacity_per_owner')
+LEGACY_CONFIGURATION_VARIABLES = (
+    'ULACACHE_NATIVE_DSA_CONFIGURATION', 'ULACACHE_NATIVE_PAGED_CONFIGURATION',
+    'ULACACHE_GLM_FLASH_CONFIGURATION', 'ULACACHE_QSA_CONFIGURATION',
+    'ULACACHE_NATIVE_OWNER_INDEX_CONFIGURATION',
+    'ULACACHE_V0522_CONFIGURATION',
+)
+
+
+def _object(value, label):
+    if not isinstance(value, dict):
+        raise ValueError(f'{label} must be a JSON object')
+    return dict(value)
+
+
+def _unique_keys(items):
+    result = {}
+    for key, value in items:
+        if key in result:
+            raise ValueError(f'Duplicate configuration field: {key}')
+        result[key] = value
+    return result
+
+
+def read_json(path):
+    return _object(json.loads(Path(path).read_text(), object_pairs_hook=_unique_keys), 'Configuration')
+
+
+def _construct(configuration_class, settings):
+    known = {field.name for field in fields(configuration_class)}
+    unknown = settings.keys() - known
+    if unknown:
+        raise ValueError(f'Unknown {configuration_class.__name__} fields: {sorted(unknown)}')
+    try:
+        configuration = configuration_class(**settings)
+    except TypeError as error:
+        raise ValueError(f'Invalid {configuration_class.__name__}: {error}') from error
+    defaults = {field.name: field.default for field in fields(configuration_class)}
+    for name, value in vars(configuration).items():
+        if configuration_class.__name__ == 'OwnerTPConfiguration':
+            # Its existing constructor validates optional launch tuning and
+            # PrefetchPolicy, including the boolean-compatible policy form.
+            if name in ('prefetch', 'low_query_pull_blocks'):
+                continue
+        if type(defaults[name]) is bool and type(value) is not bool:
+            raise ValueError(f'{name} must be boolean')
+        if (name.startswith('maximum_') or name.endswith('_budget_bytes')
+                or name in ('storage_owner_count', 'index_compression_ratio',
+                    'minimum_native_profile_available_bytes', 'prefill_window_rows')):
+            if (name == 'prefill_window_rows' and value == 0
+                    and configuration_class.__name__ == 'OwnerTPConfiguration'):
+                continue
+            if ((value is None and defaults[name] is not None)
+                    or (value is not None and (type(value) is not int or value <= 0))):
+                raise ValueError(f'{name} must be a positive integer or null')
+        if name in ('device_record_capacity', 'device_full_token_capacity'):
+            if type(value) is not int or value <= 0:
+                raise ValueError(f'{name} must be a positive integer')
+        if name in ('host_record_capacity', 'host_full_token_capacity', 'low_query_pull_blocks'):
+            if type(value) is not int or value < 0:
+                raise ValueError(f'{name} must be a nonnegative integer')
+        if name == 'index_prefill_score_mode' and value not in ('native', 'distributed'):
+            raise ValueError('Index prefill score mode must be native or distributed')
+    return configuration
+
+
+def decode_pool_configuration(adapter, settings):
+    """Decode both legacy pool JSON and the normalized model configuration."""
+    if adapter not in POOL_BINDINGS:
+        raise ValueError(f'Unknown native pool adapter: {adapter}')
+    settings = _object(settings, 'Pool settings')
+    if 'managed_compression_ratios' in settings:
+        ratios = settings['managed_compression_ratios']
+        if (not isinstance(ratios, (tuple, list)) or not ratios
+                or any(type(ratio) is not int or ratio <= 0 for ratio in ratios)):
+            raise ValueError('Managed compression ratios must be positive integers')
+        settings['managed_compression_ratios'] = tuple(ratios)
+    if settings.get('allocation_plan') is not None:
+        from ulacache import CacheCapacityPlan, CacheMemoryBudget, CacheMemoryUsage
+
+        plan = _object(settings['allocation_plan'], 'Allocation plan')
+        try:
+            for name in ('device_token_capacity_per_owner', 'host_token_capacity_per_owner', 'storage_owner_count'):
+                if type(plan[name]) is not int:
+                    raise ValueError(f'Allocation plan {name} must be an integer')
+            for group in ('memory_usage', 'memory_budget'):
+                values = _object(plan[group], group)
+                if any(type(value) is not int or value < 0 for value in values.values()):
+                    raise ValueError(f'{group} bytes must be nonnegative integers')
+            settings['allocation_plan'] = CacheCapacityPlan(**dict(plan,
+                memory_usage=CacheMemoryUsage(**_object(plan['memory_usage'], 'Memory usage')),
+                memory_budget=CacheMemoryBudget(**_object(plan['memory_budget'], 'Memory budget'))))
+        except (KeyError, TypeError) as error:
+            raise ValueError(f'Invalid allocation plan: {error}') from error
+    binding = POOL_BINDINGS[adapter]
+    configuration = _construct(getattr(import_module(binding.module), binding.configuration_class), settings)
+    plan = getattr(configuration, 'allocation_plan', None)
+    if plan is not None:
+        device, host = binding.capacity_fields
+        if ((getattr(configuration, device), getattr(configuration, host)) != (
+                plan.device_token_capacity_per_owner, plan.host_token_capacity_per_owner)
+                or (configuration.storage_owner_count is not None
+                    and configuration.storage_owner_count != plan.storage_owner_count)):
+            raise ValueError('Cold capacities and owner count must match the complete allocation plan')
+        plan.validate_memory_budget()
+    return configuration
+
+
+def load_pool_configuration(adapter, path):
+    return decode_pool_configuration(adapter, read_json(path))
+
+
+@dataclass(frozen=True)
+class ModelIntegrationConfiguration:
+    adapter: str
+    pool: object
+    cpu_ngram_embedding: bool = False
+    framework_release: str | None = None
+
+    def describe(self):
+        result = dict(schema_version=1, adapter=self.adapter,
+            pool=asdict(self.pool) if self.pool is not None else {},
+            cpu_ngram_embedding=self.cpu_ngram_embedding,
+            capacity_unit='original_tokens_per_storage_owner_before_native_guard')
+        if self.framework_release is not None:
+            result['framework_release'] = self.framework_release
+        return result
+
+
+def decode_model_configuration(document):
+    document = _object(document, 'Model configuration')
+    unknown = document.keys() - {'schema_version', 'adapter', 'capacity', 'options',
+        'cpu_ngram_embedding', 'framework_release'}
+    if unknown:
+        raise ValueError(f'Unknown model configuration fields: {sorted(unknown)}')
+    if type(document.get('schema_version')) is not int or document['schema_version'] != 1:
+        raise ValueError('The model configuration requires schema_version 1')
+    adapter = document.get('adapter')
+    if adapter not in ADAPTERS:
+        raise ValueError(f'Choose one native adapter from {ADAPTERS}')
+    release = document.get('framework_release')
+    if release not in (None, 'v0.5.22'):
+        raise ValueError('The explicit framework release must be v0.5.22')
+    cpu_ngram = document.get('cpu_ngram_embedding', False)
+    if type(cpu_ngram) is not bool or (cpu_ngram and adapter not in ('native', 'qsa')):
+        raise ValueError('CPU N-gram placement is supported only by native and QSA entries')
+    settings = _object(document.get('options', {}), 'Adapter options')
+    capacity = document.get('capacity')
+    if adapter in ('native', 'native_tp'):
+        if capacity is not None:
+            raise ValueError('Native/TP capacity uses the original framework sizing arguments')
+        if adapter == 'native':
+            if settings:
+                raise ValueError('Native control options belong in the original server arguments')
+            pool = None
+        else:
+            if release == 'v0.5.22':
+                from sglang.srt.ulacache.v0522_owner_tp import OwnerTPConfiguration
+
+                settings.setdefault('enabled', True)
+                pool = _construct(OwnerTPConfiguration, settings)
+                if not pool.enabled:
+                    raise ValueError('Select the native adapter to disable owner TP')
+            else:
+                pool = _construct(NativeTensorParallelConfiguration, settings)
+    else:
+        capacity = _object(capacity, 'Per-owner token capacity')
+        if set(capacity) != set(CAPACITY_FIELDS):
+            raise ValueError(f'Capacity requires exactly {CAPACITY_FIELDS}')
+        device, host = (('device_record_capacity', 'host_record_capacity')
+            if adapter == 'native_dpa' else POOL_BINDINGS[adapter].capacity_fields)
+        # Capacities have one public unit; adapter-specific record/tier names
+        # never override that declaration through the options object.
+        if any(name in settings for binding in POOL_BINDINGS.values() for name in binding.capacity_fields):
+            raise ValueError('Declare cold token capacities in capacity, not adapter options')
+        settings.update({device: capacity[CAPACITY_FIELDS[0]], host: capacity[CAPACITY_FIELDS[1]]})
+        if adapter == 'native_dpa':
+            if release == 'v0.5.22':
+                from sglang.srt.ulacache.v0522_dpa import DPAConfiguration
+
+                pool = _construct(DPAConfiguration, settings)
+            else:
+                pool = _construct(NativeDataParallelConfiguration, settings)
+        else:
+            pool = decode_pool_configuration(adapter, settings)
+        if adapter == 'qsa' and pool.storage_owner_count != 1:
+            raise NotImplementedError('QSA distributed owners require a validated feature-replica topology')
+    return ModelIntegrationConfiguration(adapter, pool, cpu_ngram, release)
+
+
+def load_model_configuration(path):
+    return decode_model_configuration(read_json(path))
