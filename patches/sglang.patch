index 0000000000000000000000000000000000000000..6c3d18a30cca88eaf73f044444e9b53dcebcff5c
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_dpa_geometry_adapter.py
@@ -0,0 +1,93 @@
+"""Bind actual captured DPA tensor shapes to native replay buckets on the CPU."""
+import json
+import os
+from pathlib import Path
+
+
+def install(*, replay_observer=None):
+    import torch
+    from sglang.srt.model_executor.runner.decode_cuda_graph_runner import DecodeCudaGraphRunner
+    from ulacache.cache.local_cache import UnifiedLocalResidency
+
+    root=Path(os.environ['UDCACHE_NATIVE_GEOMETRY_DIR'])
+    state=dict(capture=None,buckets={},seen=set(),replays=0)
+
+    def save(name,value):
+        root.mkdir(parents=True,exist_ok=True)
+        rank=torch.distributed.get_rank()
+        path=root/f'{name}.rank{rank}.json'
+        temporary=path.with_suffix('.tmp')
+        temporary.write_text(json.dumps(value,indent=2)+'\n')
+        temporary.replace(path)
+
+    original_plan=UnifiedLocalResidency.plan
+
+    def plan(cache,layer,selected,current):
+        capture=state['capture']
+        if capture is not None and torch.cuda.is_current_stream_capturing():
+            record=dict(selected_rows=int(selected.shape[0]),topk=int(selected.shape[1]),
+                current_rows=int(current.numel()),selected_dtype=str(selected.dtype),
+                current_dtype=str(current.dtype),native_query_bound=cache.max_queries)
+            key=str(layer)
+            prior=capture['layers'].get(key)
+            if prior is not None and prior!=record:
+                raise RuntimeError('A captured DPA layer has inconsistent query geometry')
+            capture['layers'][key]=record
+        return original_plan(cache,layer,selected,current)
+
+    UnifiedLocalResidency.plan=plan
+    original_capture=DecodeCudaGraphRunner.capture_one_shape
+
+    def capture(runner,size,*args,**kwargs):
+        if runner.model_runner.is_draft_worker:
+            return original_capture(runner,size,*args,**kwargs)
+        if runner.ragged_verify_mode:
+            raise ValueError('This geometry observer requires native uniform-width verification')
+        width=int(runner.captured_req_width)
+        item=dict(size=int(size),verify_width=width,layers={})
+        if state['capture'] is not None:
+            raise RuntimeError('Nested DPA Graph capture needs a distinct native binding')
+        state['capture']=item
+        try:
+            result=original_capture(runner,size,*args,**kwargs)
+        finally:
+            state['capture']=None
+        if item['layers']:
+            state['buckets'][f'{int(size)}:{width}']=item
+            save('CAPTURE',dict(pid=os.getpid(),policy=os.environ.get('UDCACHE_RECENCY_POLICY','pb'),
+                buckets=state['buckets'],gpu_observer_kernels=0,
+                scope='Actual tensor metadata recorded during Graph capture; no device readback or probe kernel.'))
+        return result
+
+    DecodeCudaGraphRunner.capture_one_shape=capture
+    original_load=DecodeCudaGraphRunner.load_batch
+
+    def load(runner,batch,*args,**kwargs):
+        result=original_load(runner,batch,*args,**kwargs)
+        if runner.model_runner.is_draft_worker:
+            return result
+        raw=int(runner.raw_bs)
+        bucket=int(runner.bs)
+        width=int(runner.captured_req_width)
+        raw_queries=int(runner.raw_num_token)
+        captured=state['buckets'].get(f'{bucket}:{width}')
+        if captured is None:
+            raise RuntimeError('Native DPA replay has no captured tensor-shape binding')
+        state['replays'] += 1
+        value=dict(pid=os.getpid(),raw_requests=raw,source_request_bucket=bucket,
+            raw_queries=raw_queries,verify_width=width,captured=captured,
+            native_replay_sequence=state['replays'],
+            native_load_sequence=state['replays'],
+            sequence_counts='load_batch calls, including MTP preplanning',
+            native_replay_tensor_binding_verified=True,gpu_observer_kernels=0,
+            scope='Actual native replay and captured tensor metadata; no device readback.')
+        if replay_observer is not None:
+            replay_observer(value)
+        key=(raw,bucket,width,raw_queries)
+        if key not in state['seen']:
+            state['seen'].add(key)
+            path=f'REPLAY.raw{raw}.bucket{bucket}.width{width}.queries{raw_queries}'
+            save(path,value)
+        return result
+
+    DecodeCudaGraphRunner.load_batch=load
