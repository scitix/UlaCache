+"""Startup-only native model, allocator, and cache storage receipts."""
+import json
+import os
+from dataclasses import asdict
+from functools import wraps
+from pathlib import Path
+
+
+def _owns_cache_storage(value):
+    # Native transport wrappers subclass UlaCache owners in a framework
+    # namespace. Their backing allocations still belong in the cache union.
+    return any(owner.__module__.startswith(("ulacache", "sglang.srt.ulacache", "sglang.srt.mem_cache",
+                                           "sglang.srt.managers.hisparse_coordinator"))
+               for owner in type(value).__mro__)
+
+
+def _include_device_storage_inventory(allocations, inventory, device, owner_name):
+    for pointer, size in inventory.items():
+        key = "cuda:" + str(pointer)
+        if key in allocations and allocations[key]["bytes"] != size:
+            raise ValueError("Native and UlaCache backing storage disagree")
+        allocations.setdefault(key, dict(bytes=size, device=str(device), example=owner_name))
+
+
+def _include_host_storage_inventory(allocations, inventory, owner_name):
+    for pointer, size in inventory.items():
+        key = "cpu:" + str(pointer)
+        if key in allocations and allocations[key]["bytes"] != size:
+            raise ValueError("Native and UlaCache host backing storage disagree")
+        allocations.setdefault(key, dict(bytes=size, device="cpu", example=owner_name))
+
+
+def _include_native_adapter_storage(allocations, pool, device):
+    # Outer native layer adapters retain address workspaces beyond the payload
+    # pool. Their Python namespace and Graph-only aliases must not hide them.
+    for name in ('native_sparse_cache_adapter', '_native_sparse_cache_adapter'):
+        adapter = getattr(pool, name, None)
+        provider = getattr(adapter, 'get_device_storage_inventory', None)
+        if provider is not None:
+            _include_device_storage_inventory(allocations, provider(), device,
+                'native_layer_adapter_inventory_' + name)
+
+
+def _native_memory_caches(pool):
+    caches = {str(name): tier.memory_cache
+        for name, tier in getattr(pool, 'native_paged_tiers', {}).items()}
+    if cache := getattr(pool, 'memory_cache', None):
+        caches['sparse_history'] = cache
+    return caches
+
+
+def _history_allocator(allocator):
+    """Separate complete history from a hybrid allocator's bounded window."""
+    logical = getattr(allocator, 'logical_attn_allocator', allocator)
+    return getattr(logical, 'full_attn_allocator', logical)
+
+
+def _record_distribution_inventory(pool, allocator):
+    """Report actual record ownership separately from model parallelism."""
+    directory = getattr(pool, 'flowkv_slot_directory', None)
+    if directory is None:
+        caches = _native_memory_caches(pool)
+        if not caches:
+            return None
+        partitions = {}
+        for name, cache in caches.items():
+            specification = cache.cache_specification
+            capacity = specification.capacity_plan
+            inventory = cache.get_memory_inventory()
+            owner_count = inventory.get('storage_owner_count', 1)
+            partitions[name] = dict(storage_layout=asdict(specification.storage_layout),
+                storage_owner_count=owner_count,
+                storage_owner_rank=inventory.get('storage_owner_rank', 0),
+                storage_owner_process_ranks=inventory.get('storage_owner_process_ranks'),
+                device_record_capacity_per_owner=capacity.device_record_capacity,
+                host_record_capacity_per_owner=capacity.host_record_capacity,
+                reserved_logical_record_count=capacity.reserved_logical_record_count * owner_count,
+                physical_storage_bank_count=specification.layer_reuse.unique_key_value_storage_count,
+                device_cold_payload_bytes=inventory.get('gpu_cold_key_value_bytes', inventory['gpu_kv_bytes']),
+                host_cold_payload_bytes=inventory['cpu_kv_bytes'])
+        return dict(kind='native_sparse_cache_partitions', required_partitions=partitions,
+            allocator_usable_history_token_slots=allocator.size)
+    host = getattr(pool, 'flowkv_host', None)
+    return dict(
+        kind='owner_striped_records', owner_count=directory.peers,
+        owner_rank=pool.flowkv_rank, namespaces=pool._flowkv_namespaces,
+        global_record_capacity=directory.global_slots,
+        gpu_cold_record_capacity_per_owner=pool.flowkv_shards.shape[1],
+        cpu_cold_record_capacity_per_owner=host.host_slots if host is not None else 0,
+        replicated_resident_records_per_rank=pool.flowkv_layout.rows_per_layer,
+        native_storage_records_per_page=pool.page_size,
+        allocator_records_per_page=allocator.page_size,
+        allocator_usable_logical_records=allocator.size,
+        scope='Cold record owners are disjoint; local attention views are replicas. Do not infer either capacity from TP size alone.')
+
+
+class ModelStorageInventory:
+    """Count backing allocations retained by parameters and native model state."""
+
+    def __init__(self, tensor_type):
+        self.tensor_type = tensor_type
+        self.storage_by_pointer = {}
+        self.registered_storage_pointers = set()
+        self.visited_objects = set()
+
+    def collect_storage(self, value, path, registered=False):
+        if isinstance(value, self.tensor_type):
+            if value.device.type == "cuda":
+                storage = value.untyped_storage()
+                if storage.nbytes():
+                    pointer = str(storage.data_ptr())
+                    self.storage_by_pointer.setdefault(pointer, dict(bytes=storage.nbytes(), example=path))
+                    if registered:
+                        self.registered_storage_pointers.add(pointer)
+            return
+        if id(value) in self.visited_objects:
+            return
+        self.visited_objects.add(id(value))
+        if isinstance(value, dict):
+            for key, item in value.items():
+                self.collect_storage(item, path + "." + str(key), registered)
+        elif isinstance(value, (list, tuple)):
+            for index, item in enumerate(value):
+                self.collect_storage(item, path + f"[{index}]", registered)
+        elif hasattr(value, "__dict__") and any(
+            owner.__module__.startswith(("sglang.srt.layers.quantization", "sglang.srt.layers.moe"))
+            for owner in type(value).__mro__
+        ):
+            # Native quantizers and MoE runners also own unregistered tensors.
+            for attribute, item in vars(value).items():
+                self.collect_storage(item, path + "." + attribute, registered)
+
+
+def install():
+    if not os.environ.get('UDCACHE_MATRIX_AUDIT_DIR'):
+        return
+    import torch
+    from sglang.srt.model_executor.model_runner_components import cuda_graph_setup
+    original = cuda_graph_setup.capture_decode_graph
+
+    def audit(runner, coordinator=None, cache_tree=None):
+        role = "draft" if runner.is_draft_worker else "target"
+        rank = torch.distributed.get_rank()
+        model_inventory = ModelStorageInventory(torch.Tensor)
+        model_collect = model_inventory.collect_storage
+        model = model_inventory.storage_by_pointer
+        model_registered = model_inventory.registered_storage_pointers
+
+        for name, tensor in list(runner.model.named_parameters()) + list(runner.model.named_buffers()):
+            model_collect(tensor, name, True)
+        modules = dict(runner.model.named_modules())
+        names = {id(module): name for name, module in modules.items()}
+        for name, module in modules.items():
+            for attribute, value in vars(module).items():
+                if attribute not in ("_parameters", "_buffers", "_modules"):
+                    model_collect(value, name + "." + attribute)
+        # CP may retain full originals beside materialized TP slices. Count
+        # only this runner's module owners, once per backing CUDA allocation.
+        from sglang.srt.layers.cp.cp_decode_attn_tp import get_cp_decode_attn_tp_ctx
+        for (owner, attribute), (raw, sliced, _) in get_cp_decode_attn_tp_ctx()._slice_cache.items():
+            if owner in names:
+                model_collect(raw, names[owner] + "." + attribute + ".cp_original")
+                model_collect(sliced, names[owner] + "." + attribute + ".tp_slice")
+        pool = runner.token_to_kv_pool
+        payload_pool = getattr(pool, 'full_kv_pool', pool)
+        seen, tensors = set(), {}
+
+        def collect(value, path, depth=0, root_object=False):
+            if id(value) in seen or depth > 8:
+                return
+            seen.add(id(value))
+            if isinstance(value, torch.Tensor):
+                if value.numel():
+                    storage = value.untyped_storage()
+                    key = value.device.type + ":" + str(storage.data_ptr())
+                    tensors[key] = dict(bytes=storage.nbytes(), device=str(value.device),
+                        dtype=str(value.dtype), shape=list(value.shape), example=path)
+            elif isinstance(value, (list, tuple)):
+                for i, item in enumerate(value):
+                    collect(item, path + f"[{i}]", depth + 1)
+            elif isinstance(value, dict):
+                for key, item in value.items():
+                    collect(item, path + "." + str(key), depth + 1)
+            elif hasattr(value, "__dict__") and (root_object or _owns_cache_storage(value)):
+                for key, item in vars(value).items():
+                    collect(item, path + "." + key, depth + 1)
+
+        collect(pool, "pool", root_object=True)
+        if cache_tree is not None:
+            # Native HiCache host pools belong to the scheduler's cache tree,
+            # outside ModelRunner and its device KV pool.
+            collect(cache_tree, "prefix_cache", root_object=True)
+        allocator = runner.token_to_kv_pool_allocator
+        collect(allocator, "allocator", root_object=True)
+        collect(runner.req_to_token_pool, "request_pool", root_object=True)
+        for name in ("attn_backend", "decode_attn_backend"):
+            backend = getattr(runner, name, None)
+            collect(getattr(backend, "cp_index_scorer", None), name + ".cp_scorer", root_object=True)
+        if coordinator is not None:
+            collect(coordinator, "hisparse", root_object=True)
+            collect(getattr(coordinator, "mem_pool_host", None), "hisparse.host", root_object=True)
+        if unified := getattr(pool, "udcache_local", None):
+            # Include the library's explicit inventory as well as native
+            # Index/allocator ownership; both must agree on shared storage.
+            _include_device_storage_inventory(tensors, unified.device_storage_inventory(),
+                runner.device, "udcache_owned_inventory")
+        if inventory_provider := getattr(pool, "get_device_storage_inventory", None):
+            _include_device_storage_inventory(tensors, inventory_provider(),
+                runner.device, "native_sparse_pool_inventory")
+        _include_native_adapter_storage(tensors, pool, runner.device)
+        if payload_pool is not pool:
+            if inventory_provider := getattr(payload_pool, "get_device_storage_inventory", None):
+                _include_device_storage_inventory(tensors, inventory_provider(),
+                    runner.device, "native_hybrid_payload_inventory")
+        for name, cache in _native_memory_caches(payload_pool).items():
+            _include_host_storage_inventory(tensors, cache.get_host_storage_inventory(),
+                "native_host_inventory_" + name)
+        native_paged_tiers = getattr(pool, "native_paged_tiers", {})
+        for ratio, tier in native_paged_tiers.items():
+            _include_device_storage_inventory(tensors, tier.get_device_storage_inventory(),
+                runner.device, f"native_paged_inventory_ratio_{ratio}")
+        fields = {}
+        for name in ["size", "full_size", "swa_size", "page_size", "layer_num", "start_layer", "end_layer", "kv_cache_dim",
+                     "_flowkv_global_rows", "_flowkv_storage_size", "_flowkv_namespaces"]:
+            value = getattr(pool, name, None)
+            if isinstance(value, (int, str, bool)):
+                fields[name] = value
+        logical = _history_allocator(allocator)
+        fields["logical_allocator_size"] = logical.size
+        if hasattr(allocator, 'size_swa'):
+            fields['window_allocator_size'] = allocator.size_swa
+        fields["native_request_slots"] = runner.req_to_token_pool.size
+        fields["request_address_token_slots"] = runner.req_to_token_pool.req_to_token.numel()
+        staging = getattr(allocator, "hisparse_attn_allocator", None)
+        if staging is not None:
+            fields["device_staging_allocator_size"] = staging.size
+        if coordinator is not None:
+            fields["hisparse_device_buffer_size"] = coordinator.device_buffer_size
+            fields["hisparse_padded_buffer_size"] = coordinator.padded_buffer_size
+        index = getattr(payload_pool, "index_key_cache", None)
+        fields["index_nonempty_layers"] = [i for i, t in enumerate(index.buffer) if t.numel()] if index is not None else []
+        index_runtime = getattr(payload_pool, 'native_distributed_indexer', None)
+        index_distribution = None
+        if index_runtime is not None:
+            ownership = index_runtime.ownership
+            index_distribution = dict(
+                mode='ulacache_distributed_native_fp8',
+                owner_count=ownership.owner_count, owner_rank=index_runtime.rank,
+                logical_record_capacity=ownership.logical_record_capacity,
+                reserved_record_count=ownership.reserved_record_count,
+                local_record_capacity=ownership.local_record_capacity,
+                local_native_pages=ownership.native_page_count,
+                encoded_bytes_per_record=ownership.bytes_per_record,
+                cold_storage_bytes=index_runtime.storage.numel(),
+                compact_scores=index_runtime.score_group.compact_scores,
+                maximum_queries=index_runtime.maximum_queries,
+                decode_maximum_queries=payload_pool.maximum_padded_query_count,
+                prefill_query_chunk_count=index_runtime.prefill_query_chunk_count,
+                prefill_score_mode=index_runtime.ragged_score_mode,
+                maximum_columns=index_runtime.maximum_columns)
+        elif getattr(payload_pool, "_ulacache_native_tp_cache", False) and index is not None:
+            sharded = bool(getattr(index, "is_owner_compact", False))
+            index_distribution = dict(
+                mode="owner_sharded" if sharded else "replicated",
+                owner_count=payload_pool._flowkv_storage_size if sharded else 1,
+                owner_rank=payload_pool.flowkv_rank if sharded else 0,
+                logical_record_capacity=payload_pool.index_buf_size,
+                cold_storage_bytes=sum(buffer.nbytes for buffer in index.buffer),
+                anchor_layers=fields["index_nonempty_layers"],
+            )
+        host = getattr(pool, "flowkv_host", None)
+        unified = getattr(pool, "udcache_local", None)
+        library = (host.capacity_audit() if host is not None else
+                   unified.memory_inventory() if unified is not None else None)
+        if memory_cache := getattr(payload_pool, "memory_cache", None):
+            library = memory_cache.get_memory_inventory()
+        if native_paged_tiers:
+            library = {str(ratio): tier.memory_cache.get_memory_inventory()
+                       for ratio, tier in native_paged_tiers.items()}
+        value = dict(role=role, rank=rank, pool_type=type(pool).__name__, allocator_type=type(allocator).__name__,
+            pool_fields=fields, model_storage=model, model_storage_bytes=sum(s["bytes"] for s in model.values()),
+            model_registered_storage_bytes=sum(model[p]["bytes"] for p in model_registered),
+            model_auxiliary_storage_bytes=sum(s["bytes"] for p, s in model.items() if p not in model_registered),
+            pool_storage=tensors, gpu_pool_storage_bytes=sum(s["bytes"] for s in tensors.values() if s["device"].startswith("cuda")),
+            cpu_pool_storage_bytes=sum(s["bytes"] for s in tensors.values() if s["device"] == "cpu"),
+            library=library, record_distribution=_record_distribution_inventory(payload_pool, logical),
+            index_distribution=index_distribution,
+            cuda_allocated_bytes=torch.cuda.memory_allocated(),
+            cuda_reserved_bytes=torch.cuda.memory_reserved(), scope="Native initialization receipt; persistent model/cache inventory, not decode performance")
+        root = Path(os.environ["UDCACHE_MATRIX_AUDIT_DIR"])
+        root.mkdir(parents=True, exist_ok=True)
+        path = root / f"{role}.rank{rank}.json"
+        temporary = path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(value, indent=2) + "\n")
+        temporary.replace(path)
+
+    def capture(*, model_runner):
+        result = original(model_runner=model_runner)
+        audit(model_runner)
+        return result
+
+    cuda_graph_setup.capture_decode_graph = capture
+    # Native MTP builds draft graphs in its worker, outside the target graph
+    # setup entry. Audit both initialized runners after that native entry.
+    from sglang.srt.speculative.eagle_worker_v2 import EAGLEWorkerV2
+    original_worker = EAGLEWorkerV2.init_cuda_graphs
+
+    def worker_graphs(worker, *args, **kwargs):
+        result = original_worker(worker, *args, **kwargs)
+        audit(worker.target_worker.model_runner)
+        audit(worker.draft_worker.draft_runner)
+        return result
+
+    EAGLEWorkerV2.init_cuda_graphs = worker_graphs
+    from sglang.srt.managers.scheduler import Scheduler
+    original_scheduler = Scheduler.__init__
+
+    @wraps(original_scheduler)
+    def scheduler_init(scheduler, *args, **kwargs):
+        original_scheduler(scheduler, *args, **kwargs)
+        audit(scheduler.tp_worker.model_runner, getattr(scheduler, "hisparse_coordinator", None),
+              cache_tree=getattr(scheduler, "tree_cache", None))
+        worker = getattr(scheduler, "draft_worker", None)
+        if worker is not None:
+            audit(worker.draft_worker.draft_runner)
+
+    Scheduler.__init__ = scheduler_init
