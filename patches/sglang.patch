+"""Bind original native FP8 Index codecs and buffers to shared TP owners."""
+
+
+def create_native_index_score_group(configuration, serving_group, *, max_queries,
+                                    max_page_width, device):
+    if getattr(configuration, 'index_score_transport', 'flash_ag') == 'nccl':
+        from ulacache.indexer.nccl import NCCLIndexOwner
+        from sglang.srt.distributed.device_communicators.pynccl import PyNcclCommunicator
+
+        return NCCLIndexOwner(serving_group, max_queries=max_queries,
+            max_page_width=max_page_width, device=device, communicator_factory=PyNcclCommunicator)
+    from sglang.srt.distributed.device_communicators.flash_ag_index import create_index_owner
+
+    return create_index_owner(serving_group, max_queries=max_queries,
+        max_page_width=max_page_width, device=device)
+
+
+def native_fp8_index_column_bound(request_context_tokens, compression_ratio):
+    """Match native raw page64 rounding before compressed page-table slicing."""
+    if (type(request_context_tokens) is not int or request_context_tokens < 1
+            or type(compression_ratio) is not int or compression_ratio < 1
+            or 64 % compression_ratio):
+        raise ValueError('Declare positive native context tokens and a page64 compression divisor')
+    raw_pages = (request_context_tokens + 63) // 64
+    return ((raw_pages + compression_ratio - 1) // compression_ratio) * 64
+
