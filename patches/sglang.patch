+"""Account for record shards, the resident cache and prefill reconstruction."""
+
+from sglang.srt.mem_cache.flowkv_config import (
+    flowkv_cpu_pool_geometry,
+    record_layout,
+    validate_record_config,
+)
+from sglang.srt.mem_cache.flowkv_record_storage import storage_geometry
+from sglang.srt.model_executor.pool_configurator import (
+    DefaultPoolConfigurator,
+    DSV4PoolConfigurator,
+)
+from sglang.srt.mem_cache.flowkv_v0522_context import get_memory
+
+
+
+
+
+class FlowKVPlainPoolConfigurator(DefaultPoolConfigurator):
+    """Actual Index storage plus explicitly described whole-record allocation."""
+
+    request_policy = False
+
+    def __init__(self, kvc):
+        self._v0522_owner_configurator = kvc
+        from sglang.srt.mem_cache.flowkv_config import plain_record_layout
+        from sglang.srt.mem_cache.flowkv_v0522_context import get_exec, get_schedule
+
+        self.record_template = plain_record_layout(kvc, 0)
+        from ulacache.storage.capacity import plain_prefill_pool_budget
+        self.prefill_budget = plain_prefill_pool_budget(self.record_template)
+        self.record_peers, _, self.record_namespaces = storage_geometry()
+        self.owner_index = get_exec().kernel.dsa_decode_score_mode == "cp"
+        memory = get_memory()
+        self.cpu_enabled = memory.enable_flowkv_cpu_offload
+        self.request_policy = self.cpu_enabled and getattr(memory, "flowkv_cpu_policy", "index") == "request"
+        self.cpu_slots = memory.flowkv_cpu_slots if self.cpu_enabled else 0
+        self.cpu_ratio = memory.flowkv_cpu_ratio if self.cpu_enabled else 0
+        self.index_storage_degree = self.record_peers if self.owner_index else 1
+        if self.record_namespaces != 1:
+            raise NotImplementedError("Step publication requires ordinary shared-global TP")
+        if get_exec().features.enable_memory_saver:
+            raise NotImplementedError("Step publication requires non-restored GPU epochs")
+        self.staging_indices_per_row = (
+            4 if (get_schedule().chunked_prefill_size or 0) <= 0 else 0
+        )
+        super().__init__(kvc)
+
+    def _compute_cell_size(self, kvc, num_layers):
+        layout = self.record_template
+        native_index = self._compute_dsa_indexer_cell_size(
+            kvc=kvc, num_layers=num_layers
+        )
+        self._request_index_bytes_per_owner_row = native_index
+        return (
+            native_index / self.index_storage_degree
+            + layout.row_bytes
+            * layout.layers
+            * self.record_namespaces
+            / self.record_peers
+            + self.prefill_budget.logical_row_bytes
+            + 4 * layout.groups * self.record_namespaces
+            + self.staging_indices_per_row
+            # Stable residency directory and reverse maps. With CPU offload,
+            # GPU rows are logical rows minus the fixed per-owner CPU rows.
+            + (24 * layout.groups / self.record_peers if self.cpu_enabled and not self.request_policy else 0)
+            # Pressure-time native prefix matching materializes int64 IDs.
+            + (8 if self.cpu_enabled and not self.request_policy else 0)
+        )
+
+    def _fixed_bytes(self, page_size):
+        from ulacache.storage.capacity import shared_host_workspace_fixed_bytes
+
+        layout = self.record_template
+        fixed = (
+            page_size * self._cell_size
+            + self.prefill_budget.fixed_bytes
+            + layout.local_kv_buffer_bytes
+            + layout.fixed_metadata_bytes
+            + (layout.staging_index_bytes if not self.staging_indices_per_row else 0)
+            + self.record_peers * 8
+            + layout.max_query_tokens * (layout.topk + 1) * 4
+            + 8 * (self.record_peers + 1)  # One epoch and its IPC pointer table.
+            + (4 + 8 * self.record_peers if self.owner_index else 0)
+        )
+        # The first layer window is included by plain_prefill_pool_budget.
+        # Price its independent prefetch partner before solving cold capacity.
+        fixed += (getattr(layout, "prefill_layers", 1) - 1) * layout.prefill_buffer_bytes
+        if self.cpu_enabled and not self.request_policy:
+            workspace_rows = layout.max_query_tokens * (self.record_peers * layout.topk + 1)
+            row_batch_limit = max(workspace_rows, page_size * self.record_peers)
+            fixed += (
+                # State9 epoch/free counts + ready + Work8 counters/prefix.
+                # Ring tensors and physical-row leases depend on GPU capacity
+                # and are charged exactly in _cpu_pool_bytes below.
+                shared_host_workspace_fixed_bytes(workspace_rows, layout.groups)
+                + 32 * layout.groups  # State epoch/free counts and reader flags.
+                # Six IPC pointer tables: directory, reader completion,
+                # logical access times, existing miss rows/counts and miss ready.
+                + 48 * self.record_peers + 8 + 88 * layout.layers
+                # One local physical-row plane per shared-Index group. Only
+                # actual misses are cached; Index and peer plans stay intact.
+                + 4 * layout.groups * layout.max_query_tokens * layout.topk
+                # One miss-ready epoch and a State9 30-word frame per group.
+                + 8 * layout.groups + 240 * layout.groups
+                # Bounded native page release uses int64 locations plus an
+                # int32 translation. Prefill's smaller int32 inputs do not
+                # overlap allocator operations; its scalar costs four bytes.
+                + 12 * row_batch_limit + 4
+            )
+        elif self.request_policy:
+            # One fixed original-exchange plan, counters, and two host pointer
+            # tables. Boundary copies use chunks; decode has no ring workspace.
+            workspace_rows = max(page_size, layout.max_query_tokens * (self.record_peers * layout.topk + 1))
+            fixed += 20 * workspace_rows + 32 + 16
+        return fixed
+
+    def _request_pool_bytes(self, gpu, cpu, page_size):
+        layout = self.record_template
+        return (
+            self._fixed_bytes(page_size) - page_size * self._cell_size
+            + self.record_peers * self._cell_size * (gpu + cpu)
+            # Both whole-record KV and owned packed Index move to CPU.
+            - (layout.layers * layout.row_bytes + self._request_index_bytes_per_owner_row) * cpu
+            + 4 * ((gpu + cpu) // page_size)
+        )
+
+    def _cpu_pool_bytes(self, gpu, cpu, page_size):
+        from ulacache.storage.capacity import shared_host_workspace_expiry_bytes
+        from ulacache.eviction.lru import presence_metadata_bytes
+
+        layout = self.record_template
+        # The cell charges logical Index/scratch/State9 rows and GPU KV for
+        # every logical row. CPU-resident rows replace only that KV allocation.
+        return (
+            self._fixed_bytes(page_size) - page_size * self._cell_size
+            + self.record_peers * self._cell_size * (gpu + cpu)
+            - layout.layers * layout.row_bytes * cpu
+            + layout.groups * (4 * gpu + presence_metadata_bytes(gpu))
+            + shared_host_workspace_expiry_bytes(
+                layout.max_query_tokens * (self.record_peers * layout.topk + 1),
+                layout.groups, gpu)
+        )
+
+    def calculate_pool_sizes(self, available_bytes, page_size):
+        from sglang.srt.ulacache.v0522_owner_tp import owner_pool_available_bytes
+        available_bytes = owner_pool_available_bytes(self._v0522_owner_configurator, available_bytes)
+        layout = self.record_template
+        fixed = self._fixed_bytes(page_size)
+        if self.cpu_enabled:
+            # Search the actual legal joint geometry, including rounded
+            # presence trees. This also covers explicit CPU-slot overrides.
+            cell = self.record_peers * self._cell_size
+            remaining = max(available_bytes - fixed + page_size * self._cell_size, 0)
+            low = 0
+            if self.request_policy:
+                # Logical scratch remains on GPU; unlike index policy, CPU
+                # rows do not retain their packed Index allocation on GPU.
+                # Search an upper bound using the minimum positive scratch
+                # coefficient, then the exact joint byte function below.
+                scratch = cell - layout.layers * layout.row_bytes - self._request_index_bytes_per_owner_row
+                high = int(remaining // (page_size * scratch)) + 1
+            else:
+                high = int(remaining // (page_size * (cell - layout.layers * layout.row_bytes))) + 1
+            while low + 1 < high:
+                middle = (low + high) // 2
+                gpu, cpu = flowkv_cpu_pool_geometry(
+                    middle * page_size,
+                    cpu_slots=self.cpu_slots,
+                    cpu_ratio=self.cpu_ratio,
+                    page_size=page_size,
+                )
+                if gpu < page_size:
+                    low = middle
+                elif (self._request_pool_bytes(gpu, cpu, page_size) if self.request_policy
+                      else self._cpu_pool_bytes(gpu, cpu, page_size)) <= available_bytes:
+                    low = middle
+                else:
+                    high = middle
+            gpu, cpu = flowkv_cpu_pool_geometry(
+                low * page_size,
+                cpu_slots=self.cpu_slots,
+                cpu_ratio=self.cpu_ratio,
+                page_size=page_size,
+            )
+            return self.calculate_pool_sizes_from_max_tokens(
+                self.record_peers * (gpu + cpu) - page_size, page_size
+            )
+        tokens = int(max(available_bytes - fixed, 0) // self._cell_size)
+        if self.owner_index:
+            # Include the native sentinel page in complete owner superpages.
+            # This makes the divided Index coefficient exact, including guards.
+            superpage = page_size * self.index_storage_degree
+            tokens = (tokens + page_size) // superpage * superpage - page_size
+        return self.calculate_pool_sizes_from_max_tokens(tokens, page_size)
+
+    def calculate_pool_sizes_from_max_tokens(self, max_total_num_tokens, page_size):
+        if self.cpu_enabled:
+            superpage = page_size * self.record_peers
+            max_total_num_tokens = (
+                (max_total_num_tokens + page_size) // superpage * superpage - page_size
+            )
+            logical_per_rank = (max_total_num_tokens + page_size) // self.record_peers
+            gpu, cpu = flowkv_cpu_pool_geometry(
+                logical_per_rank,
+                cpu_slots=self.cpu_slots,
+                cpu_ratio=self.cpu_ratio,
+                page_size=page_size,
+            )
+            if gpu < page_size or cpu < page_size:
+                raise ValueError(
+                    "FlowKV GPU budget cannot hold the CPU Index plus a GPU global pool; "
+                    "reduce --flowkv-cpu-ratio/--flowkv-cpu-slots or increase the KV memory budget"
+                )
+            if self.request_policy and gpu < 2 * page_size:
+                raise ValueError("FlowKV request GPU budget needs a usable page beyond its native sentinel")
+            max_total_num_tokens = self.record_peers * (gpu + cpu) - page_size
+        return super().calculate_pool_sizes_from_max_tokens(max_total_num_tokens, page_size)
