index 0000000000000000000000000000000000000000..bb1dbe30f82d17bcc5372febe9e00cb26b589967
--- /dev/null
+++ b/python/sglang/srt/ulacache/hisparse_prefill_relay_adapter.py
@@ -0,0 +1,56 @@
+"""Preserve native MTP prefill state across HiSparse asynchronous staging.
+
+Non-overlap SGLang carries the draft state on the old ScheduleBatch. HiSparse
+rebuilds that batch after CPU placement, so its native FutureMap must receive
+the existing native draft payload before the old batch is discarded. The
+staging transition already preserves those fields when refreshing its bonus.
+"""
+
+
+def stash_prefill_draft_input(scheduler, batch, result):
+    """Publish existing native tensors, with no new draft work or KV writes."""
+    if (not scheduler.enable_hisparse or scheduler.enable_overlap
+            or not batch.forward_mode.is_extend_without_speculative()
+            or batch.spec_algorithm.is_none()):
+        return
+    draft = result.next_draft_input
+    if draft is None or not batch.req_pool_indices.numel():
+        return
+    from sglang.srt.managers.overlap_utils import RelayPayload
+    if draft.topk_p is None or draft.topk_index is None:
+        raise RuntimeError('Native speculative prefill did not produce its draft proposal')
+    scheduler.future_map.stash(batch.req_pool_indices,
+        RelayPayload.from_draft_input(draft))
+
+
+def resolve_hisparse_staged_input(scheduler, batch):
+    """Return an ordinary, merge/filter-safe non-overlap native draft input."""
+    if batch.enable_overlap or batch.spec_algorithm.is_none():
+        return batch
+    draft = batch.spec_info
+    if draft is not None and draft.future_indices is not None:
+        scheduler.future_map._resolve_spec_extras(batch)
+        # FutureMap handles are consumed only in the overlap path. Synchronous
+        # batches carry concrete tensors and must merge with that same form.
+        draft.future_indices = None
+    return batch
+
+
+def install():
+    from sglang.srt.managers.scheduler import Scheduler
+    if getattr(Scheduler.run_batch, '_udcache_hisparse_prefill_relay', False):
+        return
+    original = Scheduler.run_batch
+    original_build = Scheduler._build_hisparse_decode_batch
+
+    def run_batch(self, batch, *args, **kwargs):
+        result = original(self, batch, *args, **kwargs)
+        stash_prefill_draft_input(self, batch, result)
+        return result
+
+    def build(self, reqs):
+        return resolve_hisparse_staged_input(self, original_build(self, reqs))
+
+    Scheduler._build_hisparse_decode_batch = build
+    run_batch._udcache_hisparse_prefill_relay = True
+    Scheduler.run_batch = run_batch
