+"""SGLang startup ports; steady-state record operations belong to UDCache."""
+from ulacache.cache.tp_cache import (
+    global_ids,
+    get_key_buffer,
+    begin_decode,
+    prepare_topk_lookup,
+    plan_decode,
+    pull_records,
+    pull_grid_blocks,
+    prefetch_decode,
+    prepare_decode,
+)
+
+from sglang.srt.ulacache.v0522_owner_tp import configuration
+
+def storage_geometry():
+    from sglang.srt.mem_cache.flowkv_v0522_context import get_parallel
+
+    parallel = get_parallel()
+    degree, namespaces = parallel.tp_size, parallel.attn_dp_size
+    if namespaces not in (1, degree):
+        raise ValueError("Record mode currently supports full TP or full attention DP")
+    return degree, parallel.tp_group, namespaces
+
+
+def configure_pool(pool, *, step_publication=False):
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.kernels.ops.communication.all_reduce import IPCManager
+    from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+    from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+    from sglang.srt.mem_cache.pool_host.base import host_memory_budget_bytes
+    from sglang.srt.mem_cache.flowkv_v0522_context import get_memory
+    from ulacache.cache.tp_cache import configure_pool as configure
+    from ulacache.bindings import BackendServices, CacheOptions
+    from ulacache.compiler import configure_compiler
+
+    import os
+
+    memory = get_memory()
+    degree, group, namespaces = storage_geometry()
+    initialize_window = None
+    if pool.flowkv_layout.prefill_window_rows and pool.flowkv_layout.compression_ratio > 1:
+        from sglang.kernels.ops.attention.dsv4.flowkv_chunked_prefill import initialize_window
+    configure_compiler(load_jit)
+    services = BackendServices(
+        degree=degree, group=group, namespaces=namespaces,
+        config=configuration().cache_options(),
+        memory_region=lambda: pool.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE),
+        ipc_manager_factory=IPCManager, host_pool_factory=FlowKVHostRecordPool,
+        host_memory_budget_bytes=host_memory_budget_bytes,
+        window_initializer=initialize_window,
+    )
+    from sglang.srt.mem_cache.pool_host.base import host_memory_budget_scope
+    if configuration().cpu_offload:
+        with host_memory_budget_scope(192_000_000_000):
+            return configure(pool, services, step_publication=step_publication)
+    return configure(pool, services, step_publication=step_publication)
