+        self.coordinator.wait_for_pending_backup()
+        rows = torch.cat([req_to_token[index, :count]
+                          for index, count in zip(slots, lengths)])
+        plan = make_prefill_plan(rows, batch.out_cache_loc,
+            full_history_records=full, capacity=self.capacity)
+        self.pipeline.begin(plan, layer_count=self.pool.layer_num,
+            record_count=full, keepalive_tensors=plan.keepalive_tensors)
+        return True
+
+    def _gather_history(self, layer, plan, window):
+        if plan.history_ids.numel():
+            self.transfer(cache_dst=window, indices_dst=plan.history_positions,
+                cache_src=self.coordinator.mem_pool_host.kv_buffer[layer],
+                indices_src=plan.history_ids, element_dim=self.row_bytes,
+                page_size=self.coordinator.page_size)
+
+    def _install_current(self, layer, plan, window):
+        if self.pending_writer is None or self.pending_writer[0] != layer:
+            raise RuntimeError("The native current KV writer must precede its window read")
+        _, indices, nope, rope = self.pending_writer
+        self.pool._write_mla_kv_buffer(window, self.remap(indices), nope, rope)
+        self.pending_writer = None
+
+    def prepare(self, layer):
