new file mode 100644
index 0000000000000000000000000000000000000000..120965ed2d4b92ee54daa8a45af27b5facab1447
--- /dev/null
+++ b/python/sglang/srt/ulacache/v0522_owner_tp_gate_probe.py
@@ -0,0 +1,123 @@
+"""Bounded-correctness observations; never installed by the serving entry.
+
+The root-owned CUDA fixture must construct the real native pool first, enter
+this probe for warmup/capture only, and export it after replay and synchronize.
+Requested launch options are not kernel-launch proof. Accept the trace's real
+exchange grid and block dimensions separately.
+"""
+from contextlib import AbstractContextManager
+import hashlib
+import inspect
+from pathlib import Path
+
+
+def _binding(value):
+    path = Path(inspect.getfile(value)).resolve(strict=True)
+    return dict(module=value.__module__, path=str(path),
+                sha256=hashlib.sha256(path.read_bytes()).hexdigest())
+
+
+class _ColdModule:
+    def __init__(self, original, probe):
+        self.original, self.probe = original, probe
+
+    def __getattr__(self, name):
+        return getattr(self.original, name)
+
+    def finish(self, *args, **kwargs):
+        self.probe._record('host_finish', selected='serial')
+        return self.original.finish(*args, **kwargs)
+
+    def finish_parallel(self, *args, **kwargs):
+        self.probe._record('host_finish', selected='parallel', physical_queries=int(args[5]))
+        return self.original.finish_parallel(*args, **kwargs)
+
+
+class OwnerTPGateProbe(AbstractContextManager):
+    """Observe actual Python calls and CUDA stream identity in one small gate."""
+    def __init__(self, pool):
+        from ulacache.cache.prefetch import SharedIndexLifecycle
+
+        self.pool = pool
+        self.lifecycle = pool.flowkv_shared_index
+        if type(self.lifecycle) is not SharedIndexLifecycle:
+            raise ValueError('The real library SharedIndexLifecycle must be selected')
+        self.calls, self._restore = [], []
+        self.restored = False
+        self.lifecycle_binding = _binding(SharedIndexLifecycle)
+
+    def _record(self, operation, **fields):
+        import torch
+        self.calls.append(dict(operation=operation,
+            stream=int(torch.cuda.current_stream(self.pool.device).cuda_stream), **fields))
+
+    def _wrap(self, owner, name, wrapper):
+        present, saved = name in vars(owner), vars(owner).get(name)
+        original = getattr(owner, name)
+        setattr(owner, name, wrapper(original))
+        self._restore.append((owner, name, present, saved))
+
+    def __enter__(self):
+        def index(original):
+            def call(layer, indices):
+                self._record('on_index_ready', layer=int(layer), physical_queries=int(indices.shape[0]))
+                return original(layer, indices)
+            return call
+        def history(original):
+            def call(layer):
+                self._record('history_pull', layer=int(layer),
+                    group=int(self.lifecycle.groups.group(layer)))
+                return original(layer)
+            return call
+        self._wrap(self.lifecycle, 'on_index_ready', index)
+        self._wrap(self.lifecycle, '_pull_history', history)
+        host = self.pool.flowkv_host
+        if host is not None:
+            def prepare(original):
+                def call(layer, *, queries=0):
+                    self._record('host_prepare_group', layer=int(layer), physical_queries=int(queries))
+                    return original(layer, queries=queries)
+                return call
+            self._wrap(host, 'prepare_group', prepare)
+            self._wrap(host, '_cold_module', lambda original: _ColdModule(original, self))
+        return self
+
+    def __exit__(self, *exception):
+        while self._restore:
+            owner, name, present, saved = self._restore.pop()
+            if present:
+                setattr(owner, name, saved)
+            else:
+                delattr(owner, name)
+        self.restored = True
+        return False
+
+    def snapshot_after_synchronized_replay(self):
+        """Explicit correctness-only D2H; call outside capture and before close."""
+        if not self.restored:
+            raise RuntimeError('Remove all gate observers before exporting evidence')
+        import torch
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError('A gate snapshot cannot run inside CUDA Graph capture')
+        pool, host = self.pool, self.pool.flowkv_host
+        metadata_q = int(pool.flowkv_layout.max_query_tokens)
+        result = dict(complete=True, scope='Bounded correctness, never a formal latency sample',
+            lifecycle=self.lifecycle_binding, observers_restored=True,
+            metadata_query_capacity=metadata_q,
+            actual_valid_count=int(pool.flowkv_arena.valid.cpu().item()),
+            resident_query_capacity=int(pool.flowkv_layout.resident_query_capacity),
+            prefetch_stream=int(self.lifecycle._stream.cuda_stream),
+            CPU_offload=host is not None, calls=self.calls,
+            actual_exchange_grid_verified=False,
+            required_independent_proof='Real all-rank GPU kernel trace including exchange64x256, packed gather/pack/unpack and native MLA')
+        if host is None:
+            if any(row['operation'].startswith('host_') for row in self.calls):
+                raise ValueError('CPU-off executed host preparation')
+            result['host_preparation_absent'] = True
+        else:
+            result.update(requested_exchange_launch=list(host.exchange_launch),
+                parallel_finish_enabled=host.parallel_finish,
+                parallel_victims_enabled=host.parallel_victims,
+                workspaces=[dict(group=index,counters=work.counters.cpu().tolist())
+                            for index,work in enumerate(host.workspaces)])
+        return result
