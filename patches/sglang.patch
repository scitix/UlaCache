+    return (not is_cache_step(mode) and mode.is_extend()
+            and not mode.is_mixed())
+
+
+def native_decode_reservation(coordinator):
+    """Validate native CLOCK limits and reserve only private decode records."""
+    if not 0 < coordinator.device_buffer_size <= 32768:
+        raise ValueError('Native HiSparse speculative CLOCK supports hot buffer <=32768')
+    required = coordinator.req_to_token_pool.size * (
+        coordinator.padded_buffer_size + coordinator.spec_swap.scratch_capacity)
