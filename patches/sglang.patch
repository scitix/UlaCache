@@ -0,0 +1,19 @@
+"""Launch the existing owner-striped cache with native BF16 prefix bindings."""
+
+import os
+import runpy
+import sys
+
+from sglang.srt.ulacache.native_tensor_parallel_pool import (
+    configure_native_tensor_parallel_defaults, install_native_tensor_parallel_pool)
+
+
+install_native_tensor_parallel_pool()
+configure_native_tensor_parallel_defaults(sys.argv, os.environ)
+if 'UDCACHE_MATRIX_AUDIT_DIR' in os.environ:
+    from sglang.srt.ulacache.matrix_startup_audit import install as install_startup_audit
+
+    install_startup_audit()
+
+if __name__ == '__main__':
+    runpy.run_module('sglang.launch_server', run_name='__main__')
diff --git a/python/sglang/srt/ulacache/native_tensor_parallel_pool.py b/python/sglang/srt/ulacache/native_tensor_parallel_pool.py
new file mode 100644
index 0000000000000000000000000000000000000000..e3c22ba9ff38595a5f5c9688ed3654daaa19a759
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_tensor_parallel_pool.py
@@ -0,0 +1,273 @@
+"""Bind native BF16/scaled-FP8 prefix reads to the existing owner-striped TP cache."""
+
+
+def configure_native_tensor_parallel_defaults(arguments, environment):
+    """Enable owner KV and distributed Index; leave CPU extension opt-in."""
+    if '--enable-flowkv' not in arguments:
+        arguments.append('--enable-flowkv')
+    if not any(argument == '--dsa-decode-score-mode'
+            or argument.startswith('--dsa-decode-score-mode=') for argument in arguments):
+        arguments.extend(('--dsa-decode-score-mode', 'cp'))
+    environment.setdefault('UDCACHE_PLAIN_PREFILL_WINDOW_ROWS', '512')
+
+
+class NativeTensorParallelSparsePoolBindings:
+    """Retain the existing distributed allocator, writer and decode lifecycle.
+
+    Only eager prefix reconstruction needs a new native callback. The original
+    shared-Index hooks still plan decode, fetch owner records and publish steps.
+    """
+
+    _native_prefill_record_read_plan = None
+    _native_prefill_record_source = None
+    _native_prefill_record_version = None
+    reuse_prefill_metadata = False
+
+    def prepare_cache_forward(self, batch, *, publish_active_query_count=True):
+        from ulacache.speculative import is_cache_step
+
+        self._native_fp8_target_verify = bool(getattr(self, 'dsa_kv_cache_store_fp8', False)
+            and batch.forward_mode.is_target_verify())
+        if publish_active_query_count:
+            self.flowkv_prepare_batch(batch)
+        if not is_cache_step(batch.forward_mode):
+            self._flowkv_mode = 'prefill'
+            self._native_prefill_record_read_plan = None
+            self._native_prefill_record_source = None
+            self._native_prefill_record_version = None
+
+    def prepare_native_sparse_attention(self, layer_id, selected_records):
+        # The original shared-Index hook already returns resident decode IDs.
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is not None and backend.plan is not None:
+            backend.read(layer_id - self.start_layer)
+            return backend.plan.map_native_rows(selected_records)
+        return selected_records
+
+    def read_native_prefill_records(self, layer_id, selected_records, output):
+        import torch
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is not None and backend.plan is not None:
+            from sglang.kernels.ops.attention.dsa.dequant_k_cache import dequantize_k_cache_paged
+            window = backend.read(layer_id - self.start_layer)
+            mapped = backend.plan.map_native_rows(selected_records).reshape(-1)
+            output.copy_(dequantize_k_cache_paged(
+                window.view(self.dtype).reshape(-1, 1, self.kv_cache_dim), mapped.clamp_min(0)))
+            return output
+        from ulacache.cache.prefill.window import prepare_compact_prefill_record_read_plan, run_compact_prefill_records
+
+        def read_native_rows(native_pages, resident_record_ids, output_buffer):
+            native_rows = native_pages.view(self.dtype).reshape(-1, 1, self.kv_cache_dim)
+            if getattr(self, 'dsa_kv_cache_store_fp8', False):
+                from sglang.kernels.ops.attention.dsa.dequant_k_cache import dequantize_k_cache_paged
+                output_buffer.copy_(dequantize_k_cache_paged(native_rows,
+                    resident_record_ids.clamp_min(0)))
+            else:
+                torch.index_select(native_rows, 0, resident_record_ids.long(), out=output_buffer)
+
+        plan = None
+        if self.reuse_prefill_metadata:
+            try:
+                version = getattr(selected_records, '_version', None)
+            except RuntimeError:
+                # Inference tensors have no mutation counter. Rebuild rather
+                # than treating an untracked in-place change as immutable.
+                version = None
+            if (version is None or self._native_prefill_record_read_plan is None
+                    or self._native_prefill_record_source is not selected_records
+                    or self._native_prefill_record_version != version):
+                self._native_prefill_record_read_plan = prepare_compact_prefill_record_read_plan(
+                    self, selected_records)
+                self._native_prefill_record_source = selected_records
+                self._native_prefill_record_version = version
+            plan = self._native_prefill_record_read_plan
+        run_compact_prefill_records(self, layer_id, selected_records,
+            read_native_rows, output_buffer=output, read_plan=plan)
+
+    def get_key_buffer(self, layer_id):
+        if self._flowkv_mode == 'prefill':
+            # RAGGED prefill reads current native K/RoPE directly, or replaces
+            # this borrowed view with its reconstructed prefix workspace.
+            return self.flowkv_arena.prefill.view(self.dtype).reshape(-1, 1, self.kv_cache_dim)
+        return super().get_key_buffer(layer_id)
+
+    def finish_cache_attention(self, layer_id):
+        # Native forward_decode already invokes the shared-Index hook. The
+        # source-bound scaled-FP8 forward_extend verify entry invokes only this
+        # native-cache callback after its learned-sink reader. Retire that one
+        # TP consumer here, retaining the existing final publication protocol.
+        if getattr(self, '_native_fp8_target_verify', False):
+            self.flowkv_after_attention(layer_id)
+
+    def finish_cache_forward(self):
+        self._native_prefill_record_read_plan = None
+        self._native_prefill_record_source = None
+        self._native_prefill_record_version = None
+        self.finish_flowkv_forward()
+
+    def flowkv_prepare_extend(self, history):
+        if getattr(self, '_tp_full_prefill', None) is None:
+            return super().flowkv_prepare_extend(history)
+        self._tp_native_prefill_history = history
+        self._flowkv_mode = 'prefill'
+
+    def flowkv_before_layer_prepare(self, layer_id, batch):
+        from ulacache.speculative import is_cache_step
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is not None and not is_cache_step(batch.forward_mode):
+            local = layer_id - self.start_layer
+            if local == 0:
+                backend.begin(batch, native_history=getattr(self, '_tp_native_prefill_history', None))
+            # Preserve native invalidation of fresh IDs; do not plan or promote
+            # any historical residency merely for a prefill read.
+            super().flowkv_before_layer_prepare(layer_id, batch)
+            backend.prepare(local)
+            return
+        return super().flowkv_before_layer_prepare(layer_id, batch)
+
+    def set_mla_kv_buffer(self, *args, **kwargs):
+        result = super().set_mla_kv_buffer(*args, **kwargs)
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is not None and backend.plan is not None:
+            override = kwargs.get('layer_id_override', args[4] if len(args) > 4 else None)
+            layer_id = override if override is not None else args[0].layer_id
+            backend.mark_current(layer_id - self.start_layer)
+        return result
+
+    def flowkv_compact_prefill_attention(self, layer_id, query, native_rows, seq_lens, attend):
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is None or backend.plan is None:
+            return super().flowkv_compact_prefill_attention(
+                layer_id, query, native_rows, seq_lens, attend)
+        local = layer_id - self.start_layer
+        window = backend.read(local)
+        # Retain the existing native FlashMLA callback and its full query batch.
+        result = attend(query, backend.plan.map_native_rows(native_rows), window, seq_lens)
+        backend.after_attention(local)
+        return result
+
+    def flowkv_after_attention(self, layer_id):
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is not None and backend.plan is not None:
+            backend.after_attention(layer_id - self.start_layer)
+            return
+        return super().flowkv_after_attention(layer_id)
+
+    def finish_flowkv_forward(self):
+        backend = getattr(self, '_tp_full_prefill', None)
+        if backend is not None:
+            backend.finish()
+            self._tp_native_prefill_history = None
+        return super().finish_flowkv_forward()
+
+    def create_prefill_workspace_budget(self):
+        backend = getattr(self, '_tp_full_prefill', None)
+        return backend.create_budget() if backend is not None else None
+
+    def get_prefill_workspace_memory_inventory(self):
+        backend = getattr(self, '_tp_full_prefill', None)
+        return backend.memory_inventory() if backend is not None else None
+
+    def get_kv_size_bytes(self):
+        value = super().get_kv_size_bytes()
+        backend = getattr(self, '_tp_full_prefill', None)
+        # The native sum already includes arena.prefill (the first bank).
+        return value + (backend.pipeline.windows[1].nbytes if backend is not None else 0)
+
+    def _native_rows_for_full_pages(self, full_page_ids):
+        import torch
+
+        records_per_allocation_page = self.allocation_page_size
+        return (full_page_ids[:, None] * records_per_allocation_page +
+            torch.arange(records_per_allocation_page, device=full_page_ids.device)).reshape(-1)
+
+    def register_native_full_pages(self, full_page_ids, *, prefer_device):
+        # Native FlowKV allocator hooks remain installed by the framework.
+        # This callback also supports callers using the common sparse ABI.
+        if self.flowkv_host is not None:
+            self.flowkv_host.allocate(self._native_rows_for_full_pages(full_page_ids))
+
+    def release_native_full_pages(self, full_page_ids):
+        if self.flowkv_host is not None:
+            self.flowkv_host.release(self._native_rows_for_full_pages(full_page_ids))
+
+    def clear_native_full_records(self):
+        if self.flowkv_host is not None:
+            self.flowkv_host.clear()
+
+
+def create_native_tensor_parallel_pool_class(native_pool_class, native_sparse_adapter_class):
+    """Extend the framework pool's byte-layout and process-group bindings."""
+
+    class NativeTensorParallelSparseLatentPool(
+        NativeTensorParallelSparsePoolBindings, native_sparse_adapter_class, native_pool_class,
+    ):
+        def _create_buffers(self):
+            import torch
+            from sglang.srt.runtime_context import get_exec, get_memory, get_parallel
+
+            parallel = get_parallel()
+            if (parallel.attn_tp_size != parallel.tp_size or parallel.tp_size < 2
+                    or parallel.attn_dp_size != 1 or parallel.attn_cp_size != 1
+                    or parallel.attn_dcp_size != 1):
+                raise NotImplementedError('The native owner-striped binding requires ordinary shared TP')
+            scaled_fp8 = (self.dtype != torch.bfloat16
+                and self.dtype == torch.float8_e4m3fn
+                and self.dsa_kv_cache_store_fp8 and self.kv_cache_dim == 656
+                and self.kv_lora_rank == 512 and self.qk_rope_head_dim == 64)
+            if self.dtype != torch.bfloat16 and not scaled_fp8:
+                raise NotImplementedError('Bind native BF16 or validated scaled656-byte FP8 latent records')
+            if not self.flowkv_layout.prefill_window_rows:
+                raise ValueError('Set UDCACHE_PLAIN_PREFILL_WINDOW_ROWS for bounded native prefix reads')
+            if (get_memory().enable_flowkv_cpu_offload
+                    and get_exec().kernel.dsa_decode_score_mode != 'cp'):
+                raise ValueError('TP CPU residency requires native CP Index scoring and owner allocation superpages')
+            super()._create_buffers()
+            self._tp_full_prefill = None
+            if (scaled_fp8 and get_memory().enable_flowkv_cpu_offload
+                    and self.flowkv_layout.prefill_window_rows == 1048576):
+                from sglang.srt.runtime_context import get_disagg
+                if get_disagg().disaggregation_mode == 'null':
+                    from sglang.srt.ulacache.tensor_parallel_prefill import TensorParallelPrefill
+                    self._tp_full_prefill = TensorParallelPrefill(self)
+
+    return NativeTensorParallelSparseLatentPool
+
+
+def native_tensor_parallel_services(services):
+    """Enable host finish/victims only with the optional CPU extension."""
+    from dataclasses import replace
+    import os
+    cap = int(os.environ.get('ULACACHE_TP_LOW_QUERY_PULL_BLOCKS', '0'))
+    return replace(services, config=replace(services.config,
+        host_parallel_finish=services.config.cpu_offload,
+        host_parallel_victims=services.config.cpu_offload,
+        low_query_pull_blocks=cap or None))
+
+
+def install_native_tensor_parallel_pool():
+    """Use the original framework pool selection and distributed byte budget.
+
+    Launch with the existing --enable-flowkv options. No rank-local admission
+    override or rank-local allocator wrapper is installed on this path.
+    """
+    from sglang.srt.mem_cache import flowkv_plain_pool
+    from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+
+    native_class = create_native_tensor_parallel_pool_class(
+        flowkv_plain_pool.FlowKVPlainTokenToKVPool, NativeSparseCacheAdapter)
+    import os
+    reuse = os.environ.get('ULACACHE_REUSE_PREFILL_METADATA', '0')
+    if reuse not in ('0', '1'):
+        raise ValueError('ULACACHE_REUSE_PREFILL_METADATA must be 0 or 1')
+    native_class.reuse_prefill_metadata = reuse == '1'
+    flowkv_plain_pool.FlowKVPlainTokenToKVPool = native_class
+    import ulacache.cache.tp_cache as record_storage
+    original_configure = record_storage.configure_pool
+    def configure(pool, services, *, step_publication=False):
+        if isinstance(pool, native_class) and pool.dsa_kv_cache_store_fp8:
+            services = native_tensor_parallel_services(services)
+        return original_configure(pool, services, step_publication=step_publication)
+    record_storage.configure_pool = configure
+    from sglang.srt.ulacache.tensor_parallel_prefill import bind_startup
+    bind_startup(native_class)
