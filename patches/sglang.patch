index 0000000000000000000000000000000000000000..0335304755aa16d4cc05940ad6d287f6a16cabfd
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_dsa_optimized_pool.py
@@ -0,0 +1,197 @@
+"""Bind ordinary sparse MLA pools while retaining native BF16/scaled-FP8 readers and writers."""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class NativeSparseLatentPoolConfiguration:
+    device_record_capacity: int
+    host_record_capacity: int
+    maximum_write_record_count: int
+    device_cache_budget_bytes: int | None = None
+    maximum_running_requests: int | None = None
+
+
+def create_native_sparse_latent_pool_class(configuration, layer_selection_owners,
+                                          maximum_selected_records):
+    import torch
+    import os
+    publication_flag = os.environ.get('ULACACHE_FUSE_NATIVE_RECORD_PUBLICATION', '0')
+    if publication_flag not in ('0', '1'):
+        raise ValueError('Native byte-publication opt-in must be0 or1')
+    fuse_publication = publication_flag == '1'
+    # Freeze both independent choices at native pool-class construction.
+    # An unchanged launch retains the original synchronous4x1024 exchange.
+    async_flag = os.environ.get('UDCACHE_NATIVE_PAGED_ASYNC_FOLLOWER_IO', '0')
+    if async_flag not in ('0', '1'):
+        raise ValueError('Native paged async follower opt-in must be0 or1')
+    async_followers = async_flag == '1'
+    grid_flag = os.environ.get('UDCACHE_NATIVE_PAGED_EXCHANGE_GRID', '4x1024')
+    if grid_flag not in ('4x1024', '4x256', '8x256', '16x256', '32x256', '64x256', '128x256', '32x128', '64x128'):
+        raise ValueError('Native paged exchange grid is outside the explicitly gated candidate set')
+    exchange_grid = tuple(map(int, grid_flag.split('x')))
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+    from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+    from sglang.srt.mem_cache.memory_pool import DSATokenToKVPool, unwrap_write_loc
+    from sglang.srt.mem_cache.native_sparse_cache_adapter import NativeSparseCacheAdapter
+    from sglang.srt.runtime_context import get_exec, get_parallel, get_spec
+    from ulacache import (
+        KeyValueRecordPlane, KeyValueStorageLayout, LayerReuseSpecification,
+        MemoryTierCapacity, CacheExecutionOptions, LocalCacheBindings,
+        SparseAccessSpecification, UnifiedCacheSpecification,
+        UnifiedMemoryCache,
+    )
+    from ulacache.cache.planning import create_paged_cache_execution_plan
+    from ulacache.speculative import LinearVerifyConfig, is_cache_step
+    from ulacache.storage.writers import NativeRecordWriteStaging
+    from ulacache.cache.attention_access import NativeSparseCacheExecution
+    from sglang.srt.ulacache.native_cache_topology import require_rank_local_attention_storage
+
+    class NativeSparseLatentTokenPool(NativeSparseCacheAdapter, DSATokenToKVPool):
+        def __init__(self, *args, **kwargs):
+            require_rank_local_attention_storage(get_parallel())
+            if kwargs.get('index_kpool', 1) != 1:
+                raise NotImplementedError('Compressed Index-K candidates require their native ID composition binding')
+            kernels = get_exec().kernel
+            if kernels.dsa_prefill_backend != 'flashmla_sparse' or kernels.dsa_decode_backend not in ('flashmla_sparse', 'flashmla_kv'):
+                raise ValueError('Use native sparse prefill and BF16 or scaled-FP8 decode readers')
+            speculation = get_spec()
+            verify_width = 1
+            if speculation.speculative_algorithm is not None:
+                LinearVerifyConfig(algorithm=speculation.speculative_algorithm,
+                    steps=speculation.speculative_num_steps, topk=speculation.speculative_eagle_topk,
+                    verify_tokens=speculation.speculative_num_draft_tokens,
+                    adaptive=speculation.speculative_adaptive).validate()
+                verify_width = speculation.speculative_num_draft_tokens
+            native_rows = kwargs['max_running_requests']
+            real_requests = configuration.maximum_running_requests
+            if real_requests is None:
+                real_requests = native_rows
+            elif native_rows not in (real_requests, real_requests + 1):
+                raise ValueError('Native request rows disagree with configured real requests')
+            self.maximum_padded_query_count = real_requests * verify_width
+            super().__init__(*args, **kwargs)
+
+        def _create_buffers(self):
+            self._native_scaled_fp8 = (self.dsa_kv_cache_store_fp8 and self.dtype == torch.float8_e4m3fn
+                and self.kv_lora_rank == 512 and self.qk_rope_head_dim == 64 and self.kv_cache_dim == 656)
+            if not self._native_scaled_fp8 and (self.dtype != torch.bfloat16 or self.kv_cache_dim != self.kv_lora_rank + self.qk_rope_head_dim):
+                raise NotImplementedError('Bind native BF16 or the validated scaled656-byte FP8 record layout')
+            capacity = MemoryTierCapacity(configuration.device_record_capacity,
+                configuration.host_record_capacity, configuration.maximum_write_record_count,
+                reserved_logical_record_count=self.page_size,
+                maximum_prefill_union_record_count=configuration.device_record_capacity)
+            if self.size + self.page_size != capacity.logical_record_capacity:
+                raise ValueError('Native admission must match the declared CPU plus GPU record capacity')
+            plane = (KeyValueRecordPlane('key_value', 'mla.scaled_fp8_v32.v1', (528, 128))
+                if self._native_scaled_fp8 else KeyValueRecordPlane('key_value', 'mla.bfloat16.v1',
+                    (self.kv_lora_rank * 2, self.qk_rope_head_dim * 2)))
+            specification = UnifiedCacheSpecification(
+                KeyValueStorageLayout('sparse_history', (plane,), self.page_size),
+                LayerReuseSpecification.from_shared_sparse_selection(layer_selection_owners),
+                SparseAccessSpecification(self.maximum_padded_query_count, maximum_selected_records), capacity)
+            self.execution_plan = create_paged_cache_execution_plan(specification)
+
+            def write_native_pages(values, pages, indices):
+                native_rows = pages.view(self.store_dtype).reshape(-1, 1, self.kv_cache_dim)
+                self._write_mla_kv_buffer(native_rows, indices, *values)
+
+            with self.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+                self.writer_staging = NativeRecordWriteStaging(specification, self.execution_plan,
+                    self.device, write_native_pages)
+                services = LocalCacheBindings(self.device, FlowKVHostRecordPool, load_jit,
+                    CacheExecutionOptions(record_storage_backend='native_paged', prefill_union_method='device',
+                    prepare_residency_in_parallel=True, select_victims_in_parallel=True,
+                    prepare_current_records_in_parallel=True, fuse_native_record_publication=fuse_publication,
+                    exchange_launch_dimensions=exchange_grid, follower_exchange_launch_dimensions=exchange_grid,
+                    copy_follower_records_asynchronously=async_followers, follower_copy_mode='layer'))
+                self.memory_cache = UnifiedMemoryCache(specification, services)
+            self.cache_execution = NativeSparseCacheExecution(self.memory_cache, self.execution_plan,
+                self.writer_staging, specification, self.device)
+            self.kv_buffer = [pages.view(self.store_dtype).reshape(-1, 1, self.kv_cache_dim)
+                for pages in self.memory_cache.device_record_storage]
+
+        def set_mla_kv_buffer(self, layer, loc_info, cache_k_nope, cache_k_rope,
+                              layer_id_override=None):
+            locations, _, _ = unwrap_write_loc(loc_info)
+            model_layer = layer.layer_id if layer_id_override is None else layer_id_override
+            local_layer = model_layer - self.start_layer
+            self.writer_staging.stage_native_records(local_layer, locations, (cache_k_nope, cache_k_rope))
+            self.cache_execution.publish_after_native_write(local_layer)
+
+        def prepare_cache_forward(self, batch, *, publish_active_query_count=True):
+            self.cache_execution.begin_forward(decode_like=is_cache_step(batch.forward_mode),
+                active_query_counts=batch.global_num_tokens_gpu,
+                attention_data_parallel_rank=get_parallel().attn_dp_rank,
+                query_count=batch.out_cache_loc.numel(),
+                publish_active_query_count=publish_active_query_count,
+                current_logical_record_ids=batch.out_cache_loc)
+
+        def prepare_native_sparse_attention(self, layer_id, selected_records):
+            return self.cache_execution.prepare_attention(layer_id - self.start_layer, selected_records)
+
+        def _read_native_resident_records(self, record_planes, physical_record_ids, output):
+            native_rows = record_planes[0].view(self.dtype).reshape(-1, 1, self.kv_cache_dim)
+            if self._native_scaled_fp8:
+                from sglang.kernels.ops.attention.dsa.dequant_k_cache import dequantize_k_cache_paged
+                output.copy_(dequantize_k_cache_paged(native_rows, physical_record_ids.clamp_min(0)))
+            else:
+                output.copy_(native_rows.index_select(0, physical_record_ids.clamp_min(0).long()))
+
+        def read_native_prefill_records(self, layer_id, selected_records, output):
+            self.cache_execution.reconstruct_prefill_records(layer_id - self.start_layer,
+                selected_records, output, self._read_native_resident_records)
+
+        def finish_cache_attention(self, layer_id):
+            self.cache_execution.finish_attention(layer_id - self.start_layer)
+
+        def finish_cache_forward(self):
+            pass
+
+        def register_native_full_pages(self, full_page_ids, *, prefer_device):
+            self.cache_execution.register_full_pages(full_page_ids, prefer_device=prefer_device)
+
+        def release_native_full_pages(self, full_page_ids):
+            self.cache_execution.release_full_pages(full_page_ids)
+
+        def clear_native_full_records(self):
+            self.cache_execution.clear_records()
+
+        def move_kv_cache(self, target_locations, source_locations):
+            raise NotImplementedError('Native sparse latent relocation requires a logical-record move binding')
+
+        def get_device_storage_inventory(self):
+            return self.cache_execution.get_device_storage_inventory()
+
+        def close(self):
+            self.memory_cache.close()
+
+    return NativeSparseLatentTokenPool
+
+
+def install_native_sparse_latent_pool(configuration):
+    from sglang.srt.configs.model_config import dsa_layer_skips_topk, get_dsa_index_topk
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.ulacache.native_sparse_allocator import install_native_sparse_allocator_hooks
+    from sglang.srt.ulacache.native_cache_admission import install_native_sparse_latent_admission
+
+    if configuration.device_cache_budget_bytes is not None:
+        install_native_sparse_latent_admission(configuration)
+
+    original_build = kv_cache_configurator.KVCacheConfigurator._build_dsa_kv_pool
+
+    def build(self, **kwargs):
+        if not self.is_draft_worker:
+            owners = []
+            for model_layer in range(self.layer_info.start_layer, self.layer_info.end_layer):
+                shared = dsa_layer_skips_topk(self.model_config.hf_config, model_layer)
+                if shared and not owners:
+                    raise NotImplementedError('Sparse selection reuse across pipeline stages needs a source binding')
+                owners.append(owners[-1] if shared else len(owners))
+            kwargs['dsa_pool_class'] = create_native_sparse_latent_pool_class(configuration,
+                tuple(owners), get_dsa_index_topk(self.model_config.hf_config))
+        return original_build(self, **kwargs)
+
+    kv_cache_configurator.KVCacheConfigurator._build_dsa_kv_pool = build
+    install_native_sparse_allocator_hooks()
diff --git a/python/sglang/srt/ulacache/native_dsa_pool.py b/python/sglang/srt/ulacache/native_dsa_pool.py
