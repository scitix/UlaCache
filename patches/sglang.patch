+"""Thin native Mooncake hooks for the library's canonical record receiver."""
+from __future__ import annotations
+
+
+def _audit(role):
+    import json, os, time
+    from pathlib import Path
+    root = os.environ.get('ULACACHE_PD_AUDIT_DIR')
+    if not root:return None
+    from sglang.srt.runtime_context import get_parallel
+    rank=get_parallel().tp_rank
+    path=Path(root)/f'direct-{role}.rank{rank}.jsonl'
+    path.parent.mkdir(parents=True,exist_ok=True)
+    def write(value):
+        with path.open('a') as stream:
+            stream.write(json.dumps(dict(value,recorded_unix=time.time()))+'\n')
+    return write
+
+
+def install_sender():
+    import time
+    from sglang.srt.disaggregation.mooncake.conn import MooncakeKVManager
+    from sglang.srt.disaggregation.base.conn import KVArgs
+    from ulacache.transfer.direct_receive import DirectReceivePlan, RecordRegion
+    from ulacache.transfer.direct_receiver import send_record_chunk
+
+    if getattr(MooncakeKVManager, '_ulacache_direct_sender_bound', False):
+        return
+    if not hasattr(KVArgs, 'additional_kv_regions'):
+        raise RuntimeError('Direct PD reception requires the native external-storage adapter')
+    original = MooncakeKVManager.__init__
+
+    def send(manager, request, chunk):
+        started=time.monotonic()
+        decode_seconds=0.0
+        args = manager.kv_args
+        if (args.pp_rank != 0 or args.page_size < 1
+                or chunk.num_kv_tokens is None or chunk.index_slice.step not in (None,1)):
+            raise ValueError('Direct record transfer requires native unpartitioned page chunks')
+        plan = getattr(request, '_ulacache_direct_plan', None)
+        if plan is None:
+            decoding=time.monotonic()
+            plan = DirectReceivePlan.from_bytes(request.direct_kv_metadata,
+                record_limit=len(request.dst_kv_indices)*args.page_size)
+            decode_seconds=time.monotonic()-decoding
+            if plan.page_size != args.page_size:
+                raise ValueError('Direct peers have different native page sizes')
+            request._ulacache_direct_plan = plan
+        pointers, lengths, strides = args.kv_data_ptrs, args.kv_data_lens, args.kv_item_lens
+        if not len(pointers) == len(lengths) == len(strides) == len(plan.banks):
+            raise ValueError('Direct peers must have matching target/draft bank lists')
+        if any(stride % args.page_size for stride in strides):
+            raise ValueError('Native KV pages do not contain complete fixed-width records')
+        sources = {i:RecordRegion(ptr, length, stride//args.page_size)
+            for i,(ptr,length,stride) in enumerate(zip(pointers,lengths,strides))}
+        observer=_audit('send')
+        setup_seconds=time.monotonic()-started
+        audit=None if observer is None else lambda value:observer(dict(value,room=request.room,
+            metadata_decoding_seconds=decode_seconds,sender_setup_seconds=setup_seconds))
+        return send_record_chunk(manager.engine, request.mooncake_session_id,
+            plan, sources, chunk.prefill_kv_indices,
+            page_offset=chunk.index_slice.start or 0,
+            record_count=int(chunk.num_kv_tokens), record_limit=plan.record_count,audit=audit,
+            executors=manager.executors)
+
+    def initialize(self, args, *positional, **kwargs):
+        args.direct_kv_transfer = send
+        return original(self, args, *positional, **kwargs)
+
+    MooncakeKVManager.__init__ = initialize
+    MooncakeKVManager._ulacache_direct_sender_bound = True
+
+
+def install_receiver():
+    import time
+    import torch
+    from sglang.srt.disaggregation.decode import DecodePreallocQueue, DecodeTransferQueue
+    from sglang.srt.disaggregation.utils import _is_fake_transfer
+    from sglang.srt.mem_cache import kv_cache_configurator as configurator
+    from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+    from sglang.srt.runtime_context import get_disagg
+    from ulacache.transfer.direct_receiver import DirectRecordReceiver
+
+    original_build = configurator.KVCacheConfigurator._build_dsa_kv_pool
+    original_queue = DecodePreallocQueue.__init__
+    original_allocate = DecodePreallocQueue._pre_alloc
+    original_metadata = DecodePreallocQueue._send_kv_metadata
+    original_commit = DecodeTransferQueue._commit_transfer_to_req
+    original_release = PagedTokenToKVPoolAllocator._release_page_ids
+    original_defer = DecodeTransferQueue._defer_release
+
+    def build(self, **kwargs):
+        pool = original_build(self, **kwargs)
+        if not self.is_draft_worker:
+            if get_disagg().disaggregation_mode != 'decode':
+                raise ValueError('Canonical UlaCache receiver requires a decode worker')
+            pool.pd_direct_receiver = DirectRecordReceiver(pool.memory_cache,audit=_audit('receive'))
+        return pool
+
+    def queue(self, req_to_token_pool, token_to_kv_pool_allocator,
+              draft_token_to_kv_pool, *args, **kwargs):
+        req_pool,allocator,draft = req_to_token_pool,token_to_kv_pool_allocator,draft_token_to_kv_pool
+        pool = allocator.get_kvcache()
+        receiver = getattr(pool, 'pd_direct_receiver', None)
+        if receiver is not None and draft is not None:
+            pointers,lengths,_ = draft.get_contiguous_buf_infos()
+            if (pointers != [t.data_ptr() for t in draft.kv_buffer]
+                    or lengths != [t.nbytes for t in draft.kv_buffer]):
+                raise ValueError('Draft transfer buffers differ from canonical GPU storage')
+            receiver.add_device_banks(draft.kv_buffer, page_size=draft.page_size)
+        return original_queue(self, req_pool, allocator, draft, *args, **kwargs)
+
+    def allocate(self, req, *args, **kwargs):
+        allocator = self.token_to_kv_pool_allocator
+        previous = getattr(allocator, '_udcache_receiving_records', False)
+        allocator._udcache_receiving_records = not _is_fake_transfer(req)
+        try:return original_allocate(self, req, *args, **kwargs)
+        finally:allocator._udcache_receiving_records = previous
+
+    def metadata(self, request, kv_indices, page_size, state_indices=None, **kwargs):
+        receiver = getattr(self.token_to_kv_pool, 'pd_direct_receiver', None)
+        # Health checks use a native fake receiver even on a Mooncake service.
+        # They have no remote writer and must not advertise or pin destinations.
+        if _is_fake_transfer(request.req):
+            receiver = None
+        if receiver is not None:
+            if page_size != receiver.page_size:
+                raise ValueError('Direct native transfer page size differs from the allocator')
+            plan = receiver.reserve(request.req.bootstrap_room, kv_indices,
+                request_id=request.req.rid,prefix_records=int(kwargs.get('decode_prefix_len') or 0))
+            encoding=time.monotonic()
+            kwargs['direct_kv_metadata'] = plan.to_bytes()
+            encoding_seconds=time.monotonic()-encoding
+        result=original_metadata(self, request, kv_indices, page_size, state_indices, **kwargs)
+        if receiver is not None:receiver.metadata_sent(request.req.bootstrap_room,
+            encoding_seconds=encoding_seconds,metadata_bytes=len(kwargs['direct_kv_metadata']))
+        return result
+
+    def commit(self, request):
+        pool = self.scheduler.disagg_decode_prealloc_queue.token_to_kv_pool
+        receiver = getattr(pool, 'pd_direct_receiver', None)
+        if receiver is not None and not _is_fake_transfer(request.req):
+            actual = self.metadata_buffers.get_buf(request.metadata_buffer_index)[-1][0].item()
+            expected = request.req.bootstrap_room
+            if expected and actual == expected:
+                receiver.complete(expected)
+        return original_commit(self, request)
+
+    def release(self, *page_ids):
+        receiver = getattr(self._kvcache, 'pd_direct_receiver', None)
+        if receiver is not None:
+            ids = page_ids[0] if len(page_ids)==1 else torch.cat(page_ids)
+            # Native deferred release invokes this only after its drain ACK.
+            # Retire pins BEFORE the ordinary allocator frees physical records.
+            receiver.logical_pages_freed(ids.cpu().tolist(), transport_quiesced=True)
+        return original_release(self, *page_ids)
+
+    def defer(self, request):
+        result = original_defer(self, request)
+        pool = self.scheduler.disagg_decode_prealloc_queue.token_to_kv_pool
+        if (getattr(pool, 'pd_direct_receiver', None) is not None
+                and not _is_fake_transfer(request.req)):
+            entry = self._deferred_releases[-1]
+            if entry[0] is not request:
+                raise RuntimeError('Native deferred receive ordering changed')
+            self._deferred_releases[-1] = (entry[0],entry[1],float('inf'),entry[3],entry[4])
+        return result
+
+    configurator.KVCacheConfigurator._build_dsa_kv_pool = build
+    DecodePreallocQueue.__init__ = queue
+    DecodePreallocQueue._pre_alloc = allocate
+    DecodePreallocQueue._send_kv_metadata = metadata
+    DecodeTransferQueue._commit_transfer_to_req = commit
+    DecodeTransferQueue._defer_release = defer
+    PagedTokenToKVPoolAllocator._release_page_ids = release
diff --git a/python/sglang/srt/ulacache/pd_linear_mtp_capability.py b/python/sglang/srt/ulacache/pd_linear_mtp_capability.py
new file mode 100644
index 0000000000000000000000000000000000000000..0c4122d9464e47f98d75eb45c70862cb8c74068d
--- /dev/null
+++ b/python/sglang/srt/ulacache/pd_linear_mtp_capability.py
@@ -0,0 +1,95 @@
+"""Explicit native PD capability checks for the validated linear DSA layout."""
+
+
+def supports_linear_mtp_radix(config, model, *, is_dsa, cache_kind,
+                             cuda_platform, deferred_remote_release,
+                             attention_mode='dpa', model_layout=None,
+                             resolved_attention_tp_size=None):
+    """Recognize bounded FP8/NextN configurations before weight loading.
+
+    This capability changes validation only. Native prefix matching, target and
+    draft inference, HiCache, and remote-write retirement remain authoritative.
+    Startup inventories and HTTP prefix-transfer gates are still required.
+    Ordinary TP8 is an explicit native-HiCache preflight candidate. Its actual
+    allocation, all-rank transport, capture and HTTP acceptance are separate.
+    Owner-striped UlaCache TP and HiSparse need their own receive bindings.
+    """
+    if attention_mode not in ('dpa', 'tp'):
+        return False
+    if attention_mode == 'tp' and cache_kind != 'native':
+        return False
+    if (cache_kind not in ('native', 'ulacache') or not is_dsa
+            or cuda_platform is not True or deferred_remote_release is not True):
+        return False
+    required = {
+        'disaggregation_mode': 'decode',
+        'disaggregation_transfer_backend': 'mooncake',
+        'disaggregation_decode_enable_radix_cache': True,
+        'speculative_algorithm': 'EAGLE',
+        'speculative_num_steps': 2,
+        'speculative_eagle_topk': 1,
+        'speculative_num_draft_tokens': 3,
+        'speculative_adaptive': False,
+        'disable_overlap_schedule': True,
+        'kv_cache_dtype': 'fp8_e4m3',
+        'page_size': 64,
+        'tp_size': 8,
+        'attn_dp_size': 8 if attention_mode == 'dpa' else 1,
+        'moe_dense_tp_size': 8,
+        'attn_cp_size': 1,
+        'pp_size': 1,
+        'ep_size': 1,
+        'dp_size': 1,
+        'dcp_size': 1,
+        'enable_hisparse': False,
+        'enable_unified_memory': False,
+        'enable_unified_cache_external_linker': False,
+        'enable_hierarchical_cache': cache_kind == 'native',
+    }
+    for name, value in required.items():
+        actual = getattr(config, name, None)
+        if name == 'moe_dense_tp_size' and actual is None and model_layout is not None:
+            # Native HY4 startup inherits its model TP group when this is unset.
+            continue
+        if type(actual) is not type(value) or actual != value:
+            return False
+    if model_layout is not None:
+        from sglang.srt.ulacache.hy4_pd_layout import HY4PDLayout
+        width = getattr(config, 'attn_tp_size', None)
+        if width is None:
+            width = resolved_attention_tp_size
+        return (isinstance(model_layout, HY4PDLayout)
+            and model_layout.attention_mode == attention_mode
+            and type(width) is int and width == (8 if attention_mode == 'tp' else 1)
+            and model_layout.supports(config, model))
+    return (getattr(model, 'num_nextn_predict_layers', None) == 1
+        and getattr(model, 'kv_lora_rank', None) == 512
+        and getattr(model, 'qk_rope_head_dim', None) == 64
+        and getattr(model.hf_config, 'index_share_for_mtp_iteration', False) is True)
+
+
+def install(*, model_layout=None):
+    """Register only with a native framework that exposes the capability API."""
+    import os
+    from sglang.srt.arg_groups import pd_disaggregation_hook as native
+    from sglang.srt.configs.model_config import is_deepseek_dsa
+    from sglang.srt.runtime_context import attn_tp_size_of
+    from sglang.srt.utils import is_cuda
+
+    register = getattr(native, 'register_decode_radix_speculation_capability', None)
+    if register is None or os.environ.get('ULACACHE_NATIVE_PD_LINEAR_MTP') != '1':
+        return
+
+    def accepts(server_args):
+        config = native.resolving_view(server_args)
+        model = native.model_config_of(server_args)
+        return supports_linear_mtp_radix(config, model,
+            is_dsa=is_deepseek_dsa(model.hf_config),
+            cache_kind=os.environ.get('ULACACHE_PD_CACHE_KIND'),
+            cuda_platform=is_cuda(),
+            deferred_remote_release=os.environ.get('SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE') == '1',
+            attention_mode=os.environ.get('ULACACHE_PD_ATTENTION_MODE', 'dpa'),
+            model_layout=model_layout,
+            resolved_attention_tp_size=attn_tp_size_of(config))
+
+    register('ulacache_native_linear_dsa_mtp', accepts)
diff --git a/python/sglang/srt/ulacache/pd_owner_adapter.py b/python/sglang/srt/ulacache/pd_owner_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..a9360cb57c36290ce044687aafe887270965d071
--- /dev/null
+++ b/python/sglang/srt/ulacache/pd_owner_adapter.py
@@ -0,0 +1,119 @@
+"""Explicit native TP owner-pool and Mooncake receive wiring before capture.
+
+This module supplies framework bindings only. Residency, Index ownership,
+receive leases and publication remain in the existing library implementations.
+Nothing installs this module automatically.
+"""
+import dataclasses
+import os
+
+_binding = None
+
+
+def install(*, on_publication=None, model_layout=None, target_cache_installer=None):
+    """Bind the existing owner receiver; full-model validation remains required."""
+    global _binding
+    if on_publication is not None and not callable(on_publication):
+        raise TypeError('The publication observer must be callable')
+    if _binding is not None:
+        if on_publication is not None:
+            raise ValueError('Configure the publication observer during the first installation')
+        return _binding
+    if (os.environ.get('ULACACHE_PD_CACHE_KIND') != 'ulacache'
+            or os.environ.get('ULACACHE_PD_ATTENTION_MODE') != 'tp'
+            or os.environ.get('SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE') != '1'):
+        raise ValueError('Native owner PD requires explicit TP selection and remote retirement')
+    from sglang.srt.arg_groups import memory_hook, pd_disaggregation_hook
+    if not hasattr(memory_hook, "register_flowkv_pd_cpu_offload_capability"):
+        from sglang.srt.ulacache.hy4_pd_validation import install as install_native_pd_validation
+
+        install_native_pd_validation()
+    from sglang.srt.configs.model_config import is_deepseek_dsa
+    from sglang.srt.disaggregation import decode, prefill, utils as transfer_utils
+    from sglang.srt.disaggregation.base.conn import StateType
+    from sglang.srt.disaggregation.mooncake.conn import MooncakeKVManager
+    from sglang.srt.mem_cache import kv_cache_configurator as configurator
+    from sglang.srt.mem_cache.allocator.flowkv_host import FlowKVHostTokenToKVPoolAllocator
+    from sglang.srt.mem_cache.flowkv_host_pool import FlowKVHostRecordPool
+    from sglang.srt.runtime_context import attn_tp_size_of, get_disagg, get_memory, get_parallel
+    from sglang.srt.utils import is_cuda
+    from ulacache.transfer.receive_window import incremental_state_indices
+    from sglang.srt.ulacache.pd_owner_capability import supports_owner_tp_pd_mtp
+    from sglang.srt.ulacache.pd_owner_queue_bindings import bind_native_owner_pd_queues
+    from sglang.srt.ulacache.pd_owner_receive_bindings import bind_native_owner_receive_storage
+    from sglang.srt.ulacache.pd_record_adapter import bind_native_pd_index_elision, bind_native_pd_state_compaction
+
+    register_memory = getattr(memory_hook, 'register_flowkv_pd_cpu_offload_capability', None)
+    register_radix = getattr(pd_disaggregation_hook, 'register_decode_radix_speculation_capability', None)
+    if not callable(register_memory) or not callable(register_radix):
+        raise ValueError('The pinned native owner-PD validation hooks are required')
+    if getattr(configurator, '_ulacache_pd_record_adapter_bound', False):
+        raise ValueError('A different native PD record adapter is already installed')
+    capacity = int(os.environ['ULACACHE_PD_RECEIVE_RECORDS'])
+    if capacity < 64 or capacity % 64:
+        raise ValueError('Native owner PD receive capacity must be positive and page64 aligned')
+
+    if target_cache_installer is None:
+        from sglang.srt.ulacache.native_tensor_parallel_pool import install_native_tensor_parallel_pool
+        install_native_tensor_parallel_pool()
+    else:
+        if not callable(target_cache_installer):
+            raise TypeError('The native target-cache installer must be callable')
+        target_cache_installer()
+    bind_native_pd_index_elision(configurator, get_memory, get_parallel, get_disagg)
+    bind_native_pd_state_compaction(transfer_utils, StateType.DSA, decode, prefill)
+    original_extra = MooncakeKVManager.maybe_send_extra
+
+    def send_extra(manager, request, state_indices, executor, registration=None):
+        prefix = int(request.decode_prefix_len or 0)
+        if prefix and StateType.DSA in manager.kv_args.state_types:
+            source, destination = list(state_indices), list(request.dst_state_indices)
+            index = manager.kv_args.state_types.index(StateType.DSA)
+            source[index], destination[index] = incremental_state_indices(
+                source[index], destination[index], prefix, manager.kv_args.page_size)
+            request = dataclasses.replace(request, dst_state_indices=destination)
+            state_indices = source
+        return original_extra(manager, request, state_indices, executor, registration)
+
+    MooncakeKVManager.maybe_send_extra = send_extra
+    original_build = configurator.KVCacheConfigurator._build_dsa_kv_pool
+
+    def build(native, **kwargs):
+        pool = original_build(native, **kwargs)
+        if not native.is_draft_worker:
+            if get_disagg().disaggregation_mode != 'decode':
+                raise ValueError('Native owner reception requires a decode-only worker')
+            bind_native_owner_receive_storage(pool, record_capacity=capacity,
+                allocate_host_record_storage=FlowKVHostRecordPool)
+        return pool
+
+    configurator.KVCacheConfigurator._build_dsa_kv_pool = build
+    bind_native_owner_pd_queues(decode.DecodePreallocQueue, decode.DecodeTransferQueue,
+        FlowKVHostTokenToKVPoolAllocator, dsa_state_type=StateType.DSA,
+        on_publication=on_publication)
+
+    def accepts(server_args):
+        config = memory_hook.resolving_view(server_args)
+        model = memory_hook.model_config_of(server_args)
+        return supports_owner_tp_pd_mtp(config, model,
+            resolved_attention_tp_size=attn_tp_size_of(config), model_layout=model_layout,
+            is_dsa=is_deepseek_dsa(model.hf_config), cuda_platform=is_cuda(),
+            deferred_remote_release=os.environ.get('SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE') == '1',
+            receive_binding_installed=(getattr(decode.DecodePreallocQueue,
+                '_ulacache_owner_receive_bound', False) is True))
+
+    register_memory('ulacache_native_owner_pd_mtp', accepts)
+    register_radix('ulacache_native_owner_pd_mtp', accepts)
+    configurator._ulacache_pd_record_adapter_bound = True
+    _binding = dict(installed=True, native_allocation_page_size=512,
+        native_transfer_page_size=64, maximum_running_requests=128,
+        supported_running_requests=[32, 64, 128],
+        verify_query_upper_bound=512, receive_record_capacity=capacity,
+        publication_observer_enabled=on_publication is not None,
+        full_model_or_performance_accepted=False)
+    if model_layout is not None:
+        _binding.update(model_layout=model_layout.evidence(),
+            maximum_running_requests=model_layout.request_capacity,
+            supported_running_requests=[model_layout.request_capacity],
+            verify_query_upper_bound=model_layout.request_capacity * 3)
+    return _binding
diff --git a/python/sglang/srt/ulacache/pd_owner_capability.py b/python/sglang/srt/ulacache/pd_owner_capability.py
