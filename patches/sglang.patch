+    if physical < required:
+        raise ValueError('Native decode hot/scratch capacity is underbudgeted')
+    return dict(max_hot_buffer_records=32768, physical_records=physical,
+                decode_hot_and_scratch_records=required,
+                prefill_uses_decode_physical_records=False)
+
+
