+        return (
+            DSATokenToKVPool.get_kv_size_bytes(self)
+            + arena.local_kv_buffer_bytes
+            + arena.prefill_bytes
+            + arena.staging_bytes
+            + arena.metadata_bytes
+            + self.flowkv_staging_target_rows.nbytes
+            + self.flowkv_peers.ptrs.nbytes
+            + self._flowkv_global_indices.nbytes
+            + self._flowkv_global_current.nbytes
+            + self.flowkv_step_publication.nbytes
+            + (
+                self.flowkv_host.metadata_bytes
+                if self.flowkv_host is not None else 0
+            )
+            + (self.flowkv_request.metadata_bytes if self.flowkv_request is not None else 0)
+        )
