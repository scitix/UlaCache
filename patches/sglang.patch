index 0000000000000000000000000000000000000000..1eab122ae08a3213f5068022a4228720f65a3a62
--- /dev/null
+++ b/python/sglang/srt/ulacache/matrix_prefix_load_adapter.py
@@ -0,0 +1,382 @@
+"""Restore canonical records and native continuation before native decode."""
+from contextlib import ExitStack
+import hashlib
+import json
+from pathlib import Path
+import time
+
+
+def install(config):
+    prepared_restore = config.get("prepared_dpa_restore", False)
+    if type(prepared_restore) is not bool:
+        raise ValueError("prepared_dpa_restore must be a boolean")
+    if prepared_restore and config["cache_kind"] != "dpa_udcache":
+        raise ValueError("Prepared restore requires dpa_udcache")
+    if config.get("reset_graph_padding", False):
+        if not config.get("paused_cohort_admission", False):
+            raise ValueError("Graph padding reset requires the drained paused-cohort protocol")
+        from sglang.srt.ulacache.matrix_graph_padding_adapter import install as install_padding
+        install_padding()
+    import torch
+    from sglang.srt.managers.scheduler import Scheduler
+    from sglang.srt.managers.schedule_batch import NextBatchPlan
+    from sglang.srt.managers.overlap_utils import RelayPayload
+    from sglang.srt.model_executor.model_runner import ModelRunner
+    from sglang.srt.runtime_context import get_parallel
+    from sglang.srt.speculative.eagle_info import EagleDraftInput
+    from ulacache.tools.snapshot.format import SnapshotReader
+    from ulacache.tools.snapshot.prefix import NativeByteBanks, restore_native_prefix
+    from ulacache.tools.snapshot.restore import iter_sequence_plane, write_index_records
+    from ulacache.tools.snapshot.speculative import load_continuation
+
+    if config.get("native_scheduler_control", False):
+        from sglang.srt.ulacache.native_scheduler_admission import install_scheduler_receipts
+        install_scheduler_receipts(Scheduler, config["receipts"])
+
+    if config.get("paused_cohort_admission", False) and not config.get("native_scheduler_control", False):
+        from sglang.srt.managers.tokenizer_manager import TokenizerManager
+        original_pause = TokenizerManager.pause_generation
+
+        async def pause_for_admission(manager, request):
+            await original_pause(manager, request)
+            if request.mode == "in_place":
+                # The isolated benchmark pauses native execution while still
+                # admitting its entire saved-prefix cohort. Native pause also
+                # closes the tokenizer gate, which would prevent admission.
+                async with manager.is_pause_cond:
+                    manager.is_pause = False
+                    manager.is_pause_cond.notify_all()
+
+        TokenizerManager.pause_generation = pause_for_admission
+
+    original_prefill, original_forward = Scheduler.get_new_batch_prefill, ModelRunner.forward
+    state = dict(cohort=0, active=False, forwards=0, prefills=0, pause_sequence=0,
+                 prepared_restore_requests=0)
+
+    def report(kind, value):
+        root = Path(config["receipts"])
+        root.mkdir(parents=True, exist_ok=True)
+        path = root / f"{kind}.cohort{state['cohort']:06d}.rank{torch.distributed.get_rank()}.json"
+        temporary = path.with_suffix(".tmp")
+        value = dict(value, request_cohort=value.get("request_cohort", state.get("request_cohort")))
+        temporary.write_text(json.dumps(value, indent=2) + "\n")
+        temporary.replace(path)
+
+    if config.get("replay_trace"):
+        from ulacache.tools.fixed_output import FixedMTPReplay, FixedTokenReplay, ReplayTrace
+
+        trace = ReplayTrace(config["replay_trace"])
+        if trace.speculative != config["mtp"]:
+            raise ValueError("Replay trace and server speculation settings differ")
+        replay = None
+
+        def engine():
+            nonlocal replay
+            if replay is None:
+                parallel = get_parallel()
+                replay_type = FixedMTPReplay if trace.speculative else FixedTokenReplay
+                replay = replay_type(trace, attention_dp=parallel.attn_dp_size,
+                                      rank=parallel.attn_dp_rank)
+            return replay
+
+        def completed(batch):
+            identity = FixedMTPReplay.identity(batch)
+            if identity is not None and replay.completed(identity[0]):
+                report("replay", replay.receipt(identity[0]))
+
+        if trace.speculative:
+            from sglang.srt.speculative import eagle_worker_v2, eagle_worker_common
+            original_draft = eagle_worker_v2.EagleDraftWorker.draft
+            original_sample = eagle_worker_common.eagle_sample
+
+            def replay_draft(worker, batch, *args, **kwargs):
+                if FixedMTPReplay.identity(batch) is None:
+                    return original_draft(worker, batch, *args, **kwargs)
+                return engine().draft(original_draft, worker, batch, *args, **kwargs)
+
+            def replay_sample(verify, batch, *args, **kwargs):
+                if replay is None:
+                    return original_sample(verify, batch, *args, **kwargs)
+                result = replay.sample(original_sample, verify, batch, *args, **kwargs)
+                completed(batch)
+                return result
+
+            eagle_worker_v2.EagleDraftWorker.draft = replay_draft
+            eagle_worker_common.eagle_sample = replay_sample
+        else:
+            from sglang.srt.layers.sampler import Sampler
+            original_run, original_sample = Scheduler.run_batch, Sampler.forward
+
+            def replay_run(scheduler, batch, *args, **kwargs):
+                if FixedMTPReplay.identity(batch) is None:
+                    return original_run(scheduler, batch, *args, **kwargs)
+                if scheduler.enable_overlap:
+                    raise ValueError("Fixed-output replay requires non-overlapping scheduling")
+                current = engine()
+                current.begin(batch)
+                result = original_run(scheduler, batch, *args, **kwargs)
+                current.end()
+                completed(batch)
+                return result
+
+            def replay_tokens(sampler, logits_output, sampling_info, return_logprob, *args, **kwargs):
+                result = original_sample(sampler, logits_output, sampling_info, return_logprob, *args, **kwargs)
+                return replay.sample(result, sampling_info, return_logprob) if replay else result
+
+            Scheduler.run_batch, Sampler.forward = replay_run, replay_tokens
+
+    def native_banks(pool):
+        mla = [pool.get_key_buffer(pool.start_layer + layer) for layer in range(pool.layer_num)]
+        index = {layer: tensor for layer, tensor in enumerate(pool.index_key_cache.buffer) if tensor.numel()}
+        return NativeByteBanks(mla, index, mla[0].view(torch.uint8)[0].numel())
+
+    def target_restore(scheduler, path, request, rows):
+        pool = scheduler.token_to_kv_pool_allocator.get_kvcache()
+        kind = config["cache_kind"]
+        verify = config.get("verify_restored", False)
+        if kind == "native":
+            return restore_native_prefix(path, request.key, native_banks(pool), rows,
+                config["model_fingerprint"], quiesce=torch.cuda.synchronize, verify=verify)["restored_bytes"]
+        if kind == "tp_udcache":
+            from ulacache.tools.snapshot.cuda import bind_udcache_pool
+            from ulacache.tools.snapshot.cuda import FastCudaRequestSnapshot
+            bound = bind_udcache_pool(pool, config["model_fingerprint"], quiesce=torch.cuda.synchronize)
+            reader = FastCudaRequestSnapshot(bound.bindings)
+            return reader.restore_canonical_request(path, request.key, rows,
+                verify_restored=verify)["restored_bytes"]
+        source = SnapshotReader(path)
+        if source.layout.owners != 1 or source.layout.model_fingerprint != config["model_fingerprint"]:
+            raise ValueError("A matching canonical source is required")
+        if source.layout.layers != pool.layer_num:
+            raise ValueError("Source MLA layer count differs from native pool")
+        if kind == "hisparse":
+            coordinator = scheduler.hisparse_coordinator
+            host = coordinator.mem_pool_host
+            if host.layout != "layer_first" or host.token_stride_size != source.layout.mla_row_bytes:
+                raise ValueError("HiSparse native host records differ from the canonical source")
+            host_rows = host.alloc_paged_token_slots(coordinator.req_to_host_pool,
+                coordinator.req_to_host_pool_allocated_len, request.native.kv.req_pool_idx,
+                0, request.saved.next_position).cpu().long()
+        elif kind != "dpa_udcache":
+            raise ValueError("Unknown explicit snapshot restore cache kind")
+        checked = 0
+        prepared = native_records = None
+        with ExitStack() as scopes:
+            if kind == "dpa_udcache" and callable(getattr(pool, '_native_record_io', None)):
+                native_records = scopes.enter_context(pool._native_record_io(rows))
+            elif kind == "dpa_udcache" and prepared_restore:
+                from ulacache.tools.snapshot.restore import PreparedSequenceRestore
+                prepared = PreparedSequenceRestore(pool.udcache_local, rows,
+                                                   quiesce=torch.cuda.synchronize)
+            for plane in source.layout.planes():
+                layer = int(plane.rsplit("_", 1)[1])
+                for start, data in iter_sequence_plane(source, request.key, plane):
+                    selected = rows[start:start + len(data)]
+                    if plane.startswith("index_"):
+                        bank = pool.index_key_cache.buffer[layer]
+                        if not bank.numel():
+                            raise ValueError("A source Index anchor is absent in the native target")
+                        write_index_records(bank, selected, data)
+                        if verify and native_banks(pool).read(plane, selected) != data.contiguous().numpy().tobytes():
+                            raise RuntimeError("Restored native Index bytes differ")
+                    elif kind == "hisparse":
+                        bank = host.data_refs[layer].view(torch.uint8).reshape(-1, host.token_stride_size)
+                        indices = host_rows[start:start + len(data)]
+                        bank.index_copy_(0, indices, data)
+                        if verify and not torch.equal(bank.index_select(0, indices), data):
+                            raise RuntimeError("HiSparse restored native MLA bytes differ")
+                    elif native_records is not None:
+                        native_records.write(layer, start, data)
+                        if verify and not torch.equal(native_records.read(layer, start, len(data)), data):
+                            raise RuntimeError("Restored native paged MLA bytes differ")
+                    elif prepared is not None:
+                        prepared.write(layer, start, data, verify=verify)
+                    else:
+                        from ulacache.tools.snapshot.restore import write_sequence_records
+                        write_sequence_records(pool.udcache_local, layer, selected, data, verify=verify)
+                    checked += data.numel()
+        if kind == "hisparse":
+            torch.cuda.synchronize()
+            coordinator.admit_request_direct(request.native)
+        if prepared is not None or (native_records is not None and prepared_restore):
+            state["prepared_restore_requests"] += 1
+        return checked
+
+    def prefill(scheduler, running_batch):
+        waiting = scheduler.waiting_queue
+        if not waiting or all("udcache_snapshot_batch" not in (r.sampling_params.custom_params or {}) for r in waiting):
+            if waiting:
+                state["active"] = False
+            return original_prefill(scheduler, running_batch)
+        params = [r.sampling_params.custom_params or {} for r in waiting]
+        if not all("udcache_snapshot_key" in p for p in params):
+            raise ValueError("A restore cohort cannot mix prefill and saved-prefix requests")
+        totals = {p["udcache_snapshot_batch"] for p in params}
+        locals_ = {p["udcache_snapshot_local_batch"] for p in params}
+        if len(totals) != 1 or len(locals_) != 1:
+            raise ValueError("A restore cohort needs its exact global and routed local counts")
+        total, local = totals.pop(), locals_.pop()
+        if len(waiting) < local:
+            return NextBatchPlan(batch_to_run=None, running_batch=running_batch)
+        if len(waiting) != local or not running_batch.is_empty() or total > config["batch"]:
+            raise ValueError("Saved-prefix cohort cannot be published partially")
+        state.update(cohort=state["cohort"] + 1, active=False, forwards=0, prefills=0,
+                     prepared_restore_requests=0)
+        cohorts = {p.get("udcache_snapshot_cohort", "correctness-gate") for p in params}
+        if len(cohorts) != 1:
+            raise ValueError("A restore cannot combine independently submitted cohorts")
+        state["request_cohort"] = cohorts.pop()
+        started, checked = time.monotonic(), 0
+        native_requests = sorted(waiting, key=lambda r: r.sampling_params.custom_params["udcache_snapshot_dataset_index"])
+        if scheduler.req_to_token_pool.alloc(native_requests) is None:
+            raise RuntimeError("Saved cohort exceeds native request slots")
+        allocator = scheduler.token_to_kv_pool_allocator
+        history_allocator = allocator.logical_attn_allocator if config["cache_kind"] == "hisparse" else allocator
+        continuation, restored = [], []
+        report("restore_progress", dict(requests_loaded=0, local_requests=len(native_requests),
+            restored_bytes=0, elapsed_seconds=0, scope="Unmeasured saved-prefix IO progress"))
+        for req in native_requests:
+            key = req.sampling_params.custom_params["udcache_snapshot_key"]
+            root = Path(config["bank"]) / hashlib.sha256(key.encode()).hexdigest()
+            fallback = config.get("canonical_fallback_bank")
+            if fallback and not (root / "SNAPSHOT.json").exists():
+                root = Path(fallback) / hashlib.sha256(key.encode()).hexdigest()
+            meta = json.loads((root / "SNAPSHOT.json").read_text())
+            if not meta["complete"] or meta["key"] != key or meta["model_fingerprint"] != config["model_fingerprint"]:
+                raise ValueError("Snapshot source fingerprint differs")
+            source_reader = SnapshotReader(root / "target")
+            saved = source_reader.requests[0]
+            if saved.key != key or tuple(req.origin_input_ids) != saved.input_ids:
+                raise ValueError("Saved history differs from the original complete prompt")
+            if req.return_logprob or req.is_dllm():
+                raise NotImplementedError("Canonical restore currently supplies ordinary token generation state")
+            n = saved.next_position
+            allocated = (n + allocator.page_size - 1) // allocator.page_size * allocator.page_size
+            all_rows = history_allocator.alloc(allocated)
+            if all_rows is None:
+                raise RuntimeError("Statically admitted cohort exceeds actual native logical allocation")
+            if not config["mtp"]:
