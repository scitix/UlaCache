+++ b/python/sglang/srt/ulacache/model_integration.py
@@ -0,0 +1,113 @@
+"""One startup dispatch for the native model adapters; no model math here."""
+
+from importlib import import_module
+import os
+import sys
+
+from sglang.srt.ulacache.model_configuration import LEGACY_CONFIGURATION_VARIABLES, POOL_BINDINGS
+
+
+_installed = None
+
+
+def _set_environment(environment, name, value):
+    value = str(value)
+    if name in environment and environment[name] != value:
+        raise ValueError(f'{name} conflicts with the unified configuration')
+    environment[name] = value
+
+
+def configure_launch(configuration, arguments, environment):
+    staged_arguments, staged_environment = list(arguments), dict(environment)
+    _configure_launch(configuration, staged_arguments, staged_environment)
+    arguments[:] = staged_arguments
+    environment.update(staged_environment)
+
+
+def _configure_launch(configuration, arguments, environment):
+    """Configure the same settings before pool construction in every worker."""
+    pool = configuration.pool
+    if configuration.framework_release == 'v0.5.22' and configuration.adapter in ('native_tp', 'native_dpa'):
+        # Version-pinned bindings consume the same configuration object before
+        # native validation; the official parser has no legacy cache flags.
+        return
+    if configuration.adapter == 'native_tp':
+        from sglang.srt.ulacache.native_tensor_parallel_pool import configure_native_tensor_parallel_defaults
+
+        _set_environment(environment, 'UDCACHE_PLAIN_PREFILL_WINDOW_ROWS', pool.prefill_window_rows)
+        _set_environment(environment, 'ULACACHE_TP_LOW_QUERY_PULL_BLOCKS', pool.low_query_pull_blocks)
+        _set_environment(environment, 'ULACACHE_REUSE_PREFILL_METADATA', int(pool.reuse_prefill_metadata))
+        configure_native_tensor_parallel_defaults(arguments, environment)
+    elif configuration.adapter == 'native_dpa':
+        for name, value in {
+            'UDCACHE_DPA_GPU_SLOTS': pool.device_record_capacity,
+            'UDCACHE_DPA_CPU_SLOTS': pool.host_record_capacity,
+            'UDCACHE_DPA_CACHE_BUDGET_BYTES': pool.device_cache_budget_bytes,
+            'UDCACHE_CPU_CACHE_CAP_BYTES': pool.host_cache_budget_bytes,
+            'UDCACHE_DPA_CPU_PREFILL': int(pool.cpu_prefill),
+            'UDCACHE_DPA_PARALLEL_PREPARE': int(pool.parallel_prepare),
+            'UDCACHE_DPA_PARALLEL_VICTIMS': int(pool.parallel_victims),
+            'UDCACHE_DPA_ASYNC_FOLLOWERS': int(pool.asynchronous_followers),
+        }.items():
+            _set_environment(environment, name, value)
+    if configuration.cpu_ngram_embedding and '--ple-offload-embedding' not in arguments:
+        arguments.append('--ple-offload-embedding')
+
+
+def install_model_integration(configuration):
+    """Install one binding per process, including multiprocessing spawn imports."""
+    global _installed
+    if _installed is not None:
+        if _installed[0] != configuration:
+            raise RuntimeError('A different native cache integration is already installed')
+        if not _installed[1]:
+            raise RuntimeError('The previous native installation failed; restart this process before retrying')
+        return
+    legacy = [name for name in LEGACY_CONFIGURATION_VARIABLES if os.environ.get(name)]
+    if legacy:
+        raise ValueError(f'Use ULACACHE_CONFIGURATION without legacy configuration variables: {legacy}')
+    configure_launch(configuration, sys.argv, os.environ)
+    _installed = (configuration, False)
+    adapter = configuration.adapter
+    if configuration.framework_release == 'v0.5.22' and adapter == 'native_tp':
+        from sglang.srt.ulacache.v0522_owner_tp import configure, install
+
+        configure(configuration.pool)
+        install()
+        if configuration.pool.native_kv_format == 'scaled656':
+            from sglang.srt.ulacache.native_attention import install_owner_attention as install_native_reader
+
+            install_native_reader()
+
+    elif configuration.framework_release == 'v0.5.22' and adapter == 'native_dpa':
+        from sglang.srt.ulacache.v0522_fp8_loading import install as install_fp8_loading
+        from sglang.srt.ulacache.v0522_dpa import install
+
+        install_fp8_loading()
+        install(configuration.pool)
+    elif adapter in POOL_BINDINGS:
+        binding = POOL_BINDINGS[adapter]
+        getattr(import_module(binding.module), binding.installer)(configuration.pool)
+    elif adapter == 'native_tp':
+        from sglang.srt.ulacache.native_tensor_parallel_pool import install_native_tensor_parallel_pool
+
+        install_native_tensor_parallel_pool()
+    elif adapter == 'native_dpa':
+        from sglang.srt.ulacache.unified_local_adapter import install
+
+        install()
+    else:
+        # Preserve the baseline's shared-TopK allocation optimization in both
+        # the parent entry and freshly spawned native workers.
+        from sglang.srt.ulacache.agent_hicache_shared_index_adapter import install
+
+        install()
+    if os.environ.get('UDCACHE_MATRIX_AUDIT_DIR'):
+        from sglang.srt.ulacache.matrix_startup_audit import install
+
+        install()
+        if configuration.cpu_ngram_embedding:
+            from sglang.srt.ulacache.qwen_cpu_ngram_audit import install
+
+            install()
+    _installed = (configuration, True)
diff --git a/python/sglang/srt/ulacache/native_attention.py b/python/sglang/srt/ulacache/native_attention.py
