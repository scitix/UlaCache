new file mode 100644
index 0000000000000000000000000000000000000000..fa06ba1ac7edd17b58ba687247b0f3b7e2d89085
--- /dev/null
+++ b/python/sglang/srt/mem_cache/native_sparse_cache_adapter.py
@@ -0,0 +1,60 @@
+"""Native execution boundaries for an independently managed sparse KV tier."""
+
+from abc import ABC, abstractmethod
+from typing import Any
+
+
+class NativeSparseCacheAdapter(ABC):
+    """The framework retains selection, quantization and attention computation."""
+
+    @abstractmethod
+    def prepare_cache_forward(self, batch: Any, *, publish_active_query_count: bool = True) -> None:
+        """Reset execution state; publish active query metadata outside capture.
+
+        Warmup/capture repetitions retain the count published by native setup.
+        """
+
+    @abstractmethod
+    def prepare_native_sparse_attention(self, layer_id: int, selected_records: Any) -> Any:
+        """Return device record IDs for the unmodified native sparse reader."""
+
+    @abstractmethod
+    def read_native_prefill_records(self, layer_id: int, selected_records: Any, output: Any) -> None:
+        """Read bounded resident chunks into the existing native prefill workspace."""
+
+    @abstractmethod
+    def finish_cache_attention(self, layer_id: int) -> None:
+        """Retire one consumer after its native reader has completed on stream."""
+
+    @abstractmethod
+    def finish_cache_forward(self) -> None:
+        """Finish the native forward without changing request ownership."""
+
+    @abstractmethod
+    def register_native_full_pages(self, full_page_ids: Any, *, prefer_device: bool) -> None:
+        """Register newly acquired native full pages in their declared cache tiers."""
+
+    @abstractmethod
+    def release_native_full_pages(self, full_page_ids: Any) -> None:
+        """Release the compressed records only when their native full pages retire."""
+
+    @abstractmethod
+    def clear_native_full_records(self) -> None:
+        """Reset after native readers retire and retain the native dummy page."""
+
+
+class NativeFusedSparseCacheAdapter(NativeSparseCacheAdapter):
+    """Optional output binding for native compressed MLA fused writers."""
+
+    @abstractmethod
+    def manages_native_sparse_tier(self, layer_id: int, compression_ratio: int) -> bool:
+        """Declare the independently managed tiers at each native model layer."""
+
+    @abstractmethod
+    def prepare_native_fused_cache_write(self, layer_id: int, raw_write_locations: Any,
+                                         logical_record_ids: Any) -> tuple[Any, Any]:
+        """Bind native output pages and destinations, preserving padding validity."""
+
+    @abstractmethod
+    def finish_native_fused_cache_write(self, layer_id: int) -> None:
+        """Publish eager output or retain it until decode residency is prepared."""
