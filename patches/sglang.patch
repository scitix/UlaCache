+++ b/python/sglang/srt/ulacache/tensor_parallel_draft_index.py
@@ -0,0 +1,43 @@
+"""Reuse native owner-striped Index storage for an ordinary TP MTP draft.
+
+MLA records remain in the native full address space. Only the Index facade is
+selected here; quantization, peer reads and scoring use the existing native
+owner Index and CP scorer. No allocator or request lifetime is introduced.
+"""
+
+
+def create_owner_index_draft_pool_class(base, target):
+    cache = getattr(target, "index_key_cache", None)
+    if not getattr(cache, "is_owner_compact", False):
+        raise ValueError("Distributed draft Index requires the target owner Index")
+    degree = target._flowkv_storage_size
+    if degree != 8 or target._flowkv_namespaces != 1 or target.page_size != 64:
+        raise ValueError("Distributed draft Index requires ordinary page64 TP8")
+    layout = target.flowkv_layout
+    rank = target.flowkv_rank
+
+    class OwnerIndexDraftDSATokenToKVPool(base):
+        owner_index_draft = True
+
+        def __init__(self, *args, **kwargs):
+            # These are immutable identity/topology bounds, not target storage.
+            self._flowkv_storage_size = degree
+            self._flowkv_namespaces = 1
+            self.flowkv_rank = rank
+            self.flowkv_layout = layout
+            self.flowkv_request = None
+            self.flowkv_host = None
+            super().__init__(*args, **kwargs)
+            if self.layer_num != 1:
+                raise ValueError("Distributed MTP draft Index requires one native layer")
+
+        def _create_index_key_cache(self):
+            from sglang.srt.mem_cache.flowkv_owner_index import FlowKVOwnerIndexCache
+
+            return FlowKVOwnerIndexCache(self, self.index_buf_size)
+
+        @property
+        def allocation_page_size(self):
+            return self.page_size * self._flowkv_storage_size
+
+    return OwnerIndexDraftDSATokenToKVPool
diff --git a/python/sglang/srt/ulacache/tensor_parallel_prefill.py b/python/sglang/srt/ulacache/tensor_parallel_prefill.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d6daf52c9169a919be7c85b824d09a08d720a59
--- /dev/null
+++ b/python/sglang/srt/ulacache/tensor_parallel_prefill.py
@@ -0,0 +1,246 @@
+"""Read-only owner-striped TP callbacks for the common two-window pipeline.
+
+CPU virtual addresses are dereferenced only by their owning process. Each
+rank writes its own history rows into the same compact positions; uint8 SUM
+on the existing TP device group assembles them without a third payload bank.
+"""
+from dataclasses import dataclass
+
+from ulacache.transfer.prefill_pipeline import LayerPrefillPipeline, PrefillSequenceBudget
+from ulacache.cache.prefill.reader import prepare_read_plan
+
+
+@dataclass(frozen=True)
+class TensorParallelPrefillPlan:
+    native: object
+    global_record_ids: object
+
+    @property
+    def record_count(self):
+        return self.native.record_count
+
+    @property
+    def keepalive_tensors(self):
+        return self.native.keepalive_tensors + (self.global_record_ids,)
+
+    def map_native_rows(self, rows):
+        return self.native.map_native_rows(rows)
+
+
+def join_history_collective(view, group, *, distributed=None):
+    """Make the caller's current stream wait for NCCL before ready is recorded.
+
+    Work.wait without a timeout adds the NCCL completion dependency to the
+    current CUDA stream. Merely returning an asynchronous handle is unsafe.
+    No process group, private communicator or cross-rank protocol is created.
+    """
+    if distributed is None:
+        import torch.distributed as distributed
+    work = distributed.all_reduce(view, op=distributed.ReduceOp.SUM,
+                                  group=group, async_op=True)
+    if work is None or not callable(getattr(work, 'wait', None)):
+        raise RuntimeError('Native TP history collective did not return a completion handle')
+    work.wait()
+
+
+def active_window_bytes(record_count, native_page):
+    if type(record_count) is not int or record_count < 0:
+        raise ValueError('Full-history record count must be nonnegative')
+    return ((record_count + native_page.page_size - 1) // native_page.page_size
+            * native_page.bytes_per_page)
+
+
+def full_history_lookup_upper_bytes(layout):
+    # Match MR77's full-history metadata bound. There is no selected-TopK
+    # eight-rank union and no need to price8M lookup rows for a1M window.
+    return 96 * layout.prefill_window_rows + 16 * layout.max_staging_tokens
+
+
+class TensorParallelPrefill:
+    def __init__(self, pool):
+        import torch
+        import torch.distributed as dist
+        host = pool.flowkv_host
+        if (host is None or pool._flowkv_storage_size != 8 or pool._flowkv_namespaces != 1
+                or pool.flowkv_layout.row_bytes != 656
+                or pool.flowkv_layout.prefill_window_rows != 1048576):
+            raise ValueError('Shared TP prefill requires the FP8 owner tier and two1M windows')
+        self.pool, self.host = pool, host
+        self.group = pool.udcache_services.group.device_group
+        if (dist.get_world_size(self.group) != 8 or dist.get_rank(self.group) != pool.flowkv_rank
+                or 'nccl' not in str(dist.get_backend(self.group)).lower()):
+            raise ValueError('Use the existing eight-rank native TP NCCL device group')
+        self.native_page = pool.flowkv_layout.native_page
+        first = pool.flowkv_arena.prefill
+        if first.nbytes != 1048576 * 656:
+            raise ValueError('Reuse the already-budgeted native1M prefill allocation')
+        # The first allocation is reused. Only one additional1M bank is added.
+        from sglang.srt.constants import GPU_MEMORY_TYPE_KV_CACHE
+        with pool.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+            second = torch.empty_like(first)
+        self.pipeline = LayerPrefillPipeline((first, second),
+            gather_history=self.gather_history, install_current=self.install_current)
+        self.plan = None
+        self.last_layer = -1
+        self.written_layer = None
+        # Native allocation auditors see the real storages without depending
+        # on traversal through an external adapter object.
+        pool._tp_prefill_windows = self.pipeline.windows
+
+    def create_budget(self):
+        return PrefillSequenceBudget(1048576)
+
+    def begin(self, batch, *, native_history=None):
+        from sglang.srt.ulacache.native_prefill_history import build_full_prefill_history
+        from sglang.srt.model_executor.forward_context import get_attn_backend
+        # Existing follower-copy dependency; never synchronize CPU or mutate
+        # the canonical directory/LRU merely to reconstruct prefill history.
+        self.pool.flowkv_shared_index.join_idle_prefetch()
+        metadata = get_attn_backend().forward_metadata
+        rows = build_full_prefill_history(batch, native_history=native_history,
+            flattened=getattr(metadata, 'page_table_1_flattened', None))
+        native = prepare_read_plan(rows, batch.out_cache_loc)
+        self.plan = TensorParallelPrefillPlan(native,
+            self.host._global_ids(native.record_ids))
+        self.pipeline.begin(self.plan, layer_count=self.pool.layer_num,
+            record_count=self.plan.record_count, keepalive_tensors=self.plan.keepalive_tensors)
+        self.pool._tp_prefill_plan_tensors = self.plan.keepalive_tensors
+        self.last_layer, self.written_layer = -1, None
+
+    def _retire_previous(self, layer):
+        if layer in self.pipeline.attended:
+            return
+        if layer in self.pipeline.installed:
+            self.pipeline.after_attention(layer)
+        else:
+            self.pipeline.skip_unused(layer)
+
+    def prepare(self, layer):
+        if layer:
+            # A native first-chunk MHA layer may consume projected KV directly.
+            # Reaching the next layer proves its actual native consumer retired.
+            self._retire_previous(layer - 1)
+        window = self.pipeline.prepare(layer)
+        self.pool.flowkv_arena.prefill = window
+        self.last_layer = layer
+
+    def mark_current(self, layer):
+        self.written_layer = layer
+
+    def read(self, layer):
+        return self.pipeline.read(layer)
+
+    def after_attention(self, layer):
+        if layer in self.pipeline.installed and layer not in self.pipeline.attended:
+            self.pipeline.after_attention(layer)
+
+    def gather_history(self, layer, plan, window):
+        from ulacache.cache.kernels.tensor_parallel_prefill import gather_owner_history
+        group = self.host.groups.group(layer)
+        count_bytes = active_window_bytes(plan.record_count, self.native_page)
+        view = window.view(-1)[:count_bytes]
+        view.zero_()  # non-owner, fresh and native-page padding contribute zero.
+        gather_owner_history(plan.native.record_ids, plan.global_record_ids,
+            plan.native.fresh_positions, self.host.directory[group],
+            self.pool.flowkv_shards[layer], self.host.host.ptrs, window,
+            rank=self.pool.flowkv_rank, logical_slots=self.host.logical_slots,
+            host_slots=self.host.host_slots, layer=layer, native_page=self.native_page)
+        # Called inside LayerPrefillPipeline's prefetch stream. Ready is not
+        # recorded until this work.wait enqueues its completion dependency.
+        join_history_collective(view, self.group)
+
+    def install_current(self, layer, plan, window):
+        from ulacache.cache.kernels.tensor_parallel_prefill import install_staged_current
+        if self.written_layer != layer or self.pool._flowkv_current_rows is None:
+            raise RuntimeError('Native TP writer must precede its current-row install')
+        install_staged_current(plan.native.record_ids, plan.native.fresh_positions,
+            self.pool._flowkv_current_rows, self.pool.flowkv_arena.staging, window,
+            native_page=self.native_page)
+
+    def finish(self):
+        if self.plan is None:
+            return
+        if self.last_layer != self.pool.layer_num - 1:
+            self.pipeline.abort()
+        else:
+            self._retire_previous(self.last_layer)
+            self.pipeline.finish()
+        self.plan = None
+        self.pool._tp_prefill_plan_tensors = ()
+        self.pool.flowkv_arena.prefill = self.pipeline.windows[0]
+        self.last_layer, self.written_layer = -1, None
+
+    def abort(self):
+        self.pipeline.abort()
+        self.plan = None
+        self.pool._tp_prefill_plan_tensors = ()
+        self.pool.flowkv_arena.prefill = self.pipeline.windows[0]
+        self.last_layer, self.written_layer = -1, None
+
+    def memory_inventory(self):
+        value = self.pipeline.memory_inventory()
+        value.update(first_window_reuses_original_arena_prefill=True,
+            additional_encoded_payload_bytes=self.pipeline.windows[1].nbytes,
+            additional_process_groups=0, reuses_native_TP_device_group=True,
+            full_history_identity_plan_upper_bytes=5 * 4 * 1048576,
+            current_staging_bytes=self.pool.flowkv_arena.staging.nbytes,
+            full_history_lookup_workspace_upper_bytes=full_history_lookup_upper_bytes(self.pool.flowkv_layout),
+            native_mha_latent_BF16_upper_bytes=1048576 * 576 * 2,
+            native_mha_nope_contiguous_upper_bytes=1048576 * 512 * 2,
+            native_sparse_output_argument_may_need_additional_latent_BF16=True,
+            CPU_pointer_owner_only=True, mutates_history_residency=False,
+            collective='existing_TP_NCCL_uint8_SUM_then_work.wait_on_prefetch_stream')
+        return value
+
+
+def bind_startup(native_pool_class):
+    """One normal-startup budget/admission/native-reader binding, without PD."""
+    from sglang.srt.ulacache.shared_prefill_admission import install as install_prefill_admission
+    install_prefill_admission()
+    from sglang.srt.model_executor.flowkv_pool_configurator import FlowKVPlainPoolConfigurator
+    if not getattr(FlowKVPlainPoolConfigurator, '_ulacache_shared_tp_prefill_budget', False):
+        original_fixed = FlowKVPlainPoolConfigurator._fixed_bytes
+        def fixed(configurator, page_size):
+            value = original_fixed(configurator, page_size)
+            layout = configurator.record_template
+            applies = (layout.row_bytes == 656 and layout.disaggregation_mode == 'null'
+                       and configurator.cpu_enabled and not configurator.request_policy
+                       and layout.prefill_window_rows == 1048576)
+            if applies:
+                if getattr(layout, 'prefill_layers', 1) == 2:
+                    # The native configurator already prices both banks and
+                    # the full-history metadata for PipelineTPLayout.
+                    return value
+                if layout.prefill_window_rows != 1048576:
+                    raise ValueError('NonPD owner TP prefill requires the shared1M record bound')
+                # The original sizer already charges one native window, current
+                # staging and selected-union lookup. Add exactly one bank and
+                # replace that obsolete lookup bound with full-history metadata.
+                value += (layout.prefill_buffer_bytes
+                          + full_history_lookup_upper_bytes(layout)
+                          - layout.prefill_lookup_bytes)
+            return value
+        FlowKVPlainPoolConfigurator._fixed_bytes = fixed
+        FlowKVPlainPoolConfigurator._ulacache_shared_tp_prefill_budget = True
+
+    from sglang.srt.models.deepseek_common.attention_forward_methods import forward_mha
+    original = forward_mha.DeepseekMHAForwardMixin._get_mla_kv_buffer_from_fp8_for_dsa
+    def mha_prefix(attention, batch):
+        pool = forward_mha.get_token_to_kv_pool()
+        backend = getattr(pool, '_tp_full_prefill', None)
+        if not isinstance(pool, native_pool_class) or backend is None or backend.plan is None:
+            return original(attention, batch)
+        metadata = forward_mha.resolve_attn_backend(batch).forward_metadata
+        rows = metadata.page_table_1_flattened
+        if rows is None:
+            raise ValueError('Native MHA prefix must retain its original complete row table')
+        local = attention.attn_mha.layer_id - pool.start_layer
+        window = backend.read(local)
+        mapped = backend.plan.map_native_rows(rows).reshape(-1)
+        latent = forward_mha.dequantize_k_cache_paged(
+            window.view(pool.dtype).view(-1, 1, pool.kv_cache_dim), mapped)
+        # The native projection/attention remain unchanged. Retire raw bytes at
+        # the next native layer boundary, after all actual consumers returned.
+        return (latent[:, :, :attention.kv_lora_rank].squeeze(1).contiguous(),
+                latent[:, :, attention.kv_lora_rank:])
+    forward_mha.DeepseekMHAForwardMixin._get_mla_kv_buffer_from_fp8_for_dsa = mha_prefix
diff --git a/python/sglang/srt/ulacache/tp_sparse_trace_adapter.py b/python/sglang/srt/ulacache/tp_sparse_trace_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..97c69af8aadbd615800af60ff7eea68466d78b82
--- /dev/null
+++ b/python/sglang/srt/ulacache/tp_sparse_trace_adapter.py
@@ -0,0 +1,272 @@
+"""Diagnostic native TP global-selection and local-miss capture.
+
+Install before pool construction. Buffers stay in an external weak map so
+production allocation inventories remain unchanged; diagnostic bytes are
+reported explicitly. This mode must never produce formal decode measurements.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import weakref
+
+_observers = weakref.WeakKeyDictionary()
+_by_arena = weakref.WeakKeyDictionary()
+
+
+def install():
+    import torch
+    from sglang.srt.managers.scheduler import Scheduler
+    from sglang.srt.model_executor.model_runner import ModelRunner
+    from ulacache.cache.host import FlowKVHostTier
+    from ulacache.cache.prefetch import SharedIndexLifecycle
+    from ulacache.transfer.ipc import FlowKVStepPublication
+    from ulacache.telemetry.tp_sparse_trace import GpuTpMissTrace
+    from ulacache.telemetry.sparse_trace import GpuSparseTraceRecorder, SparseTraceGeometry
+
+    root = Path(os.environ['UDCACHE_SPARSE_TRACE_DIR'])
+    max_queries = int(os.environ['UDCACHE_SPARSE_TRACE_QUERY_ROWS'])
+    max_requests = int(os.environ['UDCACHE_SPARSE_TRACE_REQUESTS'])
+    frames = int(os.environ.get('UDCACHE_SPARSE_TRACE_FRAMES', '512'))
+    warmup = int(os.environ.get('UDCACHE_SPARSE_TRACE_WARMUP', '128'))
+    state = dict(armed=False, forwards=0, finished=False, chunks=[], metadata=[], recorder=None, cohort=0)
+
+    def rank_root():
