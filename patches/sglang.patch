index 0000000000000000000000000000000000000000..97e981c037d76bf9e46aa266343d5085404c0f63
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_tp_cache.py
@@ -0,0 +1,215 @@
+"""Native TP pool and logical allocator bound to UlaCache's public cache API.
+
+The pool owns its cache handle; the framework owns request IDs and quantization.
+All overrides are ordinary methods, selected by the native pool factory.
+"""
+
+from __future__ import annotations
+
+from ulacache import SparseAttentionAccessPlan as _PublicAccessPlan
+from ulacache.cache.tensor_parallel import adopt_native_pool, canonical_selection
+from ulacache.speculative import is_cache_step
+from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+from sglang.srt.mem_cache.flowkv_plain_pool import FlowKVPlainTokenToKVPool
+from sglang.srt.mem_cache.flowkv_record_storage import global_ids
+from sglang.srt.mem_cache.memory_pool import unwrap_write_loc
+
+
+class PublicBackingAuthority:
+    """Keep native ID/page management while registering backing exactly once."""
+
+    def __init__(self, cache, native_tier):
+        self.cache, self.native_tier = cache, native_tier
+
+    def allocate(self, ids):
+        self.cache.register_logical_records(ids)
+
+    def release(self, ids):
+        self.cache.free(ids)
+
+    def clear(self):
+        self.cache.clear_registered_records()
+
+    def __getattr__(self, name):
+        return getattr(self.native_tier, name)
+
+
+class _NativeTPPageAllocator(PagedTokenToKVPoolAllocator):
+    """CPU-off pages still clear the shared cache's residency bookkeeping."""
+
+    def clear(self):
+        pool = getattr(self, "_kvcache", None)
+        if pool is not None:
+            pool.ulacache.clear_registered_records()
+        super().clear()
+
+
+class NativeTensorParallelCache(FlowKVPlainTokenToKVPool):
+    """Native encoded writes and attention callbacks over one UlaCache handle."""
+
+    _ulacache_native_tp_cache = True
+    _tp_full_prefill = None
+
+    def _create_buffers(self):
+        super()._create_buffers()
+        from sglang.srt.ulacache.v0522_owner_tp import configuration
+
+        adopt_native_pool(self, native_kv_format=configuration().native_kv_format)
+        self._tp_full_prefill = None
+        if (self.flowkv_host is not None
+                and self.flowkv_layout.prefill_window_rows == 1048576):
+            from sglang.srt.ulacache.tensor_parallel_prefill import TensorParallelPrefill
+            self._tp_full_prefill = TensorParallelPrefill(self)
+
+    @property
+    def supports_mha_one_shot(self):
+        return (getattr(self, "_tp_full_prefill", None) is not None
+                or super().supports_mha_one_shot)
+
+    def flowkv_prepare_extend(self, history):
+        if self._tp_full_prefill is None:
+            return super().flowkv_prepare_extend(history)
+        self._tp_native_prefill_history = history
+        self._flowkv_mode = "prefill"
+
+    def create_prefill_workspace_budget(self):
+        backend = self._tp_full_prefill
+        return backend.create_budget() if backend is not None else None
+
+    def get_prefill_workspace_memory_inventory(self):
+        backend = self._tp_full_prefill
+        return backend.memory_inventory() if backend is not None else None
+
+    def get_key_buffer(self, layer_id):
+        backend = self._tp_full_prefill
+        if backend is not None and backend.plan is not None:
+            return backend.read(layer_id - self.start_layer).view(self.dtype).reshape(
+                -1, 1, self.kv_cache_dim)
+        return super().get_key_buffer(layer_id)
+
+    def read_mha_prefill_records(self, layer_id, rows):
+        backend = self._tp_full_prefill
+        if backend is None or backend.plan is None:
+            return None
+        from sglang.kernels.ops.attention.dsa.dequant_k_cache import dequantize_k_cache_paged
+        window = backend.read(layer_id - self.start_layer)
+        mapped = backend.plan.map_native_rows(rows).reshape(-1)
+        return dequantize_k_cache_paged(
+            window.view(self.dtype).reshape(-1, 1, self.kv_cache_dim), mapped)
+
+    def finish_flowkv_forward(self):
+        if self._tp_full_prefill is not None:
+            self._tp_full_prefill.finish()
+            self._tp_native_prefill_history = None
+        return super().finish_flowkv_forward()
+
+    def get_kv_size_bytes(self):
+        value = super().get_kv_size_bytes()
+        backend = getattr(self, "_tp_full_prefill", None)
+        return value + (backend.pipeline.windows[1].nbytes if backend is not None else 0)
+
+    def _clear_buffers(self):
+        if self._tp_full_prefill is not None:
+            self._tp_full_prefill.pipeline.close()
+        self.ulacache.close()
+        super()._clear_buffers()
+
+    def create_logical_allocator(self, size, *, need_sort):
+        if self.flowkv_host is not None:
+            from sglang.srt.mem_cache.allocator.flowkv_host import (
+                FlowKVHostTokenToKVPoolAllocator,
+            )
+
+            return FlowKVHostTokenToKVPoolAllocator(
+                size,
+                self.allocation_page_size,
+                self.dtype,
+                self.device,
+                self,
+                need_sort,
+                host_tier=PublicBackingAuthority(self.ulacache, self.flowkv_host),
+            )
+        return _NativeTPPageAllocator(
+            size, self.allocation_page_size, self.dtype, self.device, self, need_sort
+        )
+
+    def flowkv_before_layer_prepare(self, layer_id, batch):
+        layer = layer_id - self.start_layer
+        if not is_cache_step(batch.forward_mode):
+            self._flowkv_mode = "prefill"
+            if layer == 0:
+                self.flowkv_arena.invalidate(global_ids(self, batch.out_cache_loc))
+                if self._tp_full_prefill is not None:
+                    self._tp_full_prefill.begin(batch,
+                        native_history=self._tp_native_prefill_history)
+            if self._tp_full_prefill is not None:
+                self._tp_full_prefill.prepare(layer)
+            return
+        if batch.out_cache_loc.numel() == 0:
+            return
+        if layer == 0:
+            self._flowkv_mode = "decode"
+            self._flowkv_current_native = batch.out_cache_loc
+            current = self._flowkv_global_current[: batch.out_cache_loc.numel()]
+            self.flowkv_arena.kernel().globalize_current(
+                batch.out_cache_loc, current, self._flowkv_owner_start
+            )
+            self.flowkv_step_publication.begin(current, self.flowkv_arena.valid)
+            self.ulacache.begin_model_forward()
+        if self.flowkv_prefetch:
+            self.ulacache.prepare_layer_execution(layer)
+
+    def flowkv_on_index_ready(self, layer_id, indices, batch):
+        if is_cache_step(batch.forward_mode):
+            self.ulacache.prepare_sparse_attention(
+                layer_id - self.start_layer,
+                _PublicAccessPlan(
+                    canonical_selection(indices, self.flowkv_layout.topk),
+                    self._flowkv_current_native,
+                ),
+            )
+
+    def flowkv_prepare_packed_attention(
+        self, *, layer_id, sparse_indices, packed_out_loc, decode_like
+    ):
+        layer = layer_id - self.start_layer
+        if not decode_like:
+            self._flowkv_mode = "prefill"
+            return sparse_indices
+        _public_view = self.ulacache.access(
+            canonical_selection(sparse_indices, self.flowkv_layout.topk), layer
+        )
+        self._flowkv_decode_layer = layer
+        self._flowkv_mode = "decode"
+        return _public_view.slot_ids
+
+    def flowkv_after_attention(self, layer_id):
+        if self._tp_full_prefill is not None and self._tp_full_prefill.plan is not None:
+            self._tp_full_prefill.after_attention(layer_id - self.start_layer)
+            return
+        if self._flowkv_mode == "decode":
+            layer = layer_id - self.start_layer
+            self.ulacache.finish_layer_attention(layer)
+
+    def set_mla_kv_buffer(
+        self, layer, loc_info, cache_k_nope, cache_k_rope, layer_id_override=None
+    ):
+        (loc, _, _) = unwrap_write_loc(loc_info)
+        self._check_physical_write_loc(loc_info, "set_mla_kv_buffer (record)")
+        layer_id = layer.layer_id if layer_id_override is None else layer_id_override
+        local = layer_id - self.start_layer
+        if self.dsa_kv_cache_store_fp8:
+            from sglang.kernels.ops.attention.dsa.quant_k_cache import (
+                quantize_k_cache_separate,
+            )
+
+            (cache_k_nope, cache_k_rope) = quantize_k_cache_separate(
+                cache_k_nope, cache_k_rope
+            )
+        elif cache_k_nope.dtype != self.dtype:
+            cache_k_nope = cache_k_nope.to(self.dtype)
+            if cache_k_rope.numel() > 0:
+                cache_k_rope = cache_k_rope.to(self.dtype)
+        self.ulacache.write(loc, local, (cache_k_nope, cache_k_rope))
+        if self._tp_full_prefill is not None and self._tp_full_prefill.plan is not None:
+            self._tp_full_prefill.mark_current(local)
