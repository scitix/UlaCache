+"""Native DPA prefill hook supplying target/draft records to library snapshot IO."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+def install(config):
+    import torch
+    from sglang.srt.speculative.eagle_worker_v2 import EAGLEWorkerV2
+    from sglang.srt.runtime_context import get_parallel
+    from ulacache.tools.snapshot.format import SnapshotRequest
+    from ulacache.tools.snapshot.prefix import NativeByteBanks, save_native_prefix
+    from ulacache.tools.snapshot.speculative import save_continuation
+    original = EAGLEWorkerV2.forward_batch_generation
+    saved = set()
+
+    def banks(pool):
+        start = pool.start_layer
+        mla = [pool.get_key_buffer(start + layer) for layer in range(pool.layer_num)]
+        index = {layer: tensor for layer, tensor in enumerate(pool.index_key_cache.buffer) if tensor.numel()}
+        row_bytes = mla[0].view(torch.uint8)[0].numel()
+        return NativeByteBanks(mla, index, row_bytes)
+
+    def forward(worker, batch, *args, **kwargs):
+        prefill = batch.forward_mode.is_extend() and not torch.cuda.is_current_stream_capturing()
+        result = original(worker, batch, *args, **kwargs)
+        if (not prefill or result.next_draft_input is None
+                or get_parallel().attn_tp_rank != 0):
+            return result
+        target_runner = worker.target_worker.model_runner
+        draft_runner = worker.draft_worker.draft_runner
+        for i, req in enumerate(batch.reqs):
+            params = req.sampling_params.custom_params or {}
+            key = params.get("udcache_snapshot_key")
+            if (key is None or key in saved or req.inflight_middle_chunks > 0
+                    or int(batch.seq_lens_cpu[i]) != len(req.origin_input_ids)):
+                continue
+            torch.cuda.synchronize()
+            seed = int(result.next_draft_input.bonus_tokens[i].item())
+            request = SnapshotRequest(key, tuple(req.origin_input_ids), (seed,))
+            root = Path(config["path"]) / hashlib.sha256(key.encode()).hexdigest()
+            root.mkdir(parents=True, exist_ok=False)
+            rows = target_runner.req_to_token_pool.req_to_token[req.kv.req_pool_idx, :request.next_position].clone()
+            target_receipt = save_native_prefix(root / "target", request, banks(target_runner.token_to_kv_pool),
+                rows, config["model_fingerprint"], quiesce=torch.cuda.synchronize)
+            draft_receipt = save_native_prefix(root / "draft", request, banks(draft_runner.token_to_kv_pool),
+                rows, config["model_fingerprint"], quiesce=torch.cuda.synchronize)
+            state_sha = save_continuation(root / "continuation.pt", result.next_draft_input, i, rows)
+            meta = dict(complete=True, key=key, input_tokens=len(request.input_ids), first_output_token=seed,
+                input_ids_sha256=hashlib.sha256(json.dumps(list(request.input_ids), separators=(",", ":")).encode()).hexdigest(),
+                history_rows=request.next_position, continuation_sha256=state_sha,
+                target=target_receipt, draft=draft_receipt, source_rank=torch.distributed.get_rank(),
+                model_fingerprint=config["model_fingerprint"], source_manifest_sha256=config["source_manifest_sha256"],
+                boundary="After complete native target and draft prefill; before first speculative verify")
+            tmp = root / "SNAPSHOT.tmp"
+            tmp.write_text(json.dumps(meta, indent=2) + "\n")
+            tmp.replace(root / "SNAPSHOT.json")
+            saved.add(key)
+            print(json.dumps(dict(event="canonical_mtp_prefix_saved", key=key, tokens=request.next_position,
+                                  rank=torch.distributed.get_rank(), count=len(saved))), flush=True)
+        return result
+
+    EAGLEWorkerV2.forward_batch_generation = forward
+
+
+def install_native(config):
+    """Capture the ordinary target result before its original native release."""
+    import torch
+    from sglang.srt.managers.scheduler_components.batch_result_processor import SchedulerBatchResultProcessor
+    from sglang.srt.runtime_context import get_parallel
+    from ulacache.tools.snapshot.format import SnapshotRequest
+    from ulacache.tools.snapshot.prefix import NativeByteBanks, save_native_prefix
+    original = SchedulerBatchResultProcessor.process_batch_result_prefill
+    saved = set()
+
+    def prefill(processor, batch, result):
+        if get_parallel().attn_tp_rank != 0:
+            return original(processor, batch, result)
+        for i, req in enumerate(batch.reqs):
+            params = req.sampling_params.custom_params or {}
+            key = params.get("udcache_snapshot_key")
+            if (key is None or key in saved or req.inflight_middle_chunks > 0 or req.finished()
+                    or int(batch.seq_lens_cpu[i]) != len(req.origin_input_ids)):
+                continue
+            if result.copy_done is not None:
+                result.copy_done.synchronize()
+            seed = int(result.next_token_ids[i].item())
+            request = SnapshotRequest(key, tuple(req.origin_input_ids), (seed,))
+            pool = processor.token_to_kv_pool_allocator.get_kvcache()
+            mla = [pool.get_key_buffer(pool.start_layer + layer) for layer in range(pool.layer_num)]
+            index = {layer: tensor for layer, tensor in enumerate(pool.index_key_cache.buffer) if tensor.numel()}
+            row_bytes = mla[0].view(torch.uint8)[0].numel()
+            banks = NativeByteBanks(mla, index, row_bytes)
+            rows = processor.req_to_token_pool.req_to_token[req.kv.req_pool_idx, :request.next_position].clone()
+            root = Path(config["path"]) / hashlib.sha256(key.encode()).hexdigest()
+            root.mkdir(parents=True, exist_ok=False)
+            commit = save_native_prefix(root / "target", request, banks, rows,
+                                       config["model_fingerprint"], quiesce=torch.cuda.synchronize)
+            meta = dict(complete=True, key=key, input_tokens=len(request.input_ids), first_output_token=seed,
+                input_ids_sha256=hashlib.sha256(json.dumps(list(request.input_ids), separators=(",", ":")).encode()).hexdigest(),
+                history_rows=request.next_position, target=commit, draft=None,
+                model_fingerprint=config["model_fingerprint"], source_manifest_sha256=config["source_manifest_sha256"],
+                source_rank=torch.distributed.get_rank(), boundary="Original native final prefill result, before KV release")
+            tmp = root / "SNAPSHOT.tmp"
+            tmp.write_text(json.dumps(meta, indent=2) + "\n")
+            tmp.replace(root / "SNAPSHOT.json")
+            saved.add(key)
+            print(json.dumps(dict(event="canonical_prefix_saved", key=key, tokens=request.next_position,
+                                  rank=torch.distributed.get_rank(), count=len(saved))), flush=True)
+        return original(processor, batch, result)
+
+    SchedulerBatchResultProcessor.process_batch_result_prefill = prefill
