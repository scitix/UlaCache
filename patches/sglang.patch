@@ -0,0 +1,33 @@
+"""Explicit online-only entry; no snapshot or precomputed prefix restore."""
+import json
+import os
+import runpy
+
+from contextlib import contextmanager
+from sglang.srt.model_executor.model_runner import ModelRunner
+from sglang.srt.runtime_context import get_model
+_original_load_scope=ModelRunner._load_format_scope
+@contextmanager
+def _role_reader_scope(runner,load_format):
+    with _original_load_scope(runner,load_format):
+        with get_model().override(weight_loader_disable_mmap=not runner.is_draft_worker):
+            yield
+ModelRunner._load_format_scope=_role_reader_scope
+
+if os.environ.get('UDCACHE_MATRIX_SYNC_WEIGHT_LOAD')=='1':
+    from sglang.srt.models.deepseek_common import deepseek_weight_loader
+    deepseek_weight_loader.should_async_load=lambda weight:False
+kind=os.environ['UDCACHE_MATRIX_CACHE_KIND']
+if kind=='dpa_udcache':
+    from sglang.srt.ulacache.unified_local_adapter import install
+    install()
+elif kind=='hisparse':
+    from sglang.srt.ulacache.hisparse_prefill_relay_adapter import install as install_prefill_relay
+    install_prefill_relay()
+    if os.environ.get('UDCACHE_HISPARSE_STREAMING_SESSIONS')=='1':
+        from hisparse_streaming_session_adapter import install as install_streaming
+        install_streaming()
+else:raise ValueError('Explicit DPA UDCache or HiSparse mode required')
+from sglang.srt.ulacache.matrix_startup_audit import install
+install()
+if __name__=='__main__':runpy.run_module('sglang.launch_server',run_name='__main__')
diff --git a/python/sglang/srt/ulacache/cache_schedule_profile_adapter.py b/python/sglang/srt/ulacache/cache_schedule_profile_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..40bc0840809e613bbd6d31e696aa46a442c7fff7
--- /dev/null
+++ b/python/sglang/srt/ulacache/cache_schedule_profile_adapter.py
@@ -0,0 +1,284 @@
+"""Bounded native DPA model profiles and passive prepromotion hit counters.
+
+This diagnostic never supplies model throughput measurements. Install before
+native pool/Graph construction, after the selected cache adapter is installed.
+All observer storage stays outside production cache ownership inventories.
+"""
+import json
+import os
+from pathlib import Path
+import weakref
+
+_observers=weakref.WeakKeyDictionary()
+
+
+def install():
+    import torch
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.srt.model_executor.model_runner import ModelRunner
+    from sglang.srt.model_executor.model_runner_components import cuda_graph_setup
+    from sglang.srt.managers.scheduler import Scheduler
+    from sglang.srt.distributed import get_tp_group
+    from ulacache.compiler import configure_compiler
+    from ulacache.telemetry.replay_metrics import ReplayMetrics
+    from ulacache.telemetry.hisparse_metrics import HiSparseMetrics
+    from ulacache.telemetry.sparse_trace import GpuSparseTraceRecorder, SparseTraceGeometry
+    from ulacache.telemetry.trace_coverage import validate_bucket_rotation
+
+    root=Path(os.environ['UDCACHE_SCHEDULE_PROFILE_DIR'])
+    width=int(os.environ.get('UDCACHE_SCHEDULE_PROFILE_WIDTH','3'))
+    warmup=int(os.environ.get('UDCACHE_SCHEDULE_PROFILE_WARMUP','128'))
+    frames=int(os.environ.get('UDCACHE_SCHEDULE_PROFILE_FRAMES','512'))
+    state=dict(armed=False,forwards=0,finished=False,cohort=0)
+
+    def profile_boundary(start):
+        # Match the existing native diagnostic's CPU-group protocol. A rank
+        # must not launch the next GPU collective while another rank is still
+        # flushing CUPTI in cudaProfilerStop.
+        group=get_tp_group().cpu_group
+        torch.cuda.synchronize()
+        torch.distributed.barrier(group=group)
+        (torch.cuda.cudart().cudaProfilerStart if start else
+         torch.cuda.cudart().cudaProfilerStop)()
+        torch.distributed.barrier(group=group)
+
+    def save(name,value):
+        directory=root/f'cohort{state["cohort"]:04d}'/f'rank{torch.distributed.get_rank()}'
+        directory.mkdir(parents=True,exist_ok=True)
+        path=directory/name;temp=path.with_suffix('.tmp')
+        temp.write_text(json.dumps(value,indent=2)+'\n');temp.replace(path)
+
+    original_capture=cuda_graph_setup.capture_decode_graph
+
+    def capture(*,model_runner):
+        runner=model_runner
+        if not runner.is_draft_worker and runner not in _observers:
+            configure_compiler(load_jit)
+            cache=getattr(runner.token_to_kv_pool,'udcache_local',None)
+            hs=getattr(runner,'hisparse_coordinator',None)
+            if cache is not None:
+                metrics=ReplayMetrics(cache.groups.group_count,cache.max_queries,cache.topk,device=runner.device)
+                masked=torch.empty((cache.max_queries,cache.topk),dtype=torch.int32,device=runner.device)
+                query_rows=torch.arange(cache.max_queries,device=runner.device,dtype=torch.int32)[:,None]
+                observer=dict(kind='ulacache',cache=cache,metrics=metrics,masked=masked,
+                              query_rows=query_rows,requests=None,request_copies=[])
+                observer['native_shapes']=torch.zeros((cache.groups.group_count,3),
+                    dtype=torch.int32,device=runner.device)
+                if any(r.recent_count<1 for r in cache.rings):
+                    raise ValueError('Native PB model profile requires nonempty recent buckets')
+                observer['expiry']=GpuSparseTraceRecorder(SparseTraceGeometry(
+                    groups=cache.groups.group_count,query_rows=1,topk=1,frames=frames,
+                    chunk_frames=frames,event_capacity=1),device=runner.device)
+                observer['sample_active']=torch.zeros(1,dtype=torch.int32,device=runner.device)
+                observer['descriptors']=torch.tensor([[s.epoch.data_ptr(),r.bucket_epochs.data_ptr(),
+                    r.summary.data_ptr(),r.summary.shape[1],r.recent_count]
+                    for s,r in zip(cache.states,cache.rings)],dtype=torch.int64,device=runner.device)
+                _observers[cache]=observer
+                pool_class=type(runner.token_to_kv_pool)
+                old_prepare=pool_class.flowkv_prepare_batch
+
+                def prepare(pool,batch):
+                    obs=_observers.get(pool.udcache_local)
+                    if obs is not None:
+                        obs['requests']=batch.req_pool_indices.to(torch.int32)
+                        obs['request_copies'].append(obs['requests'])
+                    return old_prepare(pool,batch)
+
+                pool_class.flowkv_prepare_batch=prepare
+            elif hs is not None and hs.spec_swap.enabled:
+                if not hs.enable_prefetch:
+                    raise ValueError('This baseline profile requires original shared-Index prefetch')
+                groups=[i for i,shared in enumerate(hs._is_shared_index_layer) if not shared]
+                metrics=HiSparseMetrics(len(groups),hs.req_device_buffer_tokens.shape[1],width,hs.top_k,
+                    native_csrc=os.environ['UDCACHE_HISPARSE_NATIVE_CSRC'],device=runner.device)
+                observer=dict(kind='hisparse',cache=hs,metrics=metrics,
+                              group_ids={anchor:i for i,anchor in enumerate(groups)})
+                _observers[hs]=observer
+                _observers[hs.spec_swap]=observer
+            else:
+                raise ValueError('Bind an explicit native DPA UlaCache or speculative HiSparse pool')
+            _observers[runner]=observer
+            save('BOOTSTRAP.json',dict(kind=observer['kind'],pid=os.getpid(),
+                width=width,warmup=warmup,frames=frames,
+                scope='Diagnostic counters and profiler only; production ownership inventory excludes observer storage.'))
+        return original_capture(model_runner=runner)
+
+    cuda_graph_setup.capture_decode_graph=capture
+
+    from ulacache.cache.local_cache import UnifiedLocalResidency
+    old_plan=UnifiedLocalResidency.plan
+    old_begin=UnifiedLocalResidency.begin_forward
+    old_write=UnifiedLocalResidency.write
+
+    def begin(cache):
+        observer=_observers.get(cache)
+        if observer is None:return old_begin(cache)
+        observer['expiry'].observe_expiry(observer['descriptors'],after=False)
+        result=old_begin(cache)
+        observer['expiry'].observe_expiry(observer['descriptors'],after=True)
+        return result
+
+    def write(cache,layer,rows,nope,rope):
+        observer=_observers.get(cache)
+        if observer is not None:
+            group=cache.groups.group(layer)
+            # Count at the actual native writer, before it consumes residency.
+            observer['metrics'].module.current(rows.to(torch.int32),cache.states[group].directory,
+                observer['metrics'].counts[group],1,cache.row_bytes)
+        return old_write(cache,layer,rows,nope,rope)
+
+    def plan(cache,layer,selected,current):
+        observer=_observers.get(cache)
+        if observer is None:
+            return old_plan(cache,layer,selected,current)
+        group=cache.groups.group(layer)
+        metrics=observer['metrics']
+        observer['expiry'].observe(group,selected[:1,:1],current[:1],
+            observer['sample_active'],cache.states[group].epoch)
+        # Graph padding can retain old IDs. The probe sees only active native
+        # query rows; the original planner still receives its original tensor.
+        masked=observer['masked'][:selected.shape[0]]
+        masked.copy_(selected)
+        masked.masked_fill_(observer['query_rows'][:selected.shape[0]]>=cache.active,0)
+        request_rows=observer['requests'].numel()
+        if not request_rows or selected.shape[0]%request_rows:
+            raise ValueError('Native Graph query rows need an explicit ragged request binding')
+        native_width=selected.shape[0]//request_rows
+        if native_width not in (1,width):
+            raise ValueError('Unexpected native warmup/target query width')
+        observer['native_shapes'][group,0].fill_(selected.shape[0])
+        observer['native_shapes'][group,1].fill_(request_rows)
+        observer['native_shapes'][group,2].fill_(native_width)
+        metrics.before_plan(group,masked,current.to(torch.int32),observer['requests'],
+            cache.states[group].directory,native_width)
+        result=old_plan(cache,layer,selected,current)
+        work=cache.workspaces[group]
+        metrics.module.plan(work.plan,work.counters,metrics.counts[group],
+            1+len(cache.groups.followers[group]),cache.row_bytes,
+            min(work.new_rows.numel(),selected.shape[0]*(cache.topk+1)))
+        return result
+
+    UnifiedLocalResidency.plan=plan
+    UnifiedLocalResidency.begin_forward=begin
+    UnifiedLocalResidency.write=write
+
+    try:
+        from sglang.srt.managers.hisparse_coordinator import HiSparseSpecSwapManager
+    except ImportError:
+        HiSparseSpecSwapManager=None
+    if HiSparseSpecSwapManager is not None:
+        old_swap=HiSparseSpecSwapManager.swap_in
+        old_backup=HiSparseSpecSwapManager._backup_device_locs_to_host
+        old_commit=HiSparseSpecSwapManager.commit_accept_tokens
+
+        def swap(manager,requests,seq_lens,selected,layer_id,**native_plan):
+            coordinator=manager._coordinator;observer=_observers.get(manager)
+            if observer is None:return old_swap(manager,requests,seq_lens,selected,layer_id,**native_plan)
+            group=observer['group_ids'][layer_id];metrics=observer['metrics']
+            metrics.before_swap(group,selected=selected,requests=requests,seq_lens=seq_lens,
+                tokens=coordinator.req_device_buffer_tokens[layer_id],
+                locs=coordinator.req_device_buffer_token_locs[layer_id],
+                state=manager.states[layer_id],host_locs=coordinator.req_to_host_pool,
+                real_requests=coordinator.num_real_reqs,hot=coordinator.device_buffer_size,
+                page_size=coordinator.mem_pool_device.page_size)
+            if 'miss_count' not in native_plan:
+                # Standalone anchors have no followers. Request the original
+                # native diagnostic plan export into the same existing
+                # workspace so bytes are observed, rather than inferred from
+                # hit counts. This profile-only flag is recorded in receipts.
+                n=requests.numel()
+                native_plan=dict(miss_src=coordinator._miss_src[:n],
+                    miss_dst=coordinator._miss_dst[:n],miss_count=coordinator._miss_count[:n])
+            result=old_swap(manager,requests,seq_lens,selected,layer_id,**native_plan)
+            row=coordinator.mem_pool_host.kv_buffer[layer_id]
+            metrics.after_swap(group,native_plan['miss_count'],coordinator.num_real_reqs,
+                layers=1+len(coordinator._prefetch_groups.get(layer_id,[])),
+                row_bytes=row.stride(0)*row.element_size())
+            return result
+
+        def backup(manager,host_locs,device_locs):
+            observer=_observers.get(manager)
+            if observer is not None:
+                row=manager._coordinator.mem_pool_host.kv_buffer[0]
+                observer['metrics'].backup(rows=host_locs.numel(),
+                    layers=len(manager._coordinator.mem_pool_host.kv_buffer),
+                    row_bytes=row.stride(0)*row.element_size())
+            return old_backup(manager,host_locs,device_locs)
+
+        def commit(manager,*args,**kwargs):
+            torch.cuda.nvtx.range_push('ulacache.baseline_spec_commit')
+            try:return old_commit(manager,*args,**kwargs)
+            finally:torch.cuda.nvtx.range_pop()
+
+        HiSparseSpecSwapManager.swap_in=swap
+        HiSparseSpecSwapManager._backup_device_locs_to_host=backup
+        HiSparseSpecSwapManager.commit_accept_tokens=commit
+
+    original_forward=ModelRunner.forward
+
+    def forward(runner,batch,*args,**kwargs):
+        observer=_observers.get(runner)
+        target=state['armed'] and not runner.is_draft_worker and observer is not None
+        if target and not state['finished']:
+            metrics=observer['metrics'];frame=state['forwards']-warmup
+            if observer['kind']=='hisparse':
+                metrics.positions[:batch.positions.numel()].copy_(batch.positions)
+            if frame==0:
+                metrics.counts.zero_()
+                if observer['kind']=='hisparse':metrics.enabled.fill_(1)
+                else:observer['expiry'].start()
+                save('START.json',dict(kind=observer['kind'],warmup_target_forwards=warmup,
+                    target_forwards=frames,query_width=width,cpu_affinity=sorted(os.sched_getaffinity(0)),
+                    numa_maps=Path('/proc/self/numa_maps').read_text(),
+                    source_gpu_budget='Production startup audit; external diagnostic storage is separate.'))
+                profile_boundary(True)
+            if frame==frames:
+                profile_boundary(False)
+                if observer['kind']=='hisparse':metrics.enabled.zero_()
+                coverage=[]
+                if observer['kind']=='ulacache':
+                    observer['expiry'].stop()
+                    chunk=observer['expiry'].drain_chunk()
+                    active=observer['sample_active'].item()!=0
+                    if active:
+                        for g,ring in enumerate(observer['cache'].rings):
+                            coverage.append(validate_bucket_rotation(chunk['expiry'][:,g].tolist(),ring.recent_count))
+                    directory=root/f'cohort{state["cohort"]:04d}'/f'rank{torch.distributed.get_rank()}'
+                    torch.save(chunk,directory/'BUCKET_COVERAGE.pt')
+                save('COMPLETE.json',dict(complete=True,kind=observer['kind'],target_forwards=frames,
+                    warmup_target_forwards=warmup,counters=metrics.snapshot(),
+                    bucket_coverage=coverage,
+                    native_source_shapes=observer['native_shapes'].cpu().tolist() if observer['kind']=='ulacache' else None,
+                    standalone_hisparse_anchor_native_plan_export=observer['kind']=='hisparse',
+                    measurement_kind='model_profile',model_throughput_accepted=False,
+                    scope='Native target Graph plus intervening MTP acceptance/host backup. Profiler stops at next target entry after last commit. Diagnostic counter/reset/mask kernels excluded.'))
+                state['finished']=True
+                torch.distributed.barrier(group=get_tp_group().cpu_group)
+            if 0<=frame<frames:
+                if observer['kind']=='ulacache':
+                    sample=int(batch.req_pool_indices.numel()>0)
+                    observer['sample_active'].fill_(sample)
+                    observer['expiry'].begin_frame(sample)
+                torch.cuda.nvtx.range_push('ulacache.target_forward')
+        measuring=target and not state['finished'] and warmup<=state['forwards']<warmup+frames
+        try:result=original_forward(runner,batch,*args,**kwargs)
+        finally:
+            if measuring:torch.cuda.nvtx.range_pop()
+        if target:
+            state['forwards']+=1
+            if not state['finished'] and state['forwards']>warmup and (state['forwards']-warmup)%64==0:
+                save('PROGRESS.json',dict(target_forwards=state['forwards']-warmup,expected=frames))
+        return result
+
+    ModelRunner.forward=forward
+    old_pause=Scheduler.pause_generation
+
+    def pause(scheduler,request):
+        result=old_pause(scheduler,request)
+        if request.mode=='in_place':
+            if state['armed'] and not state['finished']:
+                raise RuntimeError('Profile cohort ended before its complete target window')
+            state.update(armed=True,forwards=0,finished=False,cohort=state['cohort']+1)
+        return result
+
+    Scheduler.pause_generation=pause
