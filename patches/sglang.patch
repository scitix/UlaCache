+                if configuration.maximum_padded_query_count is not None
+                else kwargs['max_running_requests'] * verify_width)
+            super().__init__(*args, **kwargs)
+
+        def _create_buffers(self):
+            if self.dtype != torch.bfloat16 or self.kv_cache_dim != self.kv_lora_rank + self.qk_rope_head_dim:
+                raise NotImplementedError('Native sparse latent binding currently preserves unquantized BF16 KV')
+            owners = self.storage_owner_count
+            if self.page_size % owners:
+                raise ValueError('Native allocation pages must contain complete owner stripes')
+            capacity = MemoryTierCapacity(configuration.device_record_capacity,
+                configuration.host_record_capacity, configuration.maximum_write_record_count,
+                reserved_logical_record_count=self.page_size // owners,
+                maximum_prefill_union_record_count=configuration.device_record_capacity)
+            if self.size + self.page_size != owners * capacity.logical_record_capacity:
+                raise ValueError('Native admission must match the declared CPU plus GPU record capacity')
+            # NoPE has one native latent segment and no rotary segment.
+            segments = tuple(width for width in
+                (self.kv_lora_rank * 2, self.qk_rope_head_dim * 2) if width)
+            plane = KeyValueRecordPlane('key_value', 'mla.bfloat16.v1', segments)
+            specification = UnifiedCacheSpecification(
+                KeyValueStorageLayout('sparse_history', (plane,), self.page_size),
+                LayerReuseSpecification.from_shared_sparse_selection(layer_selection_owners),
+                SparseAccessSpecification(self.maximum_padded_query_count, maximum_selected_records), capacity)
+            self.execution_plan = (create_owner_paged_execution_plan if owners > 1
+                else create_paged_cache_execution_plan)(specification)
+
+            def write_native_pages(values, pages, indices):
+                native_rows = pages.view(self.dtype).reshape(-1, 1, self.kv_cache_dim)
