@@ -0,0 +1,20 @@
+"""Launch the validated position-sharded DCP binding through native SGLang."""
+import os
+import runpy
+
+
+def main():
+    from sglang.srt.ulacache.native_ipc_environment import validate_native_ipc_environment
+    validate_native_ipc_environment()
+    if os.environ.get('UDCACHE_CP_AUTO_GPU_CAPACITY') != '1':
+        raise ValueError('Select explicit position-owner capacity planning at startup')
+    for name in ('UDCACHE_DPA_CPU_SLOTS', 'UDCACHE_CPU_CACHE_CAP_BYTES'):
+        if not os.environ.get(name, '').isdigit() or int(os.environ[name]) <= 0:
+            raise ValueError(f'Declare the per-owner CPU geometry through {name}')
+    from sglang.srt.ulacache.context_parallel_adapter import install
+    install(prefill_context_parallel=True)
+    runpy.run_module('sglang.launch_server', run_name='__main__')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/python/sglang/srt/ulacache/entry.py b/python/sglang/srt/ulacache/entry.py
