index 0000000000000000000000000000000000000000..67766d2afd9bea965d6aecdfaf796fdae9a19ba1
--- /dev/null
+++ b/python/sglang/srt/ulacache/entry.py
@@ -0,0 +1,166 @@
+"""Native SGLang entry; cache settings come from explicit launch arguments/env."""
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import runpy
+import sys
+
+from sglang.srt.ulacache.model_configuration import load_model_configuration
+
+
+def benchmark_model_fingerprint(model):
+    """Retain a bank producer's explicit model identity when replaying its KV."""
+    default = hashlib.sha256((model / "config.json").read_bytes()).hexdigest()
+    value = os.environ.get("ULACACHE_BENCH_MODEL_FINGERPRINT", default)
+    digest = re.fullmatch(r"[0-9a-f]{64}", value)
+    pinned_model = re.fullmatch(r"[^\s@:]+@[0-9a-f]{40}:[^\s:]+:kv-[^\s:]+", value)
+    if not (digest or pinned_model):
+        raise ValueError("The KV bank model fingerprint must be a lowercase SHA256 or pinned model@revision:format:kv-format")
+    return value
+
+
+def validate_snapshot_bank_identity(bank, fingerprint):
+    """Reject a mismatched existing KV bank before any model weights load."""
+    for path in Path(bank).glob("*/SNAPSHOT.json"):
+        metadata = json.loads(path.read_text())
+        if metadata.get("complete") and metadata.get("model_fingerprint") != fingerprint:
+            raise ValueError(
+                f"KV bank {path.parent} uses model fingerprint "
+                f"{metadata.get('model_fingerprint')}, but the server uses {fingerprint}. "
+                "For a verified matching checkpoint, set ULACACHE_BENCH_MODEL_FINGERPRINT "
+                "to the bank producer's identity."
+            )
+
+
+def install_bindings():
+    import argparse
+    import sys
+
+    kind = os.environ.get("UDCACHE_MATRIX_CACHE_KIND", "native")
+    filename = os.environ.get("ULACACHE_CONFIGURATION")
+    prefix = os.environ.get("ULACACHE_BENCH_PREFIX_CACHE") == "1"
+    pd_parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
+    pd_parser.add_argument("--disaggregation-mode", default="null")
+    pd_options, _ = pd_parser.parse_known_args(sys.argv[1:])
+    pd_requested = pd_options.disaggregation_mode != "null"
+    configuration = None
+    if os.environ.get("UDCACHE_SPARSE_TRACE_DIR"):
+        from sglang.srt.ulacache.native_dpa_geometry_adapter import install as geometry
+        from sglang.srt.ulacache.sparse_trace_adapter import install as trace
+
+        latest = {}
+        geometry(replay_observer=latest.update)
+        trace(replay_geometry=lambda: latest)
+    if filename:
+        from sglang.srt.ulacache.model_integration import install_model_integration
+
+        configuration = load_model_configuration(filename)
+        install_model_integration(configuration)
+        if prefix and not pd_requested and configuration.adapter == "native_dpa":
+            from sglang.srt.ulacache.unified_local_prefix_adapter import (
+                bind_native_prefix_cache,
+            )
+            from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+            from sglang.srt.runtime_context import get_disagg, get_memory, get_spec
+
+            bind_native_prefix_cache(
+                UnifiedRadixCache, get_memory, get_disagg, get_spec
+            )
+    elif kind in ("native", "hisparse"):
+        from sglang.srt.ulacache.agent_hicache_shared_index_adapter import install
+        from sglang.srt.ulacache.v0522_fp8_loading import install as install_fp8_loading
+
+        install_fp8_loading()
+        install()
+        if kind == "hisparse":
+            from sglang.srt.ulacache.hisparse_prefill_relay_adapter import install as relay
+
+            relay()
+            if prefix and not pd_requested:
+                from sglang.srt.ulacache.hisparse_prefix_adapter import (
+                    install as prefix_cache,
+                )
+
+                prefix_cache()
+                from sglang.srt.ulacache.hisparse_prefill_adapter import (
+                    install as prefill_workspace,
+                )
+                prefill_workspace()
+        if os.environ.get("UDCACHE_MATRIX_AUDIT_DIR"):
+            from sglang.srt.ulacache.matrix_startup_audit import install as audit
+
+            audit()
+    else:
+        raise ValueError("UlaCache serving requires an explicit ULACACHE_CONFIGURATION")
+
+    if pd_requested:
+        from sglang.srt.ulacache.pd_record_adapter import configure_native_launch
+
+        configure_native_launch(configuration, sys.argv[1:], os.environ)
+
+    # Optional saved-prefix benchmark IO; no plans, source manifests or cluster control.
+    phase = os.environ.get("ULACACHE_BENCH_PHASE", "serve")
+    if phase in ("fill", "decode"):
+        model = Path(os.environ["ULACACHE_BENCH_MODEL"])
+        fingerprint = benchmark_model_fingerprint(model)
+        bank = os.environ["ULACACHE_BENCH_KV_DIR"]
+        mtp = os.environ["ULACACHE_BENCH_SPEC"] == "on"
+        if phase == "fill":
+            from sglang.srt.ulacache.matrix_prefix_save_adapter import (
+                install,
+                install_native,
+            )
+
+            config = dict(
+                path=bank,
+                mtp=mtp,
+                model_fingerprint=fingerprint,
+                source_manifest_sha256=hashlib.sha256(
+                    Path(__file__).read_bytes()
+                ).hexdigest(),
+            )
+            (install if mtp else install_native)(config)
+        else:
+            validate_snapshot_bank_identity(bank, fingerprint)
+            from sglang.srt.ulacache.matrix_prefix_load_adapter import install
+
+            install(
+                dict(
+                    bank=bank,
+                    model_fingerprint=fingerprint,
+                    cache_kind=kind,
+                    mtp=mtp,
+                    batch=int(os.environ["ULACACHE_BENCH_MAX_REQUESTS"]),
+                    receipts=os.environ["ULACACHE_BENCH_RECEIPTS"],
+                    verify_restored=False,
+                    paused_cohort_admission=True,
+                    native_scheduler_control=os.environ["ULACACHE_BENCH_MODE"] == "tp",
+                    reset_graph_padding=True,
+                    prepared_dpa_restore=False,
+                    replay_trace=os.environ.get("ULACACHE_BENCH_REPLAY_TRACE"),
+                )
+            )
+
+
+if __name__ == "__main__" and sys.argv[1:2] == ["--check-configuration"]:
+    import argparse
+
+    parser = argparse.ArgumentParser(
+        description="Validate a native cache configuration"
+    )
+    parser.add_argument("--check-configuration", required=True, metavar="JSON")
+    print(
+        json.dumps(
+            load_model_configuration(
+                parser.parse_args().check_configuration
+            ).describe(),
+            indent=2,
+        )
+    )
+else:
+    install_bindings()
+    if __name__ == "__main__":
+        runpy.run_module("sglang.launch_server", run_name="__main__")
diff --git a/python/sglang/srt/ulacache/hisparse_pending_buffer_adapter.py b/python/sglang/srt/ulacache/hisparse_pending_buffer_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..e995f96892ec2e87dab836c9d7d49e2cc7dd7cea
--- /dev/null
+++ b/python/sglang/srt/ulacache/hisparse_pending_buffer_adapter.py
@@ -0,0 +1,63 @@
+"""Account for native HiSparse staging buffers before their late allocation.
+
+Admission must retain a reservation across prefill batches while native D2H
+staging is pending. The native coordinator, allocation and transfer paths stay
+unchanged. No device query, synchronization or additional KV storage is added.
+"""
+import weakref
+
+
+def pending_buffer_slots(allocator, staging_queue):
+    """Scratch already owns physical slots; reserve only missing hot-buffer rows."""
+    return sum(allocator.request_slot_reserve(
+        has_req_pool_slot=True,prefill_tokens=req.kv.kv_allocated_len)
+        for _,_,req in staging_queue)
+
+
+def admission_available(allocator, staging_queue):
+    reserved=pending_buffer_slots(allocator,staging_queue)
+    return min(allocator.logical_attn_allocator.available_size(),
+        max(allocator.hisparse_attn_allocator.available_size()-reserved,0))
+
+
+def fixed_decode_ready(owner, requests):
+    if owner is None or requests is None or not owner.spec_swap.enabled:
+        return False
+    return all(not getattr(req,'hisparse_staging',False)
+        and req.beam_group is None
+        and req.kv.req_pool_idx in owner.spec_swap._scratch_reqs
+        for req in requests)
+
+
+def install():
+    from sglang.srt.managers.hisparse_coordinator import HiSparseCoordinator
+    from sglang.srt.mem_cache.allocator.hisparse import HiSparseTokenToKVPoolAllocator
+    original_init=HiSparseCoordinator.__init__
+    original_available=HiSparseTokenToKVPoolAllocator.available_size
+    original_decode_check=HiSparseTokenToKVPoolAllocator.check_decode_capacity
+
+    def init(self,*args,**kwargs):
+        original_init(self,*args,**kwargs)
+        if (not self.is_dsv4_hisparse and not self.is_m3_hisparse
+                and self.spec_swap.enabled):
+            self.token_to_kv_pool_allocator._udcache_pending_buffer_owner=weakref.proxy(self)
+
+    def available(self):
+        owner=getattr(self,'_udcache_pending_buffer_owner',None)
+        if owner is None or not owner.ack_staging_queue:
+            return original_available(self)
+        return admission_available(self,owner.ack_staging_queue)
+
+    def check_decode(self,*,num_tokens,tree_cache,requests=None,spec_algorithm=None):
+        owner=getattr(self,'_udcache_pending_buffer_owner',None)
+        kwargs=dict(num_tokens=num_tokens,tree_cache=tree_cache,
+            requests=requests,spec_algorithm=spec_algorithm)
+        if fixed_decode_ready(owner,requests):
+            # Native DSA alloc_decode allocates logical identities only. These
+            # ready MTP requests already own their full hot buffer and scratch.
+            return self.logical_attn_allocator.check_decode_capacity(**kwargs)
+        return original_decode_check(self,**kwargs)
+
+    HiSparseCoordinator.__init__=init
+    HiSparseTokenToKVPoolAllocator.available_size=available
+    HiSparseTokenToKVPoolAllocator.check_decode_capacity=check_decode
diff --git a/python/sglang/srt/ulacache/hisparse_prefill_adapter.py b/python/sglang/srt/ulacache/hisparse_prefill_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..6c3105b3a4cd84766d49b294b301419f4b9c23d3
--- /dev/null
+++ b/python/sglang/srt/ulacache/hisparse_prefill_adapter.py
@@ -0,0 +1,433 @@
+"""Independent per-layer prefill views over HiSparse's canonical CPU records.
+
+The shared MR77 pipeline owns two raw windows and their events. Addressing
+stays in this adapter: native Index IDs and decode mappings are never changed.
+All records keep the native encoded MLA/scales/RoPE byte layout.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from contextlib import contextmanager
+import functools
+import types
+
+
+@dataclass
+class HiSparsePrefillPlan:
+    record_ids: object
+    history_ids: object
+    history_positions: object
+    current_rows: object
+    current_positions: object
+    full_history_records: int
+
+    @property
+    def keepalive_tensors(self):
+        return (self.record_ids, self.history_ids, self.history_positions,
+                self.current_rows, self.current_positions)
+
+
+def make_prefill_plan(rows, current_rows, *, full_history_records, capacity):
+    """Use MR77's sorted native-ID union; fresh rows are not CPU history."""
+    import torch
+    if (type(full_history_records) is not int or full_history_records < 1
+            or full_history_records > capacity or rows.numel() != full_history_records):
+        raise ValueError("Complete native prefill histories must fit one window")
+    record_ids = torch.unique(rows[rows > 0].to(torch.int64), sorted=True)
+    current_rows = current_rows[current_rows > 0].to(torch.int64)
+    if not record_ids.numel():
+        raise ValueError("A prefill window needs at least one real logical record")
+    current_positions = torch.searchsorted(record_ids, current_rows)
+    positions = torch.arange(record_ids.numel(), dtype=torch.int64,
+                             device=rows.device)
+    history = torch.ones(record_ids.numel(), dtype=torch.bool, device=rows.device)
+    history[current_positions] = False
+    return HiSparsePrefillPlan(record_ids, record_ids[history], positions[history],
+                               current_rows, current_positions, full_history_records)
+
+
+class HiSparsePrefillWorkspace:
+    """Raw windows and a bounded batch plan, separate from every decode bank."""
+
+    def __init__(self, coordinator, *, capacity=1_048_576, windows=None,
+                 runtime=None, transfer=None):
+        from ulacache.transfer.prefill_pipeline import (
+            LayerPrefillPipeline, allocate_native_prefill_windows)
+        self.coordinator = coordinator
+        self.pool = coordinator.mem_pool_device
+        self.capacity = capacity
+        self.row_bytes = self.pool.kv_cache_dim * self.pool.dtype.itemsize
+        if self.row_bytes != 656:
+            raise ValueError("This prefill adapter requires native GLM FP8 MLA records")
+        if windows is None:
+            windows = allocate_native_prefill_windows(coordinator.device,
+                capacity_records=capacity, row_bytes=self.row_bytes)
+        if transfer is None:
+            from sglang.kernels.ops.kvcache.hicache import transfer_hicache_one_layer_mla
+            transfer = transfer_hicache_one_layer_mla
+        self.transfer = transfer
+        self.pipeline = LayerPrefillPipeline(windows,
+            gather_history=self._gather_history, install_current=self._install_current,
+            runtime=runtime, capacity_records=capacity, row_bytes=self.row_bytes)
+        self.pending_writer = None
+
+    @property
+    def active(self):
+        return self.pipeline.plan is not None
+
+    def begin(self, batch, req_to_token):
+        import torch
+        slots, lengths = batch.req_pool_indices_cpu, batch.seq_lens_cpu
+        if slots is None or lengths is None:
+            raise ValueError("Native CPU request/sequence metadata is required for prefill")
+        slots, lengths = slots.tolist(), lengths.tolist()
+        if len(slots) != len(lengths):
+            raise ValueError("Native prefill request rows and lengths disagree")
+        full = sum(lengths)
+        if full == 0:
+            # DPA global4 has four empty attention ranks. Their dense-TP
+            # collectives stay native; they do not own a prefill window.
+            return False
