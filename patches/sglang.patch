+            boundary="Fresh native pages, complete target/draft history and original continuation; native decode preparation"))
+        return NextBatchPlan(batch_to_run=batch, running_batch=batch)
+
+    def forward(runner, batch, *args, **kwargs):
+        capture = torch.cuda.is_current_stream_capturing()
+        if state["active"] and not capture and batch.forward_mode.name in ("EXTEND", "MIXED", "SPLIT_PREFILL"):
