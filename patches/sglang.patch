+def flashmla_attention_cache_seqlens(forward_batch: "ForwardBatch", cache_seqlens):
+    """Match FlashMLA's split schedule to the rows RadixAttention will execute.
+
+    Index scoring retains the padded metadata. An ordinary TP extend removes
+    MLP synchronization padding before attention, so its FlashMLA schedule must
+    cover those real queries, including the final cumulative split sentinel.
+    """
+    from sglang.srt.layers.radix_attention import padded_extend_real_tokens
+
+    real_rows = padded_extend_real_tokens(cache_seqlens, forward_batch)
+    return cache_seqlens if real_rows is None else cache_seqlens[:real_rows]
