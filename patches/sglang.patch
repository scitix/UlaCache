@@ -0,0 +1,34 @@
+"""Render native TopK launch traits for UlaCache's unchanged input reader."""
+
+
+def transform(logits, lengths, topk, metadata):
+    import torch
+    from sglang.kernels.jit.utils import is_arch_support_pdl, make_cpp_args
+    from sglang.kernels.jit.utils.occupancy import (
+        NoSchedulableClustersError, get_max_active_clusters,
+    )
+    from ulacache.indexer.topk import rank_major_topk_module
+
+    plan = metadata.topk_v2_plan
+    if plan is None or plan.shape[0] != logits.queries + 1:
+        raise RuntimeError("Use the actual native per-forward TopK plan")
+    if logits.score_page_size != 1:
+        raise ValueError("This owner-TP binding uses token-striped native scores")
+    compact = logits.compact_query_offsets is not None
+    args = make_cpp_args(is_arch_support_pdl(), logits.degree, 0,
+        logits.init_tokens, logits.recent_tokens, compact)
+    flags = []
+    if is_arch_support_pdl():
+        for cluster_size, occupancy in ((8, 2), (16, 1)):
+            try:
+                capacity = get_max_active_clusters(cluster_size, occupancy=occupancy)
+            except NoSchedulableClustersError:
+                capacity = 0
+            flags.append(f"-DSGL_TOPK_V2_MAX_C{cluster_size}_OCC{occupancy}={capacity}")
+    module = rank_major_topk_module(tuple(args), tuple(flags))
+    output = logits.gathered.new_empty((logits.queries, topk), dtype=torch.int32)
+    module.topk_transform_paged_rank_major(logits.gathered, lengths,
+        metadata.real_page_table, output, metadata.page_size, plan,
+        None, None, 0, logits.logical_columns,
+        logits.compact_query_offsets, logits.compact_input_packs)
+    return output
