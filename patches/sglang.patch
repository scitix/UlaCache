--- /dev/null
+++ b/python/sglang/srt/ulacache/agent_hicache_shared_index_adapter.py
@@ -0,0 +1,38 @@
+"""Retain native shared-TopK layer ownership in local CUDA HiCache pools."""
+
+
+def bind_native_index_elision(configurator, *, cuda_platform):
+    """Elide unused target buffers while preserving other native boundaries."""
+    if getattr(configurator, '_ulacache_hicache_index_elision_bound', False):
+        return
+    original = configurator._should_elide_dsa_index_k
+
+    def should_elide(*, is_draft_worker):
+        if original(is_draft_worker=is_draft_worker):
+            return True
+        memory = configurator.get_memory()
+        return (
+            cuda_platform
+            and not is_draft_worker
+            and memory.enable_hierarchical_cache
+            and not getattr(memory, 'enable_hisparse', False)
+            and not memory.enable_unified_cache_external_linker
+            and configurator.get_disagg().disaggregation_mode == 'null'
+        )
+
+    configurator._should_elide_dsa_index_k = should_elide
+    configurator._ulacache_hicache_index_elision_bound = True
+
+
+def install():
+    from sglang.srt.mem_cache import kv_cache_configurator
+    from sglang.srt.utils import is_cuda
+
+    bind_native_index_elision(kv_cache_configurator, cuda_platform=is_cuda())
+    if is_cuda():
+        from sglang.srt.ulacache.pd_record_adapter import bind_native_pd_index_elision
+
+        # Resolve native state when sizing the pool, after ServerArgs exists.
+        bind_native_pd_index_elision(kv_cache_configurator,
+            kv_cache_configurator.get_memory, kv_cache_configurator.get_parallel,
+            kv_cache_configurator.get_disagg)
