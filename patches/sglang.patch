@@ -0,0 +1,20 @@
+"""Legacy native entry using the shared pool configuration decoder."""
+
+import os
+import runpy
+
+
+def install_bindings():
+    from sglang.srt.ulacache.model_configuration import load_pool_configuration
+    from sglang.srt.ulacache.native_glm_flash_pool import install_native_glm_flash_pool
+    from sglang.srt.ulacache.matrix_startup_audit import install as install_startup_audit
+
+    if path := os.environ.get('ULACACHE_GLM_FLASH_CONFIGURATION'):
+        install_native_glm_flash_pool(load_pool_configuration('glm_flash', path))
+    install_startup_audit()
+
+
+install_bindings()
+
+if __name__ == '__main__':
+    runpy.run_module('sglang.launch_server', run_name='__main__')
diff --git a/python/sglang/srt/ulacache/native_glm_flash_index.py b/python/sglang/srt/ulacache/native_glm_flash_index.py
new file mode 100644
index 0000000000000000000000000000000000000000..5706b758e3a7412a904533dd38596dc311a9ff15
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_glm_flash_index.py
@@ -0,0 +1,79 @@
+"""Bind GLM's native FP8 compressed Index to disjoint TP storage and scoring."""
+
+
+def create_glm_distributed_index_pool_class(base_class, configuration, *, maximum_columns):
+    from sglang.srt.ulacache.native_fp8_index_pool import create_native_fp8_distributed_index_pool_class
+
+    return create_native_fp8_distributed_index_pool_class(base_class, configuration,
+        maximum_columns=maximum_columns)
+
+
+def install_glm_distributed_index_scoring():
+    """Retain native projection, compression, causal/top-k and incomplete tail."""
+    from sglang.srt.layers.attention.dsa import dsa_indexer_kpool as module
+    from sglang.srt.layers.attention.dsa import kpool_fp8_index
+    from sglang.srt.layers.attention.dsa_backend import DeepseekSparseAttnBackend
+
+    if getattr(module.IndexerKPool, '_ulacache_distributed_index_installed', False):
+        return
+    original_paged = module.IndexerKPool._get_topk_paged
+    original_ragged = module.IndexerKPool._fp8_mqa_logits
+    original_gather = kpool_fp8_index.gather_index_k_scale_prefix_into
+    original_cp_init = DeepseekSparseAttnBackend._init_cp_index_scorer
+
+    def runtime_for_pool(pool):
+        return getattr(pool, 'native_distributed_indexer', None)
+
+    def paged(self, forward_batch, layer_id, q_fp8, weights, metadata):
+        pool = module.get_token_to_kv_pool()
+        runtime = runtime_for_pool(pool)
+        if runtime is None:
+            return original_paged(self, forward_batch, layer_id, q_fp8, weights, metadata)
+        lengths = metadata.get_seqlens_int32()
+        padded = q_fp8.shape[0]
+        rows = lengths.shape[0]
+        pool_lengths, _, pooled_pages, _ = self._get_kpool_decode_metadata(metadata,
+            metadata.get_page_table_64(), lengths, 64, build_schedule_metadata=False)
+        payload = pool.full_kv_pool
+        bank = pool.full_attention_layer_id_mapping[layer_id] - payload.start_layer
+        logits = runtime.score_paged(bank, q_fp8[:rows].unsqueeze(1),
+            weights[:rows].squeeze(2), pool_lengths, pooled_pages,
+            native_score=module.deep_gemm.fp8_paged_mqa_logits)
+        native_pages, offsets, _ = self._kpool_fused_topk_mapping(metadata)
+        return self._topk_from_kpool_logits(logits, pool_lengths, seq_lens=lengths,
+            page_table=native_pages, topk_offsets=offsets,
+            out_rows=padded if padded != rows else None)
+
+    def ragged(q_fp8, k_fp8, k_scale, weights, starts, ends, *, clean_logits):
+        runtime = runtime_for_pool(module.get_token_to_kv_pool())
+        if runtime is None:
+            return original_ragged(q_fp8, k_fp8, k_scale, weights, starts, ends,
+                clean_logits=clean_logits)
+        return runtime.score_ragged(q_fp8, k_fp8, k_scale.reshape(-1), weights, starts, ends,
+            native_score=original_ragged, clean_logits=clean_logits)
+
+    def gather(pool, buf, page_indices, seq_len, k_out, scale_out):
+        runtime = runtime_for_pool(pool)
+        if runtime is None:
+            return original_gather(pool, buf, page_indices, seq_len, k_out, scale_out)
+        if not seq_len:
+            return
+        offset = buf.data_ptr() - runtime.storage.data_ptr()
+        stride = runtime.storage.stride(0)
+        if offset < 0 or offset % stride or offset // stride >= runtime.storage.shape[0]:
+            raise ValueError('Native prefix buffer is outside its declared owned Index banks')
+        runtime.gather_prefix(offset // stride, page_indices, k_out[:seq_len], scale_out[:seq_len])
+
+    def initialize_cp(self, model_runner):
+        runtime = runtime_for_pool(model_runner.token_to_kv_pool)
+        if runtime is None:
+            return original_cp_init(self, model_runner)
+        # Native mode=cp also admits this compressed Index service. Its own
+        # pooled metadata and native TopK consumer bind the same CP scorer.
+        self.cp_index_scorer = None
+
+    module.IndexerKPool._get_topk_paged = paged
+    module.IndexerKPool._fp8_mqa_logits = staticmethod(ragged)
+    kpool_fp8_index.gather_index_k_scale_prefix_into = gather
+    DeepseekSparseAttnBackend._init_cp_index_scorer = initialize_cp
+    module.IndexerKPool._ulacache_distributed_index_installed = True
diff --git a/python/sglang/srt/ulacache/native_glm_flash_pool.py b/python/sglang/srt/ulacache/native_glm_flash_pool.py
