+                draft_pool = worker.draft_worker.draft_runner.token_to_kv_pool
+                checked += restore_native_prefix(root / "draft", key, native_banks(draft_pool), rows,
+                    config["model_fingerprint"], quiesce=torch.cuda.synchronize,
+                    verify=config.get("verify_restored", False))["restored_bytes"]
+                continuation.append(load_continuation(root / "continuation.pt",
+                    meta["continuation_sha256"], rows, scheduler.device))
+            restored.append(dict(key=key, input_tokens=len(saved.input_ids), history_rows=n,
+                                 allocation_rows=allocated, first_output_token=saved.next_token_id,
+                                 source_owners=source_reader.layout.owners))
+            if len(restored) % 8 == 0 or len(restored) == len(native_requests):
