@@ -0,0 +1,59 @@
+"""Validation predicates for an explicitly installed native TP owner receiver."""
+
+
+def supports_owner_tp_pd_mtp(config, model, *, is_dsa, cuda_platform,
+                             deferred_remote_release, receive_binding_installed,
+                             resolved_attention_tp_size=None, model_layout=None):
+    """Recognize the bounded native FP8/Index-owner layout before loading weights.
+
+    A true result permits validation only. It does not establish pool sizing,
+    capture, remote-write retirement or complete serving correctness.
+    """
+    if (is_dsa is not True or cuda_platform is not True
+            or deferred_remote_release is not True
+            or receive_binding_installed is not True):
+        return False
+    if model_layout is not None:
+        config = model_layout.validation_view(config)
+    required = {
+        'device': 'cuda', 'tp_size': 8, 'attn_tp_size': 8, 'attn_dp_size': 1,
+        'attn_cp_size': 1, 'dcp_size': 1, 'dp_size': 1, 'ep_size': 1, 'pp_size': 1,
+        'moe_dense_tp_size': 8, 'page_size': 64, 'kv_cache_dtype': 'fp8_e4m3',
+        'dsa_decode_score_mode': 'cp', 'enable_flowkv': True,
+        'enable_flowkv_cpu_offload': True, 'enable_flowkv_prefetch': True,
+        'flowkv_cpu_policy': 'index', 'radix_eviction_policy': 'lru',
+        'disaggregation_mode': 'decode', 'disaggregation_transfer_backend': 'mooncake',
+        'disaggregation_decode_enable_radix_cache': True,
+        'disaggregation_decode_extra_slots': 0, 'disable_radix_cache': False,
+        'enable_pdmux': False, 'disable_overlap_schedule': True,
+        'enable_two_batch_overlap': False, 'enable_memory_saver': False,
+        'speculative_algorithm': 'EAGLE', 'speculative_num_steps': 2,
+        'speculative_eagle_topk': 1, 'speculative_num_draft_tokens': 3,
+        'speculative_adaptive': False,
+        'enable_hisparse': False, 'enable_hierarchical_cache': False,
+        'enable_unified_memory': False, 'enable_unified_cache_external_linker': False,
+        'enable_lmcache': False, 'enable_flexkv': False,
+    }
+    for name, expected in required.items():
+        value = getattr(config, name, None)
+        if name == 'moe_dense_tp_size' and value is None and model_layout is not None:
+            # Preserve HY4's native inherited MoE TP default; do not rewrite CLI.
+            continue
+        if name == 'attn_tp_size' and value is None:
+            value = resolved_attention_tp_size
+        if type(value) is not type(expected) or value != expected:
+            return False
+    requests = getattr(config, 'max_running_requests', None)
+    if model_layout is not None:
+        from sglang.srt.ulacache.hy4_pd_layout import HY4PDLayout
+        return (isinstance(model_layout, HY4PDLayout)
+            and model_layout.attention_mode == 'tp'
+            and model_layout.supports(config, model))
+    if type(requests) is not int or requests not in (32, 64, 128):
+        return False
+    hf = model.hf_config
+    return (getattr(model, 'num_nextn_predict_layers', None) == 1
+        and getattr(model, 'kv_lora_rank', None) == 512
+        and getattr(model, 'qk_rope_head_dim', None) == 64
+        and getattr(hf, 'num_hidden_layers', None) == 78
+        and getattr(hf, 'index_share_for_mtp_iteration', False) is True)
diff --git a/python/sglang/srt/ulacache/pd_owner_queue_bindings.py b/python/sglang/srt/ulacache/pd_owner_queue_bindings.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ce9d2342e2c060f45e97bad7e45576d881d1ab7
--- /dev/null
+++ b/python/sglang/srt/ulacache/pd_owner_queue_bindings.py
@@ -0,0 +1,116 @@
+"""Explicit native PD queue hooks for an already-bound owner receive pool.
+
+This module does not select pools, size memory, enable a CLI capability or
+install itself. Native scheduler, prefix matching and Mooncake remain native.
+"""
+
+
+def bind_native_owner_pd_queues(prealloc_class, transfer_class, allocator_class,
+                               *, dsa_state_type, on_publication=None):
+    """Bind native admission/publication and acknowledged allocation retirement.
+
+    The caller must bind target storage before constructing a preallocation
+    queue. Its native initializer registers all target/draft KV and Index banks.
+    Allocation superpages remain512 records; transport pages remain64 records.
+    """
+    if getattr(prealloc_class, '_ulacache_owner_receive_bound', False):
+        raise ValueError('Owner receive queues are bound once per process')
+    initialize = prealloc_class.__init__
+    token_budget = prealloc_class._allocatable_token_budgets
+    send_metadata = prealloc_class._send_kv_metadata
+    commit_transfer = transfer_class._commit_transfer_to_req
+    defer_release = transfer_class._defer_release
+    release_pages = allocator_class._release_page_ids
+
+    def initialize_queue(self, req_to_token_pool, token_to_kv_pool_allocator,
+                         draft_token_to_kv_pool, *args, **kwargs):
+        from sglang.srt.ulacache.pd_owner_receive_bindings import bind_native_owner_draft_receive
+
+        pool = token_to_kv_pool_allocator.get_kvcache()
+        if getattr(pool, 'pd_receive_window', None) is None:
+            raise ValueError('Bind owner target storage before native queue registration')
+        bind_native_owner_draft_receive(pool, draft_token_to_kv_pool)
+        return initialize(self, req_to_token_pool, token_to_kv_pool_allocator,
+                          draft_token_to_kv_pool, *args, **kwargs)
+
+    def allocatable_tokens(self, *args, **kwargs):
+        result = token_budget(self, *args, **kwargs)
+        return min(result, self.token_to_kv_pool.pd_receive_window.available_records)
+
+    def metadata(self, request, kv_indices, page_size, state_indices=None, **kwargs):
+        from sglang.srt.ulacache.pd_owner_receive_bindings import native_index_receive_state_indices
+
+        pool = self.token_to_kv_pool
+        window = pool.pd_receive_window
+        allocator = self.token_to_kv_pool_allocator
+        if (page_size != allocator.page_size or page_size != pool.allocation_page_size
+                or page_size != window.page_size*window.degree):
+            raise ValueError('Native owner allocation and transport geometry disagree')
+        state_index = self.kv_manager.kv_args.state_types.index(dsa_state_type)
+        if state_indices is None:
+            raise ValueError('Native owner reception requires its DSA state metadata')
+        logical_pages = kv_indices[::window.page_size]//window.page_size
+        room = request.req.bootstrap_room
+        window.reserve(room, logical_pages, record_count=kv_indices.numel())
+        try:
+            mapped = native_index_receive_state_indices(window, room, state_indices,
+                dsa_state_index=state_index,
+                prefix_tokens=request.req.kv.cache_protected_len)
+        except BaseException:
+            # No native metadata was published and no remote write can target
+            # this lease. Once send_metadata starts, only native retirement may
+            # release it, including when that native call raises.
+            window.logical_pages_freed(logical_pages.cpu().tolist())
+            raise
+        return send_metadata(self, request, kv_indices, window.page_size, mapped, **kwargs)
+
+    def pages(self, request, kv_indices, page_size):
+        import numpy as np
+
+        window = self.token_to_kv_pool.pd_receive_window
+        if page_size != window.page_size:
+            raise ValueError('Native transfer metadata must address page64 staging')
+        return np.asarray(window.transfer_pages(request.req.bootstrap_room), dtype=np.int32)
+
+    def commit(self, request):
+        queue = self.scheduler.disagg_decode_prealloc_queue
+        window = queue.token_to_kv_pool.pd_receive_window
+        room = self.metadata_buffers.get_buf(request.metadata_buffer_index)[-1]
+        expected = request.req.bootstrap_room
+        if expected and room[0].item() == expected:
+            records = window.publish(expected)
+            if on_publication is not None:
+                on_publication(request, records)
+        return commit_transfer(self, request)
+
+    def retire_pages(self, *page_ids):
+        from sglang.srt.ulacache.pd_owner_receive_bindings import retire_native_owner_receive_pages
+        import torch
+
+        pool = self._kvcache
+        if getattr(pool, 'pd_receive_window', None) is None:
+            return release_pages(self, *page_ids)
+        ids = page_ids[0] if len(page_ids) == 1 else torch.cat(page_ids)
+        retired = ids.to(device='cpu', dtype=torch.int64).tolist()
+        result = release_pages(self, *page_ids)
+        retire_native_owner_receive_pages(pool, retired, transport_quiesced=True)
+        return result
+
+    def defer(self, request):
+        result = defer_release(self, request)
+        entry = self._deferred_releases[-1]
+        if len(entry) != 5 or entry[0] is not request:
+            raise RuntimeError('Native deferred receive retirement order changed')
+        # Preserve the native remote acknowledgement requirement. A timeout
+        # cannot make registered staging available to an unrelated request.
+        self._deferred_releases[-1] = (entry[0], entry[1], float('inf'), entry[3], entry[4])
+        return result
+
+    prealloc_class.__init__ = initialize_queue
+    prealloc_class._allocatable_token_budgets = allocatable_tokens
+    prealloc_class._send_kv_metadata = metadata
+    prealloc_class._transfer_page_indices = pages
+    transfer_class._commit_transfer_to_req = commit
+    transfer_class._defer_release = defer
+    allocator_class._release_page_ids = retire_pages
+    prealloc_class._ulacache_owner_receive_bound = True
