index 0000000000000000000000000000000000000000..1ebf51d1f4b1bc3425a4ba49b9b6c847d2ef8444
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_dsa_pool.py
@@ -0,0 +1,324 @@
+"""Bind ordinary sparse MLA pools while retaining native BF16 readers and writers."""
+
+from dataclasses import dataclass, replace
+
+
+@dataclass(frozen=True)
+class NativeSparseLatentPoolConfiguration:
+    device_record_capacity: int
+    host_record_capacity: int
+    maximum_write_record_count: int
+    device_cache_budget_bytes: int | None = None
+    index_compression_ratio: int = 1
+    native_attention_backend: str = 'flashmla_sparse'
+    maximum_padded_query_count: int | None = None
+    prepare_in_parallel: bool = True
+    independent_tensor_parallel_caches: bool = False
+    storage_owner_count: int | None = None
+    maximum_prefill_record_count: int | None = None
+    native_record_writes_replicated: bool = True
+    native_selections_replicated: bool = False
+    distributed_indexer: bool = True
+    maximum_index_prefill_query_count: int = 256
+    index_prefill_score_mode: str = 'native'
+    index_score_transport: str = 'flash_ag'
+    reuse_attention_workspaces: bool = False
+    prefill_buffer_records: int = 0
+    prefill_query_chunk: int = 256
+    prefill_buffer_prefetch: bool = True
+    use_shared_tensor_parallel_cache: bool = False
+    low_query_pull_blocks: int = 0
+
+    def __post_init__(self):
