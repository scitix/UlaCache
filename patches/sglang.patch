index 0000000000000000000000000000000000000000..53d8f7ae7cecdda4de605b81fbe7bb815928ec49
--- /dev/null
+++ b/python/sglang/srt/mem_cache/allocator/flowkv_host.py
@@ -0,0 +1,173 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
