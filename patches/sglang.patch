@@ -0,0 +1,23 @@
+"""Own the CPU query-length list used by native eager DSA metadata."""
+from functools import wraps
+
+
+def snapshot_query_lengths(initializer):
+    """Separate published metadata from later ForwardBatch padding mutations."""
+    @wraps(initializer)
+    def initialize(metadata, *args, **kwargs):
+        initializer(metadata, *args, **kwargs)
+        lengths = getattr(metadata, "dsa_extend_seq_lens_list", None)
+        if isinstance(lengths, list):
+            object.__setattr__(metadata, "dsa_extend_seq_lens_list", list(lengths))
+    return initialize
+
+
+def install():
+    """Explicit native-source workaround; no automatic production installation."""
+    from sglang.srt.layers.attention.dsa_backend import DSAMetadata
+    if getattr(DSAMetadata, "_udcache_query_lengths_owned", False):
+        return False
+    DSAMetadata.__init__ = snapshot_query_lengths(DSAMetadata.__init__)
+    DSAMetadata._udcache_query_lengths_owned = True
+    return True
diff --git a/python/sglang/srt/ulacache/native_owner_index.py b/python/sglang/srt/ulacache/native_owner_index.py
new file mode 100644
index 0000000000000000000000000000000000000000..e397c629a5ee5f6d06607ddaf6a41f6a8fe48c67
--- /dev/null
+++ b/python/sglang/srt/ulacache/native_owner_index.py
@@ -0,0 +1,206 @@
+"""Explicit Hopper binding for the native V4.1 ratio-1/2 Index services."""
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class NativeOwnerIndexConfiguration:
+    maximum_queries: int
+    maximum_columns: int
+    maximum_write_records: int
+    query_heads: int
+    head_dimension: int
+
+
+def create_native_owner_index_pool_class(base_class, configuration, *, cpu_group):
+    """Wrap the native-paged KV adapter without changing framework kernels."""
+    import inspect
+    import torch
+    import torch.distributed as distributed
+    from sglang.kernels.jit.utils import load_jit
+    from sglang.kernels.ops.attention.dsv4.fp4_indexer import (
+        _fp4_index_logits_tile, store_fp4_index_k_cache,
+    )
+    from sglang.kernels.ops.communication.all_reduce import IPCManager
+    from sglang.srt.mem_cache.deepseek_v4_memory_pool import DeepSeekV4IndexerPool
+    from sglang.srt.runtime_context import get_platform, get_spec
+    from ulacache.storage.layout import KeyValueRecordPlane
+    from ulacache.indexer import NativeIndexOwnership, NativeIndexQueryLayout, NativeIndexStagingWriter, NativeOwnerIndexScorer
+
+    if not get_platform().is_sm90 or distributed.get_world_size(cpu_group) != 8:
+        raise NotImplementedError('Native owner Index currently requires eight Hopper ranks')
+    if get_spec().speculative_algorithm is not None:
+        raise NotImplementedError('Native owner Index has no validated speculative writer binding')
+    layout = NativeIndexQueryLayout(configuration.maximum_queries, configuration.maximum_columns,
+                                    configuration.query_heads, configuration.head_dimension)
+    if configuration.head_dimension != 128:
+        raise NotImplementedError('Bind the original native FP4 Index head dimension')
+    rank = distributed.get_rank(cpu_group)
+    plane = KeyValueRecordPlane('index', 'sglang.dsv41.fp4.rne.v1', (64, 4), 64, 'segment_major')
+    native_factory_signature = inspect.signature(base_class._make_indexer_pool)
+
+    class OwnedNativeIndexPool(DeepSeekV4IndexerPool):
+        def __init__(self, ownership, **arguments):
+            self.ownership = ownership
+            super().__init__(size=ownership.local_record_capacity, **arguments)
+            if self.uses_aiter_fp4_layout or self.index_head_dim != 128 or self.page_size != 64:
+                raise NotImplementedError('Bind the native fused Hopper FP4 Index layout')
+            self.index_k_rne = True
+            if any(buffer.shape != (ownership.native_page_count, 4352)
+                   for buffer in self.index_k_with_scale_buffer):
+                raise ValueError('Native Index allocation differs from its charged page geometry')
+            self.owner_writer = NativeIndexStagingWriter(ownership, plane, owner_rank=rank,
+                maximum_write_records=configuration.maximum_write_records,
+                device=self.device, compile_device_module=load_jit)
+
+        def set_index_fp4(self, layer_id, loc, cache_k):
+            staging, ordinals = self.owner_writer.reserve(loc)
+            store_fp4_index_k_cache(input=cache_k, cache=staging, loc=ordinals,
+                                   page_size=self.page_size, rne=self.index_k_rne)
+            self.owner_writer.commit(self.index_k_with_scale_buffer[layer_id - self.start_layer])
+
+    class NativeOwnerIndexTokenPool(base_class):
+        _ulacache_owner_index_binding = True
+
+        def __init__(self, *args, **kwargs):
+            self.native_owner_index_pools = {}
+            super().__init__(*args, **kwargs)
+            if set(self.native_owner_index_pools) != {1, 2}:
+                raise NotImplementedError('Bind the complete V4.1 ratio-1/2 Index storage')
+            self.native_owner_index_scorer = NativeOwnerIndexScorer(layout, device=self.device,
+                cpu_group=cpu_group, ipc_manager_factory=IPCManager,
+                compile_device_module=load_jit, native_score_tile=_fp4_index_logits_tile)
+
+        def _make_indexer_pool(self, *args, **kwargs):
+            bound = native_factory_signature.bind(self, *args, **kwargs)
+            bound.apply_defaults()
+            arguments = dict(bound.arguments)
+            arguments.pop('self')
+            if not arguments.pop('force_fp4'):
+                return super()._make_indexer_pool(*args, **kwargs)
+            size = arguments.pop('size')
+            full_namespace = self.full_size + self.page_size
+            ratio = full_namespace // size
+            if ratio not in (1, 2) or size * ratio != full_namespace:
+                raise ValueError('Low-ratio native Index must preserve the full allocator namespace')
+            if arguments['page_size'] != 64 or arguments['global_page_size'] is not None:
+                raise NotImplementedError('Bind the original low-ratio native Index padding rules')
+            ownership = NativeIndexOwnership(size, self.page_size // ratio, 8, 64, 1, 68)
+            pool = OwnedNativeIndexPool(ownership, **arguments, use_fp4_indexer=True)
+            self.native_owner_index_pools[ratio] = pool
+            return pool
+
+        def local_native_index_storage(self, layer_id):
+            self.wait_layer_transfer(layer_id)
+            ratio, local_layer, _ = self.layer_mapping[layer_id]
+            pool = self.native_owner_index_pools[ratio]
+            return pool, pool.get_index_k_with_scale_buffer(local_layer)
+
+        def local_native_index_keys(self, layer_id, striped_global_slots):
+            self.wait_layer_transfer(layer_id)
+            ratio, local_layer, _ = self.layer_mapping[layer_id]
+            return self.native_owner_index_pools[ratio].get_index_k_dequant(
+                local_layer, striped_global_slots // 8)
+
+        def get_index_k_with_scale_buffer(self, layer_id):
+            if self.layer_mapping[layer_id][0] in self.native_owner_index_pools:
+                raise RuntimeError('Global Index getters cannot address owner-local native pages')
+            return super().get_index_k_with_scale_buffer(layer_id)
+
+        def get_low_ratio_index_k_dequant(self, layer_id, slots=None):
+            if self.layer_mapping[layer_id][0] in self.native_owner_index_pools:
+                raise RuntimeError('Global Index readback requires the owner scoring binding')
+            return super().get_low_ratio_index_k_dequant(layer_id, slots)
+
+        def get_low_ratio_index_k_fp4(self, layer_id, slots):
+            if self.layer_mapping[layer_id][0] in self.native_owner_index_pools:
+                raise RuntimeError('Global packed Index readback requires an explicit owner binding')
+            return super().get_low_ratio_index_k_fp4(layer_id, slots)
+
+        def native_owner_index_storage_inventory(self):
+            tensors = list(self.native_owner_index_scorer.device_storage_inventory())
+            for pool in self.native_owner_index_pools.values():
+                tensors.extend(pool.index_k_with_scale_buffer)
+                tensors.extend(pool.owner_writer.device_storage_inventory())
+            return tuple(tensors)
+
+        def close(self):
+            self.native_owner_index_scorer.close()
+            super().close()
+
+    return NativeOwnerIndexTokenPool
+
+
+def install_native_owner_index_scoring():
+    """Bind native projections/metadata and retain each native top-k consumer."""
+    import torch
+    from sglang.kernels.ops.attention.dsv4.topk import plan_topk_v2
+    from sglang.srt.layers.attention.dsv4.v41_indexer import scoring, full_topk, dense_blocks
+
+    original_decode = scoring.decode_scores
+    original_prefill = scoring.prefill_requests
+
+    def decode_scores(*, inputs, token_to_kv_pool, req_to_token, candidate_mask=None):
+        pool = token_to_kv_pool
+        if not hasattr(pool, 'native_owner_index_scorer'):
+            return original_decode(inputs=inputs, token_to_kv_pool=pool,
+                req_to_token=req_to_token, candidate_mask=candidate_mask)
+        ratio = inputs.compress_ratio
+        requests, positions = inputs.req_rows, inputs.positions
+        rows = requests.shape[0]
+        if positions.shape[0] != rows:
+            raise ValueError('Owner Index decode needs one native query per request')
+        width = min(inputs.paged_metadata.max_compressed_seq_len, req_to_token.shape[1] // ratio)
+        if rows == 0 or width == 0:
+            inputs.reset_outputs()
+            return None
+        q = inputs.indexer.queries(inputs.q_lora, inputs.freqs_cis[positions])
+        weights = inputs.indexer.head_weights(inputs.x)
+        lengths = ((positions + 1) // ratio).to(torch.int32)
+        plan = plan_topk_v2(lengths)
+        index_pool, storage = pool.local_native_index_storage(inputs.layer_id)
+        scores = pool.native_owner_index_scorer.score(q, weights, requests, lengths,
+            req_to_token, storage, ownership=index_pool.ownership, logical_width=width,
+            compression_ratio=ratio, candidate_mask=candidate_mask)
+        return scoring.PagedDecodeScores(bs=rows, lmax=width, lens=lengths, scores=scores,
+            req=requests, req_to_token=req_to_token, ratio=ratio, plan=plan,
+            has_candidate_mask=candidate_mask is not None)
+
+    def prefill_requests(*, inputs, token_to_kv_pool, req_to_token):
+        pool = token_to_kv_pool
+        if not hasattr(pool, 'native_owner_index_scorer'):
+            yield from original_prefill(inputs=inputs, token_to_kv_pool=pool, req_to_token=req_to_token)
+            return
+        ratio, indexer = inputs.compress_ratio, inputs.indexer
+        req, pos = inputs.req_rows, inputs.positions
+        inputs.reset_outputs()
+        q = indexer.queries(inputs.q_lora, inputs.freqs_cis[pos])
+        weights = indexer.head_weights(inputs.x)
+        compressed_lengths = (pos + 1) // ratio
+
+        def chunks(request, index_k):
+            rows_per_chunk = min(pool.native_owner_index_scorer.layout.maximum_queries,
+                max(1, scoring._TORCH_SCORE_BUDGET_BYTES // (q.shape[1] * request.lc * 2)))
+            for start in range(0, request.tok.numel(), rows_per_chunk):
+                rows = slice(start, start + rows_per_chunk)
+                tokens, lengths = request.tok[rows], request.lens[rows]
+                scores = pool.native_owner_index_scorer.score_prefill(q[tokens], weights[tokens],
+                    req[tokens], lengths, index_k, logical_width=request.lc, native_score_fn=indexer.scores)
+                yield scoring.ChunkScores(rows=rows, tok=tokens, lens=lengths, scores=scores)
+
+        for r in torch.unique_consecutive(req).tolist():
+            tokens = (req == r).nonzero().squeeze(1)
+            lengths = compressed_lengths[tokens]
+            width = int(lengths.max().item())
+            if width == 0:
+                continue
+            columns = torch.arange(width, device=pos.device)
+            slots = req_to_token[r, columns * ratio].to(torch.int64) // ratio
+            index_k = pool.local_native_index_keys(inputs.layer_id,
+                slots[pool.native_owner_index_scorer.rank::8])
+            request = scoring.RequestScores(lc=width, k=min(indexer.index_topk, width),
+                columns=columns, tok=tokens, lens=lengths, slots=slots)
+            yield request, chunks(request, index_k)
+
+    for module in (scoring, full_topk, dense_blocks):
+        module.decode_scores = decode_scores
+        module.prefill_requests = prefill_requests
