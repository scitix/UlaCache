@@ -0,0 +1,131 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Memory accounting for the complete-record DSA KV cache.
+
+The same layout is used when sizing the KV pool and when allocating its
+decode arena.  A PD decode worker receives prefill KV from another worker,
+so it has no target-prefill scratch buffer.  Speculative target verification
+uses the decode arena and does not change this rule.
+"""
+
+from __future__ import annotations
+
+
+from sglang.srt.mem_cache.flowkv_adapter import FlowKVPackedMLASpec
+from sglang.srt.mem_cache.flowkv_record_layout import NativePageLayout, history_capacity
+from sglang.srt.mem_cache.flowkv_record_lifecycle import LayerGroupPlan
+
+from ulacache.storage.workspace import (
+    DEFAULT_FLOWKV_LOGICAL_TOKENS_PER_KV_ROW,
+    needs_prefill_scratch, round_up_power_of_two,
+)
+from ulacache.storage.workspace import ResidentQueryLayout as FlowKVLayout
+from ulacache.storage.workspace import PlainPrefillLayout
+from ulacache.storage.capacity import request_history_capacity
+
+import os
+
+def _target_query_width() -> int:
+    """Use the target graph's width; draft-token count already includes bonus."""
+    from sglang.srt.mem_cache.flowkv_v0522_context import get_spec, max_speculative_num_draft_tokens
+    from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+
+    algorithm = SpeculativeAlgorithm.from_string(get_spec().speculative_algorithm)
+    if algorithm.is_none():
+        return 1
+    return algorithm.get_num_tokens_per_req_for_target_verify(
+        max_speculative_num_draft_tokens(), is_draft_worker=False
+    )
+
+
+def _history_capacity(max_queries: int, topk: int, page_size: int) -> int:
+    from sglang.srt.environ import envs
+
+    from sglang.srt.ulacache.v0522_owner_tp import configuration
+    multiplier = configuration().cache_capacity_multiplier
+    return request_history_capacity(max_queries, topk, multiplier, page_size)
+
+
+
+
+def layout_for_packed_mla(
+    kvc, pool_rows: int, packed_mla: FlowKVPackedMLASpec
+) -> FlowKVLayout:
+    """Resolve a local-KV-buffer layout for a packed MLA cache tier.
+
+    The model adapter describes the indexed packed tier. This generic planner
+    deliberately has no dependency on model names, tier labels, or compression
+    ratios. Other KV tiers remain owned by their native model cache.
+    """
+    from sglang.srt.mem_cache.flowkv_v0522_context import (
+        get_disagg,
+        get_exec,
+        get_memory,
+        get_parallel,
+        get_schedule,
+    )
+
+    start, end = kvc.layer_info.start_layer, kvc.layer_info.end_layer
+    compression_ratio = packed_mla.compression_ratio
+    if compression_ratio <= 0:
+        raise ValueError("Packed MLA compression ratio must be positive")
+    if kvc.pool_page_size % compression_ratio:
+        raise ValueError(
+            "Global page size must be divisible by the packed MLA compression "
+            f"ratio: {kvc.pool_page_size=} {compression_ratio=}"
+        )
+    packed_layers = packed_mla.local_layer_count(start, end)
+    layer_anchors = packed_mla.local_layer_anchors(start, end)
+    layer_groups = LayerGroupPlan.from_layer_anchors(layer_anchors)
+    if not packed_layers:
+        raise ValueError("FlowKV requires at least one local packed MLA layer")
+    graph = get_exec().graph.cuda_graph_config.decode
+    parallel = get_parallel()
+    running = get_schedule().max_running_requests or 0
+    local_running = (running + parallel.attn_dp_size - 1) // parallel.attn_dp_size
+    max_batch = max(graph.max_bs or 0, max(graph.bs or [0]), local_running, 1)
+    verify_width = _target_query_width()
+    resident_queries = max_batch * verify_width
+    max_queries = round_up_power_of_two(resident_queries)
+    plain_window = int(os.environ.get("UDCACHE_PLAIN_PREFILL_WINDOW_ROWS", "0"))
+    if plain_window < 0:
+        raise ValueError("Plain prefill window must be nonnegative")
+    if plain_window and compression_ratio == 1:
+        if get_schedule().chunked_prefill_size is None or get_schedule().chunked_prefill_size <= 0:
+            raise ValueError("Bounded Plain prefill requires an explicit positive chunk capacity")
+        if (parallel.attn_dp_size != 1 or parallel.attn_cp_size != 1) and not (os.environ.get("UDCACHE_OWNER_QUERY_PREFILL") == "1" and parallel.attn_dp_size == 1 and parallel.attn_cp_size == parallel.tp_size == 8):
+            raise NotImplementedError("Bounded Plain prefill currently requires ordinary shared TP")
+
+    layout_type = PlainPrefillLayout if plain_window and compression_ratio == 1 else FlowKVLayout
+    layout = layout_type(
+        layers=packed_layers,
+        groups=layer_groups.group_count,
+        max_batch=max_batch,
+        pool_rows=pool_rows,
+        row_bytes=packed_mla.row_bytes,
+        disaggregation_mode=get_disagg().disaggregation_mode,
+        topk=packed_mla.topk,
+        max_query_tokens=max_queries,
+        max_resident_queries=resident_queries,
+        history_slots=_history_capacity(
+            max_batch, packed_mla.topk, kvc.pool_page_size // compression_ratio
+        ),
+        page_size=kvc.pool_page_size // compression_ratio,
+        native_segment_bytes=packed_mla.native_segment_bytes,
+        layer_anchors=layer_anchors,
+        compression_ratio=compression_ratio,
+        page_storage_alignment=packed_mla.page_storage_alignment,
+        max_staging_tokens=max(
+            max_queries,
+            (
+                get_schedule().chunked_prefill_size
+                if (get_schedule().chunked_prefill_size or 0) > 0
+                else pool_rows
+            ),
+        ),
+        prefill_window_rows=(
+            plain_window if compression_ratio == 1
+            else get_memory().flowkv_prefill_window_rows
+            if get_memory().enable_flowkv_cp_prefill else 0
+        ),
+    )
+    return layout
diff --git a/python/sglang/srt/mem_cache/flowkv_owner_index.py b/python/sglang/srt/mem_cache/flowkv_owner_index.py
